  <script>
    // Nav scroll state
    const nav = document.getElementById('stNav');
    const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu
    const burger = document.getElementById('stBurger');
    const menu = document.getElementById('stMenu');
    const menuLinks = menu.querySelectorAll('a');
    const toggleMenu = (open) => {
      burger.classList.toggle('is-open', open);
      menu.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => toggleMenu(!menu.classList.contains('is-open')));
    menuLinks.forEach((a) => a.addEventListener('click', () => toggleMenu(false)));

    // IntersectionObserver reveal (multiple types)
    const revealEls = document.querySelectorAll('[data-reveal], [data-draw]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => io.observe(el));

    // Stat counters (rAF eased)
    const easeOutQuart = (t) => 1 - Math.pow(1 - t, 4);
    const animateCount = (el) => {
      const target = parseFloat(el.dataset.count);
      const suffix = el.dataset.suffix || '';
      const dur = 1600;
      const start = performance.now();
      const frame = (now) => {
        const t = Math.min((now - start) / dur, 1);
        const val = target * easeOutQuart(t);
        el.textContent = Math.round(val) + suffix;
        if (t < 1) requestAnimationFrame(frame);
        else el.textContent = Math.round(target) + suffix;
      };
      requestAnimationFrame(frame);
    };
    const counters = document.querySelectorAll('[data-count]');
    const cio = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          cio.unobserve(entry.target);
        }
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => cio.observe(el));

    // Footer year
    document.getElementById('stYear').textContent = new Date().getFullYear();
  </script>
