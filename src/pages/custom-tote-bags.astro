  .tb-quote figcaption span { display: flex; flex-direction: column; }
  .tb-quote figcaption strong { font-family: var(--font-heading); font-weight: 600; font-size: 1rem; color: var(--color-brand-text); }
  .tb-quote figcaption em { font-style: normal; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-brand-muted); }
