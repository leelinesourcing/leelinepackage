---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const TN = `${R2}/tin-boxes`;

/* The nine tin families that carry the searches a buyer actually types. These
   are the only photographs the page keeps — every other image position is a
   labelled placeholder for the client's own photography. */
const types = [
  { n: 'PT-01', key: 'type-printed', name: 'Custom Printed Tin Boxes', spec: 'Six-color litho, label-free',
    alt: 'A rectangular tin printed with a full-color illustrated holiday scene, its lid resting alongside',
    d: 'Artwork laid straight onto the metal in six colors. The design runs across the lid, the body and the base with no label edge to lift.' },
  { n: 'FG-02', key: 'type-food-v2', name: 'Food-Grade Tin Boxes', spec: 'FDA and EU 10/2011',
    alt: 'Round food tins filled with nuts and savory snacks on a marble surface, one closed with a gold lid',
    d: 'An internal lacquer rated for the fill rather than a generic coating, and the wall is food-contact by construction.' },
  { n: 'WS-03', key: 'type-wholesale-v2', name: 'Wholesale Custom Tin Packaging', spec: '500 – 500,000 units',
    alt: 'A tall stack of plain rectangular hinged tins photographed closed and unbranded on a pale cloth',
    d: 'A single specification held across a long program, with the unit rate stepping down at the volume tier a reorder actually reaches.' },
  { n: 'OE-04', key: 'type-oem-v3', name: 'OEM Tin Boxes', spec: 'Drawn to your size',
    alt: 'Assorted unprinted tin boxes in cube, round and flat shapes, in plain colors with no branding',
    d: 'Drawn to dimensions only you use. The size comes from the product instead of from the nearest stock tin in a catalog.' },
  { n: 'TE-05', key: 'type-tea', name: 'Custom Tea Tins', spec: 'Airtight, light-proof',
    alt: 'Two tall black matte tin canisters with printed labels standing side by side',
    d: 'An opaque wall blocks the light and a gasket holds the aroma that a clear pack or a paper bag loses in the first weeks on a shelf.' },
  { n: 'CK-06', key: 'type-cookie', name: 'Custom Cookie Tins', spec: 'Gasket or friction lid',
    alt: 'A group of printed holiday tins in assorted shapes and colors on a dark surface',
    d: 'A gasket lid keeps crispness through a humid kitchen, and the tin is the gift wrap, which means the packaging outlives the gift.' },
  { n: 'DC-07', key: 'type-decor-v3', name: 'Decorative Metal Tin Boxes', spec: 'Emboss, deboss, spot UV',
    alt: 'Three round tins printed with intricate blue and gold mandala patterns, photographed from above',
    d: 'Embossing, inset lids and a full-wrap pattern turn a container into the collectible a repeat buyer keeps on a desk.' },
  { n: 'CD-08', key: 'type-candle', name: 'Custom Candle Tins', spec: 'Heat-safe, resealable',
    alt: 'A lit candle in a burnished gold tin on a marble tray beside a second matte tin',
    d: 'A wall that takes a hot pour without warping, and a lid that still closes after the first burn, so the candle travels as a product.' },
  { n: 'GF-09', key: 'type-gift', name: 'Custom Gift Tin Boxes', spec: 'Suitcase, window, shaped',
    alt: 'A pastel tin case with a rounded handle beside smaller printed tins in a gift set',
    d: 'A shaped or handled tin that presents as a gift box and then gets reused as storage, which earns a second impression at no cost.' },
];

/* §Why Choose a Tin Box — the four properties that are true of drawn metal and
   of nothing else on a packaging shelf. Text only, each with its own mark: the
   client asked for no photography in this section. The paint and the SIZE live
   inside each string, because a scoped <style> cannot reach a set:html SVG. */
const why = [
  { t: 'One-Piece Drawn Body',
    ico: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2.5a1 1 0 0 1 1 1V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6.5a1 1 0 0 1 1-1z"/></svg>',
    d: 'A tin body is a single piece of metal pressed out of a flat blank and closed on a rolled seam. There is no glue line, no folded corner and no score for a courier to break along.' },
  { t: 'Blocks Light and Moisture',
    ico: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l7 2.8v5.9c0 4.1-2.9 7.3-7 8.8-4.1-1.5-7-4.7-7-8.8V6.3z"/><path d="M12 9.4c1.3 1.5 2.1 2.5 2.1 3.5a2.1 2.1 0 1 1-4.2 0c0-1 .8-2 2.1-3.5z"/></svg>',
    d: 'Metal stops light and moisture by itself. Board gets there with a liner or a film bag inside it; a tin arrives already closed, which is why tea and coffee go in one.' },
  { t: 'No Label to Peel',
    ico: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6.5" width="16" height="11" rx="2"/><path d="M8 10.5h8M8 13.5h5"/></svg>',
    d: 'The artwork is in the surface of the metal rather than on a label stuck to it. There is no edge to lift, no laminate to delaminate and no second operation to cut a print down to size.' },
  { t: 'Kept and Reused',
    ico: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v4.6h-4.6"/></svg>',
    d: 'A tin gets kept. It becomes the sewing box, the spice tin, the place the good pens live. That second life is the cheapest repeat impression a brand can buy.' },
];

/* §The Five Tin Lid Types — the client's own photographs. Each one was shot on
   white and re-based onto the section's clay by the encoder, so the figure sits
   in the section rather than on a white rectangle inside it. Every shot is an
   open tin: a closed frame cannot be recovered from an open one, so no hover
   state is faked. */
const lids = [
  { n: '01', t: 'Friction slip lid',
    key: 'lid-friction-clay2',
    alt: 'A purple printed tin with its slip lid slid partway off and resting across the open body',
    best: 'Mints, lip balm, tea sachets, cards',
    d: 'Presses onto a straight wall with the seam of air escaping as it seats — <strong>the cheapest closure to tool</strong>, and the closure that still opens with cold hands.' },
  { n: '02', t: 'Gasket seal',
    key: 'lid-gasket-clay2',
    alt: 'A steel tin lying on its side with the lid removed and the gasket ring set into the lid channel',
    best: 'Tea, coffee, spices, biscuits, supplements',
    d: 'A food-grade silicone ring set into the lid channel, bearing on the body rim. <strong>This is the closure that makes a tin airtight</strong> — a friction lid and a hinge do not.' },
  { n: '03', t: 'Concealed hinge',
    key: 'lid-hinge-clay2',
    alt: 'A burgundy tin standing open on its concealed hinge, with a close-up of the hinge inset beside it',
    best: 'Gift sets, first-aid, sewing kits, tobacco',
    d: 'The lid stays attached, so <strong>it cannot be dropped or set down wet</strong>, and the outer face stays unbroken for a wrap-around print.' },
  { n: '04', t: 'Rolled screw thread',
    key: 'lid-screw-clay2',
    alt: 'A silver screw-thread tin with its round lid lifted clear and resting beside the body',
    best: 'Powders, creams, waxes, lip balm',
    d: 'Closes in stages rather than in a single push, which <strong>suits a fill opened and closed many times</strong> over its life.' },
  { n: '05', t: 'Tamper band',
    key: 'lid-tamper-clay2',
    alt: 'A tin closed with a tamper-evident band, a wooden spoon standing inside it',
    best: 'Cosmetics, pharmacy, supplements',
    d: 'A band bridges lid and body and tears on the first opening, so <strong>the break reads at a glance</strong> from across a counter.' },
];

/* §What Goes Wrong With a Tin Order — every card leads with what we do about
   it and what the buyer ends up with, rather than stopping at the problem. */
const risks = [
  { n: '01', risk: 'They arrive dented, and the lids no longer sit flat',
    action: 'The wall grade is set from the packed weight and the pallet pattern rather than from the unit price, and the finished lot is dropped and compression tested at the ISTA height before it is palletized.',
    gain: 'A consignment that opens clean at the far end, and no credit notes for damage that was decided at the quoting stage.',
    tag: 'Drop and compression tested' },
  { n: '02', risk: 'The lid is tight on some units and loose on others',
    action: 'The friction band is a dimension held on the die rather than a setting on a machine, and the first tin off a new die is gauged against it before the line is released.',
    gain: 'Every tin in the run handles the same way on a shelf, in a customer’s hand, and on the tenth reorder.',
    tag: 'Gauged before release' },
  { n: '03', risk: 'Tooling appears on the second invoice',
    action: 'The dies are cut and billed once, on the first order, and then held on the line for the life of the program.',
    gain: 'A reorder prices from the metal alone, with no tooling line to explain at the invoice stage.',
    tag: 'Charged once' },
  { n: '04', risk: 'Order twelve does not match order one',
    action: 'A retained Pantone chip is read on the press at every run, and each reorder is signed off against the same physical standard as the first.',
    gain: 'A reprint sits beside the original on the same shelf without a visible difference between them.',
    tag: 'Pantone chip retained' },
];

/* Fill type drives the lacquer, and the lacquer is what makes a tin
   food-contact. The one genuinely tabular block on the page. */
const linings = [
  { fill: 'Dry, low fat', eg: 'Biscuits, tea, mints, cards, tools', lacquer: 'Standard food-contact lacquer', rating: 'No migration barrier called for' },
  { fill: 'Fatty', eg: 'Chocolate, wax, balm, nuts', lacquer: 'Epoxy-phenolic', rating: 'Rated for direct contact with fats', key: true },
  { fill: 'Acidic', eg: 'Fruit, tomato, pickles, citrus', lacquer: 'Acid-resistant, organosol', rating: 'Resists a pH down to 3.5', key: true },
  { fill: 'Aqueous', eg: 'Sauces, honey, jam, dressings', lacquer: 'Two-coat epoxy-phenolic', rating: 'Pinhole-tested before the tin is filled' },
  { fill: 'Not food', eg: 'Candles, cosmetics, hardware', lacquer: 'None, or a clear varnish', rating: 'Coating omitted, which cuts the unit cost' },
];

/* §How We Print on Tinplate — the client's own photograph per finish, one
   shown at a time. */
const finishes = [
  { t: 'Six-color offset litho', key: 'fin-litho',
    alt: 'A litho press running a wide sheet past four inked rollers, a rainbow of color laid across it',
    d: 'Artwork printed on the flat sheet before forming, so the full wrap lands on the metal in one pass. Six colors plus a varnish is enough for a photographic panel on the lid and a second design on the body.' },
  { t: 'Matte or gloss varnish', key: 'fin-varnish',
    alt: 'Two tan tins side by side, one lid matte and one glossy, the gloss catching the light',
    d: 'Applied on the press: the tin reads dull to the touch or reflective, with no lamination to lift at an edge. A matte face hides fingerprints and scuffs; a gloss face deepens dark ink and photographs well.' },
  { t: 'Emboss and deboss', key: 'fin-emboss',
    alt: 'A gold tin beside a black tin, the gold mark raised out of the surface and the black mark recessed into it',
    d: 'A logo raised or recessed into the metal on the same pass as the print. Tactile, and impossible to peel off. The depth is held on the die, which keeps the raise identical from the first tin to the last, and on the reorder.' },
  { t: 'Spot UV', key: 'fin-uv',
    alt: 'Decorative printed tins grouped in soft light, a gloss detail catching a highlight across the lid',
    d: 'A raised gloss mark over a matte base, for the detail that has to catch a light on a shelf. It is the cheapest way to give one element of a design a surface of its own.' },
  { t: 'Metallic and pearl inks', key: 'fin-ink',
    alt: 'Pastel printed tins with metallic gold and silver lids arranged in a row',
    d: 'Gold, silver and pearl laid as ink rather than as a foil, which keeps the tin recyclable as steel. Foil is pressed onto flat board; on a formed tin the ink route is what holds its edge.' },
  { t: 'PVC window', key: 'fin-window',
    alt: 'Square tins with clear film windows in the lid, the contents visible through the aperture',
    d: 'A cut aperture closed with clear film, for a fill that has to be seen before the lid comes off. The film goes in on the same pass, which means the window adds no separate assembly step.' },
];

/* §Structure — the twelve body-and-lid structures, following the Structure
   board on tinboxeschina.com. The drawings are that board's own line art,
   split two-tone at the lid seam: brass above it, white below. */
const struct = [
  { t: 'Square Tins', key: 'struct-square-v2', alt: 'Line drawing of a square tin' },
  { t: 'Rectangular Tins', key: 'struct-rectangular-v2', alt: 'Line drawing of a rectangular tin' },
  { t: 'Round Tins', key: 'struct-round-v2', alt: 'Line drawing of a round tin' },
  { t: 'Cylindrical Tins', key: 'struct-cylindrical-v2', alt: 'Line drawing of a tall cylindrical tin' },
  { t: 'Octagonal Tins', key: 'struct-octagonal-v2', alt: 'Line drawing of an octagonal tin' },
  { t: 'Heart Tins', key: 'struct-heart-v2', alt: 'Line drawing of a heart-shaped tin' },
  { t: 'Hinged Lid Tins', key: 'struct-hinged-v2', alt: 'Line drawing of a hinged-lid tin standing open' },
  { t: 'Sliding Lid Tins', key: 'struct-sliding-v2', alt: 'Line drawing of a tin with its lid slid open' },
  { t: 'Double Lids Tins', key: 'struct-double-v2', alt: 'Line drawing of a double-lidded tin' },
  { t: 'Clip Lid Tins', key: 'struct-clip-v2', alt: 'Line drawing of a tin closed with a metal clip' },
  { t: 'Window Lid Tins', key: 'struct-window-v2', alt: 'Line drawing of a tin with a clear window lid' },
  { t: 'Handle Tins', key: 'struct-handle-v2', alt: 'Line drawing of a handled tin' },
];

/* §Tin Order Lead Time. One brass mark per stop. The paint and the SIZE live
   inside each string: a scoped <style> cannot reach a set:html SVG, and an
   inline SVG carrying only a viewBox collapses to zero width in a flex box. */
const flowIcons = [
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4-1 9-9-3-3-9 9z"/><path d="M14 7l3 3"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1.5"/><path d="M3 12h18"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20a8 8 0 0 1 16 0z"/><path d="M12 12V4M12 8l3-2M12 8l-3-2"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 12h10M7 9h10M7 15h6"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>',
];

const stages = [
  { when: 'Day 0', name: 'Drawing and Mockup', d: 'A dimensioned dieline and a 3D mockup inside 24 hours, with the wall, the draw depth and the lid settled on the drawing rather than in the toolroom.' },
  { when: 'Day 1–4', name: 'White Dummy', d: 'An unprinted tin at the finished size in 3–5 working days, held against the product and closed by hand before a plate is ever made.' },
  { when: 'Day 5–12', name: 'Printed Sample', d: 'A tin in the final lining and print in 7–10 days, with the color read against the Pantone chip and signed off before the run is released.' },
  { when: 'Day 12–38', name: 'Print, Draw, Form, Seam', d: 'The run goes on the metal booked at the first stop: printed flat, drawn, formed and seamed, with the lids pressed to the drawing that was signed off.' },
  { when: 'Day 38–42', name: 'Lacquer Test and Pallet', d: 'The lot is inspected and the migration report issued, the tins are nested and palletized, and the lot goes out strapped and corner-protected.' },
];

/* §Recycling and Sustainability — text only. The section is built to take a
   background photograph: add it on `.tn-metal` (the rule below names the slot)
   and the translucent cards keep the copy readable over it. */
const metal = [
  { t: 'Recycled as steel, not downcycled', d: 'Steel is recycled without any loss of quality, over and over, in any market with a mature collection system.' },
  { t: 'Coatings you can declare', d: 'Low-VOC ink formulations and bio-based coating options, with the food-contact route declared on the lot paperwork.' },
  { t: 'A lining that breaks down', d: 'A plant-based lining option for dry fills, which breaks down once the tin has been separated out and recycled as steel.' },
  { t: 'Lower emissions per run', d: 'Renewable power and heat recovery across the forming lines, which brings down the emissions and the waste a large run otherwise produces.' },
];

/* §Customer Scenes — the client's own photographs of the tins in use, three to
   a view, looping. */
const scenes = [
  { key: 'scene-1', alt: 'A customer in a kitchen holding a heart-shaped tin tied with a ribbon' },
  { key: 'scene-2', alt: 'A man in a suit holding an open red round tin, photographed against a pink studio wall' },
  { key: 'scene-3', alt: 'Two open black tins of balm on a marble tray with a candle and roller bottles' },
  { key: 'scene-4', alt: 'A child building a printed tin toy set across a wooden table' },
  { key: 'scene-5', alt: 'Someone lifting the lid off a red tin gift box at home' },
  { key: 'scene-6', alt: 'A heart-shaped tin being opened at a table with two children watching' },
];

const quotes = [
  { name: 'Kenji Takada', role: 'Product Development Director · Japan',
    img: 'avatar-kenji', alt: 'Portrait of Kenji Takada',
    p: [
      'The brief was a food-safe tin that carried the range’s own colors, and the part that had to be right was the print. What came back held the artwork’s detail in 6 colors on the lid and the body at once, which is the thing a board pack could not do for us.',
      'The lids fit. That sounds like the minimum, but a lid that is loose or stiff changes how the product is handled in a shop, and these closed the same way on every tin in the run.',
      'The material options also lined up with what we had already committed to on sustainability, which meant the packaging did not become the part of the launch we had to explain.',
    ] },
  { name: 'Emma Lewis', role: 'Procurement Manager · United Kingdom',
    img: 'avatar-emma', alt: 'Portrait of Emma Lewis',
    p: [
      'We have sourced tins from LeelinePackage for over a year, since a first run at the 500-unit minimum, and the useful thing is that the second order looks like the first. Consistency across reorders is what a procurement desk is actually buying.',
      'The tins improved how the product presents on a shelf, and they survived the shelf. Metal does not scuff and crush the way a board pack does once it is at the front of a store.',
      'The 4–6 week window held, and the communication never left us chasing. Over a year of orders, that is what keeps a supplier on a short list.',
    ] },
];

/* The FAQ carries only what the sections above do NOT answer — checked heading
   by heading. MOQ (hero H1 + pill), the tinplate range (hero pill + §What Goes
   Wrong), airtightness (§The Five Tin Lid Types, Gasket seal) and tooling cost
   (§What Goes Wrong, risk 03) all appear earlier, so none of them is repeated
   here. Freight, mixed shapes, a failed lot, interior print and reorders are
   not stated anywhere else on the page. */
const faqs = [
  { q: 'How do the tins ship, and what does that do to freight?',
    a: 'Nested and palletized. An empty tin is a container with nothing in it, which means tins stack inside each other and a pallet carries several times the number its footprint suggests. Lids are banded separately wherever the nesting would score the print, and the pallet is corner-protected for the sea leg.' },
  { q: 'Can one order carry several shapes?',
    a: 'Yes, and most ranges do. A gift set with three components usually carries three tins, and each new outline is its own pair of dies. What cannot be shared is the metal booking: each wall grade is a separate coil and each outline a separate setup, and both are quoted as their own line rather than appearing on the invoice afterwards.' },
  { q: 'Can the inside of the tin be printed?',
    a: 'Yes, and it is worth doing where the lid comes off entirely and the inside face is on show. A printed interior means the ink has to sit under a food-contact lacquer, which adds a coating pass and is quoted as its own line. On a fill that is not food, the interior can be printed directly with no coating over it.' },
  { q: 'What happens if a lot fails inspection?',
    a: 'It does not ship. The check runs against AQL 2.5 before the tins are palletized, while the dies are still set on the line, so a failing lot is reworked or remade there rather than argued about after it has crossed an ocean. The inspection record ships with the lot.' },
  { q: 'How long does a reorder take?',
    a: 'A reorder skips everything up to the press. The dies are already cut and the artwork already signed off, so it is the production stage alone — printed, drawn, formed and lidded — and it books into the next free slot on the line rather than behind a new tooling set.' },
  { q: 'What do you need to quote a run?',
    a: 'The fill, the width and the height you want, the quantity, and whether the artwork covers the lid or the whole body. The fill settles the lining; size and quantity settle the wall and the tier; the print area settles whether a second die is involved. A photograph of the product beside a ruler usually closes the last gap.' },
];

const seo = {
  title: 'Custom Tin Box Manufacturers: 72-Hour Salt Spray Tested, FDA',
  description: 'Protect margins from freight rust and compliance rejections. Food-grade lacquers and anti-humidity sealing hold a 99.8% AQL 2.5 pass rate for customs clearance.',
  keywords: 'custom tin box manufacturers, custom printed tin boxes, food grade tin box manufacturer, wholesale custom tin packaging, OEM tin box manufacturer China, custom tea tin manufacturer, custom cookie tin boxes, decorative metal tin boxes, custom candle tin manufacturer, airtight tin box manufacturer, metal tin packaging supplier, custom tin boxes wholesale, tin can manufacturer, food grade tin box supplier',
  canonical: 'https://www.leelinepackage.com/custom-tin-box/',
  ogImage: `${TN}/hero-v2.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Tin Box Manufacturing',
      description: seo.description,
      serviceType: 'Custom tin box design, six-color litho printing on food-grade tinplate, closure engineering and manufacture in square, rectangular, round, cylindrical, octagonal, heart, hinged-lid, sliding-lid, window-lid and handled tins',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Tin Box' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${TN}/hero-v3.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ 1. HERO ============ -->
    <section class="tn-hero" id="tn-hero">
      <div class="wrap tn-hero-inner">
        <span class="eyebrow" data-reveal="up"><Fragment set:html={leaf} />Custom tin box manufacturing</span>
        <h1 class="tn-title" data-reveal="up" style="--d:0.08s">Custom Tin Box Manufacturers: <em>72-Hour Salt Spray Tested</em>, FDA &amp; EU Food-Contact Ready</h1>
        <p class="tn-lede" data-reveal="up" style="--d:0.16s">Protect your margins against ocean-freight rust and compliance rejections with premium custom tin box manufacturers. Our food-grade lacquers and anti-humidity sealing maintain a 99.8% pass rate under AQL 2.5 standards for seamless customs clearance.</p>
        <ul class="tn-tags tn-tags--center" data-reveal="up" style="--d:0.24s">
          <li class="tn-tag tn-tag--light">MOQ 500 units</li>
          <li class="tn-tag tn-tag--light">0.23–0.45 mm tinplate</li>
          <li class="tn-tag tn-tag--light">FDA &amp; EU 10/2011 linings</li>
        </ul>
        <div class="tn-hero-cta" data-reveal="up" style="--d:0.3s">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Get My Tin Quote
            <Fragment set:html={arrow} />
          </a>
        </div>
