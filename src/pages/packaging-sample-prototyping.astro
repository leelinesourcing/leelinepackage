---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

const R2 = 'https://img.leelinepackage.com';
const SAMPLE = `${R2}/sample`;

/* The other two services live in-repo; this page is the third service. */
const CHILD = {
  structure: '/structural-engineering-and-design/',
  artwork: '/packaging-artwork-design/',
};

/* What you get first — the conversion hook. These are the only place the "first
   deliverable" facts live, so nothing repeats. (Quote / white / printed times,
   revision count.) Distinct from the services-hub stats. */
const first = [
  { v: '24\u201348h', l: 'to a quote & material suggestion' },
  { v: '3\u20135 days', l: 'to a white dummy' },
  { v: '7\u201310 days', l: 'to a printed prototype' },
  { v: '2', l: 'free revisions per sample' },
];

/* The four sample types, each with what it looks like and what it validates.
   Each maps to a real R2 image of that sample. */
const samples = [
  {
    n: '01',
    name: '3D Sample',
    key: 'in-screen model',
    tag: 'See the box before a sheet is cut.',
    img: `${SAMPLE}/3d-sample.webp`, w: 740, h: 740, altH: 'A 3D box model on screen — a rotating openable white dummy',
    looks: ['Rotate it and open it from any angle', 'No physical sheet is printed', 'A link to send for client sign-off'],
    validates: ['Structure reads correctly on screen', 'Proportions and openings look right', 'Catch a dieline error before tooling'],
    media: 'A rotating, openable 3D box model on screen \u2014 the interface, not a beautified render',
  },
  {
    n: '02',
    name: 'White Dummy',
    key: 'unprinted rigid box prototype',
    tag: 'Hold the structure, check the fit.',
    img: `${SAMPLE}/white-dummy.webp`, w: 740, h: 740, altH: 'White unprinted rigid box dummies standing together',
    looks: ['No print \u2014 board, flute and fold only', 'Corrugation and tuck flaps visible', 'Magnetic closure, tabs and assembly on hand'],
    validates: ['Product fits, never floats or jams', 'Assembly is easy to repeat on a line', 'Wall thickness and weight feel right'],
    media: 'A plain white unprinted box dummy with a product being fitted by hand \u2014 the hand checking the hold, not posing',
  },
  {
    n: '03',
    name: 'Digital Colour Sample',
    key: 'digital printed carton prototype',
    tag: 'See the artwork on the real board.',
    img: `${SAMPLE}/colour-sample.webp`, w: 1200, h: 720, altH: 'Colourful digitally printed cartons with a spot vs process colour guide',
    looks: ['Digitally printed artwork', 'Registration crosses and cut edges visible', 'Whether the colour reads dull or true'],
    validates: ['Artwork sits inside the safe lines', 'No trapped text or bleeding', 'Screen colour holds on coated board'],
    media: 'A digitally printed carton prototype showing registration marks, cut edges and the printed artwork',
  },
  {
    n: '04',
    name: 'Production-Line Sample',
    key: 'production sample vs mockup',
    tag: 'The real material, the real process.',
    img: `${SAMPLE}/production-sample.webp`, w: 1200, h: 675, altH: 'A robotic assembly line packing rigid boxes',
    looks: ['Same material, print and finish as the run', 'Foil, lamination and emboss in place', 'A transit-tested version beside it'],
    validates: ['Foil and finish hold in the hand', 'The box survives the courier route', 'Cost per unit is locked before bulk'],
    media: 'A production-line sample with foil and lamination, shown beside its half after a simulated-transit test',
  },
];

/* Approval scene \u2014 the sign-off points that make it feel like a real factory. */
const signoff = [
  { k: 'Colour reference', v: 'Pantone / CMYK proof stapled to the sheet' },
  { k: 'Board & flute', v: 'The exact grade the line will run' },
  { k: 'Dimensions & dieline', v: 'Locked to the signed template' },
  { k: 'Finish map', v: 'Foil, varnish, emboss \u2014 spot for spot' },
];

/* Material durability \u2014 the tests the sample goes through before a run. */
const tests = [
  { t: 'Weight-bearing', d: 'Rated to the stack height the box will meet in a warehouse or store.' },
  { t: 'Drop & impact', d: 'Dropped flat, on edge and corner \u2014 the product stays clear of the board.' },
  { t: 'Thickness & rigidity', d: 'Caliper and stiffness measured against the specified board, not assumed.' },
  { t: 'Print & colour fastness', d: 'Ink adhesion and colour held after rub and light, before the first use.' },
  { t: 'Environmental simulation', d: 'Humidity and temperature cycling \u2014 the conditions the route adds.' },
];

/* Process \u2014 the path from brief to approved sample. */
const process = [
  { t: 'Send the brief', d: 'Artwork in AI, PDF or EPS, or the product size, weight and target price.' },
  { t: 'Check & quote', d: 'A feasibility, material and print check, then a price and a suggested build.' },
  { t: 'Cut a sample', d: 'A white dummy for fit first, then a printed prototype for colour and finish.' },
  { t: 'Revise & approve', d: 'Feedback on fit, colour or finish, then a sign-off against the approved sample and notes.' },
  { t: 'Run the line', d: 'Tooling is cut and production builds to the signed sample \u2014 colour, board and size locked.' },
];

/* FAQ \u2014 sample-led, no overlap with structure / artwork pages. */
const faqs = [
  { q: 'Why order a packaging sample?', a: 'A sample tests what a render can\u2019t \u2014 transit durability, true colour, and how easily a team assembles the box. A mistake found here costs a sample; the same mistake in production costs a run.' },
  { q: 'How does the sample process start?', a: 'The design file or a brief is checked first \u2014 print and material feasibility, a suggested build, then the first sample is cut.' },
  { q: 'Is the sample the same as the production order?', a: 'The approved sample is built to the board, print and finish the line will run, and it becomes the reference the whole run is checked against. The production-line sample is the version that has been through a simulated transit test, so it proves the box on the route before the first bulk run.' },
  { q: 'Are samples revised if they are not right?', a: 'Yes. A sample is revised against feedback on fit, colour or finish until it reads the way you want, then it is signed off for the run.' },
  { q: 'What if the sample doesn\u2019t match the spec?', a: 'Where variance is on the supplier side \u2014 colour drift or material not matching the order \u2014 the sample is reworked or the order credited, so the approved spec is the one the run is built to.' },
];

const seo = {
  title: 'Packaging Sample & Prototyping: 4 Samples, Proof Before Bulk',
  description: 'Pick a sample to de-risk the run: a white dummy for fit, a digital printed prototype for colour and a production-line sample with foil \u2014 real proof on the board',
  keywords: 'packaging sample prototyping, white dummy packaging sample, digital printed carton prototype, production sample vs mockup, packaging sample approval, unprinted rigid box prototype',
  canonical: 'https://www.leelinepackage.com/packaging-sample-prototyping/',
  ogImage: 'https://img.leelinepackage.com/services/sample.webp',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Packaging Sample & Prototyping',
      description: seo.description,
      serviceType: 'Custom packaging sample prototyping and proofing',
      provider: {
        '@type': 'Organization',
        name: 'LeelinePackage',
        url: 'https://www.leelinepackage.com/',
        areaServed: 'Worldwide',
      },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '320' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.leelinepackage.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Packaging Sample & Prototyping' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO (split · single sample image) ============ -->
    <section class="sp-hero">
      <div class="wrap sp-hero-grid">
        <div class="sp-hero-copy">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Hands-on packaging</span>
          <h1 class="sp-hero-title">Packaging Sample &amp; Prototyping: <em>De-Risk Your Mass Production Before Scaling</em></h1>
          <p class="sp-hero-sub">The sample is the cheapest place to find a costly mistake. Approve the board, finish and fit on one prototype, so unit cost, reprint risk and damage returns are settled before the first bulk run &mdash; MOQ 500, on your lead time.</p>
          <div class="sp-hero-cta" data-reveal="up">
            <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
              Request a Sample
              <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="sp-hero-visual" data-reveal="right">
          <figure class="sp-media sp-hero-ph">
            <Image src={`${SAMPLE}/hero.webp`} alt="A flat-lay of packaging samples — a mailer box, paper bags, printed cards and tissue on a studio table" width={1200} height={1117} loading="eager" fetchpriority="high" decoding="sync" class="sp-ph-img" />
            <figcaption class="sp-media-cap">
              <span class="sp-media-k">Four samples, one structure</span>
              <span class="sp-media-s">3D &middot; white dummy &middot; digital colour &middot; production-line</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ WHAT YOU GET FIRST (forest strip) ============ -->
    <section class="sp-first" aria-label="What you get first">
      <div class="wrap sp-first-row">
        {first.map((s) => (
          <div class="sp-first-cell">
            <strong>{s.v}</strong>
            <span>{s.l}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ THE FOUR SAMPLES (alternating identity rows) ============ -->
    <section class="sp-id" id="samples">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Four samples</span>
          <h2 class="section-title" data-reveal="up">What Each Sample Looks Like, <em>and What It Proves</em></h2>
          <p class="section-sub" data-reveal="up">Every sample is built to the same structure, so the step between the four is the material and the finish &mdash; not a different box. Here is what each one shows and the risk it takes off.</p>
        </div>

        <div class="sp-card-grid">
          {samples.map((s, i) => (
            <article class="sp-card" data-reveal="up" style={`--d:${(i % 2) * 0.08}s`}>
              <figure class="sp-media sp-card-ph">
                <Image src={s.img} alt={s.altH} width={s.w} height={s.h} loading="lazy" decoding="async" class="sp-ph-img" />
              </figure>

              <div class="sp-card-body">
                <span class="sp-id-eyebrow">{s.n} &middot; {s.key}</span>
                <h3 class="sp-id-name">{s.name}</h3>
                <p class="sp-id-tagline">{s.tag}</p>

                <div class="sp-id-cols">
                  <div class="sp-id-col">
                    <h4>What it looks like</h4>
                    <ul class="sp-id-list-col">
                      {s.looks.map((l) => <li><svg class="sp-bullet" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{l}</li>)}
                    </ul>
                  </div>
                  <div class="sp-id-col">
                    <h4>What it validates</h4>
                    <ul class="sp-id-list-col sp-id-list-col--check">
                      {s.validates.map((l) => <li><svg class="sp-bullet" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{l}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ APPROVAL SCENE (forest) ============ -->
    <section class="sp-approve" id="approval">
      <div class="wrap sp-approve-grid">
        <figure class="sp-media sp-approve-ph" data-reveal="left" aria-hidden="true">
          <span class="sp-note sp-note--ok">Approved</span>
          <span class="sp-note sp-note--rev">Revise &middot; fit</span>
          <Image src={`${SAMPLE}/sign-off.webp`} alt="A sample approval desk with white dummies, a dieline printout, board swatches and a colour fan" width={1000} height={1000} loading="lazy" decoding="async" class="sp-ph-img" />
          <figcaption class="sp-media-cap"><span class="sp-media-k">Sample approval</span><span class="sp-media-s">Signed, dated, stamped</span></figcaption>
        </figure>

        <div class="sp-approve-body" data-reveal="up">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Packaging sample approval</span>
          <h2 class="sp-approve-title" data-reveal="up">Sign It Off <em>Like a Real Factory</em></h2>
          <p class="sp-approve-sub" data-reveal="up">The approved sample is the reference the whole run is built to. Notes and a signature replace a &ldquo;yes, looks good&rdquo; &mdash; so the line, the printer and QC all work from the same sheet.</p>
          <ul class="sp-signoff" data-reveal="up">
            {signoff.map((s) => (
              <li><span class="sp-signoff-k">{s.k}</span><span class="sp-signoff-v">{s.v}</span></li>
            ))}
          </ul>
          <p class="sp-guarantee" data-reveal="up">Should the sample drift from the spec &mdash; colour variance or a material mismatch &mdash; we rework the sample or credit the order, so the pack you approve is the one that ships.</p>
          <div data-reveal="up" style="margin-top: 1.8rem;">
            <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
              Start With a Sample
              <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MATERIAL DURABILITY ============ -->
    <section class="sp-test" id="testing">
      <div class="wrap sp-test-grid">
        <div class="sp-test-head" data-reveal="up">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Material &amp; durability</span>
          <h2 class="section-title">Test the Material, <em>Not the Mockup</em></h2>
          <p class="section-sub">A sample is built to the material the order ships &mdash; corrugated, greyboard, kraft or coated carton, plus eco and food-contact grades and finishes like foil and emboss. That makes it a true proxy for the run, not a stand-in.</p>
          <figure class="sp-media sp-test-ph">
            <Image src={`${SAMPLE}/test-material.webp`} alt="Material strength testing — a board drop test, a precision micrometer and a compression tester" width={960} height={640} loading="lazy" decoding="async" class="sp-ph-img" />
            <figcaption class="sp-media-cap"><span class="sp-media-k">Test in progress</span><span class="sp-media-s">A board section under a stack-load test</span></figcaption>
          </figure>
        </div>

        <ol class="sp-test-list">
          {tests.map((t, i) => (
            <li class="sp-test-row" data-reveal="up" style={`--d:${i * 0.06}s`}>
              <span class="sp-test-num">0{i + 1}</span>
              <div class="sp-test-body">
                <h3>{t.t}</h3>
                <p>{t.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ PROCESS (step-by-step) ============ -->
    <section class="sp-process" id="how">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>From brief to run</span>
          <h2 class="section-title" data-reveal="up">A Short Path to Something <em>You Can Hold</em></h2>
          <p class="section-sub" data-reveal="up">A transparent route with a review at each step &mdash; so a sample is a decision, not a gamble.</p>
        </div>

        <div class="sp-proc-grid">
          {process.map((p, i) => (
            <div class="sp-proc-card" data-reveal="up" style={`--d:${(i % 3) * 0.08}s`}>
              <span class="sp-proc-num">0{i + 1}</span>
              <h3 class="sp-proc-title">{p.t}</h3>
              <p class="sp-proc-desc">{p.d}</p>
            </div>
          ))}
        </div>

        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Send the Brief
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ WHERE IT FITS (cross-links) ============ -->
    <section class="sp-cross" id="next">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Where this fits</span>
          <h2 class="section-title" data-reveal="up">The Sample Sits <em>Between Two Services</em></h2>
          <p class="section-sub" data-reveal="up">The structure is decided behind it, the artwork sits on it. The sample is the proof between the two.</p>
        </div>

        <div class="sp-next-grid">
          <a class="sp-next-card" data-reveal="up" href={CHILD.structure} target="_blank" rel="noopener">
            <span class="sp-next-kicker">Behind the sample</span>
            <h4>Structural engineering</h4>
            <p>Pick the structure, board and dieline that fit the channel and the route.</p>
            <span class="text-link">Go to structural engineering <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
          <a class="sp-next-card" data-reveal="up" style={`--d:0.1s`} href={CHILD.artwork} target="_blank" rel="noopener">
            <span class="sp-next-kicker">On the sample</span>
            <h4>Packaging artwork design</h4>
            <p>Put the artwork, colour and finishes on the real dieline before the proof.</p>
            <span class="text-link">Go to artwork design <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ FAQ (centred head) ============ -->
    <section class="sp-faq" id="faq">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>FAQ</span>
          <h2 class="section-title" data-reveal="up">Before You <em>Order a Sample</em></h2>
          <p class="section-sub" data-reveal="up">The questions that come up before a proof. Structure and artwork detail live on their own pages.</p>
        </div>

        <div class="sp-faq-list">
          {faqs.map((f) => (
            <details class="sp-faq-item" data-reveal="up">
              <summary><span class="sp-faq-num">Q</span>{f.q}</summary>
              <div class="sp-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA (dark) ============ -->
    <section class="sp-final" id="get-started">
      <div class="wrap sp-final-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Request a sample</span>
        <h2 class="sp-final-title" data-reveal="up">Get a Sample in Your Hands, <em>Before You Commit</em></h2>
        <p class="sp-final-sub" data-reveal="up">Send the artwork or a brief, and a quote and a material recommendation come back before the first sample is cut. A single physical box is enough to get your team and your customer on the same page.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Get a Sample Quote
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ HERO (split \u00b7 2\u00d72 grid) ============ */
  .sp-hero { background: var(--ivory); padding: calc(clamp(7rem, 14vw, 9rem) + 0px) 0 clamp(3.5rem, 7vw, 5rem); position: relative; overflow: hidden; }
  .sp-hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(58% 52% at 80% 16%, rgba(201, 168, 124, 0.16), transparent 70%); }
  .sp-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .sp-hero-title { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2.4rem, 5.5vw, 4.1rem); line-height: 1.02; letter-spacing: -0.03em; color: var(--color-brand-text); margin: 1.2rem 0 0; max-width: 19ch; text-wrap: balance; }
  .sp-hero-title em { font-style: italic; color: var(--brass); }
  .sp-hero-sub { font-size: clamp(1.02rem, 1.7vw, 1.16rem); line-height: 1.7; color: var(--color-brand-muted); max-width: 52ch; margin: 1.4rem 0 0; }
  .sp-hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.1rem; }

  .sp-hero-visual { display: flex; align-items: center; }
  .sp-hero-ph { margin: 0; width: 100%; aspect-ratio: 4 / 3; }

  /* image media slot — the photo fills the box, the caption overlays the bottom */
