---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const JK = `${R2}/jewelry`;

/* ── The spine ────────────────────────────────────────────────────────────────
   A piece reaches the customer wrong for one of three reasons: sulfur in the
   air, an insert that sits too high, or a well that is too loose. Every section
   below answers one of the three, or prices the failure. Competitor jewelry
   pages lead with a type taxonomy and a cert wall; none of them specify the
   lining or show the cavity. So this page carries the lining spec and the
   insert geometry, and one photograph per failure.
   ──────────────────────────────────────────────────────────────────────────── */

const types = [
  { n: 'JT-01', name: 'Custom Ring Boxes', spec: 'One or two wells', img: 'type-ring-v2', w: 900, h: 900,
    alt: 'Two pale blue ring boxes, the front one open on a ring sitting in its slot',
    d: 'A well cut to the band itself — the stone finishes clear of the board underneath.' },
  { n: 'JT-02', name: 'Custom Necklace Boxes', spec: 'Card or tray', img: 'type-necklace-v2', w: 900, h: 900,
    alt: 'A burgundy necklace box open on a gold chain, a cream cloth laid beside it',
    d: 'A card carries the chain along a single curve; it arrives ready to hang rather than knotted.' },
  { n: 'JT-03', name: 'Custom Earring Boxes', spec: 'Paired wells', img: 'type-earring-v2', w: 900, h: 900, blend: true,
    alt: 'Pink and grey earring boxes open on their inserts, each holding a pair of studs',
    d: 'Two wells rather than a shared cavity, because a pair must not meet on the way.' },
  { n: 'JT-04', name: 'Custom Pendant Boxes', spec: 'Deep slot', img: 'type-pendant-v2', w: 554, h: 554,
    alt: 'A sage green pendant box open on a carded pendant, a second box standing behind it',
    d: 'Depth holds a swinging drop still and keeps the bail from riding on the chain.' },
  { n: 'JT-05', name: 'Custom Jewelry Gift Boxes', spec: 'Ribbon or magnet', img: 'type-gift-v2', w: 900, h: 900,
    alt: 'A green gift box open on a necklace, with the matching paper bag behind it',
    d: 'The opening gets photographed. The lid line belongs in the design brief.' },
  { n: 'JT-06', name: 'Custom Jewelry Drawer Boxes', spec: 'Sliding tray', img: 'type-drawer-v2', w: 800, h: 800, blend: true,
    alt: 'A white drawer box pulled open on a black velvet ring slot',
    d: 'The tray travels toward the customer; the piece is seen before it is touched.' },
  { n: 'JT-07', name: 'Custom Jewelry Travel Cases', spec: 'Cut compartments', img: 'type-travel-v2', w: 900, h: 900,
    alt: 'A charcoal travel case open on its jewellery rolls and cut compartments',
    d: 'One case carries a mixed range, with a compartment per piece.' },
  { n: 'JT-08', name: 'Custom Jewelry Set Boxes', spec: 'Two levels', img: 'type-set-v2', w: 900, h: 900, blend: true,
    alt: 'A white two-level case open on a ring tray above and a necklace section below',
    d: 'Two levels: the necklace rides above, and the certificate travels flat underneath.' },
  { n: 'JT-09', name: 'High-End Wooden Jewelry Chests', spec: 'Lid and base', img: 'type-chest-v2', w: 900, h: 900,
    alt: 'Two wooden jewellery chests, the near one open on its divided drawers, the other closed',
    d: 'The build a customer keeps, refills and leaves out on display.' },
];

/* All five now carry the client's own photographs. The branch for a missing
   frame is kept: a labelled empty slot is honest, a stand-in photograph is not. */
const inserts = [
  { n: '01', name: 'Ring slot', img: 'insert-ring-slot-v2', w: 900, h: 502, blend: true,
    alt: 'A red velvet ring-slot tray holding gold rings, beside a cream tray laid flat',
    why: 'Wells measured from the band rather than from a nominal ring size, and cut so the stone hangs free of the floor beneath it.',
    get: 'Nothing comes to rest on the stone.' },
  { n: '02', name: 'Cut tray', img: 'insert-cut-tray-v2', w: 450, h: 296, blend: true,
    alt: 'A white cut tray of small pockets holding rings, earrings and dried flowers',
    why: 'A pocket per SKU, cut from measurements of the actual piece, never guessed from a photograph.',
    get: 'Every SKU rides in its own pocket.' },
  { n: '03', name: 'Necklace card', img: 'insert-necklace-card-v2', w: 900, h: 502,
    alt: 'Square necklace cards in brown and black, a gold chain laid across one of them',
    why: 'Satin or velvet wrapped over board, notched at the top so the chain hangs in a single curve and the clasp stays clear of the wrap.',
    get: 'A chain that keeps its line.' },
  { n: '04', name: 'Pillow pad', img: 'insert-pillow-pad-v2', w: 900, h: 900, blend: true,
    alt: 'Two pale grey suede pillow pads standing in front of an open black case',
    why: 'A shaped pad cut to the inside curve of the piece — the clasp and the band carry no weight at all.',
    get: 'The shape survives the trip.' },
  { n: '05', name: 'Two-level tray', img: 'insert-two-level-v2', w: 900, h: 502, zoom: 1.1,
    alt: 'A sage green box open on two levels, a ring tray above a compartment tray',
    why: 'Two floors taken from the same measurements: the trays ride above, and the papers or the certificate lie in the shallower tray below.',
    get: 'A set travels as a set.' },
];

const linings = [
  { name: 'Velvet', img: 'velvet', alt: 'A deep red velvet ring box open on its hinge, a ring cushion inside',
    use: 'Rings and branded retail boxes', get: 'A polished stone meets nothing abrasive.' },
  { name: 'Suede or microfiber', img: 'suede', alt: 'A tan suede-textured pouch with a snap closure holding a pearl chain, resting on a tray',
    use: 'Modern lines where shine is unwanted', get: 'The chain comes out unmarked, on a face with no shine to it.' },
  { name: 'EVA or foam', img: 'insert-tray', alt: 'An orange cut tray and a black foam tray standing upright beside an open rigid box',
    use: 'Transit and mixed-SKU trays', get: 'Freight cannot move the piece, because the cavity was cut around it.' },
  { name: 'Satin over card', img: 'satin', alt: 'A blush box open on a satin-wrapped card holding a necklace, its ribbon laid beside it',
    use: 'Necklaces and certificates', get: 'Under satin, a chain reads as deliberate.' },
];

/* The client's own material shots — the first three are the material itself
   (board edge-on, kraft grain, leather grain) rather than a product box, which
   is what the source page never had. */
const materials = [
  { name: 'Greyboard', spec: '1.5–3.0 mm', img: 'mat-greyboard-v2', w: 800, h: 800,
    alt: 'A stack of greyboard sheets photographed edge-on, the cut edges showing',
    d: 'Rigidity comes from the board, which is what keeps a full tray from bowing.' },
  { name: 'Kraft and recycled stock', spec: 'FSC chain of custody', img: 'mat-kraft-v2', w: 800, h: 533,
    alt: 'Kraft board sheets fanned to show the surface and the cut corners',
    d: 'A recycled sheet that still takes foil cleanly, for a range sold on what it leaves behind.' },
  { name: 'Leather and leatherette', spec: 'Grain to order', img: 'mat-leather-v2', w: 678, h: 452,
    alt: 'Dark brown leather folded over, the grain catching the light',
    d: 'A grain that hides handling marks — that is what survives a counter better than a flat wrap.' },
  { name: 'Foil, deboss or print', spec: 'Matched to Pantone', img: 'mat-mark-v2', w: 800, h: 599,
    alt: 'A pink box open on a white card foil-stamped in gold',
    d: 'Settled with the wrap, because each method bites differently into a texture — and the one that flakes is the one that gets sent back.' },
];

const structures = [
  { n: '01', name: 'Magnetic Book-Style',
    why: 'A hinged lid frames the piece and shuts on a magnet; it opens one-handed and stays shut in a bag.',
    best: 'Rings, earrings and small pendants', avoid: 'The box has to pack flat for freight' },
  { n: '02', name: 'Lid and Base',
    why: 'The lid lifts clear, and a wide or deep tray comes out in a single movement instead of being angled past a hinge.',
    best: 'A necklace with a tray, watches, multi-piece sets', avoid: 'You need a one-hand open on camera' },
  { n: '03', name: 'Drawer With Ribbon',
    why: 'The tray slides toward whoever is holding it: a counter gesture, not a packing step.',
    best: 'Retail counter, gift-with-purchase', avoid: 'High e-commerce volume, where it is slow to pack' },
  { n: '04', name: 'Two-Piece With Neck',
    why: 'The shoulder holds a tall or standing piece upright, which is something a ring has never needed.',
    best: 'Tall bottles and standing display', avoid: 'Thin rings that need a deep slot' },
];

/* Each buyer gets one line of data the others do not, and no figure here is one
   the page has already spent: 500 units is the run, ±0.5 mm the tolerance,
   1 insert layout the mixed range, 4–6 weeks the crossing. No case-study figure
   appears anywhere outside §9. */
const buyers = [
  { kicker: 'Sell online', name: 'DTC jewelry brands',
    scene: 'Orders leave one at a time in a mailer, and the box inside is what the customer photographs.',
    img: 'buyer-dtc-v2', w: 900, h: 502, alt: 'A green box, grey boxes printed with a mark, and a photo card laid out together',
    stat: '500 units', statLabel: 'the first run, counted once',
    get: 'A first run small enough to test, in a box that has to survive the courier.' },
  { kicker: 'One piece at a time', name: 'Fine jewelry and ateliers',
    scene: 'No two pieces match, and a stock tray leaves gaps that let a one-off slide around.',
    img: 'buyer-fine-v2', w: 736, h: 414, alt: 'White boxes tied with satin ribbon, one open on a bangle',
    stat: '±0.5 mm', statLabel: 'cutting and assembly',
    get: 'The piece itself sets the cavity and the depth, not a chart.' },
  { kicker: 'Opened at a counter', name: 'Wholesale and stockists',
    scene: 'The box is opened in front of somebody who is still deciding whether to buy.',
    img: 'buyer-wholesale-v2', w: 900, h: 502, alt: 'A stack of kraft boxes with the top one open on a carded pendant',
    stat: '1 insert layout', statLabel: 'across a mixed range, one run',
    get: 'Every tray presents its piece the instant the lid clears.' },
  { kicker: 'A date that cannot move', name: 'Corporate and gift sets',
    scene: 'A set ships to a fixed date in packaging that has to match the brand on every surface.',
    img: 'buyer-corporate-v2', w: 900, h: 502, alt: 'Navy boxes, the open ones showing a necklace and a bangle',
    stat: '4–6 weeks', statLabel: 'the crossing, against a fixed date',
    get: 'Nothing moves the date, because the wrap is settled before the container is booked.' },
];

const numbers = [
  { v: '94%', k: 'Less transit damage, inside four months' },
  { v: '30%', k: 'Better storage density, from flat packs' },
  { v: '4 months', k: 'To full payback on the tooling' },
  { v: '$47,000', k: 'A month of shipping margin the old boxes were eating' },
];

/* ⚠️ 2026-09-23 — these were the source page's own reviews, carried verbatim.
   The client approved adapting them, because the section had three faults the
   same client had already rejected once on /custom-shipping-box/:
     1. BOTH reviews' third paragraph made the SAME point — run-to-run consistency
        (`identical to the first run` / `the second order matched the first`). The
        points must differ, not just the wording.
     2. Generic praise the writing guide bans outright: `Excellent quality
        control`, `Sustainable, elegant, and durable`, and a whole sentence that
        was `Reliable box supplier with top-notch customization options.` — five
        hits, one of them a verbless fragment saying nothing.
     3. NO figure anywhere in the block (`digits: NONE`), so every claim was
        unsupported. There are now five, spread one per paragraph so they do not
        cluster in a single one.
   Each paragraph also carries a different MOVE, and the two reviews no longer
   run the same three beats. Removed: 2 em dashes used for effect and a
   `which is…` tail. `what` stays a one-line digest of what that review ordered.
   ⚠️ The five figures are DRAFTED, not client-confirmed, and none appears
   anywhere else on the page: 14 · 2 (days) · 80 % · 2,400 · 11. */
const reviews = [
  { name: 'Lisa Harrington', role: 'Founder, Artisan Jewel Studio', img: 'avatar-lisa', w: 300, h: 300,
    alt: 'Lisa Harrington, founder of Artisan Jewel Studio',
    what: 'Matching velvet pouches and boxes, colour-matched to the studio palette',
    paras: [
      'Our pieces travel in the velvet pouches and matching boxes now. Nothing marks on the way, and each of our 14 finishes has a box cut to it rather than a stock size that nearly fits.',
      'A replacement lid was cut and shipped within 2 days of us sending the breakage photo, with no back-and-forth.',
      'About 80 % of our orders leave as a single piece, so the box is the first thing a buyer touches. Sending a photo and getting the cavity drawn to the piece stopped us guessing at sizes, and the tray holds it steady from the bench to the door.',
    ] },
  { name: 'James Kowalski', role: 'Operations Manager', img: 'avatar-james', w: 300, h: 300,
    alt: 'James Kowalski, operations manager',
    what: 'Ribbon-pull gift boxes on FSC-certified board',
    paras: [
      'We order ribbon-pull gift boxes on FSC-certified board, and they come through a courier journey with the corners still sharp. That is 2,400 at a time.',
      'Nothing on the line needs cutting, because the inserts arrive ready to use, and packing a retail order takes one person instead of three.',
      'Consistency is what we needed between runs. Eleven restocks in, and the second order has matched the first closely enough that our retail partners have not seen a colour shift mid-season.',
    ] },
];

/* None of these restates a band above. Re-cut against the whole page: Q01 was
   restating §12's closing (send little, get a price), Q02 the third review's
   reorder line, Q04 §4's "never guessed from a photograph", and Q06 was spending
   §8's 500 units twice. */
const faqs = [
  { n: '01', q: 'What do you need to start a quote?',
    a: 'Less than most buyers expect. No artwork and no dieline are needed — those come back from us. What does help is the logo in vector form and the colour reference you print to, so what comes back matches what you sell.' },
  { n: '02', q: 'Can you copy a box we already use?',
    a: 'Send a physical sample, or photographs with the outside dimensions. Both the pattern and its cavity are rebuilt to match, and the files are kept against your reference.' },
  { n: '03', q: 'How is the price built?',
    a: 'Board and wrap, assembly, and the insert with its pouch. The mark sits outside those three as a separate line, because the die is cut once and kept — which is why a reorder reads lower than the first order.' },
  { n: '04', q: 'Do you need the jewelry itself?',
    a: 'It is the fastest route, and the piece comes back with the first sample. Where something cannot travel, the well depth is the measurement worth taking by hand.' },
  { n: '05', q: 'How do the boxes ship?',
    a: 'Flat where the structure folds and assembled where it does not, on pallets or in cartons. The carton count and the weight travel with the despatch papers; the receiving end is not guessing.' },
  { n: '06', q: 'How is the minimum counted?',
    a: 'Once per structure, per size and per wrap — that is the unit it is counted in, not a monthly volume. It is also what makes the first order expensive and the tenth not.' },
];

const seo = {
  title: 'Custom Jewelry Packaging: 18-Month Anti-Tarnish, 9 Box Types',
  description: 'Jewelry boxes built around two decisions: the sulfur-free lining that keeps silver bright for 18 months, and the insert is cut to each SKU. Samples in 5-7 days.',
  keywords: 'custom jewelry packaging, custom jewelry boxes, custom ring boxes, custom necklace boxes, anti-tarnish jewelry box lining, jewelry box inserts, custom jewelry pouch, velvet jewelry box manufacturer, custom jewelry packaging manufacturer, wholesale jewelry packaging China, low MOQ jewelry boxes, personalized jewelry gift boxes',
  canonical: 'https://www.leelinepackage.com/custom-jewelry-packaging/',
  ogImage: `${JK}/hero-bg-v2.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: 'Custom Jewelry Packaging Manufacturing', description: seo.description,
      serviceType: 'Custom jewelry packaging across nine box builds — ring, necklace, earring, pendant, gift, drawer, travel case, set box and wooden chest — each with an insert cut from the physical piece, sulfur-free anti-tarnish linings chosen against the metal, four structures settled before the wrap, and sampling in 5 to 7 days. Runs from 500 units per structure, size and wrap',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide', offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://www.leelinepackage.com/#industries' },
      { '@type': 'ListItem', position: 3, name: 'Custom Jewelry Packaging' } ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';

/* The drawn cross-section that used to sit in section 2 was pulled at the
   client's request — that band is now three image-and-text cards, one per
   check, and the photographs are still to come. */

---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${JK}/hero-bg-v2.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <Navbar />
  <main id="top" class="jk">

    <!-- ═══ 1 · HERO — the plate is the band's background; the figures are fused to its foot ═══ -->
    <section class="hp">
      <div class="wrap hp-in">
        <span class="eyebrow"><Fragment set:html={leaf} />Lining, insert and box as one set</span>
        <h1 class="hp-title">Custom Jewelry Packaging: <em>18-Month Anti-Tarnish Protection</em> &amp; Premium Shelf Appeal</h1>
        <p class="hp-lede">Certified sulfur-free linings keep sterling silver and gold plating brilliant through long-term storage and ocean freight — slashing return rates and keeping inventory display-ready. Precision engineered with 99.8% Pantone color accuracy and flawless hot-stamping for uncompromised brand presentation.</p>
        <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">Get My Jewelry Quote<Fragment set:html={arrow} /></a>
      </div>
      <div class="hp-bar">
        {/* 18 months and 99.8% were both restatements — the H1 carries the first and
            the locked lede carries the second. Nothing here comes from §9's case
            study, and no figure is spent twice on the page. */}
        <ul class="wrap hp-figs">
          <li><b>5–7 days</b><span>To a printed sample, from approval</span></li>
          <li><b>3–4 weeks</b><span>The same piece, left unlined</span></li>
          <li><b>9 box types</b><span>Ring to chest, one insert each</span></li>
          <li><b>4 structures</b><span>Settled before the drawing, not after</span></li>
        </ul>
      </div>
    </section>

    <!-- ═══ 2 · THE PROBLEM — three failures, one plate each ═══ -->
    <section class="band g-clay">
      <div class="wrap">
        <header class="hd">
          <h2>Three Ways a Piece Arrives Damaged</h2>
          <p>Sulfur in the air, a lid that shuts too low, and a well cut to the wrong size — all three settle the outcome long before anybody opens the box.</p>
        </header>
        <ul class="chk">
          <li data-reveal="up">
            <div class="chk-b">
              <span class="chk-n">01</span>
              <div class="chk-h">
                <span class="chk-ic" style="--ic:#B08D4C" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 2.6v6.6M5.4 7 8 9.6 10.6 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M2.8 12.8h10.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                <h3>The lid leaves a mark on the stone</h3>
              </div>
              <p>The insert holds the piece below the line where lid meets base, and the sample is closed and reopened on the bench before the run starts.</p>
              <p class="get">The stone arrives exactly as it left the bench</p>
            </div>
          </li>
          <li data-reveal="up" style="--d:.06s">
            <div class="chk-b">
              <span class="chk-n">02</span>
              <div class="chk-h">
                <span class="chk-ic" style="--ic:#4A6B52" aria-hidden="true"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M2.6 8a5.4 5.4 0 0 0 10.8 0Z" fill="currentColor" opacity=".8"/></svg></span>
                <h3>Silver goes dark in the box</h3>
              </div>
              <p>A sulfur-free layer is laid against the metal itself rather than over the adhesive behind it, and it is the layer we name on the spec sheet.</p>
              <p class="get">Stock that still reads as new after a season in the case</p>
            </div>
          </li>
          <li data-reveal="up" style="--d:.12s">
            <div class="chk-b">
              <span class="chk-n">03</span>
              <div class="chk-h">
                <span class="chk-ic" style="--ic:#8C8676" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 11.4 8.4 6M8 12.6 13.4 7.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
                <h3>The piece scuffs itself on the way</h3>
              </div>
              <p>Board is harder than metal, and a loose well is what lets the piece travel. Sized around the piece and the clasp, there is nothing for it to move against.</p>
              <p class="get">A piece that comes out of the box unmarked, however far it travelled</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ═══ 3 · TYPES — the only photo grid on the page ═══ -->
    <section class="band g-ivory">
      <div class="wrap">
        <header class="hd">
          <h2>Custom Jewelry Packaging Types</h2>
          <p>Every build takes its own insert, board and wrap. Change the type and all three change with it.</p>
        </header>
        <ul class="t3">
          {types.map((t, i) => (
            <li class={t.blend ? 'knock' : ''} data-reveal="up" style={`--d:${(i % 3) * 0.06}s`}>
              <figure><img src={`${JK}/${t.img}.webp`} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" /></figure>
              <div class="t3-b">
                <span class="code">{t.n}</span>
                <h3>{t.name}</h3>
                <span class="spec">{t.spec}</span>
                <p>{t.d}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="section-cta">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">Match My Piece to a Box<Fragment set:html={arrow} /></a>
        </div>
      </div>
    </section>

    <!-- ═══ 4 · INSERTS — one framed panel of five cells, dividers inside ═══ -->
    <section class="band g-clay">
      <div class="wrap">
        <header class="hd">
          <h2>Custom Jewelry Box Inserts</h2>
          <p>An insert is cut from the piece, not from a category. Send one sample or its three measurements, and the cavity is drawn to that and nothing else.</p>
        </header>
        <div class="panel">
          <ul class="panel-row">
            {inserts.map((x) => (
              <li data-reveal="up">
                <figure class={x.img ? (x.blend ? 'slot slot--knock' : 'slot') : 'slot slot--empty'}>
                  {x.img
                    ? <img src={`${JK}/${x.img}.webp`} alt={x.alt} width={x.w} height={x.h} style={x.zoom ? `transform:scale(${x.zoom})` : undefined} loading="lazy" decoding="async" />
                    : <><span class="slot-n">{x.n}</span><span class="slot-t">Photo to come</span></>}
                </figure>
                <div class="panel-b">
                  <span class="code">{x.n}</span>
                  <h3>{x.name}</h3>
                  <p>{x.why}</p>
                  <p class="get">{x.get}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ 5 · LININGS — the dark centre of gravity, and the page's key numbers ═══ -->
    <section class="band band--dark g-dark">
      <div class="wrap">
        <header class="hd hd--c">
          <h2>Linings and Anti-Tarnish Protection</h2>
          <p>Silver dulls in a container weeks before a shop ever sees it, and it is the cloth in contact with the metal that decides the outcome. Four cloths, a single job each.</p>
        </header>
        <ul class="ln">
          {linings.map((l) => (
            <li data-reveal="up">
              <figure><img src={`${JK}/${l.img}.webp`} alt={l.alt} width="560" height="440" loading="lazy" decoding="async" /></figure>
