  .cb-midcta { background: linear-gradient(180deg, rgba(245,240,229,0.82) 0%, rgba(245,240,229,0.86) 100%), url('https://img.leelinepackage.com/custom-bag/mid-cta.webp') center / cover no-repeat; padding: clamp(3.5rem, 8vw, 6.5rem) 0; text-align: center; }
  .cb-midcta-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.04; letter-spacing: -0.025em; color: var(--color-brand-text); max-width: 22ch; margin: 1.1rem auto 0; text-wrap: balance; }
  .cb-midcta-title em { font-style: italic; color: var(--brass); }
