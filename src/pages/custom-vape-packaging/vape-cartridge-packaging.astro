  /* ============ DIMENSIONS — the page's ONE drawn module ============ */
  .vc-dims { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .vc-dims .section-sub { max-width: 74ch; }
  .vc-dims-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 4vw, 3.2rem); align-items: center; }
  .vc-dims-fig { margin: 0; }
  .vc-dw { display: block; width: 100%; height: auto; }
  .vc-dw-mouth { fill: var(--brass-soft); stroke: #8A6E42; stroke-width: 1.4; }
  .vc-dw-tube { fill: var(--color-brand-surface); stroke: #8A6E42; stroke-width: 1.4; }
