  { name: 'Reusable Bag', img: IMG.reusable, blurb: 'Woven and non-woven, built to be reused.', span: 's-4' },
  { name: 'Satin Bag', img: IMG.satin, blurb: 'Soft-touch pouches for jewelry and gifts.', span: 's-4' },
  { name: 'Labels & Stickers', img: IMG.labels, blurb: 'Die-cut, foil-stamped, weatherproof.', span: 's-8' },
];

const cases = [
  {
    title: 'The Keepsake Rigid',
    client: 'Nova Skin',
    persona: 'Beauty & skincare',
    img: IMG.rigid,
    metric: '+38%',
    metricLabel: 'perceived value',
    body: 'A magnetic-closure rigid box with gold foil and a debossed monogram turned a serum into a keepsake customers photograph before they even open it.',
    tag: 'Rigid · gold foil · deboss',
  },
  {
    title: 'The DTC Unboxing',
    client: 'Bloom Supply',
    persona: 'Direct-to-consumer',
    img: IMG.mailer,
    metric: '2×',
    metricLabel: 'unboxing shares',
    body: 'A custom-sized, self-locking mailer printed inside and out made every delivery feel like a drop. Shares doubled the month it shipped.',
    tag: 'Mailer · inside print · custom size',
  },
  {
    title: 'The Flat-Pack Pivot',
    client: 'Atlas Home',
    persona: 'Supply chain',
    img: IMG.corrugated,
    metric: '-23%',
    metricLabel: 'freight cost',
    body: 'Re-engineered dielines and flat-pack nesting cut dimensional weight across a 50,000-unit run — without weakening a single flute.',
    tag: 'Corrugated · flat-pack · ISTA tested',
  },
];

const testimonials = [
  {
    quote: 'Our unboxing completion rate doubled the month we switched to Leeline’s custom mailers. The box finally matches the brand.',
    name: 'DTC Danny',
    role: 'Founder, Bloom Supply',
    initials: 'DD',
  },
  {
    quote: 'The rigid box with gold foil made our $180 serum feel worth every cent. Clients keep the box. That’s the whole point.',
    name: 'Cosmetic Carla',
    role: 'Brand Director, Nova Skin',
    initials: 'CC',
  },
  {
    quote: 'Custom-sized boxes, no rattling, and dimensional weight that doesn’t eat our margins. On time, every single month.',
    name: 'Subscription Sarah',
    role: 'Ops Lead, Marrow & Co.',
    initials: 'SS',
  },
];

const logos = ['NOVA SKIN', 'MARROW & CO.', 'BLOOM SUPPLY', 'KEEN ROAST', 'ATLAS HOME', 'VANTA LAB'];
---

<Layout title="The Material Atelier — LeelinePackage">
  <style is:global>
    :root {
      --color-brand-primary:   #1F3B2C;
      --color-brand-secondary: #C9A87C;
      --color-brand-accent:    #B08D4C;
      --color-brand-bg:        #F5F0E5;
      --color-brand-surface:   #EDE5D4;
      --color-brand-text:      #21241C;
      --color-brand-muted:     #8C8676;
      --font-heading: 'Newsreader Variable', Georgia, serif;
      --font-body:    'Instrument Sans Variable', system-ui, sans-serif;
      --forest-deep: #14261B;
      --brass: #B08D4C;
      --brass-soft: #C9A87C;
      --ivory: #F5F0E5;
      --kraft: #EDE5D4;
    }

    html { scroll-behavior: smooth; }
    body { overflow-x: hidden; }
    body.menu-open { overflow: hidden; }

    ::selection { background: var(--brass-soft); color: #1F3B2C; }

    /* Scroll-reveal (kept global so ancestors like html/body aren't scoped away).
       :where() zeroes the inner selector's specificity so hover transforms still win. */
    html.js :where([data-reveal]) {
      opacity: 0;
      transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.9s ease, clip-path 0.9s ease;
      transition-delay: var(--d, 0s);
      will-change: transform, opacity;
    }
    html.js :where([data-reveal="up"]) { transform: translateY(36px); }
    html.js :where([data-reveal="left"]) { transform: translateX(-48px); }
    html.js :where([data-reveal="right"]) { transform: translateX(48px); }
    html.js :where([data-reveal="scale"]) { transform: scale(0.9); }
    html.js :where([data-reveal="blur"]) { filter: blur(12px); }
    html.js :where([data-reveal="clip"]) { clip-path: inset(0 0 100% 0); }
    html.js :where([data-reveal].in) {
      opacity: 1;
      transform: none;
      filter: none;
      clip-path: inset(0 0 0 0);
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
    }
  </style>

  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- ============ SVG MOTIF SPRITE ============ -->
  <svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
    <defs>
      <!-- The brass leaf seal — recurring signature motif -->
      <symbol id="i-leaf" viewBox="0 0 64 64">
        <circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="1.1" />
        <circle cx="32" cy="32" r="24" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.45" />
        <path d="M32 12 C 19 20 19 44 32 52 C 45 44 45 20 32 12 Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        <path d="M32 19 L32 47" stroke="currentColor" stroke-width="0.8" />
        <path d="M32 25 C 28 27.5 26.5 30 25.5 32.5" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round" />
        <path d="M32 31 C 36 33.5 37.5 36 38.5 38.5" fill="none" stroke="currentColor" stroke-width="0.55" stroke-linecap="round" />
        <circle cx="32" cy="6" r="1.1" fill="currentColor" />
        <circle cx="32" cy="58" r="1.1" fill="currentColor" />
        <circle cx="6" cy="32" r="1.1" fill="currentColor" />
        <circle cx="58" cy="32" r="1.1" fill="currentColor" />
      </symbol>

      <!-- Foil underline flourish -->
      <symbol id="i-foil" viewBox="0 0 140 16">
        <path d="M2 11 C 38 4 84 4 116 10" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        <path d="M116 10 C 123 12 131 11 136 6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        <circle cx="137" cy="6" r="1.5" fill="currentColor" />
      </symbol>

      <!-- Small leaf for inline accents -->
      <symbol id="i-leaf-sm" viewBox="0 0 32 32">
        <path d="M16 4 C 9 9 9 23 16 28 C 23 23 23 9 16 4 Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M16 9 L16 25" stroke="currentColor" stroke-width="0.8" />
      </symbol>
    </defs>
  </svg>

  <!-- ============ GRAIN OVERLAY ============ -->
  <div class="grain" aria-hidden="true"></div>

  <!-- ============ NAVIGATION ============ -->
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a class="brand" href="#top" aria-label="LeelinePackage home">
        <svg class="brand-seal" aria-hidden="true"><use href="#i-leaf" /></svg>
        <span class="brand-word">Leeline<em>Package</em></span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        <a href="#materials">Materials</a>
        <a href="#offerings">Offerings</a>
        <a href="#work">Work</a>
        <a href="#why">Why us</a>
        <a href="#proof">Proof</a>
      </nav>

      <div class="nav-actions">
        <a class="btn btn-primary btn-sm" href="#quote">
          Get a Free Quote
          <svg class="btn-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
        </a>
        <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobileMenu">
      <nav class="mobile-links" aria-label="Mobile">
        <a href="#materials">Materials</a>
        <a href="#offerings">Offerings</a>
        <a href="#work">Work</a>
        <a href="#why">Why us</a>
        <a href="#proof">Proof</a>
        <a href="#quote" class="btn btn-primary">Get a Free Quote</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <svg class="hero-seal" aria-hidden="true"><use href="#i-leaf" /></svg>

      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow hero-el" style="--d:.05s">
            <svg class="eyebrow-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            FSC-Certified · Materials-First Packaging
          </p>
          <h1 class="hero-el" style="--d:.15s">
            The art of the <em>unboxing</em>,<br />
            engineered in every fibre.
          </h1>
          <p class="hero-sub hero-el" style="--d:.32s">
            LeelinePackage turns FSC-certified paper, board and finish into packaging that
            protects in transit and impresses at the doorstep — from 500 units to 500,000.
          </p>
          <div class="hero-cta hero-el" style="--d:.46s">
            <a class="btn btn-primary" href="#quote">
              Get a Free Quote
              <svg class="btn-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            </a>
            <a class="btn btn-ghost" href="#quote">Request Your Sample Kit</a>
          </div>
          <ul class="hero-spec hero-el" style="--d:.6s">
            <li><span>24h</span> digital mockups</li>
            <li><span>3–5 day</span> samples</li>
            <li><span>500</span> MOQ units</li>
          </ul>
        </div>

        <div class="hero-visual hero-el" style="--d:.24s">
          <figure class="hero-main">
            <img src={IMG.rigid} alt="Rigid keepsake boxes with premium finishes" width="760" height="900" loading="eager" />
            <span class="hero-frame" aria-hidden="true"></span>
          </figure>

          <figure class="hero-chip hero-chip--kraft">
            <img src={IMG.kraft} alt="Kraft paper material swatch" width="320" height="220" loading="eager" />
          </figure>

          <div class="hero-badge" aria-hidden="true">
            <svg class="hero-badge-seal"><use href="#i-leaf" /></svg>
            <div>
              <strong>FSC® Certified</strong>
              <span>Chain-of-custody materials</span>
            </div>
          </div>

          <div class="hero-foil" aria-hidden="true">
            <svg viewBox="0 0 64 64"><use href="#i-leaf" /></svg>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MATERIALS MARQUEE ============ -->
    <section class="materials" id="materials" aria-label="Materials">
      <div class="marquee">
        <div class="marquee-track">
          {materials.map((m) => (
            <div class="m-item">
              <div class="m-thumb">
                <img src={m.img} alt={m.name} loading="lazy" />
              </div>
              <div class="m-meta">
                <span class="m-name">{m.name}</span>
                <span class="m-spec">{m.spec}</span>
              </div>
              <svg class="m-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            </div>
          ))}
          {materials.map((m) => (
            <div class="m-item" aria-hidden="true">
              <div class="m-thumb">
                <img src={m.img} alt="" loading="lazy" />
              </div>
              <div class="m-meta">
                <span class="m-name">{m.name}</span>
                <span class="m-spec">{m.spec}</span>
              </div>
              <svg class="m-leaf"><use href="#i-leaf-sm" /></svg>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ OFFERINGS ============ -->
    <section class="offerings" id="offerings">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow" data-reveal="up">
            <svg class="eyebrow-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            The Atelier's Range
          </p>
          <h2 class="section-title" data-reveal="up" style="--d:.06s">
            Every format.<br /><em>One standard of craft.</em>
          </h2>
          <p class="section-sub" data-reveal="up" style="--d:.12s">
            Folding cartons to rigid keepsakes, pouches to paper bags — each cut, creased and
            finished in-house with the same obsessive attention to material.
          </p>
        </div>

        <!-- Featured: Folding Carton -->
        <article class="feature" data-reveal="up">
          <figure class="feature-media">
            <img src={IMG.folding} alt="Folding carton boxes" loading="lazy" />
            <span class="feature-swirl" aria-hidden="true"></span>
          </figure>
          <div class="feature-body">
            <span class="card-num">01</span>
            <h3>Folding Carton</h3>
            <p>Crisp retail cartons with sharp creases and full-bleed print — the workhorse of shelf presence, cut with surgical precision.</p>
            <ul class="chips">
              <li>Foil</li><li>Spot UV</li><li>Emboss</li><li>Deboss</li><li>Soft-touch</li>
            </ul>
            <a class="text-link" href="#quote">Spec this format
              <svg class="arrow" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>

        <!-- Remaining 11 formats -->
        <div class="services-grid">
          {services.map((s, i) => (
            <article class={`card ${s.span} ${i % 3 === 1 ? 'card--down' : ''}`} data-reveal={i % 3 === 2 ? 'scale' : 'up'} style={`--d:${(i % 3) * 0.08}s`}>
              <a href="#quote" class="card-link">
                <figure class="card-media">
                  <img src={s.img} alt={s.name} loading="lazy" />
                  <span class="card-ring" aria-hidden="true"></span>
                </figure>
                <div class="card-body">
                  <span class="card-num">{String(i + 2).padStart(2, '0')}</span>
                  <h3>{s.name}</h3>
                  <p>{s.blurb}</p>
                  <span class="card-cta">
                    Explore
                    <svg class="arrow" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Organic divider: ivory -> kraft -->
    <div class="curve curve--kraft" aria-hidden="true">
      <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
        <path d="M0 100 C 240 22, 520 92, 780 62 C 1020 34, 1260 92, 1440 40 L1440 100 Z" fill="#EDE5D4" />
      </svg>
    </div>

    <!-- ============ FEATURED WORK ============ -->
    <section class="work" id="work">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow" data-reveal="up">
            <svg class="eyebrow-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            Featured Work
          </p>
          <h2 class="section-title" data-reveal="up" style="--d:.06s">
            Built to be <em>kept</em>,<br />not thrown away.
          </h2>
        </div>

        <div class="case-grid">
          {cases.map((c, i) => (
            <article class="case" data-reveal={['up', 'left', 'right'][i]} style={`--d:${i * 0.12}s`}>
              <figure class="case-media">
                <img src={c.img} alt={`${c.title} — ${c.client}`} loading="lazy" />
                <span class="case-metric">
                  <strong>{c.metric}</strong>
                  <span>{c.metricLabel}</span>
                </span>
              </figure>
              <div class="case-body">
                <div class="case-client">
                  <span class="case-persona">{c.persona}</span>
                  <span class="case-dot" aria-hidden="true"></span>
                  <span class="case-name">{c.client}</span>
                </div>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <p class="case-tag"><svg class="tag-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>{c.tag}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ WHY US (INVERTED FOREST) ============ -->
    <section class="why" id="why">
      <div class="why-grain" aria-hidden="true"></div>
      <svg class="why-seal" aria-hidden="true"><use href="#i-leaf" /></svg>

      <div class="wrap why-grid">
        <div class="why-intro">
          <p class="eyebrow eyebrow--light" data-reveal="up">
            <svg class="eyebrow-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            Why Leeline
          </p>
          <h2 class="why-title" data-reveal="up" style="--d:.06s">
            Protect <em>&amp;</em> impress,<br />without compromise.
          </h2>
          <p class="why-sub" data-reveal="up" style="--d:.12s">
            Three disciplines run through everything we make — structure, finish and
            sustainability. It's why a box survives the last mile and still deserves the shelf.
          </p>
          <a class="btn btn-light" href="#quote" data-reveal="up" style="--d:.18s">
            Start your project
            <svg class="btn-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
          </a>
        </div>

        <div class="why-list">
          <article class="reason" data-reveal="left" style="--d:0s">
            <span class="reason-num">01</span>
            <h3>Structural engineering</h3>
            <p>Custom dielines and inserts, load-bearing flute selection and ISTA drop &amp; compression testing. No crushed-box disasters, ever.</p>
          </article>
          <article class="reason" data-reveal="left" style="--d:.1s">
            <span class="reason-num">02</span>
            <h3>Premium finishes, honest prices</h3>
            <p>Gold foil, spot UV, emboss and deboss — the kind of finishes Western suppliers reserve for 50k runs, delivered at factory-direct cost.</p>
          </article>
          <article class="reason" data-reveal="left" style="--d:.2s">
            <span class="reason-num">03</span>
            <h3>Sustainable by default</h3>
            <p>FSC-certified materials, recyclable board and flat-pack optimization that cuts freight. MOQ from 500, seamlessly up to 500,000.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ SOCIAL PROOF ============ -->
    <section class="proof" id="proof">
      <div class="wrap">
        <div class="section-head section-head--center">
          <p class="eyebrow" data-reveal="up">
            <svg class="eyebrow-leaf" aria-hidden="true"><use href="#i-leaf-sm" /></svg>
            Proof, in Numbers
          </p>
          <h2 class="section-title" data-reveal="up" style="--d:.06s">
            Trusted from the first sample<br />to the <em>500,000th</em> box.
          </h2>
        </div>

        <div class="stats">
          <div class="stat" data-reveal="up">
            <div class="stat-num"><span data-count="500" data-suffix="K+">0</span></div>
            <div class="stat-label">boxes shipped worldwide</div>
          </div>
          <div class="stat" data-reveal="up" style="--d:.08s">
            <div class="stat-num"><span data-count="24" data-suffix="h">0</span></div>
            <div class="stat-label">digital 3D mockups</div>
          </div>
          <div class="stat" data-reveal="up" style="--d:.16s">
            <div class="stat-num"><span class="static">3–5</span></div>
            <div class="stat-label">day white-dummy samples</div>
          </div>
          <div class="stat" data-reveal="up" style="--d:.24s">
            <div class="stat-num"><span data-count="500">0</span></div>
            <div class="stat-label">MOQ, up to 500k per run</div>
          </div>
        </div>

        <div class="trust-strip" data-reveal="up" style="--d:.2s">
          <span>Founded 2015</span><i aria-hidden="true"></i>
          <span>ISO 9001</span><i aria-hidden="true"></i>
          <span>FSC® Certified</span><i aria-hidden="true"></i>
          <span>ISTA Tested</span>
        </div>

        <div class="testimonials">
          {testimonials.map((t, i) => (
            <blockquote class="t-card" data-reveal={['up', 'scale', 'up'][i]} style={`--d:${i * 0.1}s`}>
              <svg class="t-mark" aria-hidden="true" viewBox="0 0 40 28"><path d="M0 28V14C0 4 6 0 16 0v6C9 7 6 10 6 15h8v13H0Zm24 0V14C24 4 30 0 40 0v6c-7 1-10 4-10 9h8v13H24Z" fill="currentColor"/></svg>
              <p>{t.quote}</p>
