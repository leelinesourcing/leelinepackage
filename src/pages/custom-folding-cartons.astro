    .fx-flow-track { grid-template-columns: 1fr; gap: 0; }
    .fx-flow-track::before { display: none; }
    .fx-flow-step { display: grid; grid-template-columns: 46px 1fr; column-gap: 1.2rem; text-align: left; padding-bottom: 1.7rem; position: relative; }
    .fx-flow-node { grid-row: 1 / span 2; margin-inline: 0; }
    .fx-flow-step h3 { margin-top: 0.25rem; }
    /* rail turns vertical again, running from the node down to the next one */
    .fx-flow-step::before { content: ''; position: absolute; top: 46px; left: 23px; width: 1px; height: calc(100% - 46px); background: rgba(31,59,44,0.24); }
    .fx-flow-step:last-child { padding-bottom: 0; }
