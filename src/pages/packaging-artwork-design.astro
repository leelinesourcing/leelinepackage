---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

const R2 = 'https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev';
const svcImg = (name) => `${R2}/services/${name}.webp`;
const ART = `${R2}/artwork`;

const CHILD = {
  structure: '/structural-engineering-design/',
  sample: '/packaging-sample-prototyping/',
};

/* § Benefits — the three ways the pack works as a brand asset. */
const benefits = [
  { t: 'Stand out on shelves', d: 'A shelf is won in a second. A pack that is unmistakable stops the eye, stands apart from the one beside it and makes the product easy to find again \u2014 so the brand is remembered, not just seen.', img: `${ART}/stand-out.webp`, w: 620, h: 481, altH: 'A standout custom pack standing apart on a retail shelf', path: 'M12 2l2.35 4.9 5.4.78-3.9 3.8.92 5.38L12 14.3 7.23 16.86l.92-5.38-3.9-3.8 5.4-.78L12 2z' },
  { t: 'Enhance the unboxing', d: 'The open is part of the product. A considered reveal \u2014 the weight, the moment, the detail inside \u2014 turns a delivery into something worth photographing, and a first-time buyer into a regular who tells others.', img: `${ART}/enhance-unboxing.webp`, w: 620, h: 288, altH: 'A customer lifting the lid on a printed unboxing moment', path: 'M12 3v10m0 0 3.5-3.5M12 13 8.5 9.5M4 19h16M6 13v6h12v-6' },
  { t: 'Drive business growth', d: 'Better packaging pays for itself. A tighter, well-designed pack usually ships cheaper, damages less and reads more premium \u2014 lifting perceived value, repeat purchase and word of mouth over the life of a brand.', img: `${ART}/drive-growth-new.webp`, w: 620, h: 511, altH: 'A stack of finished printed packs after a production run', path: 'M4 20h16M7 16l4-5 3 3 5-7M16 7h3v3' },
];

/* §1 印刷方式对照 — digital / flexo / offset. `rail` scales the press-rail block. */
const print = [
  { name: 'Digital', tag: 'Short runs, no plate', vol: '500\u20132,000 units', paper: 'Coated & kraft carton', detail: 'Sharp, but limited spot colours', best: 'Tests, drops and market launches \u2014 each box can carry different data.', img: `${ART}/digital.webp`, w: 620, h: 348, altH: 'A digital press printing a short run of cartons' },
  { name: 'Flexographic', tag: 'Volume on corrugated', vol: '2,000\u201350,000+', paper: 'Corrugated & kraft board', detail: 'Bold solids, fewer colours', best: 'Mailers and corrugated boxes where board texture matters more than a 5-pt rule.', img: `${ART}/flexographic.webp`, w: 620, h: 325, altH: 'A flexographic press running corrugated board' },
  { name: 'Offset litho', tag: 'Fine detail on carton', vol: '2,000\u2013100,000+', paper: 'Coated folding carton & rigid board', detail: 'Best for photos, gradients, fine type', best: 'Retail cartons and rigid gift boxes where the finish carries the brand.', img: `${ART}/offset.webp`, w: 620, h: 364, altH: 'An offset litho press printing fine detail on coated carton' },
];

/* §3 后道工艺 — finishing. `gift`/`ecomm` are 1\u20135 fit; `cost` is a 1\u20133 tier. */
const finishes = [
  { name: 'Foil stamping', sw: 'foil', img: `${ART}/foil.webp`, w: 620, h: 348, altH: 'A foil-stamped gold logo on a rigid box lid', desc: 'A metal or pigmented foil pressed in with heat. The most premium read per square centimetre \u2014 the one finish that photographs as luxury.', gift: 5, ecomm: 2, cost: 3 },
  { name: 'Embossing / debossing', sw: 'emboss', img: `${ART}/emboss.webp`, w: 620, h: 418, altH: 'Embossed lettering raised on a box panel catching the light', desc: 'The surface raised or sunk to catch the light. Tactile without adding a layer \u2014 a quiet mark of craft on a gift box lid.', gift: 4, ecomm: 3, cost: 2 },
  { name: 'Spot UV', sw: 'uv', img: `${ART}/spot-uv.webp`, w: 620, h: 317, altH: 'A spot UV gloss area on a matte box panel', desc: 'A high-gloss clear varnish on one area, matte everywhere else. A small area of shine that costs little and sells the pack on a shelf.', gift: 3, ecomm: 4, cost: 2 },
  { name: 'Lamination (gloss / matte)', sw: 'lam', img: `${ART}/lamination.webp`, w: 531, h: 343, altH: 'A matte-laminated carton held in the hand', desc: 'A thin film over the whole sheet \u2014 scuff-proof, richer colour, and a matte option that reads high-end. The everyday workhorse.', gift: 4, ecomm: 5, cost: 2 },
  { name: 'Soft-touch coating', sw: 'soft', img: `${ART}/soft-touch.webp`, w: 620, h: 346, altH: 'A soft-touch matte box with a subtle sheen', desc: 'A velvet-matte coat. A dry, high-end hand-feel that also hides fingerprints \u2014 the flavour of a rigid box without the film.', gift: 4, ecomm: 3, cost: 3 },
];

/* §3 文件规范 — the checked file-format requirements (the zone/placement rules
   live in the dieline legend so nothing is said twice). */
const specs = [
  'PDF/X-1a or an unflattened AI, art on its own layer',
  'Text outlined and fonts embedded',
  'Images at print resolution, at 100% scale',
  'Finishes and spot colours on their own layers',
  'Inside-print and unboxing detail on the keyline layer',
  'Dieline locked to a keyline layer that can be hidden',
];

/* §5 颜色管理. */
const colour = [
  { t: 'Pantone reference', d: 'The brand colour is locked to a Pantone reference and proofed against it \u2014 not eyeballed off a monitor.' },
  { t: 'Proof sign-off', d: 'A contract proof or a printed drawdown is signed before the plate. That proof is the colour approved \u2014 and the one a run is held to.' },
  { t: 'Batch consistency', d: 'Ink density, colour and coating are measured and logged per batch, so a reorder matches the last run, not a new guess.' },
];

/* §6 工艺与结构的交界 — brief, detail lives on the structure page. */
const doRules = [
  'Keep large foil areas off crease lines \u2014 a fold through a wide foil cracks it.',
  'Hold the key logo off a window and off the die-cut edge.',
  'Route a large flat colour area around a fold instead of straight across it.',
  'Give a panel that tucks a little extra margin, so the fold never eats the art.',
];
const avoidRules = [
  'Don\u2019t run fine type in a spot colour alone \u2014 thin type drops out on a rough board.',
  'Don\u2019t trap a solid dark area against a fold \u2014 it scuffs and shows a line.',
  'Don\u2019t place a QR where a fold or a coating warps it.',
  'Don\u2019t split an element that must line up across two panels that fold apart.',
];

/* § Process — the original site's "From Idea to Iconic Packaging" steps. */
const process = [
  { n: '01', t: 'Discovery', d: 'A free session on the brand story, audience, products, palette, material and budget \u2014 a clear creative direction before any artwork.' },
  { n: '02', t: 'Concepts', d: 'Two to three directions sketched inside the studio, shared as mood boards with the pattern, type and style that fit.' },
  { n: '03', t: 'Drafts', d: 'High-fidelity digital drafts in Adobe Illustrator, with the pack size, print spec and sustainability factored in.' },
  { n: '04', t: 'Feedback', d: 'Reviewed on a secure platform with annotations; changes land within 48 hours, over one or two rounds on colour and elements.' },
  { n: '05', t: 'Approve', d: 'Print-ready files, a digital simulation and a physical prototype. Approval carries full IP ownership.' },
  { n: '06', t: 'Print', d: 'Files go to the print partners with production guidelines and a brand asset kit \u2014 including the vector sources.' },
];

/* § Gallery — placeholder slots for the "see it in real life" row. */
const gallery = [
  { label: 'Rigid gift box', img: `${ART}/rigid-gift-box.webp`, w: 800, h: 533, altH: 'A rigid gift box finished and closed' },
  { label: 'Mailer box', img: `${ART}/mailer-box.webp`, w: 800, h: 533, altH: 'A printed mailer box flat and folded' },
  { label: 'Folding carton', img: `${ART}/folding-carton.webp`, w: 640, h: 433, altH: 'A printed folding carton' },
  { label: 'Point-of-sale display', img: `${ART}/pos-display.webp`, w: 800, h: 533, altH: 'A point-of-sale display unit in a store' },
  { label: 'Pouches', img: `${ART}/pouches.webp`, w: 800, h: 406, altH: 'Printed pouches lined up in a row' },
  { label: 'Paper bag', img: `${ART}/paper-bag.webp`, w: 800, h: 800, altH: 'A printed paper bag standing upright' },
];

/* § FAQ — deliberately kept clear of the topics already covered in the
   sections above (colour, print process, file spec, deliverables). */
const faqs = [
  { q: 'What do we need from you to get started?', a: 'A brand manual, a logo, a high-res export or a printed pack \u2014 plus rough dimensions and a quantity. That is enough; anything on top is redrawn to vector here.' },
  { q: 'Can you fix artwork that has already been made?', a: 'Usually. The logo and headline are redrawn to vector and the layout rebuilt to the dieline, then a print-feasibility check shows what is fixable before committing.' },
  { q: 'How long does the artwork design take?', a: 'A first proof usually lands within a few days, and small revisions within a couple of days. The timeline depends on how much needs redrawing, not on the run size.' },
  { q: 'Do you work from our brand guidelines, or create the brand too?', a: 'Work starts from existing brand guidelines and artwork. With only a logo or a rough idea, the packaging artwork is drawn around it \u2014 the broader brand identity stays separate.' },
  { q: 'How is the quote structured?', a: 'A one-off setup plus any plates or tooling the finish needs, then a per-unit price that falls as quantity rises. The quote lists each line, so the total is clear before committing.' },
  { q: 'Who owns the artwork and the dieline, and is it kept confidential?', a: 'Ownership stays with the buyer. The artwork and dieline are the buyer\u2019s files, a master is kept for reorders, and work is held under NDA on request.' },
];

const seo = {
  title: 'Packaging Artwork Design: 5 Finishes to Boost Shelf Presence',
  description: 'Packaging artwork design from concept to print \u2014 brand colour, foil and finish held to the proof, a 3D mockup before the run and a MOQ from 500 units. It sells.',
  keywords: 'packaging artwork design, custom packaging design, pantone color matching, spot uv printing, foil stamping packaging, packaging file specifications, print-ready packaging files',
  canonical: 'https://www.leelinepackage.com/packaging-artwork-design/',
  ogImage: svcImg('artwork'),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Packaging Artwork Design',
      description: seo.description,
      serviceType: 'Custom packaging artwork design and print preparation',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '210' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.leelinepackage.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Packaging Artwork Design' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO (centered, concise) ============ -->
    <section class="aw-hero">
      <div class="wrap aw-hero-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Graphic-to-press packaging</span>
        <h1 class="aw-hero-title">Packaging Artwork Design <em>That Drives Margin &amp; Prints Flawlessly</em></h1>
        <p class="aw-hero-sub">Transform your brand vision into shelf-ready packaging artwork &mdash; a visual hierarchy that converts on the shelf and prints exactly as approved, so the approved box is the one that ships.</p>
        <div class="aw-hero-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact">
            Get a Free Design Review
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ BENEFITS (3 columns) ============ -->
    <section class="aw-benefit" id="benefits">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Why it pays</span>
          <h2 class="section-title" data-reveal="up">Turn Packaging Into <em>Your Brand&rsquo;s Secret Weapon</em></h2>
          <p class="section-sub" data-reveal="up">In a crowded market the pack is the first touchpoint &mdash; what it says, how it opens and what it costs to ship decide whether a product is picked up, kept and reordered.</p>
        </div>
        <div class="aw-benefit-grid">
          {benefits.map((b, i) => (
            <article class="aw-benefit-card" data-reveal="up" style={`--d:${i * 0.1}s`}>
              <figure class="aw-benefit-media" aria-hidden="true">
                <Image src={b.img} alt={b.altH} width={b.w} height={b.h} loading="lazy" decoding="async" class="aw-benefit-img" />
              </figure>
              <h3>{b.t}</h3>
              <p>{b.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 1. PRINT PROCESS ============ -->
    <section class="aw-print" id="process">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>1 &middot; Print process</span>
          <h2 class="section-title" data-reveal="up">Digital, Flexo or Offset &mdash; <em>Pick the Right Run</em></h2>
          <p class="section-sub" data-reveal="up">The process is set by quantity, board and fine detail. Here is the honest trade-off, so the run and the board settle the choice.</p>
        </div>

        <div class="aw-print-grid">
          {print.map((p, i) => (
            <article class="aw-print-card" data-reveal="up" style={`--d:${i * 0.1}s`}>
              <figure class="aw-print-media" aria-hidden="true">
                <Image src={p.img} alt={p.altH} width={p.w} height={p.h} loading="lazy" decoding="async" class="aw-print-img" />
              </figure>
              <h3>{p.name}</h3>
              <p class="aw-print-tag">{p.tag}</p>
              <dl class="aw-print-spec">
                <div><dt>Volume</dt><dd>{p.vol}</dd></div>
                <div><dt>Board</dt><dd>{p.paper}</dd></div>
                <div><dt>Fine detail</dt><dd>{p.detail}</dd></div>
              </dl>
              <p class="aw-print-best"><strong>Best for:</strong> {p.best}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 3. FINISHING (tactile swatch cards) ============ -->
    <section class="aw-finish" id="finishing">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>2 &middot; Finishing</span>
          <h2 class="section-title" data-reveal="up">Five Finishes, Priced to <em>Fit the Moment</em></h2>
          <p class="section-sub" data-reveal="up">A gift box and an e-commerce box should not finish the same way. Here is each effect, what it costs in the run, and where it earns it back.</p>
        </div>

        <div class="aw-finish-grid">
          {finishes.map((f, i) => (
            <article class="aw-fin-card" data-reveal="up" style={`--d:${(i % 3) * 0.08}s`}>
              {f.img ? (
                <figure class="aw-fin-thumb" aria-hidden="true">
                  <Image src={f.img} alt={f.altH} width={f.w} height={f.h} loading="lazy" decoding="async" class="aw-fin-img" />
                </figure>
              ) : (
                <figure class={"aw-fin-thumb aw-swatch--" + f.sw} aria-hidden="true"></figure>
              )}
              <div class="aw-fin-body">
                <h3>{f.name}</h3>
                <p>{f.desc}</p>
                <div class="aw-fin-fit">
                  <div class="aw-fit-row"><span class="aw-fit-label">Gift box</span><span class="aw-fit-dots">{[1, 2, 3, 4, 5].map((d) => <i class={"aw-dot" + (d <= f.gift ? ' on' : '')}></i>)}</span></div>
                  <div class="aw-fit-row"><span class="aw-fit-label">E-comm box</span><span class="aw-fit-dots">{[1, 2, 3, 4, 5].map((d) => <i class={"aw-dot" + (d <= f.ecomm ? ' on' : '')}></i>)}</span></div>
                </div>
                <span class={"aw-cost aw-cost--" + f.cost}>{'$'.repeat(f.cost)}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ MID CTA (forest) ============ -->
    <section class="aw-quote" id="start">
      <div class="wrap aw-quote-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Start the artwork</span>
        <h2 class="aw-quote-title" data-reveal="up">A Story Woven Through <em>Fold &amp; Colour</em></h2>
        <p class="aw-quote-sub" data-reveal="up">Send a design or a brand manual and get a creative direction back &mdash; before the run is committed.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact">Start a Project <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </section>

    <!-- ============ 4. FILE SPEC + DIELINE ============ -->
    <section class="aw-spec" id="files">
      <div class="wrap">
        <div class="aw-spec-grid">
          <figure class="aw-dieline" data-reveal="left">
            <svg class="aw-dl" viewBox="0 0 360 360" role="img" aria-label="A packaging dieline showing the bleed, die-cut edge, crease, safe line, window knockout and a spot colour area">
              <defs><pattern id="awHatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="10" stroke="#C9A87C" stroke-width="1.1" opacity="0.5" /></pattern></defs>
              <rect class="aw-dl-bleed" x="6" y="6" width="348" height="348" rx="4" />
              <rect class="aw-dl-cut" x="24" y="24" width="312" height="312" />
              <rect class="aw-dl-safe" x="54" y="54" width="252" height="252" />
              <line class="aw-dl-crease" x1="286" y1="24" x2="286" y2="336" />
              <rect class="aw-dl-window" x="196" y="84" width="66" height="88" />
              <rect class="aw-dl-spot" x="76" y="198" width="120" height="72" />
              <rect class="aw-dl-spotline" x="76" y="198" width="120" height="72" />
              <g class="dl-crop"><path d="M6 16v-10h10M344 6h10v10M354 344v10h-10M16 354H6v-10" /></g>
              <g class="dl-pin" transform="translate(24,24)"><circle r="10" /><text x="0" y="3.6" text-anchor="middle">1</text></g>
              <g class="dl-pin" transform="translate(286,120)"><circle r="10" /><text x="0" y="3.6" text-anchor="middle">2</text></g>
              <g class="dl-pin" transform="translate(8,8)"><circle r="10" /><text x="0" y="3.6" text-anchor="middle">3</text></g>
              <g class="dl-pin" transform="translate(56,56)"><circle r="10" /><text x="0" y="3.6" text-anchor="middle">4</text></g>
              <g class="dl-pin" transform="translate(228,128)"><circle r="10" /><text x="0" y="3.6" text-anchor="middle">5</text></g>
              <g class="dl-pin" transform="translate(136,234)"><circle r="10" /><text x="0" y="3.6" text-anchor="middle">6</text></g>
            </svg>
            <figcaption class="aw-dl-key">
              <ol>
                <li><b>1</b> Die-cut edge &mdash; where the sheet is trimmed; no live art sits outside it.</li>
                <li><b>2</b> Crease / fold &mdash; the line a panel folds on.</li>
                <li><b>3</b> Bleed 3 mm &mdash; art runs past the cut so a cut wiggle never shows white.</li>
                <li><b>4</b> Safe line &mdash; critical type, barcodes, QR and legal copy stay inside this line.</li>
                <li><b>5</b> Window knockout &mdash; a see-through panel.</li>
                <li><b>6</b> Spot colour &amp; overprint &mdash; named, then set to overprint so traps hold.</li>
              </ol>
            </figcaption>
          </figure>

          <div class="aw-spec-body" data-reveal="up">
            <div class="section-head">
              <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>3 &middot; File spec</span>
              <h2 class="section-title" data-reveal="up">A File That Prints <em>First Time</em></h2>
              <p class="section-sub" data-reveal="up">Most &lsquo;looks right on screen&rsquo; files fail on the press. These are the specs that keep a file out of the rework pile.</p>
            </div>
            <p class="aw-spec-lead">A supplier needs the dieline, the bleed and the separations to match &mdash; and the key visual, the codes and the inside print in the right zones. Hand over a file that already accounts for them and the first proof is the one approved.</p>
            <ul class="aw-check">
              {specs.map((s) => (
                <li class="aw-check-item"><svg class="aw-check-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{s}</span></li>
              ))}
            </ul>
            <div class="section-cta" data-reveal="up">
              <a class="btn btn-gold" href="/contact">Run a Print Check <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 5. COLOUR MANAGEMENT (dark) ============ -->
    <section class="aw-colour" id="colour">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>4 &middot; Colour</span>
          <h2 class="section-title" data-reveal="up">Hold the Brand Colour <em>Across Every Run</em></h2>
          <p class="section-sub" data-reveal="up">CMYK drifts between presses. Pantone holds. Here is how the brand colour stays the same on the first box and the ten-thousandth.</p>
        </div>

        <div class="aw-colour-demo" data-reveal="up">
          <div class="aw-col-legend"><span>Approved &mdash; palette held to reference</span><span>Unmatched &mdash; CMYK drift between runs</span></div>
          <div class="aw-col-strip">
            <div class="aw-col-track">{[ '#E63946', '#F77F00', '#FFB703', '#2A9D8F', '#4CAF50', '#3A86FF', '#7B2CBF', '#EC4899' ].map((c) => <i class="aw-col-cell" style={`background:${c}`}></i>)}</div>
            <div class="aw-col-track">{[ '#D9867F', '#E39A54', '#D9B87C', '#4E9A90', '#6FAE72', '#4E7FBF', '#8A6B9E', '#C687A6' ].map((c) => <i class="aw-col-cell" style={`background:${c}`}></i>)}</div>
          </div>
        </div>

        <div class="aw-colour-grid">
          {colour.map((c, i) => (
            <article class="aw-colour-card" data-reveal="up" style={`--d:${i * 0.1}s`}>
              <span class="aw-colour-num">0{i + 1}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 6. CRAFT x STRUCTURE ============ -->
    <section class="aw-bound" id="boundary">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>5 &middot; Craft &times; structure</span>
          <h2 class="section-title" data-reveal="up">Where Artwork <em>Meets the Structure</em></h2>
          <p class="section-sub" data-reveal="up">A finish can be ruined by the fold it lands on. A few rules keep the artwork and the box agreeing &mdash; the rest is structural engineering.</p>
        </div>

        <div class="aw-bound-grid">
          <div class="aw-bound-col aw-bound-col--do" data-reveal="up">
            <h3 class="aw-bound-h aw-bound-h--do"><span class="aw-bound-badge">Do</span> Place for a clean fold</h3>
            <ul class="aw-bound-list">
              {doRules.map((r) => <li><svg class="aw-check-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{r}</span></li>)}
            </ul>
          </div>
          <div class="aw-bound-col" data-reveal="up" style={`--d:0.1s`}>
            <h3 class="aw-bound-h aw-bound-h--avoid"><span class="aw-bound-badge">Avoid</span> The classic failures</h3>
            <ul class="aw-bound-list">
              {avoidRules.map((r) => <li><svg class="aw-check-ico aw-check-ico--x" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{r}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ STEP-BY-STEP (vertical stepper) ============ -->
    <section class="aw-process" id="how">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>The process</span>
          <h2 class="section-title" data-reveal="up">From Idea to Iconic Packaging, <em>Step by Step</em></h2>
          <p class="section-sub" data-reveal="up">A transparent path with input at every turn &mdash; balanced against the speed and quality a launch needs.</p>
        </div>

        <ol class="aw-process-list">
          {process.map((s, i) => (
            <li class="aw-process-step" data-reveal="up" style={`--d:${(i % 2) * 0.06}s`}>
              <span class="aw-process-num">{s.n}</span>
              <div class="aw-process-body"><h3>{s.t}</h3><p>{s.d}</p></div>
            </li>
          ))}
        </ol>

        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact">Request a Design Brief <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </section>

    <!-- ============ GALLERY (looping carousel) ============ -->
    <section class="aw-gallery" id="work">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>In real life</span>
          <h2 class="section-title" data-reveal="up">See the Packs <em>Put in Shops</em></h2>
        </div>

        <div class="aw-carousel" data-reveal="up">
          <button class="aw-car-btn aw-car-btn--prev" type="button" aria-label="Previous pack">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <div class="aw-car-vp">
            <div class="aw-car-track">
              {gallery.map((g) => (
                <figure class="aw-car-slide" aria-hidden="true">
                  <Image src={g.img} alt={g.altH} width={g.w} height={g.h} loading="lazy" decoding="async" class="aw-car-img" />
                </figure>
              ))}
            </div>
          </div>
          <button class="aw-car-btn aw-car-btn--next" type="button" aria-label="Next pack">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT (related-service cards left/right, text centre) ============ -->
    <section class="aw-about">
      <div class="wrap aw-about-grid">
        <a class="aw-about-card" href={CHILD.structure}>
          <span class="aw-about-kicker">Related service</span>
          <h3>Get the structure first</h3>
          <p>Artwork sits on a dieline. If the box isn&rsquo;t set yet, start with structural engineering, then come back for the artwork.</p>
          <span class="text-link"><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Go to structural engineering</span>
        </a>
        <div class="aw-about-copy">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>About LeelinePackage</span>
          <p>Started in 2015, LeelinePackage is the custom-packaging partner for brands, retailers and DTC businesses &mdash; protecting the product and impressing the customer, from the first dieline to the final mile.</p>
        </div>
        <a class="aw-about-card" href={CHILD.sample}>
          <span class="aw-about-kicker">Next step</span>
          <h3>Packaging Sample &amp; Prototyping</h3>
          <p>Prove the artwork on a physical sample &mdash; a white dummy for fit, a printed prototype for colour and finish.</p>
          <span class="text-link">Go to sample &amp; prototyping <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="aw-faq" id="faq">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>FAQ</span>
          <h2 class="section-title" data-reveal="up">Frequently Asked <em>Questions</em></h2>
          <p class="section-sub" data-reveal="up">The practical questions before a project starts. Structure and sample detail live on their own pages.</p>
        </div>
        <div class="aw-faq-list">
          {faqs.map((f) => (
            <details class="aw-faq-item" data-reveal="up">
              <summary><span class="aw-faq-num">Q</span>{f.q}</summary>
              <div class="aw-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA (dark) ============ -->
    <section class="aw-final" id="get-started">
      <div class="wrap aw-final-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Start the artwork</span>
        <h2 class="aw-final-title" data-reveal="up">Turn Any Brand Into <em>a Pack That Sells</em></h2>
        <p class="aw-final-sub" data-reveal="up">Upload an existing design or brand manual &mdash; get a print-feasibility check and a 3D mockup back before the run is committed. A single partner from the first concept sketch to the press line, so nothing is lost between design and print.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact">Upload a Design or Brand Manual <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ HERO (centered, concise) ============ */
  .aw-hero { background: linear-gradient(180deg, rgba(20, 38, 27, 0.42), rgba(20, 38, 27, 0.6)), url('https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev/artwork/hero.webp') center / cover no-repeat; padding: calc(clamp(7rem, 14vw, 9rem) + 0px) 0 clamp(3.5rem, 7vw, 5rem); position: relative; overflow: hidden; }
  .aw-hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(55% 50% at 50% 12%, rgba(201, 168, 124, 0.14), transparent 72%); }
  .aw-hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .aw-hero-title { font-family: var(--font-heading); font-weight: 700; font-size: clamp(2.4rem, 5.5vw, 4.4rem); line-height: 1.02; letter-spacing: -0.03em; color: #FFFFFF; text-shadow: 0 2px 24px rgba(20, 38, 27, 0.4); margin: 1.2rem 0 0; max-width: 22ch; text-wrap: balance; }
  .aw-hero-title em { font-style: italic; color: #E3C29A; }
  .aw-hero-sub { font-size: clamp(1.02rem, 1.7vw, 1.16rem); line-height: 1.7; color: rgba(255, 255, 255, 0.95); max-width: 50ch; margin: 1.4rem auto 0; text-shadow: 0 1px 18px rgba(20, 38, 27, 0.4); }
  .aw-hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; margin-top: 2.1rem; }

  /* placeholder slot — dashed frame where a photo would sit */
  .aw-ph { position: relative; border: 1.5px dashed rgba(176, 141, 76, 0.55); border-radius: 1rem; background: repeating-linear-gradient(45deg, rgba(201, 168, 124, 0.1) 0 12px, transparent 12px 26px), var(--color-brand-surface); display: grid; place-items: center; color: var(--brass); overflow: hidden; }
  .aw-ph-pico { width: 34px; height: 34px; opacity: 0.85; }
  .aw-ph-label { position: absolute; left: 0.7rem; bottom: 0.7rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--forest-deep); background: rgba(245, 240, 229, 0.92); border: 1px solid rgba(31, 59, 44, 0.16); border-radius: 999px; padding: 0.3rem 0.6rem; white-space: nowrap; max-width: calc(100% - 1.4rem); overflow: hidden; text-overflow: ellipsis; }

  /* ============ BENEFITS ============ */
  .aw-benefit { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 8rem) 0; }
  .aw-benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 2.5vw, 1.8rem); }
  .aw-benefit-card { background: var(--ivory); border: 1px solid rgba(31, 59, 44, 0.1); border-radius: 1.4rem; padding: clamp(1.4rem, 3vw, 2rem); }
  .aw-benefit-media { margin: 0 0 1.2rem; align-self: stretch; height: 210px; overflow: hidden; border-radius: 0.9rem; background: var(--ivory); }
  .aw-benefit-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .aw-benefit-pico { width: 34px; height: 34px; }
  .aw-benefit-card h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.01em; color: var(--color-brand-text); margin: 0 0 0.5rem; }
  .aw-benefit-card p { font-size: 0.98rem; line-height: 1.65; color: var(--color-brand-muted); margin: 0; }

  /* ============ 1. PRINT PROCESS ============ */
  .aw-print { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .aw-print-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 2.5vw, 1.6rem); }
  .aw-print-card { background: var(--color-brand-surface); border: 1px solid rgba(31, 59, 44, 0.1); border-radius: 1.4rem; padding: clamp(1.4rem, 2.8vw, 1.9rem); display: flex; flex-direction: column; }
