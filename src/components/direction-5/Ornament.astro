---
interface Props {
  variant?: 'mark' | 'rule' | 'corner' | 'medallion' | 'flourish' | 'dot';
  class?: string;
}
const { variant = 'rule', class: className = '' } = Astro.props;
---

{
  variant === 'mark' && (
    <svg class={className} viewBox="0 0 64 64" fill="none" aria-hidden="true">
      <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1" />
      <circle cx="32" cy="32" r="24.5" stroke="currentColor" stroke-width="0.75" opacity="0.6" />
      <circle cx="32" cy="32" r="1.6" fill="currentColor" />
      <path d="M32 15 L39 32 L32 49 L25 32 Z" fill="currentColor" />
      <path d="M32 6.5 L34 15 L32 21 L30 15 Z" fill="currentColor" opacity="0.9" />
      <path d="M32 43 L34 51.5 L32 57.5 L30 51.5 Z" fill="currentColor" opacity="0.9" />
      <path d="M6.5 32 L15 30 L21 32 L15 34 Z" fill="currentColor" opacity="0.9" />
      <path d="M43 32 L51.5 30 L57.5 32 L51.5 34 Z" fill="currentColor" opacity="0.9" />
      <path d="M14.5 14.5 L22 19 L21 27 L13.5 22.5 Z" fill="currentColor" opacity="0.75" />
      <path d="M49.5 14.5 L42 19 L43 27 L50.5 22.5 Z" fill="currentColor" opacity="0.75" />
      <path d="M14.5 49.5 L22 45 L21 37 L13.5 41.5 Z" fill="currentColor" opacity="0.75" />
      <path d="M49.5 49.5 L42 45 L43 37 L50.5 41.5 Z" fill="currentColor" opacity="0.75" />
    </svg>
  )
}

{
  variant === 'rule' && (
    <svg class={className} viewBox="0 0 320 40" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-width="1">
        <line x1="0" y1="20" x2="116" y2="20" />
        <line x1="204" y1="20" x2="320" y2="20" />
        <path d="M116 20 C 110 20, 106 15, 106 9 C 106 4, 111 2, 116 4.5" />
        <path d="M204 20 C 210 20, 214 15, 214 9 C 214 4, 209 2, 204 4.5" />
      </g>
      <path d="M160 9.5 L170.5 20 L160 30.5 L149.5 20 Z" fill="currentColor" stroke="none" />
      <path d="M126 20 C 129 14, 135 14, 135 20 C 135 26, 129 26, 126 20 Z" fill="currentColor" stroke="none" />
      <path d="M194 20 C 191 14, 185 14, 185 20 C 185 26, 191 26, 194 20 Z" fill="currentColor" stroke="none" />
      <circle cx="140" cy="20" r="1.4" fill="currentColor" />
      <circle cx="180" cy="20" r="1.4" fill="currentColor" />
    </svg>
  )
}

{
  variant === 'corner' && (
    <svg class={className} viewBox="0 0 64 64" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-width="1">
        <path d="M3 64 L3 13 Q3 3 13 3 L64 3" />
        <path d="M11 64 L11 15 Q11 11 15 11 L64 11" opacity="0.55" />
      </g>
      <path d="M23 23 L28.5 27.5 L23 32 L17.5 27.5 Z" fill="currentColor" stroke="none" />
      <circle cx="33" cy="33" r="1.2" fill="currentColor" opacity="0.7" />
    </svg>
  )
}

{
  variant === 'medallion' && (
    <svg class={className} viewBox="0 0 200 200" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-width="1">
        <circle cx="100" cy="100" r="96" />
        <circle cx="100" cy="100" r="88" opacity="0.55" />
        <circle cx="100" cy="100" r="78" opacity="0.28" />
      </g>
      <path d="M100 38 L107.5 73 L100 88 L92.5 73 Z" fill="currentColor" />
      <path d="M100 162 L107.5 127 L100 112 L92.5 127 Z" fill="currentColor" />
      <path d="M38 100 L73 92.5 L88 100 L73 107.5 Z" fill="currentColor" />
      <path d="M162 100 L127 92.5 L112 100 L127 107.5 Z" fill="currentColor" />
      <path d="M56 56 L71 64 L65 79 L50 71 Z" fill="currentColor" opacity="0.9" />
      <path d="M144 144 L129 136 L135 121 L150 129 Z" fill="currentColor" opacity="0.9" />
      <path d="M144 56 L129 64 L135 79 L150 71 Z" fill="currentColor" opacity="0.9" />
      <path d="M56 144 L71 136 L65 121 L50 129 Z" fill="currentColor" opacity="0.9" />
      <circle cx="100" cy="15" r="2.4" fill="currentColor" />
      <circle cx="100" cy="185" r="2.4" fill="currentColor" />
      <circle cx="15" cy="100" r="2.4" fill="currentColor" />
      <circle cx="185" cy="100" r="2.4" fill="currentColor" />
    </svg>
  )
}

{
  variant === 'flourish' && (
    <svg class={className} viewBox="0 0 200 24" fill="none" aria-hidden="true">
      <path d="M3 15 C 38 5, 78 25, 100 13 C 122 1, 162 23, 197 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      <circle cx="3" cy="15" r="1.6" fill="currentColor" />
      <circle cx="197" cy="7" r="1.6" fill="currentColor" />
    </svg>
  )
}

{
  variant === 'dot' && (
    <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 1 L9.5 6.5 L15 8 L9.5 9.5 L8 15 L6.5 9.5 L1 8 L6.5 6.5 Z" fill="currentColor" />
    </svg>
  )
}
