---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const CX = `${R2}/custom-box`;

/* Hero stat rail — the four figures the page stands on. */
const stat = [
  { v: '98%', l: 'customer satisfaction' },
  { v: '500\u2013500,000', l: 'units on a single order' },
  { v: '4\u20136 weeks', l: 'from artwork to pallet' },
  { v: '5\u20137 days', l: 'to hold a sample' },
];

/* Compare rail — a table: a row-label column, then one column per box type.
   Each `yes` entry lines up with `compareRows` (true = that type carries that row).
   Kept deliberately free of taglines: the Box types section above already describes each type,
   so repeating it here would read as duplicate copy. Images are placeholders. */
const compareRows = ['Full-colour print', 'Recyclable paperboard', 'Custom sizes and dielines', 'Rigid board shell', 'Fitted insert'];
/* Row-level modifiers for the compare table: the zebra stripe + the hairline above every row but the
   first (the first row butts straight onto the header band, as in the reference). */
const cmpRow = (i) => `${i % 2 === 0 ? ' cx-cmp-lite' : ''}${i > 0 ? ' cx-cmp-rule' : ''}`;
const compare = [
  { name: 'Rigid Boxes', yes: [true, true, true, true, true] },
  { name: 'Magnetic Closure Boxes', yes: [true, true, true, true, true] },
  { name: 'Custom Jewelry Boxes', yes: [true, true, true, true, true] },
  { name: 'Display Boxes', yes: [true, true, true, false, false] },
  { name: 'Apparel Boxes', yes: [true, true, true, false, false] },
];

/* The nine box types the factory runs. */
const types = [
  { name: 'Custom Jewelry Boxes', n: '01', img: `${CX}/types-jewelry.webp`, w: 550, h: 525,
    alt: 'A pink rigid jewellery box with a pull-out drawer', d: 'A soft-touch shell and a fitted insert, so a small piece sits centred.' },
  { name: 'Rigid Boxes', n: '02', img: `${CX}/types-rigid.webp`, w: 525, h: 500,
    alt: 'A two-piece rigid box set with a printed sleeve', d: 'Thick greyboard wrapped in printed paper \u2014 the weight a gift is expected to have.' },
  { name: 'Magnetic Closure Boxes', n: '03', img: `${CX}/types-magnetic.webp`, w: 900, h: 600,
    alt: 'Two white gift boxes closed with satin bows', d: 'A snap-shut lid that opens like a book and closes with a clean click.' },
  { name: 'Display Boxes', n: '04', img: `${CX}/types-display.webp`, w: 550, h: 525,
    alt: 'A kraft counter display box with a printed header panel', d: 'A counter or shelf piece that shows the product and sells from the carton.' },
  { name: 'Custom Candle Boxes', n: '05', img: `${CX}/types-candle.webp`, w: 550, h: 525,
    alt: 'An open kraft rigid box holding a jar candle', d: 'A snug cavity and a printed panel that carries the scent note and burn time.' },
  { name: 'Cosmetic Boxes', n: '06', img: `${CX}/types-cosmetic.webp`, w: 550, h: 525,
    alt: 'A long printed box cradling a row of cosmetic ampoules', d: 'Shelf-ready cartons with the foil and finish the price point asks for.' },
  { name: 'Food Packaging Boxes', n: '07', img: `${CX}/types-food.webp`, w: 550, h: 525,
    alt: 'Stacked kraft food trays with clear lids', d: 'Food-grade board and linings that keep grease, moisture and flavour in place.' },
  { name: 'Apparel Boxes', n: '08', img: `${CX}/types-apparel.webp`, w: 550, h: 525,
    alt: 'A printed two-piece box in yellow and black with a contrast interior', d: 'Folding cartons and mailers drawn for folding, stacking and a tidy return.' },
  { name: 'Electronics Packaging Boxes', n: '09', img: `${CX}/types-electronics.webp`, w: 550, h: 525,
    alt: 'A black box with a foam insert beside a printed carton', d: 'A fitted cradle plus ESD-safe material, so the device arrives unmarked.' },
];

/* Protection engineering — what goes wrong, what stops it, and why the fix works.
   `icon` is raw INNER svg markup (several shapes), injected with set:html.
   Icons are deliberately literal — an isometric carton, a carton with a loose item, a water
   droplet and a delivery truck — so each reads at a glance against its uppercase symptom label. */
const protect = [
  { bad: 'Crushed corners', fix: 'Double-wall BC flute on the faces that carry the stack.', d: 'A corner takes the first hit whenever a pallet is set down, so the flute is doubled exactly where the load lands.',
    icon: '<path d="M12 3 3 7.6l9 4.5 9-4.5z"/><path d="M3 7.6v8.8L12 21v-8.9"/><path d="M21 7.6v8.8L12 21"/>' },
  { bad: 'Rattle inside', fix: 'A die-cut cradle that holds the item still, however it lands.', d: 'The insert is cut to the product rather than padded around it, and nothing shifts on a rough leg of the route.',
    icon: '<path d="M3.5 6.5h17v13h-17z"/><circle cx="9.2" cy="15.6" r="2.2"/>' },
  { bad: 'Moisture in transit', fix: 'A coated liner and a tight, sealed fit for the damp routes.', d: 'Damp air softens corrugated from the inside out; the liner seals moisture off before the board gives.',
    icon: '<path d="M12 4c2.8 3.6 5.5 6.4 5.5 9.2a5.5 5.5 0 0 1-11 0C6.5 10.4 9.2 7.6 12 4z"/>' },
  { bad: 'Freight paid on air', fix: 'Board right-sized to the product, not to the pallet.', d: 'Empty space is volume paid to ship, and paid again on the next order.',
    icon: '<path d="M2.5 7h10.5v8.6H2.5z"/><path d="M13 10.2h3.9l2.6 2.7v2.7H13z"/><path d="M6.6 15.6a1.9 1.9 0 0 1 0 3.8 1.9 1.9 0 0 1 0-3.8"/><path d="M16.6 15.6a1.9 1.9 0 0 1 0 3.8 1.9 1.9 0 0 1 0-3.8"/>' },
];

/* The four conditions a structure is signed off against. */
const tests = [
  { t: 'Drop', d: 'A free-fall from the height the route actually hands a parcel.' },
  { t: 'Compression', d: 'A stack load past the pallet those boxes will sit under.' },
  { t: 'Vibration', d: 'Truck and rail shake, run long enough to loosen a marginal fit.' },
  { t: 'Humidity', d: 'Damp air, where corrugated gives up its strength first.' },
];

/* Why a brand picks this factory. */
const why = [
  { n: '01', t: 'Quality Assurance at Every Stage', d: 'Prepress, the press operator and a final inspector each sign off; box ten thousand matches box one.' },
  { n: '02', t: 'Runs Sized to the Order', d: 'A test batch and a full rollout come off the same line, with nothing retooled between them.' },
  { n: '03', t: 'Tailored, Never Template', d: 'Sizes, shapes and finishes follow the product, never a near-enough stock carton.' },
  { n: '04', t: 'One Account Manager', d: 'A single contact holds the order from the first quote to the last pallet, and answers on the same day.' },
];

/* Production scale and the reasons it holds up. `icon` is one <path d> drawn in a 24×24 box. */
const facts = [
  { t: 'Board Sourced Locally', tag: 'Mills a short drive away', d: 'Board comes from mills within a short drive of the floor; procurement never waits on an import to clear a port before the next run starts.', icon: 'M12 3 3 7.5l9 4.5 9-4.5zM3 12l9 4.5 9-4.5M3 16.5l9 4.5 9-4.5' },
  { t: 'Sited Near a Major Port', tag: 'A short inland haul', d: 'Dispatch leaves from a port city, keeping the inland leg short with a choice of sailings each week.', icon: 'M12 3.8a2.2 2.2 0 0 1 0 4.4 2.2 2.2 0 0 1 0-4.4M12 8.2V20M8.5 11h7M4 13a8 8 0 0 0 16 0' },
  { t: 'One-Stop Production', tag: 'Nothing leaves the building', d: 'Printing, die-cutting, gluing and packing all happen on site, with nothing trucked between vendors and no colour re-registered at a second shop.', icon: 'M3 20V9.2L12 4l9 5.2V20zM9 20v-6h6v6' },
  { t: 'Visible at Every Handoff', tag: 'No blind spots', d: 'Order status is checked and shared at each stage, from prepress through the run to the pallet; a delay surfaces early enough to protect the delivery date.', icon: 'M2 12a10 6 0 0 1 20 0 10 6 0 0 1-20 0M12 8.6a3.4 3.4 0 0 1 0 6.8 3.4 3.4 0 0 1 0-6.8' },
];

/* Specialty formats beyond the standard carton. */
const formats = [
  { name: 'Pillow Box', img: `${CX}/format-pillow.webp`, alt: 'Two striped pillow boxes with curved ends',
    d: 'A curved pocket glued from a single die-cut, rounded at both ends.', best: 'Gifts, confectionery, jewellery' },
  { name: 'Fence Partition Box', img: `${CX}/format-fence.webp`, alt: 'A kraft corrugated partition insert forming divided cells',
    d: 'Corrugated cells stand between bottles and jars, taking the knock of glass against glass.', best: 'Bottles, jars, spirits, oils' },
  { name: 'Tray Box', img: `${CX}/format-tray.webp`, alt: 'A shallow kraft tray box with a white outer',
    d: 'A shallow open tray that presents its contents as soon as the lid or sleeve comes off.', best: 'Sets, kits, subscription boxes', blend: true },
  { name: 'Header Card', img: `${CX}/format-header-card.webp`, alt: 'A printed header card stapled to a clear bag of granola',
    d: 'A printed card turns a plain bag or pouch into peg-ready retail, with no printed bag to order.', best: 'Bags and pouches on pegs' },
  { name: 'French Fry Box', img: `${CX}/format-french-fry.webp`, alt: 'A kraft tapered french fry box filled with fries',
    d: 'A tapered scoop a hand can hold and a mouth can eat from, greased and food-safe inside.', best: 'Street food, snacks, catering' },
  { name: 'Punch Partition Box', img: `${CX}/format-punch.webp`, alt: 'A white punch partition insert with round cut-outs',
    d: 'A slotted insert that holds each item upright and apart, a cell per unit.', best: 'Candles, tubes, ampoules' },
];

/* Materials & compliance — specifics already established elsewhere on the site (homepage, footer)
   but NEW to this page's body, so the band adds information instead of restating it.
   `icon` is raw inner svg markup, injected with set:html. */
const materials = [
  { t: 'FSC\u00ae chain-of-custody board', d: 'Paper and board traced back through the forest supply chain: the FSC claim you print is one you can stand behind.',
    icon: '<path d="M12 3.5 7.4 9.1h9.2z"/><path d="M12 8.2 6 14.8h12z"/><path d="M12 14.8V21"/>' },
  { t: 'Recycled kraft, B/C/E flute', d: 'The board grades most orders run on, held in stock rather than ordered job by job.',
    icon: '<path d="M6.2 9.5a6.5 6.5 0 0 1 11.3-.5"/><path d="M17.8 5.4v3.8h-3.8"/><path d="M17.8 14.5a6.5 6.5 0 0 1-11.3.5"/><path d="M6.2 18.6v-3.8h3.8"/>' },
  { t: 'Soy-based inks', d: 'Print chemistry that keeps the sheet in the paper recycling stream.',
    icon: '<path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z"/><path d="M6.5 17.5 15.5 8.5"/>' },
  { t: 'ISO 9001 quality system', d: 'A documented, audited system behind every run.',
    icon: '<circle cx="12" cy="9.4" r="5.4"/><path d="M8.6 14.2 7 21l5-2.6 5 2.6-1.6-6.8"/>' },
];

/* The four presses behind every run. */
const printMethods = [
  { name: 'Offset Printing', img: `${CX}/print-offset.webp`, alt: 'An offset printing press with CMYK ink rollers', d: 'Sharp, vivid detail for larger runs, where fine type and gradients have to hold.' },
  { name: 'Flexographic Printing', img: `${CX}/print-flexo.webp`, alt: 'A flexographic press with printing rollers', d: 'The economical route for simple artwork on corrugated, and for long runs.' },
  { name: 'Digital Printing', img: `${CX}/print-digital.webp`, alt: 'A large-format digital printer producing colourful sheets', d: 'No plates and no setup \u2014 the fastest route to short or personalised batches.' },
  { name: 'Screen Printing', img: `${CX}/print-screen.webp`, alt: 'Hands pulling a squeegee across a screen-printing frame', d: 'Thick ink with a tactile lift, for bold colour on specialty board.' },
];

/* Boxes that left the floor — the user's six unboxing / application photos.
   Keys are descriptive rather than case-1…6 on purpose: the old `case-N` URLs were already cached
   in browsers from an earlier build, so re-using them meant visitors kept seeing the old shots. */
const cases = [
  { img: `${CX}/case-unboxing.webp`, alt: 'A woman lifting orange tissue paper out of an open kraft mailer box', cap: 'A mailer unwrapped at home' },
  { img: `${CX}/case-jewelry-box.webp`, alt: 'A child opening a floral-printed rigid jewelry box with a ballerina inside', cap: 'A printed musical jewelry box' },
  { img: `${CX}/case-gift-box.webp`, alt: 'A couple holding a lilac rigid gift box tied with a satin bow', cap: 'A lilac rigid box, ribboned' },
  { img: `${CX}/case-display-unit.webp`, alt: 'A large printed retail display box standing on a shop floor beside stacked confectionery cartons', cap: 'A retail display unit in store' },
  { img: `${CX}/case-food-cartons.webp`, alt: 'A cook in black gloves closing filled kraft food cartons on a counter', cap: 'Kraft food cartons on the pass' },
  { img: `${CX}/case-shipping-box.webp`, alt: 'A worker taping a tablet into a brown corrugated mailer beside a wall of flat-packed boxes', cap: 'A shipping box packed and taped' },
];

/* Two customers, three paragraphs each, varied openings. */
const testimonials = [
  {
    name: 'Alex Martinez', role: 'Founder', co: 'Horizon Brewing Co.', loc: 'United States',
    avatar: `${CX}/avatar-alex.webp`,
    q: [
      'A limited-edition series needed packaging that felt handmade and still survived a courier. The first sample arrived with the dieline tight, the foil sitting exactly on the mark, and board heavier than the spec sheet promised.',
      'Nothing shifted inside on the way to the taproom. Four hundred cases were stacked, palletised and shipped without a crushed corner \u2014 something this brewery could not say before.',
      'The same person handled the reorder from quote to delivery, and the dates never moved. A seasonal release can only be planned around a supplier that repeats itself.',
    ],
  },
  {
    name: 'Jason Williams', role: 'Operations Lead', co: 'Urban Threads Clothing', loc: 'Canada',
    avatar: `${CX}/avatar-jason.webp`,
    q: [
      'Scaling up meant parcels that could take a sorting belt and still look worth photographing. The mailers that came back were rigid where it mattered and printed right to the edge.',
      'Damage dropped once the flute and the insert changed. Fewer replacements, fewer refunds, and a returns pile that is now mostly size exchanges instead of crush claims.',
      'The size variants were drawn as a system; each SKU folds to the same footprint and stacks without gaps in the warehouse.',
    ],
  },
];

/* Questions the page has not already answered above. */
const faqs = [
  { q: 'Can I approve a dieline before production starts?', a: 'Yes. A cut file and a 3D mockup are shared for sign-off before any board is cut, and the run follows the dieline that was approved.' },
  { q: 'How is the price of a custom box worked out?', a: 'Board grade, box size, print method, finish and run length set the unit price. Send the quantity and the artwork, and the quote itemises each line.' },
  { q: 'Can the inside of a box be printed?', a: 'Yes. Inside print, a coloured liner and a printed insert are all available, and they show the moment the lid comes off.' },
  { q: 'Can the boxes ship flat to save freight?', a: 'Folding cartons and many rigid styles are delivered flat or knocked down, and a container carries far more than it would with assembled boxes.' },
  { q: 'What if a batch does not match the approved sample?', a: 'Where the variance sits with us, the run is remade or the order credited. The approved sample is the reference for the whole batch.' },
];

const seo = {
  title: 'Custom Box Manufacturer: 500-Unit MOQ, Damage Capped at 0.2%',
  description: 'Custom box manufacturer building corrugated, rigid and folding cartons. A 500-unit MOQ, damage-tested structure, and transit damage held under 0.2% on each run.',
  keywords: 'custom box manufacturer, custom boxes, custom packaging boxes, corrugated box manufacturer, rigid box manufacturer, folding carton manufacturer, custom printed boxes, custom box factory, wholesale custom boxes, custom display boxes, custom mailer boxes, packaging box supplier',
  canonical: 'https://www.leelinepackage.com/custom-box-manufacturer/',
  ogImage: `${CX}/hero.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Box Manufacturing',
      description: seo.description,
      serviceType: 'Custom box design, engineering and manufacturing',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Box Manufacturer' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO ============ -->
    <section class="cx-hero">
      <div class="cx-hero-shade"></div>
      <div class="cx-grain"></div>
      <div class="wrap cx-hero-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>China custom box factory &middot; Design to pallet</span>
        <h1 class="cx-hero-title" data-reveal="up">Custom Box Manufacturer: <em>Heavy-Duty Protection, &lt;0.2% Transit Damage</em></h1>
        <p class="cx-hero-sub" data-reveal="up">Products that arrive intact, returns that stop climbing, and an unboxing that still feels worth the price. That is the job the box does in the last mile &mdash; where a crushed corner becomes a refund and a scuffed lid becomes a review.</p>
        <div class="cx-hero-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Start Your Box Project
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <div class="wrap cx-rail-wrap">
      <ul class="cx-rail" data-reveal="up">
        {stat.map((s) => (
          <li><strong>{s.v}</strong><span>{s.l}</span></li>
        ))}
      </ul>
    </div>

    <!-- ============ BOX TYPES ============ -->
    <section class="cx-types" id="box-types">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Box types</span>
          <h2 class="section-title" data-reveal="up">Box Types Built Around <em>the Product Inside</em></h2>
          <p class="section-sub" data-reveal="up">Nine constructions under a single roof: the box suits the product, not whatever the line happens to be running &mdash; with board, fit and finish tuned to the channel it sells through.</p>
        </div>
        <div class="cx-type-grid">
          {types.map((t, i) => (
            <article class="cx-type-card" data-reveal="up" style={`--d:${(i % 3) * 0.1}s`}>
              <figure class="cx-type-ph">
                <img src={t.img} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" class="cx-img" />
              </figure>
              <span class="cx-type-num">{t.n}</span>
              <h3 class="cx-type-name">{t.name}</h3>
              <p class="cx-type-desc">{t.d}</p>
            </article>
          ))}
        </div>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Send Your Box Spec
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ COMPARE PRODUCTS ============ -->
    <section class="cx-cmp" id="compare">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Compare</span>
          <h2 class="section-title" data-reveal="up">The Box Types, <em>Side by Side</em></h2>
          <p class="section-sub" data-reveal="up">Five box types on the same five points &mdash; the decision gets made on structure rather than on a recommendation.</p>
        </div>
        <div class="cx-cmp-rail" data-reveal="up">
          <div class="cx-cmp-track" style={`grid-template-rows: auto repeat(${compareRows.length}, auto)`}>
            <p class="cx-cmp-name cx-cmp-r-tl" aria-hidden="true"></p>
            {compareRows.map((r, i) => <p class={`cx-cmp-label${cmpRow(i)}${i === compareRows.length - 1 ? ' cx-cmp-r-bl' : ''}`}>{r}</p>)}
            {compare.map((c, ci) => (
              <>
                <h3 class={`cx-cmp-name${ci === compare.length - 1 ? ' cx-cmp-r-tr' : ''}`}>{c.name}</h3>
                {compareRows.map((r, i) => (
                  <p class={`cx-cmp-cell${cmpRow(i)}${ci === compare.length - 1 && i === compareRows.length - 1 ? ' cx-cmp-r-br' : ''}`}>
                    {c.yes[i]
                      ? <svg class="cx-cmp-ico cx-cmp-ico--yes" viewBox="0 0 24 24" role="img" aria-label={`${r}: included`}><circle cx="12" cy="12" r="11.5" fill="currentColor" /><path d="M6.8 12.3l3.4 3.4L17.2 9.1" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      : <svg class="cx-cmp-ico cx-cmp-ico--no" viewBox="0 0 24 24" role="img" aria-label={`${r}: not offered`}><circle cx="12" cy="12" r="11.5" fill="currentColor" opacity=".14" /><path d="M6.5 12h11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>}
                  </p>
                ))}
              </>
            ))}
          </div>
        </div>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Get a Recommendation
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ WHY ============ -->
    <section class="cx-why">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Why a brand picks us</span>
          <h2 class="section-title" data-reveal="up">A Custom Box Manufacturer <em>Built Around the Order</em></h2>
          <p class="section-sub" data-reveal="up">Four things that change once the factory answers to your brand rather than to a catalogue.</p>
        </div>
        <div class="cx-why-grid">
          <figure class="cx-why-visual" data-reveal="left">
            <img src={`${CX}/brand.webp`} alt="Workers assembling printed boxes on the factory floor" width={800} height={761} loading="lazy" decoding="async" class="cx-img" />
          </figure>
          <ol class="cx-why-list">
            {why.map((w, i) => (
