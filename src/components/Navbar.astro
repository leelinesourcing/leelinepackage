---
const LOGO = 'https://img.leelinepackage.com/leelinepackage-logo.webp';
const R2 = 'https://img.leelinepackage.com';

// Products is grouped into three columns for the mega panel. Each entry carries the product
// thumbnail shown beside it (a plain R2 <img>) plus `sub`, a short descriptor taken from that
// product page's own copy — it is what tells a buyer what the thing IS, so keep it factual.
// An entry MAY also carry `children` for a nested sub-list: one line per shipped sub-page,
// drawn as a tree under the parent on desktop (`.nav-mega-children`) and as a `↳`-marked line
// in the mobile panel below.
const productGroups = [
  {
    label: 'Bags & Pouches',
    entries: [
      { label: 'Custom Bag', href: '/custom-bag-manufacturer/', img: `${R2}/satin-bag-v2.webp`, sub: 'Cotton · canvas · jute' },
      { label: 'Custom Paper Bag', href: '/custom-paper-bag/', img: `${R2}/paper-bag-v2.webp`, sub: 'Reinforced handles' },
      { label: 'Custom Mailer Bags', href: '/custom-mailer-bags/', img: `${R2}/mailer-box-v2.webp`, sub: '80% lighter than a box' },
      { label: 'Custom Pouches', href: '/custom-pouches/', img: `${R2}/pouches-v2.webp`, sub: 'Stand-up · flat · spouted' },
      { label: 'Custom Tote Bags', href: '/custom-tote-bags/', img: `${R2}/custom-bag/bt-tote.webp`, sub: 'Six fabrics · bar-tacked' },
      { label: 'Custom Reusable Shopping Bags', href: '/custom-reusable-shopping-bags/', img: `${R2}/reusable-bag-v2.webp`, sub: 'GRS · GOTS certified' },
      { label: 'Custom Velvet Bags', href: '/custom-velvet-bags/', img: `${R2}/velvet-bags/type-drawstring-v2.webp`, sub: 'Tarnish-lined velvet' },
    ],
  },
  {
    label: 'Boxes & Cartons',
    entries: [
      { label: 'Custom Box', href: '/custom-box-manufacturer/', img: `${R2}/custom-box/types-magnetic.webp`, sub: 'Corrugated · rigid · folding' },
      { label: 'Custom Folding Cartons', href: '/custom-folding-cartons/', img: `${R2}/folding-carton-v2.webp`, sub: 'Machine-run · FSC board' },
      { label: 'Custom Rigid Boxes', href: '/custom-rigid-boxes/', img: `${R2}/rigid-box-v2.webp`, sub: '90° V-cut corners' },
      { label: 'Custom Display Box', href: '/custom-display-box/', img: `${R2}/display-box-v2.webp`, sub: 'Counter · PDQ · floor' },
      { label: 'Custom Corrugated Boxes', href: '/custom-corrugated-boxes/', img: `${R2}/corrugated-box-v2.webp`, sub: 'Right-sized to your ECT' },
      { label: 'Custom Tin Box', href: '/custom-tin-box/', img: `${R2}/tin-box-v2.webp`, sub: 'Food-grade lacquer' },
      { label: 'Custom Acrylic Box', href: '/custom-acrylic-box/', img: `${R2}/acrylic-box.webp`, sub: 'Polished · 92% clarity' },
    ],
  },
  {
    label: 'Specialty',
    entries: [
      { label: 'Custom Package Stickers', href: '/custom-package-stickers/', img: `${R2}/labels-stickers-v2.webp`, sub: 'BOPP · vinyl · kraft' },
      {
        label: 'Custom Vape Packaging',
        href: '/custom-vape-packaging/',
        img: `${R2}/custom-vape/type-disposable.webp`,
        sub: 'Child-resistant · pods',
        // Sub-pages render as a nested line under their parent. Add one entry per shipped page;
        // a sub-page that does not exist is a 404 on every page of the site.
        children: [
          { label: 'Vape Cartridge Packaging', href: '/custom-vape-packaging/vape-cartridge-packaging/' },
          { label: 'Disposable Vape Packaging', href: '/custom-vape-packaging/disposable-vape-packaging/' },
        ],
      },
    ],
  },
];

// The panel's footer strip — the one trading line the mega menu can safely make, using only
// figures that are already settled site-wide (500-unit MOQ, 24-hour mockup).
const navMegaMeta = 'All 16 lines from 500 units · 3D mockup in 24 hours';

const nav = {
  home: '/',
  // Industries + Services carry the same `img` / `sub` shape as the Products entries, so the
  // desktop dropdowns render the identical row. The mobile panel reads only `label` / `href`.
  industries: [
    { label: 'Custom Jewelry Packaging', href: '/custom-jewelry-packaging/', img: `${R2}/jewelry/type-chest-v2.webp`, sub: 'Tarnish-free lining' },
    { label: 'Custom Gift Box', href: '/custom-gift-box/', img: `${R2}/gift-box/type-magnetic.webp`, sub: 'Board · wrap · insert' },
    { label: 'Custom Shipping Box', href: '/custom-shipping-box/', img: `${R2}/shipping-box/type-rsc.webp`, sub: '32–51 ECT · ISTA 3A' },
  ],
  about: '/about-us/',
  caseStudy: '/case-study/',
  services: [
    { label: 'Structural Engineering', href: '/structural-engineering-and-design/', img: `${R2}/services/structural.webp`, sub: 'Structure · board · dieline' },
    { label: 'Packaging Artwork Design', href: '/packaging-artwork-design/', img: `${R2}/services/artwork.webp`, sub: 'Brand colour · foil · finish' },
    { label: 'Packaging Sample & Prototyping', href: '/packaging-sample-prototyping/', img: `${R2}/sample/hero.webp`, sub: 'White dummy · printed proof' },
  ],
  blog: '/blog/',
  cta: '/contact/',
};
---


<header class="site-nav" id="siteNav">
  <div class="site-nav-inner">
    <a class="brand" href="/" target="_blank" rel="noopener" aria-label="LeelinePackage home">
      <img class="brand-logo" src={LOGO} alt="LeelinePackage" width={500} height={100} loading="eager" />
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href={nav.home} target="_blank" rel="noopener">Home</a>

      <div class="nav-drop nav-drop--mega">
        <button class="nav-drop-btn" aria-haspopup="true" aria-expanded="false">
          Products
          <svg class="chev" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-mega">
          <div class="nav-mega-inner">
            <div class="nav-mega-grid">
              {productGroups.map((g) => (
                <div class="nav-mega-col">
                  <p class="nav-mega-label">{g.label}</p>
                  <div class="nav-mega-list">
                    {g.entries.map((e) => (
                      <>
                        <a class="nav-mega-item" href={e.href} target="_blank" rel="noopener">
                          <span class="nav-mega-thumb-wrap">
                            {e.img
                              ? <img class="nav-mega-thumb" src={e.img} alt="" width="60" height="60" loading="lazy" decoding="async" />
                              : <span class="nav-mega-thumb nav-mega-thumb--ph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M8 7V5h8v2"/></svg></span>}
                          </span>
                          <span class="nav-mega-text">
                            <span class="nav-mega-name">{e.label}</span>
                            {e.sub && <span class="nav-mega-desc">{e.sub}</span>}
                          </span>
                        </a>
                        {e.children && (
                          <div class="nav-mega-children">
                            {e.children.map((c) => (
                              <a href={c.href} target="_blank" rel="noopener">{c.label}</a>
                            ))}
                          </div>
                        )}
                      </>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <div class="nav-mega-foot">
              <span class="nav-mega-meta">{navMegaMeta}</span>
              <a class="nav-mega-cta" href="/contact/" target="_blank" rel="noopener">Start Your Project</a>
            </div>
          </div>
        </div>
      </div>

      <div class="nav-drop">
        <button class="nav-drop-btn" aria-haspopup="true" aria-expanded="false">
          Industries
          <svg class="chev" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-menu">
          {nav.industries.map((p) => (
            <a class="nav-mega-item" href={p.href} target="_blank" rel="noopener">
              <span class="nav-mega-thumb-wrap"><img class="nav-mega-thumb" src={p.img} alt="" width="60" height="60" loading="lazy" decoding="async" /></span>
              <span class="nav-mega-text">
                <span class="nav-mega-name">{p.label}</span>
                <span class="nav-mega-desc">{p.sub}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <a href={nav.about} target="_blank" rel="noopener">About Us</a>
      <a href={nav.caseStudy} target="_blank" rel="noopener">Case Studies</a>

      <div class="nav-drop">
        <a class="nav-drop-link" href="/services/" target="_blank" rel="noopener">
          Services
          <svg class="chev" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="nav-menu">
          {nav.services.map((p) => (
            <a class="nav-mega-item" href={p.href} target="_blank" rel="noopener">
              <span class="nav-mega-thumb-wrap"><img class="nav-mega-thumb" src={p.img} alt="" width="60" height="60" loading="lazy" decoding="async" /></span>
              <span class="nav-mega-text">
                <span class="nav-mega-name">{p.label}</span>
                <span class="nav-mega-desc">{p.sub}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <a href={nav.blog} target="_blank" rel="noopener">Blog</a>
    </nav>

    <div class="nav-actions">
      <a class="btn btn-primary btn-sm" href={nav.cta} target="_blank" rel="noopener">Get Free Quote<svg class="btn-leaf" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <button class="search-btn" id="navSearchBtn" type="button" aria-label="Search the blog" aria-haspopup="dialog" aria-controls="navSearch" aria-expanded="false">
        <svg class="search-ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12.9 12.9 17.6 17.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <button class="menu-btn" id="navMenuBtn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ⚠️ Must stay OUTSIDE <header class="site-nav">. The header carries `backdrop-filter`, which
     makes it the containing block for `position: fixed` descendants — inside the header this
     panel resolves `inset: 0` against the 76px bar instead of the viewport, so the menu opens as
     a 76px sliver and looks like nothing happened. As a sibling its containing block is the ICB.
     z-index 999 keeps it above the page but below the header bar (1000), so the bar stays usable. -->
<div class="nav-mobile" id="navMobile">
  <nav class="nav-mobile-links" aria-label="Mobile">
    <a href="/" target="_blank" rel="noopener">Home</a>
    <details>
      <summary>Products<svg class="m-chev" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
      <div class="sub">
        {productGroups.flatMap((g) => g.entries).flatMap((e) => [
          <a href={e.href} target="_blank" rel="noopener">{e.label}</a>,
          ...(e.children ?? []).map((c) => <a class="m-sub-child" href={c.href} target="_blank" rel="noopener">{c.label}</a>),
        ])}
      </div>
    </details>
    <details>
      <summary>Industries<svg class="m-chev" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
      <div class="sub">{nav.industries.map((p) => <a href={p.href} target="_blank" rel="noopener">{p.label}</a>)}</div>
    </details>
    <a href="/about-us/" target="_blank" rel="noopener">About Us</a>
    <a href="/case-study/" target="_blank" rel="noopener">Case Studies</a>
    <details>
      <summary>Services<svg class="m-chev" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
      <div class="sub">
        <a href="/services/" target="_blank" rel="noopener">Services Overview</a>
        {nav.services.map((p) => <a href={p.href} target="_blank" rel="noopener">{p.label}</a>)}
      </div>
    </details>
    <a href="/blog/" target="_blank" rel="noopener">Blog</a>
    <button class="m-search" id="navMobileSearch" type="button">
      <svg class="search-ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12.9 12.9 17.6 17.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      Search the Blog
    </button>
    <a href="/contact/" class="btn btn-primary" target="_blank" rel="noopener">Start Your Project<svg class="btn-leaf" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </nav>
</div>

<!--
  ⚠️ Same containment rule as `.nav-mobile` above: kept OUTSIDE <header class="site-nav">, because
  the header's `backdrop-filter` would otherwise become this panel's containing block and clip
  `inset: 0` to the 76 px bar.
-->
<div class="nav-search" id="navSearch" role="dialog" aria-modal="true" aria-label="Search the blog">
  <div class="nav-search-panel">
    <div class="nav-search-bar">
      <svg class="search-ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12.9 12.9 17.6 17.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <input class="nav-search-input" id="navSearchInput" type="search" name="s" placeholder="Search the blog…" autocomplete="off" aria-label="Search the blog" aria-describedby="navSearchHint" />
      <button class="nav-search-close" id="navSearchClose" type="button" aria-label="Close search">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
    <p class="nav-search-hint" id="navSearchHint">Search every article by title or topic.</p>
    <div class="nav-search-results" id="navSearchResults"></div>
  </div>
</div>

<style>
  :global(body) { padding-top: 0; }
  /* The open menu is a full-screen panel; lock the page behind it. Kept here (not in a page) so all
     32 pages get it — it used to live only in index.astro, so the other 31 scrolled underneath. */
  :global(body.menu-open) { overflow: hidden; }
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(245, 240, 229, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(31, 59, 44, 0.08);
    transition: box-shadow 0.4s ease;
  }
  /* brand + links + quote button form one cluster packed left against the logo,
     all sharing the same gap, instead of the button being pushed to the far edge */
  .site-nav-inner {
    width: min(1280px, 100% - clamp(2rem, 6vw, 6rem));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(1.1rem, 2.4vw, 1.9rem);
    padding: 1rem 0;
    transition: padding 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .site-nav.scrolled .site-nav-inner { padding: 0.55rem 0; }

  .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .brand-logo { height: 42px; width: auto; object-fit: contain; }

  .nav-links { display: flex; align-items: center; gap: clamp(1.1rem, 2.4vw, 1.9rem); }
  .nav-links > a, .nav-drop-btn, .nav-drop-link {
    font-size: 0.92rem; font-weight: 500; color: var(--color-brand-text); text-decoration: none;
    background: none; border: 0; cursor: pointer; padding: 0.3rem 0; position: relative;
    display: inline-flex; align-items: center; gap: 0.35rem; font-family: inherit;
  }
  .nav-links > a::after, .nav-drop-btn::after, .nav-drop-link::after {
    content: ''; position: absolute; left: 0; bottom: 0; height: 1.5px; width: 100%;
    background: var(--brass); transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-links > a:hover::after, .nav-drop:hover .nav-drop-btn::after, .nav-drop:focus-within .nav-drop-btn::after, .nav-drop:hover .nav-drop-link::after, .nav-drop:focus-within .nav-drop-link::after { transform: scaleX(1); }
  .chev { width: 11px; height: 8px; transition: transform 0.3s ease; }
  .nav-drop:hover .chev, .nav-drop:focus-within .chev { transform: rotate(180deg); }

  .nav-drop { position: relative; }
  /* Industries + Services: the SAME row as the Products panel (`.nav-mega-item`), in a narrow
     floating card — three entries each, so no full-bleed band. */
  .nav-menu {
    position: absolute; top: calc(100% + 0.5rem); left: 50%; transform: translateX(-50%) translateY(-6px);
    width: max-content; min-width: 300px; max-width: min(440px, calc(100vw - 2rem));
    background: var(--ivory); border: 1px solid rgba(176, 141, 76, 0.3); border-radius: 0.9rem;
    padding: 0.5rem; box-shadow: 0 28px 50px -34px rgba(31, 59, 44, 0.5);
    display: flex; flex-direction: column; gap: 0.25rem;
    opacity: 0; visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
  }
  .nav-drop:hover .nav-menu, .nav-drop:focus-within .nav-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

  /* ── Products mega panel ───────────────────────────────────────────────────────────────────
     A full-bleed band under the bar, copied from the LantaoBags navigation the client picked:
     52 px thumbnails that zoom on hover, a two-line row (name + descriptor), hairline rules
     between the columns, and a footer strip with one trading line and a CTA.
     It is anchored to the BAR, not the trigger — `.nav-drop--mega` drops its `position: relative`,
     so the containing block is <header> and `left: 0; right: 0` spans the viewport. `.nav-mega-inner`
     reuses `.site-nav-inner`'s exact width, so column 1 lines up under the logo.
     ⚠️ The band starts at the bar's bottom, so the only dead zone for the pointer crossing from the
     trigger is the ~14 px inside the bar — shorter than the 0.18 s the close transition lasts.
     ⚠️ `max-height` + scroll: seven rows per column is a ~690 px panel, taller than a 620 px-tall
     laptop viewport. Without this guard the footer is cut off. */
  .nav-drop--mega { position: static; }
  .nav-mega {
    position: absolute; top: 100%; left: 0; right: 0; z-index: 40;
    background: var(--ivory);
    border-bottom: 1px solid rgba(176, 141, 76, 0.3);
    box-shadow: 0 28px 50px -34px rgba(31, 59, 44, 0.5);
    max-height: calc(100vh - 4.5rem); overflow-y: auto;
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
  }
  .nav-drop--mega:hover .nav-mega, .nav-drop--mega:focus-within .nav-mega {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .nav-mega-inner { width: min(1280px, 100% - clamp(2rem, 6vw, 6rem)); margin-inline: auto; padding: 1.5rem 0 1.25rem; }
  .nav-mega-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .nav-mega-col + .nav-mega-col { border-left: 1px solid rgba(176, 141, 76, 0.3); padding-left: 2rem; }
  .nav-mega-label {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-brand-primary); margin: 0 0 0.875rem;
  }
  .nav-mega-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .nav-mega-item {
    display: flex; align-items: center; gap: 0.9rem;
    padding: 0.4rem; margin: 0 -0.4rem; border-radius: 0.6rem;
    text-decoration: none; color: var(--color-brand-text);
    transition: background 0.2s ease;
  }
  .nav-mega-item:hover { background: var(--color-brand-surface); }
  /* The tile's ground is the panel's own ivory and `darken` maps any pixel LIGHTER than that ground
     back onto it, so white-background studio shots melt into the card instead of showing a white or
     grey square. Measured over the 16 product thumbnails, only the vape shot is really white
     (46 % of its pixels move); every other one is under 1 % apart from its own bright highlights,
     which is why this is one global rule rather than a per-item flag.
     `isolation: isolate` keeps the blend inside the tile instead of reaching the band behind it;
     the dashed placeholder opts out. */
  .nav-mega-thumb-wrap {
    display: block; width: 60px; height: 60px; flex: 0 0 auto; border-radius: 0.6rem;
    overflow: hidden; background: var(--ivory); isolation: isolate;
  }
  .nav-mega-thumb { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .nav-mega-thumb:not(.nav-mega-thumb--ph) { mix-blend-mode: darken; }
  .nav-mega-item:hover .nav-mega-thumb { transform: scale(1.05); }
  .nav-mega-thumb--ph {
    display: grid; place-items: center; border: 1px dashed rgba(31, 59, 44, 0.25);
    background: repeating-linear-gradient(135deg, rgba(31, 59, 44, 0.06) 0 7px, rgba(31, 59, 44, 0.02) 7px 14px);
  }
  .nav-mega-thumb--ph svg { width: 24px; height: 24px; color: var(--brass); }
  .nav-mega-thumb--ph:hover, .nav-mega-item:hover .nav-mega-thumb--ph { transform: none; }
  .nav-mega-text { min-width: 0; }
  .nav-mega-name { display: block; font-size: 0.95rem; font-weight: 600; line-height: 1.25; }
  .nav-mega-item:hover .nav-mega-name { color: var(--color-brand-primary); }
  .nav-mega-desc { display: block; margin-top: 0.2rem; font-size: 0.8rem; line-height: 1.3; color: var(--color-brand-muted); }
  /* A product's sub-pages, drawn as a TREE so they read as children of the row above instead of as
     a dim footnote. A brass rail drops down the parent's text column and elbows into each child
     (├ … └); labels sit at full brand ink, one size under the parent's name.
     The rail is drawn per row: consecutive rows' stubs meet to form the continuous line, and the
     LAST row's stub stops at its own elbow (`bottom: 50%`) — that half-height stub is what turns
     the final ├ into a └. Applies to any future entry that carries `children`. */
  .nav-mega-children {
    display: flex; flex-direction: column;
    margin: 0.2rem 0 0.35rem 4.9rem;
  }
  .nav-mega-children a {
    position: relative; display: block;
    padding: 0.34rem 0.6rem 0.34rem 1.1rem;
    font-size: 0.85rem; font-weight: 500; color: var(--color-brand-text);
    text-decoration: none; border-radius: 0.5rem;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .nav-mega-children a::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px;
    background: rgba(176, 141, 76, 0.45); transition: background 0.2s ease;
  }
  .nav-mega-children a:last-child::before { bottom: 50%; }
  .nav-mega-children a::after {
    content: ''; position: absolute; left: 0; top: calc(50% - 0.5px); width: 0.5rem; height: 1px;
    background: rgba(176, 141, 76, 0.45); transition: background 0.2s ease;
  }
  .nav-mega-children a:hover { background: var(--color-brand-surface); color: var(--color-brand-primary); }
  .nav-mega-children a:hover::before, .nav-mega-children a:hover::after { background: var(--brass); }
  .nav-mega-foot {
    margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(176, 141, 76, 0.25);
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
  }
  .nav-mega-meta { font-size: 0.85rem; color: var(--color-brand-muted); }
  .nav-mega-cta {
    flex: 0 0 auto; display: inline-block; background: var(--color-brand-primary); color: var(--ivory);
    padding: 0.65rem 1.35rem; border-radius: 2rem; font-size: 0.85rem; font-weight: 600;
    letter-spacing: 0.04em; text-decoration: none; transition: opacity 0.25s ease;
  }
  .nav-mega-cta:hover { opacity: 0.9; }

  .nav-actions { display: flex; align-items: center; gap: 0.8rem; }
  .menu-btn { display: none; flex-direction: column; gap: 5px; width: 44px; height: 44px; align-items: center; justify-content: center; background: none; border: 1px solid rgba(31, 59, 44, 0.2); border-radius: 50%; cursor: pointer; }
  .menu-btn span { display: block; width: 18px; height: 1.6px; background: var(--color-brand-text); transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease; }
  body.menu-open .menu-btn span:nth-child(1) { transform: translateY(3.3px) rotate(45deg); }
  body.menu-open .menu-btn span:nth-child(2) { transform: translateY(-3.3px) rotate(-45deg); }

  /* Blog search — the live site's GeneratePress search icon, kept in the same slot (right of the
     quote pill, left of the hamburger). ⚠️ Hidden below 601px: at 390px the bar is already
     exactly full (measured 340 of 358px with a logo squeezed to 119px), so a fourth control
     would crush the wordmark. Under the breakpoint the same action moves into the mobile panel
     as `.m-search`, which is where the WordPress slideout carried it too. */
  /* The magnifier is the one control in the bar that has to be NOTICED, so it carries the
     full-strength brand green rather than the 20%-alpha hairline the hamburger uses, and fills
     on hover. ⚠️ `.menu-btn` beside it still has the faint border — match it only if asked. */
  .search-btn {
    display: none; width: 44px; height: 44px; align-items: center; justify-content: center;
    background: none; border: 1px solid var(--color-brand-primary); border-radius: 50%;
    color: var(--color-brand-text); cursor: pointer;
    transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease;
  }
  .search-btn:hover { background: var(--color-brand-primary); color: var(--ivory); }
  .search-ico { width: 19px; height: 19px; flex: 0 0 auto; }
  /* Thickened here, once, instead of on all three inline copies of the icon. CSS beats the
     `stroke-width` presentation attribute. */
  .search-ico circle, .search-ico path { stroke-width: 2.15; }
  @media (min-width: 601px) { .search-btn { display: flex; } }

  /* ⚠️ Sits OUTSIDE <header> on purpose — see the note in the markup. The header's
     `backdrop-filter` would otherwise become this element's containing block and clip
     `inset: 0` to the 76px bar. z-index 999 = above the page, below the bar (1000). */
  .nav-mobile {
    position: fixed; inset: 0; z-index: 999; background: var(--ivory);
    display: grid; place-items: center; opacity: 0; visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease; overflow-y: auto;
  }
  body.menu-open .nav-mobile { opacity: 1; visibility: visible; }
  .nav-mobile-links { display: flex; flex-direction: column; align-items: center; gap: 1.2rem; padding: 6rem 1.5rem 3rem; width: 100%; max-height: 100%; overflow-y: auto; }
  .nav-mobile-links > a, .nav-mobile-links summary {
    font-family: var(--font-heading); font-size: 1.7rem; color: var(--color-brand-text); text-decoration: none;
    list-style: none; cursor: pointer; text-align: center;
  }
  /* The three expandable rows are the only tappable-within-a-tap here, and in the
     panel they render as plain text — indistinguishable from "Blog". The chevron
     is what says "this opens". Inline-flex keeps it tight against the word while
     the column's `align-items: center` still centers the pair. */
  .nav-mobile-links summary { display: inline-flex; align-items: center; gap: 0.45rem; }
  .m-chev { width: 0.6em; height: 0.4em; flex: 0 0 auto; transition: transform 0.3s ease; }
  .nav-mobile-links details[open] > summary .m-chev { transform: rotate(180deg); }
  .nav-mobile-links summary::-webkit-details-marker { display: none; }
  .nav-mobile-links .sub { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 0.5rem; text-align: center; }
  .nav-mobile-links .sub a { font-family: var(--font-body); font-size: 1rem; color: var(--color-brand-muted); text-decoration: none; }
  /* A sub-page line in the mobile panel. The list is centered, so a rail cannot read as a tree —
     a brass ↳ plus full-strength ink is what says "this hangs off the line above". */
  .nav-mobile-links .sub .m-sub-child { font-size: 0.92rem; color: var(--color-brand-text); }
  .nav-mobile-links .sub .m-sub-child::before { content: '↳ '; color: var(--brass); }
  /* ⚠️ `.nav-mobile-links > a` (0,1,1) outranks `.btn-primary`'s `color: var(--ivory)`
     (0,1,0), so the panel's CTA was shipping near-black text on the dark green pill.
     This (0,2,1) puts the ivory back. */
  .nav-mobile-links a.btn { font-family: var(--font-body); font-size: 1rem; margin-top: 0.6rem; color: var(--ivory); }
  /* The <601px stand-in for `.search-btn` — same panel row rhythm as the summaries. */
  .nav-mobile-links .m-search {
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 0; background: none; border: 0;
    font-family: var(--font-heading); font-size: 1.7rem; color: var(--color-brand-text); cursor: pointer;
  }
  .nav-mobile-links .m-search .search-ico { width: 0.75em; height: 0.75em; color: var(--brass); }
  @media (min-width: 601px) { .nav-mobile-links .m-search { display: none; } }

  /* ── blog search panel ─────────────────────────────────────────────────────────────────────
     The static stand-in for GeneratePress's `?s=` modal on the live site. Same containment rule
     as `.nav-mobile`: OUTSIDE <header>, or the bar's `backdrop-filter` clips `inset: 0` to 76px.
     z-index 998 keeps it under the bar (1000) so the logo and the close button stay reachable. */
  :global(body.search-open) { overflow: hidden; }
  .nav-search {
    position: fixed; inset: 0; z-index: 998; display: flex; justify-content: center;
    align-items: flex-start; padding: clamp(4.5rem, 12vh, 8rem) 1.25rem 1.25rem;
    background: rgba(31, 59, 44, 0.42); opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  body.search-open .nav-search { opacity: 1; visibility: visible; }
  .nav-search-panel {
    width: min(760px, 100%); max-height: min(72vh, 620px); display: flex; flex-direction: column;
    background: #fff; border-radius: 1.25rem; overflow: hidden;
    box-shadow: 0 34px 80px -34px rgba(20, 38, 27, 0.6);
    transform: translateY(-10px); transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  body.search-open .nav-search-panel { transform: translateY(0); }
  .nav-search-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1rem; border-bottom: 1px solid rgba(31, 59, 44, 0.12); color: var(--color-brand-muted); }
  .nav-search-input { flex: 1 1 auto; min-width: 0; border: 0; outline: none; background: none; font-family: var(--font-body); font-size: 1.05rem; color: var(--color-brand-text); }
  .nav-search-input::placeholder { color: var(--color-brand-muted); }
  .nav-search-close { width: 36px; height: 36px; flex: 0 0 auto; display: grid; place-items: center; background: none; border: 1px solid rgba(31, 59, 44, 0.16); border-radius: 50%; color: var(--color-brand-text); cursor: pointer; transition: border-color 0.3s ease; }
  .nav-search-close:hover { border-color: var(--color-brand-primary); }
  .nav-search-close svg { width: 15px; height: 15px; }
  .nav-search-hint, .nav-search-none { margin: 0; padding: 1rem 1.15rem 1.2rem; font-size: 0.92rem; color: var(--color-brand-muted); }
  .nav-search-results { overflow-y: auto; padding: 0.35rem 0.6rem 0.7rem; }
  .nav-search-results a { display: block; padding: 0.7rem 0.6rem; border-radius: 0.7rem; text-decoration: none; transition: background 0.2s ease; }
  .nav-search-results a:hover, .nav-search-results a.is-active { background: rgba(31, 59, 44, 0.06); }
  .nsr-cat { display: block; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass); margin-bottom: 0.25rem; }
  .nsr-title { display: block; font-family: var(--font-heading); font-size: 1.08rem; line-height: 1.3; color: var(--color-brand-text); }
  .nsr-x { display: block; margin-top: 0.25rem; font-size: 0.88rem; line-height: 1.5; color: var(--color-brand-muted); }

  /* the longer CTA label costs ~35px, so the link row tightens in the band
     between the hamburger breakpoint and ~1200px rather than letting
     "About Us" / "Case Studies" wrap onto two lines.
     ⚠️ 1025–1200 is the ONLY band where the bar is at its limit: measured nav-links 527px
     against a 963px row at 1025px. The search button needs ~44 + a gap, so this band also
     shrinks it to 38px, tightens `.nav-actions` and the row gap, and pulls the nav-links
     font/gap down to 0.82rem/0.65rem — that lands nav-links at ~478px, ~27px of slack. */
  @media (min-width: 1025px) and (max-width: 1200px) {
    .site-nav-inner { gap: 1.15rem; }
    .nav-links { gap: 0.65rem; }
    .nav-links > a, .nav-drop-btn, .nav-drop-link { font-size: 0.82rem; }
    .nav-actions { gap: 0.55rem; }
    .search-btn { width: 38px; height: 38px; }
    .search-btn .search-ico { width: 17px; height: 17px; }
  }

  @media (max-width: 1024px) {
    .nav-links { display: none; }
    /* the desktop cluster is left-packed; on mobile the quote pill + hamburger
       still belong against the right edge */
    .nav-actions { margin-left: auto; }
    .menu-btn { display: flex; }
  }
</style>

<script>
  const nav = document.getElementById('siteNav');
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const btn = document.getElementById('navMenuBtn');
  const toggle = (open) => {
    if (open) setSearch(false);
    document.body.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => toggle(!document.body.classList.contains('menu-open')));
  document.querySelectorAll('#navMobile a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  document.querySelectorAll('.nav-drop-btn').forEach((b) => {
    b.addEventListener('click', (e) => { e.preventDefault(); b.closest('.nav-drop').classList.toggle('open'); });
  });

  /*
    ── blog search ─────────────────────────────────────────────────────────────────────────────

    Backed by `/search-index.json`, written at build time by `src/pages/search-index.json.ts`.
    The request is deferred until the panel is first opened — the index is ~34 KB and must never
    be on the critical path (see the note in that endpoint).

    Matches on title + category + excerpt, AND-joined so "rigid foil" narrows rather than widens.
  */
  const searchBtn = document.getElementById('navSearchBtn');
  const mobileSearchBtn = document.getElementById('navMobileSearch');
  const searchPanel = document.getElementById('navSearch');
  const searchInput = document.getElementById('navSearchInput');
  const searchClose = document.getElementById('navSearchClose');
  const searchResults = document.getElementById('navSearchResults');
  const searchHint = document.getElementById('navSearchHint');
  let index = null;
  let loading = false;
  let active = -1;

  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  function setSearch(open) {
    if (open) toggleMenuClosed();
    document.body.classList.toggle('search-open', open);
    [searchBtn, mobileSearchBtn].forEach((b) => b && b.setAttribute('aria-expanded', String(open)));
    if (!open) return;
    loadIndex();
    searchInput.focus();
  }

  // Kept separate from `toggle` so the two panels can close each other without recursing.
  function toggleMenuClosed() {
    document.body.classList.remove('menu-open');
    btn.setAttribute('aria-expanded', 'false');
  }

  function loadIndex() {
    if (index || loading) return;
    loading = true;
    fetch('/search-index.json')
      .then((r) => (r.ok ? r.json() : []))
      .then((d) => { index = d; render(); })
      .catch(() => { index = []; render(); });
  }

  function render() {
    const q = searchInput.value.trim();
    active = -1;
    if (!q) {
      searchHint.hidden = false;
      searchResults.innerHTML = '';
      return;
    }
    searchHint.hidden = true;
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    const hits = (index || [])
      .filter((p) => {
        const hay = `${p.t} ${p.c} ${p.x}`.toLowerCase();
        return terms.every((t) => hay.includes(t));
      })
      .slice(0, 12);

    if (!hits.length) {
      searchResults.innerHTML = `<p class="nav-search-none">No articles match &ldquo;${esc(q)}&rdquo;.</p>`;
      return;
    }
    searchResults.innerHTML = hits
      .map((p) => `<a href="${esc(p.u)}" target="_blank" rel="noopener"><span class="nsr-cat">${esc(p.c)}</span><span class="nsr-title">${esc(p.t)}</span><span class="nsr-x">${esc(p.x)}</span></a>`)
      .join('');
  }

  searchBtn.addEventListener('click', () => setSearch(!document.body.classList.contains('search-open')));
  mobileSearchBtn.addEventListener('click', () => setSearch(true));
  searchClose.addEventListener('click', () => setSearch(false));
  searchInput.addEventListener('input', render);
  // The backdrop closes; the panel itself must not.
  searchPanel.addEventListener('click', (e) => { if (e.target === searchPanel) setSearch(false); });

  document.addEventListener('keydown', (e) => {
    if (!document.body.classList.contains('search-open')) return;
    if (e.key === 'Escape') { setSearch(false); return; }
    const links = [...searchResults.querySelectorAll('a')];
    if (!links.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      active = Math.max(0, Math.min(links.length - 1, active + (e.key === 'ArrowDown' ? 1 : -1)));
      links.forEach((a, i) => a.classList.toggle('is-active', i === active));
      links[active].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      window.open(links[active].href, '_blank', 'noopener');
    }
  });
</script>
