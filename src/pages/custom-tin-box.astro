</Layout>

<style>
  /* ======================= THE DEVICES =======================
     — `.tn-tag`   a pill for one number, beside the copy it decides
     Row separators are absent by design: `border-top`/`border-bottom` survive
     only inside the lacquer table, the review cards, and the FAQ list. */

  main { overflow-x: clip; }
  :global(:root) { --tn-per: 3; }

  .tn-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.3;
    color: var(--color-brand-primary);
    background: rgba(176, 141, 76, 0.15);
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
  }
  .tn-tag--light { background: rgba(201, 168, 124, 0.2); color: var(--brass-soft); }
  /* On the five photographic grounds the scrim is only a tint, which is too
     thin to carry brass text at pill size. These pills stop depending on what
     is behind them: the backing goes dark enough to be its own contrast floor,
     and the text moves up to the brightest brass. */
  .tn-hero .tn-tag--light,
  .tn-mid .tn-tag--light,
  .tn-wrong .tn-tag--light,
  .tn-metal .tn-tag--light,
  .tn-final .tn-tag--light {
    background: rgba(20, 38, 27, 0.58);
    color: var(--brass-bright);
    text-shadow: 0 1px 8px rgba(20, 38, 27, 0.75);
  }
  .tn-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tn-tags--center { justify-content: center; }

  /* ---- The section heads -------------------------------------------------- */
  .tn-head { margin-bottom: clamp(2.2rem, 5vw, 3.6rem); }
  .tn-head--split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.4rem, 4vw, 3.5rem);
    align-items: end;
  }
  .tn-head--split .section-title { margin-top: 1rem; }
  .tn-head-sub { font-size: 1.04rem; line-height: 1.72; color: var(--color-brand-muted); }
  .tn-head-sub--wide { max-width: 74ch; margin-top: 1.2rem; }
  .tn-head-sub--light { color: rgba(245, 240, 229, 0.78); }
  /* Requested as pure white. There is no white in the token block, so it is
     written literally here rather than adding a site-wide token for one line. */
  .tn-wrong .tn-head-sub { color: #fff; }
  .tn-title-light { color: var(--ivory); }

  /* ============================ 1. HERO ============================
     The composed 2x2 plate runs the full width of the viewport as the
     section's own ground and the copy is centred over a flat scrim. The copy
     is three tones, not one: the eyebrow brass, the headline ivory with the
     claim in kraft, the lede a dimmer ivory, the pills kraft. */
  .tn-hero {
    position: relative;
    isolation: isolate;
    padding: calc(clamp(3.4rem, 7vw, 5.2rem) + 4.75rem) 0 clamp(4rem, 8vw, 6.2rem);
    background-color: var(--forest-deep);
    background-image: url('https://img.leelinepackage.com/tin-boxes/hero-v3.webp');
    background-size: cover;
    background-position: center 58%;
    color: var(--ivory);
    overflow: hidden;
  }
  /* The photograph is pre-darkened in the file, so the veil here is only a
     forest tint rather than a mask. That matters: a heavy flat scrim lifts
     every black toward the scrim colour and flattens the picture, whereas
     darkening the file moves the same range down with its contrast intact —
     20% more visible detail at the same average luminance. The radial keeps the
     tint densest behind the copy and almost absent at the outer thirds. */
  .tn-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(102% 100% at 50% 50%,
      rgba(20, 38, 27, 0.46) 0%,
      rgba(20, 38, 27, 0.4) 38%,
      rgba(20, 38, 27, 0.18) 72%,
      rgba(20, 38, 27, 0.1) 100%);
  }
  .tn-hero-inner { position: relative; text-align: center; }
  .tn-hero .eyebrow { color: var(--brass-bright); font-size: 0.78rem; }
  .tn-title {
    font-family: var(--font-heading);
    font-weight: 700;
    /* Sized larger than before; `max-width` is in ch, so the line count is
       unchanged and only the type grows. */
    font-size: clamp(2.2rem, 4.8vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ivory);
    text-wrap: balance;
    max-width: 24ch;
    margin: 0.9rem auto 0;
    /* The scrim is deliberately lighter than a flat wash, so the type carries
       its own protection against the mid-tones of the photograph behind it. */
    text-shadow: 0 2px 18px rgba(20, 38, 27, 0.7);
  }
  .tn-title em { font-style: italic; color: var(--brass-soft); }
  .tn-lede {
    font-size: clamp(1.06rem, 1.4vw, 1.16rem);
    line-height: 1.68;
    color: rgba(245, 240, 229, 0.78);
    max-width: 64ch;
    margin: 1.1rem auto 0;
    text-shadow: 0 1px 12px rgba(20, 38, 27, 0.72);
  }
  .tn-hero-inner .tn-tags { margin: 1.4rem auto 0; }
  .tn-hero-inner .tn-tag { font-size: 0.8rem; padding: 0.36rem 0.86rem; }
  .tn-hero-cta { margin-top: 1.6rem; }
  .tn-hero-cta .btn { font-size: 1rem; padding: 1rem 1.85rem; }

  /* ======================= 2. NINE TYPES ======================= */
  .tn-types { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .tn-sub { max-width: 74ch; }
  .tn-type-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.5rem);
  }
  .tn-type {
    display: flex;
    flex-direction: column;
    background: var(--ivory);
    border: 1px solid rgba(31, 59, 44, 0.09);
    border-radius: 1.15rem;
    padding: 0.75rem;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease;
  }
  .tn-type:hover { transform: translateY(-6px); box-shadow: 0 24px 50px -30px rgba(31, 59, 44, 0.5); }
  .tn-type-fig { position: relative; margin: 0; }
  /* slightly wider than tall: the square was reading too long. 0.968 of the
     width works out at roughly the 0.3 cm the client asked off the height at
     this card's width, and it holds the same proportion as the grid reflows. */
  .tn-type-fig img { width: 100%; aspect-ratio: 100 / 96.8; object-fit: cover; border-radius: 0.7rem; }
  .tn-type-code {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ivory);
    background: rgba(20, 38, 27, 0.72);
    border-radius: 999px;
    padding: 0.24rem 0.6rem;
  }
  .tn-type-body { padding: 1.15rem 0.55rem 0.7rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; flex: 1; }
  .tn-type-body h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.22rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
  }
  .tn-type-body p { font-size: 0.94rem; line-height: 1.66; color: var(--color-brand-muted); }

  /* ======================= 3. WHY CHOOSE A TIN BOX ======================= */
  .tn-why { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--ivory); }
  .tn-why-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.6rem);
  }
  .tn-why-grid li { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; }
  .tn-why-head { display: flex; align-items: center; gap: 0.8rem; }
  /* A solid brass disc, the same treatment the carousel arrows use, so the mark
     carries colour rather than sitting as a faint tint. */
  .tn-why-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--brass-bright);
    color: var(--forest-deep);
    box-shadow: 0 8px 18px -10px rgba(31, 59, 44, 0.55);
  }
  .tn-why-grid h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
  }
  .tn-why-grid p { font-size: 0.93rem; line-height: 1.68; color: var(--color-brand-muted); }

  /* ======================= 5. THE FIVE TIN LID TYPES =======================
     Five stacked rows, not five columns: at 1200 px a column of this much copy
     is about 200 px wide and reads cramped. A row gives each lid the whole
     measure and lets the slot, the name and the paragraph sit side by side. */
  .tn-lid { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .tn-lid-list { list-style: none; display: flex; flex-direction: column; }
  .tn-lid-list li {
    display: grid;
    grid-template-columns: 3rem 13rem minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    align-items: center;
    padding: clamp(1.2rem, 2.4vw, 1.8rem) 0;
    border-top: 1px solid rgba(31, 59, 44, 0.14);
  }
  .tn-lid-list li:first-child { border-top-color: rgba(176, 141, 76, 0.6); }
  .tn-lid-n {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--brass);
  }
  /* The photograph only. The shots are all open tins, so there is no closing
     frame to animate between — see the note on `lids` above. The frame is 6:5,
     which is the ratio the encoder cuts them to, so nothing is cropped here. */
  .tn-lid-fig { aspect-ratio: 6 / 5; }
  .tn-lid-open {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tn-lid-body {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }
  .tn-lid-lead { display: flex; flex-direction: column; gap: 0.45rem; }
  .tn-lid-list h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--color-brand-text);
  }
  .tn-lid-best {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--brass);
  }
  .tn-lid-best span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    margin-bottom: 0.25rem;
  }
  .tn-lid-d { font-size: 0.95rem; line-height: 1.7; color: var(--color-brand-muted); }
  /* the injected <strong> has to be reached through :global() */
  .tn-lid-d :global(strong) { font-weight: 600; color: var(--color-brand-text); }

  /* ===================== 4. MID CTA =====================
     Same construction as the hero: the file is pre-darkened, so the scrim is a
     forest tint that fades to almost nothing at the corners and the photograph
     keeps its own contrast underneath the copy. */
  .tn-mid {
    position: relative;
    background-color: var(--forest-deep);
    background-image:
      radial-gradient(98% 106% at 50% 50%,
        rgba(20, 38, 27, 0.46) 0%,
        rgba(20, 38, 27, 0.4) 40%,
        rgba(20, 38, 27, 0.16) 74%,
        rgba(20, 38, 27, 0.08) 100%),
      url('https://img.leelinepackage.com/tin-boxes/mid-cta-bg-v2.webp');
    background-size: cover, cover;
    background-position: center, center;
    padding: clamp(3rem, 6vw, 4.2rem) 0;
    color: var(--ivory);
  }
  .tn-mid::before, .tn-mid::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brass), transparent);
  }
  .tn-mid::before { top: 0; }
  .tn-mid::after { bottom: 0; }
  .tn-mid-inner { text-align: center; }
  .tn-mid .eyebrow { color: var(--brass-bright); }
  .tn-mid-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ivory);
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(20, 38, 27, 0.72);
    max-width: 24ch;
    margin: 1rem auto 0;
  }
  .tn-mid-lede {
    font-size: 1.04rem;
    line-height: 1.72;
    color: rgba(245, 240, 229, 0.8);
    text-shadow: 0 1px 12px rgba(20, 38, 27, 0.75);
    max-width: 62ch;
    margin: 1.2rem auto 1.9rem;
  }

  /* ============ 6. WHAT GOES WRONG — risk, action, gain ============
     The inspection-line photograph is pre-darkened in the file, so this is a
     forest tint over it rather than a mask: the conveyor, the pink tins and the
     operator all stay readable. The cards are dark solids, so they never
     depended on the scrim, and the section head carries its own text shadow. */
  .tn-wrong {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background-color: var(--forest-deep);
    background-image:
      linear-gradient(180deg,
        rgba(20, 38, 27, 0.46) 0%,
        rgba(20, 38, 27, 0.34) 46%,
        rgba(20, 38, 27, 0.48) 100%),
      url('https://img.leelinepackage.com/tin-boxes/wrong-bg-v2.webp');
    background-size: cover, cover;
    background-position: center, center 40%;
    color: var(--ivory);
  }
  .tn-wrong .tn-head { text-shadow: 0 1px 14px rgba(20, 38, 27, 0.8); }
  .tn-risk-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.6rem);
  }
  .tn-risk {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.78rem;
    background: rgba(20, 38, 27, 0.72);
    border: 1px solid rgba(245, 240, 229, 0.16);
    border-radius: 1.2rem;
    padding: clamp(1.35rem, 2.5vw, 1.85rem);
    overflow: hidden;
  }
  .tn-risk-n {
    position: absolute;
    top: 0.15rem;
    right: 0.95rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 4.4rem;
    line-height: 1;
    color: rgba(201, 168, 124, 0.16);
    pointer-events: none;
  }
  .tn-risk-issue,
  .tn-risk-gain { position: relative; font-size: 0.93rem; line-height: 1.7; }
  .tn-risk-issue { color: rgba(245, 240, 229, 0.6); }
  .tn-risk-gain { color: var(--brass-soft); }
  .tn-risk-issue span,
  .tn-risk-gain span {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
  .tn-risk-issue span { color: rgba(245, 240, 229, 0.42); }
  .tn-risk-gain span { color: var(--brass-bright); }
  .tn-risk h3 {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: var(--ivory);
    text-wrap: balance;
  }
  .tn-risk .tn-tag { margin-top: auto; }

  /* ===================== 7. FOOD-GRADE LININGS =====================
     The table sits in a panel at the head's own measure, so it is centred with
     the section rather than floating wide, and the header row is tinted. */
  .tn-food { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .tn-food-notes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.5vw, 2rem);
    margin-bottom: clamp(2.6rem, 5vw, 4rem);
  }
  .tn-food-notes li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    height: 100%;
    background: var(--ivory);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-top: 2px solid var(--brass);
    border-radius: 0 0 1rem 1rem;
    padding: clamp(1.1rem, 2vw, 1.5rem);
  }
  .tn-food-notes p { font-size: 0.95rem; line-height: 1.65; color: var(--color-brand-muted); }
  /* the key points are FILLED with the brand green, not tinted */
  .tn-food-notes .tn-tag {
    background: var(--color-forest);
    color: var(--ivory);
    padding: 0.42rem 0.95rem;
  }

  .tn-liner-panel {
    background: var(--ivory);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.3rem;
    padding: clamp(1.4rem, 3vw, 2.4rem);
    box-shadow: 0 26px 60px -42px rgba(31, 59, 44, 0.55);
  }
  .tn-liner-head { margin-bottom: 1.4rem; }
  .tn-liner-head h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    letter-spacing: -0.01em;
    color: var(--color-brand-primary);
    margin-bottom: 0.5rem;
  }
  .tn-liner-head p { font-size: 0.98rem; line-height: 1.7; color: var(--color-brand-muted); max-width: 74ch; }
  .tn-liner-head strong { font-weight: 600; color: var(--color-forest); }
  /* the two rows that actually change the answer carry the green */
  .tn-liner-table tbody tr.tn-liner-key th { color: var(--color-forest); }
  .tn-liner-table tbody tr.tn-liner-key th::before {
    content: '';
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--brass-bright);
    vertical-align: middle;
  }
  .tn-liner-table { width: 100%; border-collapse: collapse; }
  .tn-liner-table thead th {
    text-align: left;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ivory);
    padding: 0.9rem 1.4rem;
    background: var(--color-forest);
  }
  .tn-liner-table thead th:first-child { padding-left: 1rem; border-radius: 0.5rem 0 0 0.5rem; }
  .tn-liner-table thead th:last-child { border-radius: 0 0.5rem 0.5rem 0; padding-right: 0.9rem; }
  .tn-liner-table tbody th {
    text-align: left;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.06rem;
    color: var(--color-brand-primary);
    padding: 1.15rem 1.4rem 1.15rem 0;
    vertical-align: top;
    border-bottom: 1px solid rgba(31, 59, 44, 0.12);
    white-space: nowrap;
  }
  .tn-liner-table tbody tr:nth-child(even) th,
  .tn-liner-table tbody tr:nth-child(even) td { background: rgba(31, 59, 44, 0.05); }
  .tn-liner-table tbody td {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
    padding: 1.1rem 1.4rem 1.1rem 0;
    vertical-align: top;
    border-bottom: 1px solid rgba(31, 59, 44, 0.1);
  }
  .tn-liner-table tbody tr:last-child th, .tn-liner-table tbody tr:last-child td { border-bottom: 0; }
  .tn-liner-table tbody td:last-child, .tn-liner-table thead th:last-child { padding-right: 0; }

  /* ======================= 9. HOW WE PRINT ON TINPLATE ======================= */
  .tn-print { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--ivory); }
  /* The arrows sit in a gutter either side; the strip itself clips at the
     content edge, or the next slide bleeds into the gutter as a cut-off sliver. */
  .tn-fin-car { position: relative; padding: 0 clamp(3.4rem, 6vw, 5rem); }
  .tn-fin-clip { overflow: hidden; }
  .tn-fin-track {
    list-style: none;
    display: flex;
    margin: 0;
    padding: 0;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .tn-fin-slide { flex: 0 0 100%; }
  .tn-fin-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.6rem, 4vw, 3.4rem);
    align-items: center;
    max-width: 68rem;
    margin-inline: auto;
  }
  .tn-fin-body h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    letter-spacing: -0.02em;
    color: var(--color-brand-text);
    margin-bottom: 0.7rem;
  }
  .tn-fin-body p { font-size: 1rem; line-height: 1.72; color: var(--color-brand-muted); margin-bottom: 1.1rem; }
  .tn-fin-fig {
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: 1.2rem;
    border: 1px solid rgba(176, 141, 76, 0.34);
  }
  .tn-fin-fig img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ======================= 8. STRUCTURE ======================= */
  .tn-struct {
    position: relative;
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: linear-gradient(180deg, var(--color-forest), var(--forest-deep));
    color: var(--ivory);
  }
  .tn-struct::before, .tn-struct::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brass), transparent);
  }
  .tn-struct::before { top: 0; }
  .tn-struct::after { bottom: 0; }
  .tn-struct-head { text-align: center; max-width: 62rem; margin: 0 auto clamp(2.6rem, 5vw, 3.8rem); }
  .tn-struct-head .eyebrow { color: var(--brass-soft); }
  .tn-struct-title {
    position: relative;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ivory);
    margin: 1rem 0 0;
    padding-bottom: 1.1rem;
  }
  .tn-struct-title::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 3.6rem;
    height: 2px;
    background: var(--brass-bright);
  }
  .tn-struct-sub {
    font-size: 1.02rem;
    line-height: 1.72;
    color: rgba(245, 240, 229, 0.74);
    max-width: 62ch;
    margin: 1.2rem auto 0;
  }
  .tn-struct-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2.4rem);
  }
  .tn-struct-grid li { display: flex; flex-direction: column; align-items: center; gap: 0.85rem; }
  .tn-struct-icon { width: 5rem; height: auto; transition: filter 0.35s ease; }
  .tn-struct-grid li:hover .tn-struct-icon {
    filter: drop-shadow(0 0 7px rgba(228, 181, 77, 0.6)) brightness(1.12);
  }
  .tn-struct-specs { margin-top: clamp(2rem, 4vw, 2.8rem); }
  .tn-struct-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.25;
    text-align: center;
    color: var(--ivory);
  }

  /* ===================== 10. TIN ORDER LEAD TIME =====================
     The one place a rule is the content: it is the timeline itself. Each stop
     now carries a brass mark beside its name. */
  .tn-flow { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--ivory); }
  .tn-flow-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 1.8rem);
    position: relative;
  }
  .tn-flow-list::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--brass), rgba(176, 141, 76, 0.25));
  }
  .tn-flow-list li { position: relative; padding-top: 2rem; }
  .tn-flow-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--ivory);
    border: 2px solid var(--brass);
  }
  .tn-flow-when {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.7rem;
  }
  .tn-flow-list h3 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--color-brand-text);
    margin-bottom: 0.55rem;
  }
  .tn-flow-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgba(176, 141, 76, 0.16);
    color: var(--brass);
  }
  .tn-flow-list p { font-size: 0.92rem; line-height: 1.66; color: var(--color-brand-muted); }

  /* ============ 11. RECYCLING AND SUSTAINABILITY ============
     Pre-darkened in the file, tinted here. Their card copy is ivory, so the
     cards are dark solids rather than light-translucent, and the section head
     carries a text shadow — which is what lets the tint stay this thin. */
  .tn-metal {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background-color: var(--forest-deep);
    background-image:
      linear-gradient(180deg,
        rgba(20, 38, 27, 0.46) 0%,
        rgba(20, 38, 27, 0.36) 48%,
        rgba(20, 38, 27, 0.48) 100%),
      url('https://img.leelinepackage.com/tin-boxes/recyc-bg-v2.webp');
    background-size: cover, cover;
    background-position: center, center;
    color: var(--ivory);
  }
  .tn-metal .tn-head { text-shadow: 0 1px 14px rgba(20, 38, 27, 0.8); }
  .tn-metal .eyebrow { color: var(--brass-soft); }
  .tn-metal .tn-tags { margin: 0 0 clamp(1.8rem, 3.5vw, 2.6rem); }
  .tn-metal-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.5rem);
  }
  .tn-metal-grid li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1.2rem;
    padding: clamp(1.3rem, 2.4vw, 1.8rem);
    background: rgba(20, 38, 27, 0.62);
    border: 1px solid rgba(245, 240, 229, 0.17);
    border-radius: 1.15rem;
  }
  .tn-metal-n {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1.1;
    color: var(--brass-bright);
    grid-row: span 2;
  }
  .tn-metal-grid h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.12rem;
    color: var(--ivory);
    margin-bottom: 0.4rem;
  }
  .tn-metal-grid p { font-size: 0.93rem; line-height: 1.7; color: rgba(245, 240, 229, 0.76); }

  /* ============ 12. CUSTOMER SCENES — 6 slides, 3 to a view ============
     The loop needs clones on both ends, and the clone count has to equal the
     slides-per-view or the wrap shows a gap — `--tn-per` is read by the script
     and re-defined at each breakpoint. */
  .tn-scenes { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--ivory); }
  .tn-scenes .section-head { margin-bottom: clamp(1.8rem, 3.5vw, 2.6rem); }
  /* The strip is clipped to the wrap, and the two arrows sit ON the outermost
     images rather than in a gutter beside them. */
  .tn-car { position: relative; overflow: hidden; }
  .tn-car-track {
    list-style: none;
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.4rem);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .tn-car-slide { flex: 0 0 calc((100% - (var(--tn-per) - 1) * clamp(0.9rem, 2vw, 1.4rem)) / var(--tn-per)); }
  .tn-car-fig {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.2rem;
    border: 1px solid rgba(176, 141, 76, 0.34);
  }
  .tn-car-fig img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tn-car-btn,
  .tn-fin-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: 2px solid rgba(245, 240, 229, 0.85);
    background: var(--brass-bright);
    color: var(--forest-deep);
    cursor: pointer;
    box-shadow: 0 12px 30px -12px rgba(20, 38, 27, 0.6);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease;
  }
  .tn-car-btn svg,
  .tn-fin-btn svg { width: 1.5rem; height: 1.5rem; }
  .tn-car-btn:hover,
  .tn-fin-btn:hover { background: #EFC45A; }
  .tn-car-btn--prev,
  .tn-fin-btn--prev { left: 1rem; }
  .tn-fin-car .tn-fin-btn--prev { left: 0; }
  .tn-fin-car .tn-fin-btn--next { right: 0; }
  .tn-car-btn--next,
  .tn-fin-btn--next { right: 1rem; }
  .tn-car-btn--prev:hover,
  .tn-fin-btn--prev:hover { transform: translateY(-50%) translateX(-3px); }
  .tn-car-btn--next:hover,
  .tn-fin-btn--next:hover { transform: translateY(-50%) translateX(3px); }
  .tn-car-btn:focus-visible,
  .tn-fin-btn:focus-visible { outline: 3px solid var(--ivory); outline-offset: 3px; }

  /* ============ 13. CUSTOMER REVIEWS — two cards, side by side ============ */
  .tn-quotes { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .tn-quote-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.6rem);
  }
  .tn-quote {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: var(--ivory);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 2.8vw, 2.2rem);
  }
  .tn-quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 3.4rem;
    line-height: 0.5;
    color: rgba(176, 141, 76, 0.6);
  }
  .tn-quote-mark--end { text-align: right; margin-top: -0.4rem; }
  .tn-quote p {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: 1.06rem;
    line-height: 1.76;
    color: var(--color-brand-text);
  }
  .tn-quote footer {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: auto;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(31, 59, 44, 0.14);
  }
  .tn-quote-ava {
    width: 5.2rem;
    height: 5.2rem;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--brass-soft);
  }
  .tn-quote-who { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.88rem; color: var(--color-brand-muted); }
  .tn-quote-who strong {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.06rem;
    letter-spacing: 0.01em;
    color: var(--color-brand-text);
  }

  /* ============ 14. FAQ — one column of plain cards ============ */
  .tn-faq { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--ivory); }
  .tn-faq-list { display: flex; flex-direction: column; gap: 0.9rem; max-width: 60rem; margin-inline: auto; }
  .tn-faq-list details {
    background: var(--color-clay);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.1rem;
    padding: 1.35rem 1.6rem;
  }
  /* The number and the question read left to right inside the card; the card
     itself stays on the centred column, so the block is centred and the text
     in it is not. */
  .tn-faq-list summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.35;
    color: var(--color-brand-text);
  }
  .tn-faq-list summary::-webkit-details-marker { display: none; }
  .tn-faq-n {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--brass);
  }
  .tn-faq-ico { position: relative; flex: 0 0 auto; width: 1rem; height: 1rem; }
  .tn-faq-ico::before, .tn-faq-ico::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: var(--brass);
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition: opacity 0.25s ease;
  }
  .tn-faq-ico::before { width: 1rem; height: 2px; }
  .tn-faq-ico::after { width: 2px; height: 1rem; }
  .tn-faq-list details[open] .tn-faq-ico::after { opacity: 0; }
  /* Indented to the question's own text edge (2.2rem column + 1.1rem gap), so
     the answer blocks under the line it answers rather than under the number. */
  .tn-faq-a { padding-left: 3.3rem; }
  .tn-faq-a p {
    font-size: 0.97rem;
    line-height: 1.75;
    color: var(--color-brand-muted);
    margin-top: 0.95rem;
    max-width: 82ch;
  }

  /* =========================== 15. FINAL CTA ===========================
     Pre-darkened in the file and tinted here, so the line-up of printed tins
     stays readable behind the copy. The radial keeps the tint off the outer
     thirds, and the title carries a shadow of its own. */
  .tn-final {
    /* 0.5cm off each side = the 1cm shorter band the client asked for. */
    padding: calc(clamp(4rem, 9vw, 7rem) - 0.5cm) 0;
    background-color: var(--forest-deep);
    background-image:
      radial-gradient(96% 106% at 50% 52%,
        rgba(20, 38, 27, 0.48) 0%,
        rgba(20, 38, 27, 0.4) 40%,
        rgba(20, 38, 27, 0.2) 74%,
        rgba(20, 38, 27, 0.1) 100%),
      url('https://img.leelinepackage.com/tin-boxes/final-cta-bg-v2.webp');
    background-size: cover, cover;
    background-position: center, center 62%;
    color: var(--ivory);
  }
  .tn-final-inner { text-align: center; }
  .tn-final .eyebrow { color: var(--brass-soft); }
  .tn-final-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.9rem, 4.4vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ivory);
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(20, 38, 27, 0.7);
    max-width: 24ch;
    margin: 1rem auto 0;
  }
  .tn-final-lede {
    font-size: 1.04rem;
    line-height: 1.75;
    color: rgba(245, 240, 229, 0.78);
    max-width: 64ch;
    margin: 1.2rem auto 1.5rem;
  }
  .tn-final .tn-tags { margin-bottom: 1.9rem; }

  /* ============================ REVEAL ============================ */
  [data-reveal] {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0s);
  }
  [data-reveal].in { opacity: 1; transform: none; }

  /* =========================== RESPONSIVE =========================== */
  @media (max-width: 1100px) {
    .tn-why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tn-metal-grid { grid-template-columns: minmax(0, 1fr); }
    .tn-struct-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .tn-lid-list li { grid-template-columns: 3rem 11rem minmax(0, 1fr); }
    .tn-lid-body { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }
  @media (max-width: 1024px) {
    .tn-type-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tn-flow-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tn-flow-list::before { display: none; }
    :global(:root) { --tn-per: 2; }
  }
  @media (max-width: 900px) {
    .tn-head--split { grid-template-columns: minmax(0, 1fr); gap: 1.1rem; align-items: start; }
    .tn-food-notes { grid-template-columns: minmax(0, 1fr); }
    .tn-risk-grid { grid-template-columns: minmax(0, 1fr); }
    .tn-quote-grid { grid-template-columns: minmax(0, 1fr); }
    .tn-fin-panel { grid-template-columns: minmax(0, 1fr); }
    .tn-struct-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .tn-type-grid { grid-template-columns: minmax(0, 1fr); }
    .tn-flow-list { grid-template-columns: minmax(0, 1fr); }
    .tn-why-grid { grid-template-columns: minmax(0, 1fr); }
    .tn-struct-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tn-struct-icon { width: 4rem; }
    .tn-title { max-width: none; }
    :global(:root) { --tn-per: 1; }
    .tn-car-btn { width: 2.6rem; height: 2.6rem; }
    .tn-car-btn--prev { left: 0.5rem; }
    .tn-car-btn--next { right: 0.5rem; }
    .tn-fin-car { padding: 0 2.9rem; }
    .tn-fin-btn { width: 2.6rem; height: 2.6rem; }
    .tn-fin-btn svg { width: 1.2rem; height: 1.2rem; }
    .tn-car-btn svg { width: 1.2rem; height: 1.2rem; }
    .tn-lid-list li { grid-template-columns: 2.6rem minmax(0, 1fr); }
    .tn-lid-fig { max-width: 13rem; }
    /* The answer's indent is tied to the number column, so both shrink
       together or the answer stops lining up under the question. */
    .tn-faq-list summary { grid-template-columns: 1.8rem minmax(0, 1fr) auto; gap: 0.7rem; }
    .tn-faq-a { padding-left: 2.5rem; }

    /* The one table restacks into labelled rows rather than scrolling
       sideways. The cells need an explicit `display: block` — a `td` left at
       its default `table-cell` inside a `display:block` row is wrapped in an
       ANONYMOUS table and the cells line up side by side again, which is
       exactly the layout the restack was meant to remove. */
    .tn-liner-panel { padding: 1.2rem; }
    .tn-liner-table thead { display: none; }
    .tn-liner-table, .tn-liner-table tbody, .tn-liner-table tbody tr { display: block; }
    .tn-liner-table tbody tr { border-top: 1px solid rgba(31, 59, 44, 0.16); padding: 1.1rem 0; }
    .tn-liner-table tbody tr:first-child { border-top: 0; padding-top: 0; }
    .tn-liner-table tbody th, .tn-liner-table tbody td { display: block; }
    .tn-liner-table tbody th {
      padding: 0 0 0.6rem;
      border-bottom: 0;
      font-family: var(--font-heading);
      font-size: 1.08rem;
    }
    .tn-liner-table tbody td { padding: 0.35rem 0 0; border-bottom: 0; }
    .tn-liner-table tbody td::before {
      content: attr(data-l);
      display: block;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--brass);
      margin-bottom: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .tn-car-track { transition: none; }
  }
</style>

<script>
  // Reveal on scroll.
  const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ('IntersectionObserver' in window && !reduce) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Two looping strips: §How We Print on Tinplate (one panel to a view) and
  // §Customer Scenes (three to a view). A copy of the last N slides sits before
  // slide one and a copy of the first N after the last, so stepping past either
  // end animates onto a clone and is then snapped — with no transition — onto
  // the matching real slide. N must equal the slides-per-view, or the wrap shows
  // a gap; `--tn-per` carries that number and is re-defined at each breakpoint.
  function loopStrip(trackSel, prevSel, nextSel, perVar) {
    const track = document.querySelector(trackSel);
    if (!track) return;
    const real = Array.from(track.children);
    const total = real.length;
    const per = perVar
      ? (Number(getComputedStyle(document.documentElement).getPropertyValue(perVar)) || 1)
      : 1;
    if (total <= per) return;

    for (let k = 0; k < per; k++) {
      const a = real[total - per + k].cloneNode(true);
      a.setAttribute('aria-hidden', 'true');
      track.insertBefore(a, track.firstChild);
      const b = real[k].cloneNode(true);
      b.setAttribute('aria-hidden', 'true');
      track.appendChild(b);
    }

    let idx = per;
    let busy = false;
    let timer = null;
    const step = () => {
      const first = track.children[0];
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.getBoundingClientRect().width + gap;
    };
    const place = (animate) => {
      track.style.transition = animate ? 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
      track.style.transform = `translateX(${-idx * step()}px)`;
    };
    // `transitionend` is the signal for the snap, but a timer backs it up: if the
    // event is ever missed the strip wedges with `busy` stuck on and every later
    // click is ignored.
    const settle = () => {
      clearTimeout(timer);
      timer = null;
      if (!busy) return;
      busy = false;
      if (idx >= total + per) { idx -= total; place(false); }
      if (idx < per) { idx += total; place(false); }
    };
    const go = (dir) => {
      if (busy) return;
      busy = true;
      idx += dir;
      place(true);
      clearTimeout(timer);
      timer = setTimeout(settle, 750);
    };
    track.addEventListener('transitionend', (e) => {
      if (e.target === track && e.propertyName === 'transform') settle();
    });
    const prevBtn = document.querySelector(prevSel);
    const nextBtn = document.querySelector(nextSel);
    if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => go(1));
    window.addEventListener('resize', () => place(false));
    place(false);
  }

  if (!reduce) {
    loopStrip('.tn-car-track', '.tn-car-btn--prev', '.tn-car-btn--next', '--tn-per');
    loopStrip('.tn-fin-track', '.tn-fin-btn--prev', '.tn-fin-btn--next', null);
  }

  // One answer open at a time.
  const faqItems = Array.from(document.querySelectorAll('.tn-faq-list details'));
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      faqItems.forEach((o) => { if (o !== d) o.open = false; });
    });
  });
</script>
