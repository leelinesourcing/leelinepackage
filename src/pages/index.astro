];

const KEYWORDS = 'custom packaging manufacturers, custom printed packaging manufacturers, custom eco-friendly packaging manufacturers, custom rigid box manufacturers, custom cosmetic packaging manufacturers, custom jewelry packaging manufacturers';

const seoJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'LeelinePackage',
  url: 'https://www.leelinepackage.com/',
  description: 'Custom packaging manufacturer in China — corrugated mailers, rigid gift boxes, folding cartons, pouches, labels & more. Factory-direct, MOQ from 500.',
  foundingDate: '2015',
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressCountry: 'CN' },
  /*
    `logo` as a typed ImageObject, to match what the old WordPress site published (Rank Math
    emitted an `ImageObject` at `#logo` with a caption). Google reads Organization.logo from the
    homepage for the brand entity, which is why it is added here and not on all 28 pages that
    carry their own inline Organization node.

    ⚠️ Google asks for a logo at least 112 px tall; this file is 500x100, so it is 12 px short.
    Pre-existing, and the old site's 150x100 crop was short too.
  */
  logo: {
    '@type': 'ImageObject',
    '@id': 'https://www.leelinepackage.com/#logo',
    url: IMG.logo,
    contentUrl: IMG.logo,
    caption: 'LeelinePackage',
  },
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Printed Packaging' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Eco-Friendly Packaging' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Rigid Boxes' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Cosmetic Packaging' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom Jewelry Packaging' } },
  ],
});

/*
  ⚠️ NO `aggregateRating` in the block above. It used to declare `ratingValue: 4.9,
  reviewCount: 320`, which is a Google structured-data violation: a self-serving rating is only
  valid when the reviews behind it exist on the page, and this site has no review system. The count
  also disagreed with itself across pages (320 here, on the sampling page and the structural page;
  210 on the artwork page) and no `Review` node was ever emitted. Removed rather than left in
  place — do not reinstate it without real, visible reviews backing the figure.
*/
---

<Layout
  title="Custom Packaging Manufacturer: MOQ 500, 5-Day Samples & ISO"
  description="Custom packaging manufacturer in China. Custom boxes, rigid mailers & pouches. MOQ 500 — free 3D mockups, 5-day samples, FSC & ISO 9001. Get a free quote today."
  keywords={KEYWORDS}
  canonical="https://www.leelinepackage.com/"
  ogImage="https://img.leelinepackage.com/rigid-box.webp"
  preloadImage={IMG.hero1440}
  preloadImageSrcset={`${IMG.hero480} 480w, ${IMG.hero960} 960w, ${IMG.hero1440} 1440w`}
  preloadImageSizes="(min-width: 1025px) 1440px, (min-width: 641px) 960px, 480px"
  jsonLd={seoJsonLd}
>
  <style is:global>
    :root {
      --color-brand-primary:   #1F3B2C;
      --color-brand-secondary: #C9A87C;
      --color-brand-accent:    #B08D4C;
      --color-brand-bg:        #F5F0E5;
      --color-brand-surface:   #EDE5D4;
      --color-brand-text:      #2B2F26;
      --color-brand-muted:     #605C4E;
      --font-heading: 'Newsreader Variable', Georgia, serif;
      --font-body:    'Instrument Sans Variable', system-ui, sans-serif;
      --forest-deep: #14261B;
      --forest-light: #2E4F3D;
      --brass: #B08D4C;
      --brass-bright: #E4B54D;
      --brass-soft: #C9A87C;
      --ivory: #F5F0E5;
      --kraft: #EDE5D4;
    }

    html { scroll-behavior: smooth; }
    body { overflow-x: hidden; }

    ::selection { background: var(--brass-soft); color: var(--forest-deep); }

    /* Scroll-reveal (kept global so ancestors like html/body aren't scoped away).
       :where() zeroes the inner selector's specificity so hover transforms still win. */
    html.js :where([data-reveal]) {
      opacity: 0;
      transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.9s ease, clip-path 0.9s ease;
      transition-delay: var(--d, 0s);
    }
    html.js :where([data-reveal="up"]) { transform: translateY(36px); }
    html.js :where([data-reveal="left"]) { transform: translateX(-48px); }
    html.js :where([data-reveal="right"]) { transform: translateX(48px); }
