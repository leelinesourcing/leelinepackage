  /* ============ PROCESS — a centred stepper on one rail ============ */
  .fx-flow { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; content-visibility: auto; contain-intrinsic-size: auto 800px; }
  /* the head is not boxed into the narrow centred column any more, and the sub
