    .mb-tm-prev { left: calc(50% - 3.4rem); }
    .mb-tm-next { right: calc(50% - 3.4rem); }
    /* one label at a time on the top border: the stars centre, the tag steps aside */
    .mb-tm-tag { display: none; }
    .mb-tm-bubble::after { right: calc(50% - 16px); }
    .mb-tm-rank { right: calc(50% - 65px); }
    .mb-tm-person { flex-direction: column; margin-top: 30px; }
    .mb-tm-ava { width: 88px; margin: 0 0 0.7rem; }
    .mb-tm-ava img { width: 88px; height: 88px; }
    .mb-tm-mark--a { top: 28px; left: -10px; }
    .mb-tm-mark--b { top: 64px; right: 3px; }
