---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const BAG = `${R2}/custom-bag`;

/* Why a brand picks us — five outcomes, no repeated claims. */
const why = [
  { n: '01', t: 'In-house design & R&D', d: 'A rough sketch becomes a runnable sample in-house — no separate design bill.' },
  { n: '02', t: 'Small runs, low risk', d: 'Order for the moment it is needed, then scale up only once the demand is proven.' },
  { n: '03', t: 'Shipping that bends', d: 'Air, sea or DDP express — routed to the lowest landed cost for the market.' },
  { n: '04', t: 'Materials with a footprint', d: 'Recycled, renewable and FSC\u00ae-certified, so the label backs the claim.' },
  { n: '05', t: 'Certified & documented', d: 'ISO 9001 from the floor to the last QC check, with proof at each handoff.' },
];

/* The 9 bag types. */
const types = [
  { name: 'Custom Tote Bags', d: 'The everyday bag people reach for, trip after trip.', img: `${BAG}/bt-tote.webp`, w: 800, h: 800, alt: 'A printed canvas tote bag on a wooden bench' },
  { name: 'Custom Reusable Shopping Bags', d: 'Replace single-use plastic with a bag that earns its keep.', img: `${BAG}/bt-reusable.webp`, w: 1000, h: 1000, alt: 'A row of reusable shopping bags with printed logos' },
  { name: 'Custom Paper Bag', d: 'Sturdy kraft or white \u2014 the classic carry for shops and events.', img: `${BAG}/bt-paper.webp`, w: 600, h: 600, alt: 'A kraft paper bag printed with a brand mark' },
  { name: 'Custom Satin Bags', d: 'A drawstring pouch with a soft, polished shine.', img: `${BAG}/bt-satin.webp`, w: 1000, h: 794, alt: 'Satin drawstring pouches with a soft sheen' },
  { name: 'Custom Velvet Bags', d: 'Deep, tactile velvet for jewellery and small keepsakes.', img: `${BAG}/bt-velvet.webp`, w: 1000, h: 1000, alt: 'Velvet drawstring pouches in rich colours' },
  { name: 'Custom Dust Bags', d: 'A soft cover that keeps accessories clean between wears.', img: `${BAG}/bt-dust.webp`, w: 1000, h: 1000, alt: 'Cotton dust bags with a printed mark' },
  { name: 'Eco-Friendly Jute Bags', d: 'A natural, compostable tote with a rustic texture.', img: `${BAG}/bt-jute.webp`, w: 1000, h: 1000, alt: 'A natural jute tote bag with a printed logo' },
  { name: 'Custom Mesh Bags', d: 'Light and see-through, for produce, swimwear and small goods.', img: `${BAG}/bt-mesh.webp`, w: 612, h: 612, alt: 'A mesh drawstring bag' },
  { name: 'PVC Packaging Bags', d: 'Clear pouches that put the product on display.', img: `${BAG}/bt-pvc.webp`, w: 750, h: 750, alt: 'A clear PVC pouch with printed accents' },
];

/* Capability band — what a real manufacturer does. */
const capability = [
  { n: '01', t: 'China Bag Factory', d: 'Launch a bag line without owning a factory \u2014 each construction method sits with one supplier.' },
  { n: '02', t: 'OEM & ODM Bags', d: 'Your logo on a finished, shelf-ready bag \u2014 art, print and hardware set up and ready to run.' },
  { n: '03', t: 'Design & Innovation', d: 'Stay a step ahead of what\u2019s in demand — 30% of our profit goes back into new processes yearly.' },
  { n: '04', t: 'Private Label Bags', d: 'Pick from 6,000+ styles and make one the brand\u2019s own \u2014 tags, hardware and finishing to match.' },
];

/* Materials. */
/* The 5 customisation categories, each with its options and a sample — a tabbed "compare".
   Folds the former Materials + Customisation sections into one. */
const compare = [
  { tab: 'Material',
    desc: 'The fabric decides how a bag feels, how long it lasts and the story it tells. Cotton brings a soft premium hand-feel, canvas adds durability, nylon and polyester shrug off the weather, and jute and recycled fibre carry a natural, compostable story.',
    options: [
      { name: 'Organic cotton', img: `${BAG}/opt-material-cotton.webp`, w: 800, h: 800 },
      { name: 'Heavy-duty canvas', img: `${BAG}/opt-material-canvas.webp`, w: 900, h: 900 },
      { name: 'Waterproof nylon & polyester', img: `${BAG}/opt-material-nylon.webp`, w: 900, h: 900 },
      { name: 'Recycled & jute', img: `${BAG}/opt-material-jute.webp`, w: 900, h: 818 },
    ] },
  { tab: 'Size & Shape',
    desc: 'Shape decides how a bag packs and carries, and size decides what it holds. A flat bag folds flat to save freight, a gusset adds depth for bulky goods, and the small-to-large range matches the product to the channel.',
    options: [
      { name: 'Flat', img: `${BAG}/opt-size-flat.webp`, w: 900, h: 900 },
      { name: 'Gusseted', img: `${BAG}/opt-size-gusset.webp`, w: 800, h: 600 },
      { name: 'Small', img: `${BAG}/opt-size-small.webp`, w: 900, h: 675 },
      { name: 'Large', img: `${BAG}/opt-size-large.webp`, w: 717, h: 427 },
    ] },
  { tab: 'Printing',
    desc: 'A logo either carries a brand or does nothing. Choose the method that suits the artwork and the board \u2014 screen print for flat colour, embroidery for a tactile mark, embossing for a raised relief, and foil stamp for a metallic highlight. Approve a printed proof before any run.',
    options: [
      { name: 'Screen print', img: `${BAG}/opt-print-screen.webp`, w: 900, h: 506 },
      { name: 'Embroidery', img: `${BAG}/opt-print-embroidery.webp`, w: 900, h: 900 },
      { name: 'Embossing', img: `${BAG}/opt-print-emboss.webp`, w: 600, h: 450 },
      { name: 'Foil stamp', img: `${BAG}/opt-print-foil.webp`, w: 478, h: 318 },
    ] },
  { tab: 'Finish',
    desc: 'The finish separates a commodity bag from a premium one. A matte keeps it quiet, a gloss lifts the colour, soft-touch feels expensive in the hand, and an oil- and water-resistant coat protects the print. Pick the surface that matches the shelf and the price point.',
    options: [
      { name: 'Matte', img: `${BAG}/opt-finish-matte.webp`, w: 900, h: 675 },
      { name: 'Gloss', img: `${BAG}/opt-finish-gloss.webp`, w: 900, h: 900 },
      { name: 'Soft-touch', img: `${BAG}/opt-finish-softtouch.webp`, w: 619, h: 495 },
      { name: 'Oil- & water-resistant', img: `${BAG}/opt-finish-oil.webp`, w: 900, h: 900 },
    ] },
  { tab: 'Handle & Hardware',
    desc: 'How a bag opens, closes and carries decides how often it gets used. Twisted paper handles give a classic grip, cotton webbing feels softer, a magnetic closure snaps shut cleanly, and a zipper seals the contents. Choose the hardware that fits how the customer holds it.',
    options: [
      { name: 'Twisted paper handles', img: `${BAG}/opt-handle-twisted.webp`, w: 800, h: 800 },
      { name: 'Cotton webbing', img: `${BAG}/opt-handle-webbing.webp`, w: 900, h: 900 },
      { name: 'Magnetic closure', img: `${BAG}/opt-handle-magnetic.webp`, w: 554, h: 554 },
      { name: 'Zipper', img: `${BAG}/opt-handle-zipper.webp`, w: 900, h: 675 },
    ] },
];

/* Industries. */
const industries = [
  { name: 'Food & Beverage', img: `${BAG}/industry-food.webp`, w: 500, h: 400, alt: 'Liquid drink pouches with spouts', d: 'Preserves freshness and extends shelf life from production to consumption.' },
  { name: 'Agriculture & Seed', img: `${BAG}/industry-agriculture.webp`, w: 500, h: 400, alt: 'Seed packets arranged in rows', d: 'Shields against moisture, UV and weather from storage through shipment.' },
  { name: 'Electronics & Technology', img: `${BAG}/industry-electronics.webp`, w: 500, h: 400, alt: 'A padded electronic accessory pouch', d: 'Anti-static, moisture-resistant layers so components arrive intact.' },
  { name: 'Cosmetics & Personal Care', img: `${BAG}/industry-cosmetics.webp`, w: 500, h: 400, alt: 'A row of cosmetic bottles and pumps', d: 'Lightweight, moisture-proof and brand-forward, pristine on the shelf.' },
  { name: 'Chemical & Industrial', img: `${BAG}/industry-chemical.webp`, w: 500, h: 400, alt: 'Bulk industrial bags stacked on pallets', d: 'Leak-proof and chemical-resistant, built to international transport standards.' },
  { name: 'E-commerce & Retail', img: `${BAG}/industry-ecommerce.webp`, w: 500, h: 400, alt: 'A printed poly mailer bag with a branded design', d: 'Lightweight, customisable and eco-friendly, for a memorable unboxing.' },
];

/* Compliance marks — uploaded once from the LantaoBags "Quality You Can Verify" folder (exception). */
const certs = [
  { name: 'ISO 9001:2015', img: 'https://img.leelinepackage.com/custom-bag/compliance/iso-9001.webp' },
  { name: 'FSC Packaging', img: 'https://img.leelinepackage.com/custom-bag/compliance/fsc.webp' },
  { name: 'BSCI Audited', img: 'https://img.leelinepackage.com/custom-bag/compliance/bsci.webp' },
  { name: 'SEDEX Member', img: 'https://img.leelinepackage.com/custom-bag/compliance/sedex.webp' },
  { name: 'LWG', img: 'https://img.leelinepackage.com/custom-bag/compliance/lwg.webp' },
];

/* Real-life examples — bags in use, in the shop and on the counter. */
const cases = [
  { img: `${BAG}/case-new-1.webp`, w: 900, h: 900, cap: 'Branded totes, packed for a pop-up' },
  { img: `${BAG}/case-new-2.webp`, w: 660, h: 660, cap: 'Kraft bag with twisted handles' },
  { img: `${BAG}/case-new-3.webp`, w: 1000, h: 872, cap: 'Packing orders at the counter' },
  { img: `${BAG}/case-new-4.webp`, w: 554, h: 554, cap: 'Cotton tote, closed by hand' },
  { img: `${BAG}/case-new-5.webp`, w: 500, h: 500, cap: 'Windowed kraft bag, product on show' },
  { img: `${BAG}/case-new-6.webp`, w: 1000, h: 558, cap: 'Retail bags stocked for the day' },
];

/* Two customers, two full paragraphs, real names. */
const testimonials = [
  {
    name: 'Sarah Thompson', role: 'Marketing Manager', co: 'EcoTrend Retail', loc: 'United States',
    avatar: `${BAG}/avatar-sarah.webp`,
    q: [
      'First batch of totes, and the stitching was so clean we barely ran a second check. The QC team signs off on the factory floor, not on paper \u2014 and that discipline carried into every run.',
      'The last 1,000 eco-friendly totes pushed our pop-up engagement up a full 20%. Customers reused the bags, photographed the labels, and did the marketing for us.',
      'Lead time held to the day across two separate orders. A 500-unit launch grew into a thousand-plus reorder without a single change to the artwork, and the schedule never slipped.',
    ],
  },
  {
    name: 'Mathieu Tremblay', role: 'Event Coordinator', co: 'Horizon Conventions', loc: 'Canada',
    avatar: `${BAG}/avatar-michael.webp`,
    q: [
      'The canvas drawstring sample came back embroidered to spec \u2014 every logo crisp, evenly spaced, sitting exactly where the file said it would. At that level of precision, sign-off almost felt like a formality.',
      'Prototyping moved faster than expected. A revision came back in days rather than weeks, so the final sample was approved well ahead of the event.',
      'Five hundred bags at the conference, zero defects returned, and nothing needed chasing. The updates kept the whole timeline honest.',
    ],
  },
];

/* People also ask — no overlap with the numbers above. */
const faqs = [
  { q: 'Which artwork file is needed to start?', a: 'A print-ready PDF, or an editable AI or EPS from the designer. Bleed, safe lines and spot colours are checked before the first print, so the proof matches the file.' },
  { q: 'Can colours be matched to a brand standard?', a: 'Yes. Colour is matched to a Pantone reference or an approved printed proof, and held run to run so a reorder matches the first batch.' },
  { q: 'Is a new design kept confidential?', a: 'A Non-Disclosure Agreement is signed before any artwork is shared, and the design is used only for the order it was made for.' },
  { q: 'What happens if a batch is not right?', a: 'Where variance is on the supplier side \u2014 colour drift or material that does not match the order \u2014 the batch is reworked or the order credited.' },
  { q: 'What payment terms are offered?', a: 'A deposit secures the order and the balance settles before shipment, with terms for repeat buyers available.' },
];

/* Trusted-by logo wall (same set + markup as the homepage). */
const brandLogos = [
  { name: 'Under Armour', img: 'https://img.leelinepackage.com/under-armour-3.webp' },
  { name: 'copper', img: 'https://img.leelinepackage.com/copper.webp' },
  { name: 'Ring', img: 'https://img.leelinepackage.com/RING.webp' },
  { name: 'Sephora', img: 'https://img.leelinepackage.com/sephora.webp' },
  { name: 'Illy', img: 'https://img.leelinepackage.com/illy-1.webp' },
  { name: 'Wilderness', img: 'https://img.leelinepackage.com/WILDERNESS.webp' },
  { name: 'Misstomis', img: 'https://img.leelinepackage.com/misstomis.webp' },
  { name: 'JBL', img: 'https://img.leelinepackage.com/JBL-2.webp' },
  { name: 'Volcom', img: 'https://img.leelinepackage.com/VOLCOM-1.webp' },
  { name: 'Pufies', img: 'https://img.leelinepackage.com/PUFIES.webp' },
  { name: 'Disney', img: 'https://img.leelinepackage.com/disney.webp' },
  { name: 'pat', img: 'https://img.leelinepackage.com/pat.webp' },
  { name: 'Procana', img: 'https://img.leelinepackage.com/Procana.webp' },
  { name: 'Maybelline', img: 'https://img.leelinepackage.com/MAYBELLINE.webp' },
];

const seo = {
  title: 'Custom Bag Manufacturer: 99.8% Pass Rate, AQL 2.5 Inspection',
  description: 'Custom bag manufacturer: 99.8% pass rate under strict AQL 2.5 inspection. OEM, ODM and private label, low MOQ, eco materials, and sample signed off before bulk.',
  keywords: 'custom bag manufacturer, OEM bag manufacturer, ODM bag manufacturer, private label bag manufacturer, custom bag factory, wholesale custom bags, bulk custom bags, custom bag supplier, contract bag manufacturer, custom bag production, low MOQ custom bags',
  canonical: 'https://www.leelinepackage.com/custom-bag-manufacturer/',
  ogImage: `${BAG}/hero.webp?v=2`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Bag Manufacturer',
      description: seo.description,
      serviceType: 'OEM & ODM custom bag manufacturing and private label',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '320' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Bag Manufacturer' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const stat = [
  { v: 'Since 2015', l: 'a bag factory to rely on' },
  { v: '24h', l: 'to a 3D mockup' },
  { v: '4\u20136 weeks', l: 'to a full production' },
  { v: '90%', l: 'eco-friendly materials' },
];
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO (full-bleed · centred) ============ -->
    <section class="cb-hero">
      <div class="cb-hero-shade"></div>
      <div class="cb-hero-grain"></div>
      <div class="wrap cb-hero-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>China custom bag factory &middot; OEM &amp; ODM</span>
        <h1 class="cb-hero-title" data-reveal="up">Custom Bag Manufacturer: <em>7-Day Sample Turnaround</em>, 99% Spec Precision</h1>
        <p class="cb-hero-sub" data-reveal="up">Precise tech-pack translation and AQL 2.5 quality control deliver premium bags for scaling brands &mdash; low 500-unit MOQs, zero supply chain headaches, and reorders that hold the same fabric, print and finish, run after run.</p>
        <div class="cb-hero-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Get a Free Quote
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ul class="cb-hero-stats" data-reveal="up">
          {stat.map((s) => (
            <li><strong>{s.v}</strong><span>{s.l}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ BAG TYPES (offset grid) ============ -->
    <section class="cb-types" id="bag-types">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Custom bag types</span>
          <h2 class="section-title" data-reveal="up">The Bag Types Cut, <em>Sewn and Printed</em></h2>
          <p class="section-sub" data-reveal="up">Nine constructions, one factory. From a paper carry bag to a velvet drawstring pouch, built to spec.</p>
        </div>
        <div class="cb-type-grid">
          {types.map((t, i) => (
            <article class="cb-type-card" data-reveal="up" style={`--d:${(i % 3) * 0.1}s`}>
              <figure class="cb-type-ph">
                <img src={t.img} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" class="cb-img" />
              </figure>
              <h3 class="cb-type-name">{t.name}</h3>
              <p class="cb-type-desc">{t.d}</p>
            </article>
          ))}
        </div>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Design Your Bags
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ WHY (editorial numbers) ============ -->
    <section class="cb-why">
      <span class="cb-ghost" aria-hidden="true">why</span>
      <div class="wrap cb-why-grid">
        <div class="cb-why-head" data-reveal="up">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Why a brand picks us</span>
          <h2 class="section-title">A China Bag Factory Built Around <em>Your Brand, Not Stock</em></h2>
          <p class="section-sub">Five things that change when the factory works for the brand, not the other way around.</p>
        </div>
        <ol class="cb-why-list">
          {why.map((w, i) => (
            <li class="cb-why-item" data-reveal="up" style={`--d:${i * 0.06}s`}>
              <span class="cb-why-num">{w.n}</span>
              <div class="cb-why-body">
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ CAPABILITY (diagonal forest band) ============ -->
    <section class="cb-cap">
      <svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
        <defs><clipPath id="cb-wave-clip" clipPathUnits="objectBoundingBox"><path d="M0 .13 C .17 .01, .46 .16, .72 .06 C .86 .01, .96 .11, 1 .05 L1 1 L0 1 Z"/></clipPath></defs>
      </svg>
      <div class="cb-cap-bg"></div>
      <svg class="cb-wave cb-wave--bottom" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,34 C240,70 480,10 720,45 C960,82 1200,24 1440,56 L1440,90 L0,90 Z" fill="#F5F0E5"/>
      </svg>
      <div class="wrap cb-cap-inner">
        <div class="section-head section-head--center cb-cap-head">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>What the factory can do</span>
          <h2 class="section-title" data-reveal="up">What a Custom Bag Manufacturer <em>Can Actually Do</em></h2>
          <p class="section-sub" data-reveal="up">A certified China bag factory that scales from a startup&rsquo;s first test run to an established label&rsquo;s steady line. One partner owns the order end to end &mdash; no trading layer, no hand-offs, no surprises.</p>
        </div>
        <div class="cb-cap-grid">
          {capability.map((c, i) => (
            <div class="cb-cap-card" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="cb-cap-num">{c.n}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ BRAND WALL ============ -->
    <section class="brand-logos">
      <div class="wrap">
        <div class="logo-wall" data-reveal="up">
          <p class="logo-wall-label">Trusted by Global Brands</p>
          <div class="logo-slider">
            <div class="logo-track" id="logoTrack">
              {brandLogos.map((b) => (
                <span class="logo-item"><img src={b.img} alt={b.name} loading="lazy" decoding="async" /></span>
              ))}
            </div>
            <button class="logo-pager logo-pager--prev" id="logoPrev" aria-label="Previous logos"><svg viewBox="0 0 24 24"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button class="logo-pager logo-pager--next" id="logoNext" aria-label="Next logos"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MID CTA ============ -->
    <section class="cb-midcta">
      <div class="wrap">
        <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Free quote</span>
        <h2 class="cb-midcta-title" data-reveal="up">Five Options, <em>One Supplier</em></h2>
        <p class="cb-midcta-sub" data-reveal="up">Send a size, a logo or finished artwork &mdash; a quote with a material recommendation comes back before anything is cut.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Send Your Spec
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ COMPARE: 5 CUSTOM OPTIONS ============ -->
    <section class="cb-tabs" id="options">
      <div class="wrap">
        <div class="section-head section-head--center">
