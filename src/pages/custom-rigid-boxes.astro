        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>From the floor</span>
          <h2 class="section-title" data-reveal="up">Rigid Boxes That <em>Left the Floor</em></h2>
        </div>

        <div class="rb-case-list">
          {cases.map((c) => (
            <article class="rb-case" data-reveal="up">
              <figure class="rb-case-ph">
                <img src={c.img} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" class="rb-img" />
              </figure>
              <div class="rb-case-body">
                <span class="rb-case-tag">{c.tag}</span>
                <h3 class="rb-case-t">{c.t}</h3>
                <p class="rb-case-d">{c.d}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ PROCESS — a horizontal flow, arrows between steps ============ -->
    <section class="rb-flow" id="process">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>How it runs</span>
          <h2 class="section-title" data-reveal="up">Four Steps From <em>Brief to Pallet</em></h2>
          <p class="section-sub" data-reveal="up">The same four steps run for a first sample and for a repeat order.</p>
        </div>

        <ol class="rb-flow-track">
          {steps.map((s, i) => (
            <li class="rb-flow-step" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="rb-flow-ico" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${s.icon}</svg>`} />
              <span class="rb-flow-n">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ SCENES — client scenes carousel (placeholders) ============ -->
    <section class="rb-sc" id="scenes">
      <div class="wrap">
        <div class="rb-sc-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>In the field</span>
          <h2 class="section-title" data-reveal="up">Where the Boxes <em>End Up</em></h2>
        </div>

        <div class="rb-sc-body">
          <div class="rb-sc-vp">
            <div class="rb-sc-track">
              {scenes.map((s) => (
                <figure class="rb-sc-slide">
