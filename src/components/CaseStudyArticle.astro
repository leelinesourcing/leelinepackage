<script>
  /*
    Two jobs, both small:
    • the current-section highlight, driven from one observer for BOTH the mobile chip bar and
      the ≥1240px right-hand rail (they carry the same `data-jump`, so the same element lights up
      in whichever one is on screen)
    • the rail's own visibility — it is fixed, so it must be hidden whenever the sectioned body is
      off screen, or its muted palette would land on the dark verdict band and the dark CTA

    ⚠️ `.csx-body` must stay overflow-free or the sticky chip bar's containing block changes and it
    silently stops sticking.
  */
  const jumpLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.csx-chip, .csx-rail-link'),
  );

  const bands = jumpLinks
    .map((link) => ({ link, el: document.getElementById(`csx-${link.dataset.jump ?? ''}`) }))
    .filter((b): b is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(b.el));

  if (bands.length && 'IntersectionObserver' in window) {
    const setActive = (current: Element) =>
      bands.forEach(({ link, el }) => link.classList.toggle('is-on', el === current));

    const spy = new IntersectionObserver(
      (entries) => {
        const shown = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (shown[0]) setActive(shown[0].target);
      },
      // the "current" band clears the 76px navbar AND the 52px chip bar
      { rootMargin: '-136px 0px -60% 0px', threshold: 0 },
    );

    const seen = new Set<Element>();
    bands.forEach(({ el }) => {
      if (!seen.has(el)) {
        seen.add(el);
        spy.observe(el);
      }
    });
  }

  /*
    The rail is on screen from the first band to the last. It is switched off only when the footer
    arrives, because past that point there is nothing left to navigate to — and a contents card
    floating over the footer reads as a bug.
  */
  /*
    ⚠️ There is deliberately NO show/hide logic for the rail. It was briefly hidden once the footer
    arrived, and the client's call was *"不用收，就留着，可以看清楚"*. The parchment plate on
    `.csx-rail-in` is what makes it readable when a dark band is behind it — that is the fix, not a
    toggle. Do not reinstate one.
  */
</script>
