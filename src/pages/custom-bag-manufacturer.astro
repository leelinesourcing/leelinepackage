  .cb-opt-img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; mix-blend-mode: multiply; }
  .cb-opt-name { font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; line-height: 1.3; color: var(--color-brand-text); padding: 0.75rem 0.9rem 0.95rem; }

  /* ============ INDUSTRIES ============ */
  .cb-ind { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .cb-ind-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.1rem, 2.4vw, 1.7rem); }
  .cb-ind-card { background: var(--color-brand-surface); border: 1px solid rgba(31,59,44,0.1); border-radius: 1.1rem; overflow: hidden; transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease; }
  .cb-ind-card:hover { transform: translateY(-6px); box-shadow: 0 24px 46px -22px rgba(31,59,44,0.28); }
  .cb-ind-ph { margin: 0; aspect-ratio: 4 / 3; }
  .cb-ind-body { padding: clamp(1rem, 2vw, 1.3rem); }
  .cb-ind-body h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.14rem; color: var(--color-brand-text); margin: 0 0 0.4rem; }
  .cb-ind-body p { font-size: 0.94rem; line-height: 1.55; color: var(--color-brand-muted); margin: 0; }

  /* ============ COMPLIANCE ============ */
  .cb-cert { background: var(--ivory); padding: clamp(3.5rem, 7vw, 5.5rem) 0; }
  .cb-cert-head { text-align: center; }
  .cb-cert-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--color-brand-text); margin: 1rem 0 0; text-wrap: balance; }
  .cb-cert-title em { font-style: italic; color: var(--brass); }
  .cb-cert-sub { font-size: 1.02rem; line-height: 1.7; color: var(--color-brand-muted); max-width: 46ch; margin: 1rem auto 0; }
  .cb-cert-row { display: flex; flex-wrap: wrap; gap: clamp(1.6rem, 4vw, 3.4rem); justify-content: center; align-items: center; margin-top: clamp(1.8rem, 4vw, 2.8rem); }
  .cb-cert-logo { height: clamp(64px, 8vw, 104px); width: auto; max-width: 240px; object-fit: contain; opacity: 0.96; }

  /* ============ CASES (looping carousel) ============ */
  .cb-cases { position: relative; background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 8rem) 0; }
  .cb-cases::before { content: ''; position: absolute; top: 4%; left: -6%; width: clamp(240px, 34vw, 500px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 36%, rgba(31,59,44,0.12), rgba(31,59,44,0) 66%); pointer-events: none; z-index: 0; }
  .cb-cases .wrap { position: relative; z-index: 1; }
  .cb-carousel { position: relative; margin-top: clamp(2rem, 4vw, 3rem); }
  .cb-car-vp { overflow: hidden; border-radius: 1.4rem; }
  .cb-car-track { display: flex; gap: 1rem; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  .cb-car-slide { flex: 0 0 calc((100% - 2rem) / 3); aspect-ratio: 4 / 3; margin: 0; border-radius: 1.2rem; overflow: hidden; background: var(--ivory); position: relative; }
  .cb-car-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cb-car-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 2rem 1.1rem 0.9rem; background: linear-gradient(180deg, transparent 45%, rgba(20,38,27,0.8)); pointer-events: none; }
  .cb-car-cap span { color: #fff; font-size: 0.86rem; font-weight: 600; letter-spacing: 0.01em; text-shadow: 0 1px 10px rgba(20,38,27,0.6); }
  .cb-car-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 50px; height: 50px; border-radius: 50%; border: 1px solid rgba(31,59,44,0.16); background: rgba(245,240,229,0.92); color: var(--forest-deep); cursor: pointer; display: grid; place-items: center; box-shadow: 0 12px 28px -16px rgba(31,59,44,0.5); transition: background 0.3s ease; }
  .cb-car-btn:hover { background: var(--brass-bright); color: var(--forest-deep); }
  .cb-car-btn--prev { left: -8px; }
  .cb-car-btn--next { right: -8px; }
  .cb-car-btn svg { width: 22px; height: 22px; }

  /* ============ TESTIMONIALS ============ */
  .cb-quote { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .cb-quote-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.2rem, 3vw, 2rem); max-width: 1080px; margin-inline: auto; }
  .cb-quote-card { background: var(--color-brand-surface); border: 1px solid rgba(31,59,44,0.1); border-radius: 1.2rem; padding: clamp(1.5rem, 3vw, 2.1rem); display: flex; flex-direction: column; gap: 1.4rem; }
  .cb-quote-copy p { margin: 0; font-family: var(--font-body); font-size: 1rem; line-height: 1.7; color: var(--color-brand-text); }
  .cb-quote-copy p + p { margin-top: 1rem; }
  .cb-quote-person { display: flex; align-items: center; gap: 0.9rem; margin-top: auto; padding-top: 1.2rem; border-top: 1px solid rgba(31,59,44,0.12); }
  .cb-avatar { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; }
  .cb-quote-person strong { display: block; font-size: 0.98rem; color: var(--color-brand-text); }
  .cb-quote-person span { display: block; font-size: 0.82rem; color: var(--color-brand-muted); margin-top: 0.1rem; }

  /* ============ FAQ ============ */
  .cb-faq { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 8rem) 0; }
  .cb-faq-list { display: flex; flex-direction: column; max-width: 820px; margin-inline: auto; }
  .cb-faq-item { border-top: 1px solid rgba(31,59,44,0.14); background: var(--ivory); }
  .cb-faq-item:first-child { border-radius: 1rem 1rem 0 0; }
  .cb-faq-item:last-child { border-bottom: 1px solid rgba(31,59,44,0.14); border-radius: 0 0 1rem 1rem; }
  .cb-faq-item + .cb-faq-item { margin-top: 0.6rem; }
  .cb-faq-num { font-family: var(--font-heading); font-weight: 600; color: var(--brass); margin-right: 0.9rem; }
  .cb-faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1rem; padding: 1.3rem 1.2rem; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.05rem, 1.8vw, 1.22rem); color: var(--color-brand-text); }
  .cb-faq-item summary::-webkit-details-marker { display: none; }
  .cb-faq-item summary::after { content: '+'; font-family: var(--font-body); font-weight: 400; font-size: 1.6rem; color: var(--brass); transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1); margin-left: auto; }
  .cb-faq-item[open] summary::after { transform: rotate(45deg); }
  .cb-faq-a { padding: 0 1.2rem 1.4rem; }
  .cb-faq-a p { font-size: 0.98rem; line-height: 1.7; color: var(--color-brand-muted); max-width: 68ch; margin: 0; }

  /* ============ FINAL CTA (dark) ============ */
  .cb-final { background: linear-gradient(180deg, rgba(20,38,27,0.6) 0%, rgba(20,38,27,0.72) 100%), url('https://img.leelinepackage.com/custom-bag/final-cta-2.webp') center / cover no-repeat; color: var(--ivory); padding: calc(clamp(3.5rem, 9vw, 7.5rem) - 1cm) 0; position: relative; overflow: hidden; }
  .cb-final::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(48% 70% at 22% 30%, rgba(228,181,77,0.13), transparent 70%); }
  .cb-final-inner { text-align: center; position: relative; z-index: 1; }
  .cb-final-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.4rem, 6vw, 4.4rem); line-height: 1.04; letter-spacing: -0.025em; color: #fff; text-shadow: 0 2px 24px rgba(20,38,27,0.4); margin: 1.1rem 0 0; max-width: 24ch; margin-inline: auto; text-wrap: balance; }
  .cb-final-title em { font-style: italic; color: #E3C29A; }
  .cb-final-sub { font-size: 1.08rem; line-height: 1.7; color: rgba(255,255,255,0.95); max-width: 52ch; margin: 1.5rem auto 0; text-shadow: 0 1px 18px rgba(20,38,27,0.4); }
  .cb-final .section-cta { margin-top: clamp(2.2rem, 5vw, 3rem); }

  /* ============ responsive ============ */
  @media (max-width: 1024px) {
    .cb-why-grid { grid-template-columns: 1fr; }
    .cb-why-head { position: static; margin-bottom: 1.5rem; }
    .cb-cap-grid { grid-template-columns: repeat(2, 1fr); }
    .cb-opt-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .cb-type-grid { grid-template-columns: repeat(2, 1fr); }
    .cb-ind-grid { grid-template-columns: repeat(2, 1fr); }
    .cb-quote-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .cb-type-grid { grid-template-columns: 1fr; }
    .cb-opt-grid { grid-template-columns: 1fr; }
    .cb-ind-grid { grid-template-columns: 1fr; }
    .cb-cap-grid { grid-template-columns: 1fr; }
    .cb-car-slide { flex: 0 0 100%; }
    .cb-car-btn { width: 42px; height: 42px; }
    .cb-car-btn--prev { left: -4px; }
    .cb-car-btn--next { right: -4px; }
    .cb-hero-cta .btn { width: 100%; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Infinite 3-up carousel (clone 3 at each end for a seamless wrap in both directions)
  const track = document.querySelector('.cb-car-track');
  if (track) {
    const slides = Array.from(track.children);
    const N = slides.length;
    if (N > 0) {
      const clones = Math.min(3, N);
      // Front clones: copies of the LAST `clones` slides, placed directly before s0
      for (let k = 0; k < clones; k++) {
        const c = slides[(N - clones + k) % N].cloneNode(true);
        c.classList.add('cb-car-clone');
        track.insertBefore(c, slides[0]);
      }
      // Back clones: copies of the FIRST `clones` slides, appended after the last slide
      for (let k = 0; k < clones; k++) {
        const c = slides[k % N].cloneNode(true);
        c.classList.add('cb-car-clone');
        track.appendChild(c);
      }
      const start = clones;
      let i = start;

      const step = () => {
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        return track.children[start].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        track.style.transition = animate ? 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        track.style.transform = `translateX(${-i * step()}px)`;
      };

      const go = (dir) => {
        if (track._busy) return;
        track._busy = true;
        i += dir;
        move(true);
        setTimeout(() => {
          if (i < start) i += N;
          else if (i > start + N - 1) i -= N;
          move(false);
          track._busy = false;
        }, 520);
      };

      const prevBtn = document.querySelector('.cb-car-btn--prev');
      const nextBtn = document.querySelector('.cb-car-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!track._busy) move(false); });
    }
  }

  // Tabbed "compare" — 5 customisation categories
  const tabBtns = document.querySelectorAll('.cb-tab-btn');
  const tabPanels = document.querySelectorAll('.cb-tab-panel');
  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.dataset.tab;
      tabBtns.forEach((b) => { b.classList.toggle('cb-tab-btn--active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
      tabPanels.forEach((p) => { p.classList.toggle('cb-tab-panel--active', p.dataset.panel === idx); });
    });
  });

  // Infinite logo wall (same auto-loop as the homepage)
  const logoTrack = document.getElementById('logoTrack');
  if (logoTrack) {
    const real = Array.from(logoTrack.children);
    const N = real.length;
    const lg = 1.6 * 16;
    const lper = () => window.innerWidth <= 640 ? 3 : (window.innerWidth <= 900 ? 5 : 6);
    const stripClones = () => { Array.from(logoTrack.children).forEach((k) => { if (!real.includes(k)) k.remove(); }); };
    const brate = (c) => { const n = c.cloneNode(true); const im = n.querySelector('img'); if (im) im.loading = 'eager'; return n; };
    const buildClones = () => { stripClones(); const pp = lper(); const lead = real.slice(N - pp).slice().reverse(); const trail = real.slice(0, pp); lead.forEach((c) => logoTrack.insertBefore(brate(c), logoTrack.firstChild)); trail.forEach((c) => logoTrack.appendChild(brate(c))); return pp; };
    let p = buildClones();
    const kids = () => logoTrack.children;
    const step = () => (kids()[0].offsetWidth + lg);
    let li = p;
    let busy = false;
    const lsec = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
    const apply = () => logoTrack.style.transform = 'translateX(' + (-li * step()) + 'px)';
    logoTrack.style.transition = 'none';
    apply();
    void logoTrack.offsetWidth;
    logoTrack.style.transition = lsec;
    const snap = (v) => { logoTrack.style.transition = 'none'; li = v; apply(); void logoTrack.offsetWidth; logoTrack.style.transition = lsec; busy = false; };
    const go = (dir) => { if (busy) return; busy = true; li += dir; apply(); if ((dir > 0 && li >= p + N) || (dir < 0 && li < p)) setTimeout(() => snap(li - (dir > 0 ? N : -N)), 620); else setTimeout(() => { busy = false; }, 620); };
    document.getElementById('logoPrev').addEventListener('click', () => go(-1));
    document.getElementById('logoNext').addEventListener('click', () => go(1));
    window.addEventListener('resize', () => { p = buildClones(); li = p; busy = false; logoTrack.style.transition = 'none'; apply(); void logoTrack.offsetWidth; logoTrack.style.transition = lsec; });
  }
</script>
