      font-weight: 600;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--brass);
    }
    .eyebrow-leaf { width: 1.05em; height: 1.05em; flex: 0 0 auto; }
    .eyebrow--light { color: #E3C29A; }

    .section-title {
      font-family: var(--font-heading);
      font-weight: 500;
      font-size: clamp(2rem, 5vw, 3.6rem);
      line-height: 1.04;
      letter-spacing: -0.02em;
      color: var(--color-brand-text);
      text-wrap: balance;
      margin: 1.1rem 0 0;
    }
    .section-title em {
      font-style: italic;
      color: var(--brass);
    }
    .section-sub {
      font-size: 1.06rem;
      line-height: 1.7;
      color: var(--color-brand-muted);
      max-width: 46ch;
      margin-top: 1.2rem;
    }
    .section-head { margin-bottom: clamp(2.5rem, 6vw, 5rem); }
    .section-head--center { text-align: center; max-width: 66rem; margin-inline: auto; margin-bottom: clamp(3rem, 7vw, 5.5rem); }
    .section-head--center .section-title { font-size: clamp(2.2rem, 5.2vw, 4rem); }
    .section-head--center .section-sub { margin-inline: auto; }

    /* ============ BUTTONS ============ */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      padding: 0.95rem 1.7rem;
      border-radius: 999px;
      border: 1px solid transparent;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      white-space: nowrap;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease, background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
    }
    .btn:hover { transform: translateY(-3px); }
    .btn:active { transform: translateY(-1px) scale(0.98); }

    .btn-leaf { width: 1em; height: 1em; flex: 0 0 auto; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .btn:hover .btn-leaf { transform: translateX(4px); }

    .btn-primary {
      background: var(--forest-light);
      color: var(--ivory);
    }
    .btn-primary:hover { background: var(--forest-deep); box-shadow: 0 14px 30px -12px rgba(31, 59, 44, 0.55); }

    .btn-ghost {
      border-color: rgba(31, 59, 44, 0.35);
      color: var(--color-brand-primary);
    }
    .btn-ghost:hover { border-color: var(--color-brand-primary); background: rgba(31, 59, 44, 0.06); }

    .btn-gold {
      background: var(--brass-bright);
      color: var(--forest-deep);
    }
    .btn-gold:hover { background: #EFC45A; box-shadow: 0 14px 34px -12px rgba(31, 59, 44, 0.7); }

    .btn-light {
      border-color: rgba(245, 240, 229, 0.4);
      color: var(--ivory);
    }
    .btn-light:hover { border-color: var(--ivory); background: rgba(245, 240, 229, 0.1); }

    .btn-sm { padding: 0.6rem 1.15rem; font-size: 0.88rem; }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--color-brand-primary);
      padding-bottom: 0.25rem;
    }
    .text-link .arrow { width: 1.15em; height: 1.15em; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .text-link:hover .arrow { transform: translateX(5px); }

    .arrow { width: 1.15em; height: 1.15em; }

    .brand { display: inline-flex; align-items: center; gap: 0.7rem; }


    /* ============ HERO ============ */
    .hero {
      position: relative;
      min-height: min(94vh, 900px);
      display: grid;
      place-items: center;
      text-align: center;
      overflow: hidden;
      padding: clamp(8rem, 16vw, 11rem) 0 clamp(4rem, 8vw, 6rem);
      color: var(--ivory);
    }
    .hero-bg { position: absolute; inset: 0; z-index: 0; background: url('https://img.leelinepackage.com/hero-480.webp') center / cover no-repeat; filter: brightness(1.12); }
    .hero-bg::after { content: ''; position: absolute; inset: 0; background: rgba(20, 38, 27, 0.45); }
    @media (min-width: 641px) { .hero-bg { background-image: url('https://img.leelinepackage.com/hero-960.webp'); } }
    @media (min-width: 1025px) { .hero-bg { background-image: url('https://img.leelinepackage.com/hero-1440.webp'); } }
    .hero-inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; transform: translateY(-1cm); }
    .hero-rating { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 1.05rem; border-radius: 999px; background: rgba(245, 240, 229, 0.12); border: 1px solid rgba(245, 240, 229, 0.25); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transform: translateY(-0.3cm); }
    .hero-rating .stars { color: #E3C29A; font-size: 1rem; letter-spacing: 0.12em; }
    .hero-rating .rating-text { font-size: 0.85rem; color: rgba(255, 255, 255, 0.98); font-family: var(--font-body); }
    .hero h1 {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: clamp(2.8rem, 5.3vw, 4.8rem);
      line-height: 1.24;
      letter-spacing: -0.03em;
      color: #FFFFFF;
      text-shadow: 0 2px 24px rgba(20, 38, 27, 0.4);
      margin: 1.3rem 0 0;
      width: min(96vw, 2000px);
    }
    .hero h1 em { font-style: italic; color: #E3C29A; }
    .hero-sub { font-size: clamp(1.04rem, 1.7vw, 1.22rem); line-height: 1.7; color: rgba(255, 255, 255, 0.97); max-width: 58ch; margin: 1.6rem 0 0; text-shadow: 0 1px 18px rgba(20, 38, 27, 0.4); }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin-top: 2.3rem; }
    .hero-spec {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 2.6rem;
      justify-content: center;
      margin: 2.8rem 0 0;
      padding: 1.5rem 0 0;
      border-top: 1px solid rgba(245, 240, 229, 0.2);
      max-width: 700px;
    }
    .hero-spec li { font-size: 0.92rem; color: rgba(245, 240, 229, 0.82); display: flex; align-items: baseline; gap: 0.5rem; }
    .hero-spec span { font-family: var(--font-heading); font-weight: 600; font-size: 1.5rem; color: var(--brass-soft); }
    .hero-seal { position: absolute; top: 12%; left: 6%; width: clamp(160px, 18vw, 300px); aspect-ratio: 1; height: auto; color: rgba(245, 240, 229, 0.05); animation: drift 16s ease-in-out infinite; z-index: 1; }

    /* ============ MARQUEE ============ */
    .materials {
      background: var(--kraft);
      padding: 1.6rem 0;
      overflow: hidden;
      border-top: 1px solid rgba(31, 59, 44, 0.08);
      border-bottom: 1px solid rgba(31, 59, 44, 0.08);
    }
    .marquee { overflow: hidden; }
    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee 42s linear infinite;
    }
    .materials:hover .marquee-track { animation-play-state: paused; }
    .m-item {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-right: 2.6rem;
    }
    .m-thumb {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid rgba(31, 59, 44, 0.4);
      flex: 0 0 auto;
