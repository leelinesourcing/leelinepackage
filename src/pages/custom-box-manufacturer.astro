<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Cases carousel — 3-up, seamless infinite loop in both directions.
  // A copy of the last `clones` slides sits before slide one and a copy of the first
  // `clones` sits after the last, so stepping past either end animates onto a clone and
  // is then snapped (no transition) back onto the matching real slide. No visible jump.
  const carTrack = document.querySelector('.cx-car-track');
  if (carTrack) {
    const slides = Array.from(carTrack.children);
    const N = slides.length;
    if (N > 0) {
      const clones = Math.min(3, N);
      for (let k = 0; k < clones; k++) {
        const c = slides[(N - clones + k) % N].cloneNode(true);
        c.classList.add('cx-car-clone');
        c.setAttribute('aria-hidden', 'true');
        carTrack.insertBefore(c, slides[0]);
      }
      for (let k = 0; k < clones; k++) {
        const c = slides[k % N].cloneNode(true);
        c.classList.add('cx-car-clone');
        c.setAttribute('aria-hidden', 'true');
        carTrack.appendChild(c);
      }
      const start = clones;
      let idx = start;

      const step = () => {
        const gap = parseFloat(getComputedStyle(carTrack).gap) || 0;
        return carTrack.children[start].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        carTrack.style.transition = animate ? 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        carTrack.style.transform = `translateX(${-idx * step()}px)`;
      };
      const go = (dir) => {
        if (carTrack._busy) return;
        carTrack._busy = true;
        idx += dir;
        move(true);
        setTimeout(() => {
          if (idx < start) idx += N;
          else if (idx > start + N - 1) idx -= N;
          move(false);
          carTrack._busy = false;
        }, 520);
      };

      const prevBtn = document.querySelector('.cx-car-btn--prev');
      const nextBtn = document.querySelector('.cx-car-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!carTrack._busy) move(false); });
    }
  }
</script>
