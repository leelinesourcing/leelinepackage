---
import FoundryMark from './FoundryMark.astro';
---

<section class="hero on-dark" id="top">
  <div class="hero-media" aria-hidden="true">
    <img
      src="/images/首页/image-03.avif"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-veil"></div>
    <div class="hero-veil hero-veil-2"></div>
  </div>

  <div class="hero-reg" aria-hidden="true">
    <FoundryMark variant="reg" />
  </div>
  <div class="hero-rail" aria-hidden="true">
    <span class="hero-rail-line"></span>
    <span class="hero-rail-text">The Foundry — Structural Brand Architects</span>
  </div>

  <div class="container hero-body">
    <p class="eyebrow" data-reveal="up" style="--d:0ms">
      <span class="mark"><FoundryMark variant="notch" /></span>
      Wuhan, China · Est. 2015 · ISO 9001 / FSC
    </p>

    <h1 class="hero-title">
      <span class="line" data-reveal="clip" style="--d:70ms">Engineered to <em>protect.</em></span>
      <span class="line" data-reveal="clip" style="--d:190ms">Finished to <em>impress.</em></span>
    </h1>

    <p class="hero-lede" data-reveal="up" style="--d:340ms">
      LeelinePackage is the structural brand architect behind custom corrugated,
      rigid, and folding cartons — die-cut, foil-stamped, and load-tested in Wuhan,
      then unboxed by half a million customers who hit record.
    </p>

    <div class="hero-cta" data-reveal="up" style="--d:430ms">
      <a href="#quote" class="btn btn-primary">Get a Free Quote <span class="arr" aria-hidden="true">&rarr;</span></a>
      <a href="mailto:hello@leelinepackage.com?subject=Sample%20Kit" class="btn btn-ghost">Request Your Sample Kit</a>
    </div>
  </div>

  <div class="container hero-stats" data-reveal="up" style="--d:520ms">
    <div class="stat">
      <span class="stat-num"><span data-target="500" data-suffix="K+">0</span></span>
      <span class="stat-label">boxes shipped to date</span>
    </div>
    <span class="stat-div" aria-hidden="true"><FoundryMark variant="foldline" /></span>
    <div class="stat">
      <span class="stat-num"><span data-target="24" data-suffix="h">0</span></span>
      <span class="stat-label">digital 3D mockups</span>
    </div>
    <span class="stat-div" aria-hidden="true"><FoundryMark variant="foldline" /></span>
    <div class="stat">
      <span class="stat-num">MOQ <span data-target="500">0</span></span>
      <span class="stat-label">factory-direct, from 500 units</span>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="hero-scroll-word">Scroll</span>
    <span class="hero-scroll-line"><i></i></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 118px 0 0;
    overflow: hidden;
    background: var(--foundry-ink);
    color: var(--color-brand-cream);
  }

  .hero-media { position: absolute; inset: 0; z-index: 0; }
  .hero-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.72) contrast(1.05);
    transform: scale(1.06);
    animation: hero-zoom 14s var(--ease-out-expo) forwards;
  }
  @keyframes hero-zoom { to { transform: scale(1.14); } }
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(21, 17, 12, 0.66) 0%, rgba(21, 17, 12, 0.18) 42%, rgba(21, 17, 12, 0.55) 100%);
  }
  .hero-veil-2 {
    background:
      radial-gradient(120% 90% at 16% 30%, rgba(21, 17, 12, 0.55) 0%, transparent 60%),
      radial-gradient(90% 70% at 100% 100%, rgba(43, 33, 25, 0.7) 0%, transparent 55%);
  }

  /* Floating registration mark */
  .hero-reg {
    position: absolute; top: 22%; right: 6%;
    width: clamp(120px, 16vw, 240px); height: clamp(120px, 16vw, 240px);
    color: rgba(199, 154, 99, 0.34);
    z-index: 1;
    animation: hero-float 7s ease-in-out infinite;
  }
  .hero-reg svg { width: 100%; height: 100%; }
  @keyframes hero-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-18px) rotate(4deg); }
  }

  .hero-rail {
    position: absolute; top: 50%; right: clamp(1.4rem, 3vw, 3rem);
    transform: translateY(-50%);
    display: flex; align-items: center; gap: 1rem;
    writing-mode: vertical-rl;
    color: rgba(250, 247, 242, 0.4);
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.34em; text-transform: uppercase;
    z-index: 1;
  }
  .hero-rail-line { width: 1px; height: 64px; background: linear-gradient(rgba(199,154,99,0.6), transparent); }

  .hero-body { position: relative; z-index: 2; padding-bottom: 2.4rem; }
  .hero-title {
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: clamp(2.7rem, 8vw, 6.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 1.6rem 0 1.7rem;
    text-wrap: balance;
  }
  .hero-title .line { display: block; overflow: hidden; }
  .hero-title em {
    font-style: italic;
    font-weight: 470;
    color: var(--color-brand-accent);
  }

  .hero-lede {
    font-size: clamp(1.02rem, 1.5vw, 1.22rem);
    line-height: 1.7;
    color: rgba(250, 247, 242, 0.78);
    max-width: 38rem;
    margin-bottom: 2rem;
  }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .hero-cta .btn-ghost { color: var(--color-brand-cream); }

  .hero-stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    padding: 1.7rem 0 2.1rem;
    margin-top: 2.4rem;
    border-top: 1px solid var(--foundry-line-light);
  }
  .stat { display: flex; flex-direction: column; gap: 0.4rem; }
  .stat-num {
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-brand-cream);
  }
  .stat-label {
    font-size: 0.76rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(250, 247, 242, 0.52);
  }
  .stat-div { display: none; color: rgba(199, 154, 99, 0.5); align-self: stretch; width: 100%; }
  .stat-div svg { width: 100%; height: 14px; }

  .hero-scroll {
    position: absolute; left: 1.6rem; bottom: 1.8rem;
    z-index: 2;
    display: flex; align-items: center; gap: 0.8rem;
    color: rgba(250, 247, 242, 0.4);
  }
  .hero-scroll-word { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; }
  .hero-scroll-line {
    position: relative; width: 1px; height: 40px; background: rgba(250,247,242,0.16); overflow: hidden;
  }
  .hero-scroll-line i {
    position: absolute; top: 0; left: 0; width: 100%; height: 40%;
    background: var(--color-brand-accent);
    animation: scroll-pulse 2.2s var(--ease-swift) infinite;
  }
  @keyframes scroll-pulse {
    0% { transform: translateY(-100%); }
    55% { transform: translateY(260%); }
    100% { transform: translateY(260%); }
  }

  @media (min-width: 720px) {
    .hero-stats {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: 1.6rem;
      padding: 1.9rem 0 2.4rem;
    }
    .stat-div { display: block; }
    .hero-scroll { left: 2.2rem; bottom: 2.2rem; }
    .hero-rail { display: flex; }
  }
  @media (max-width: 719px) {
    .hero-rail { display: none; }
    .hero-scroll { display: none; }
  }
</style>
