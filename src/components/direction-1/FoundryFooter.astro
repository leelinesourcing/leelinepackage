---
import FoundryMark from './FoundryMark.astro';

const cols = [
  {
    title: 'Company',
    links: [
      { label: 'About the Foundry', href: '#top' },
      { label: 'Featured Work', href: '#work' },
      { label: 'Why LeelinePackage', href: '#why' },
      { label: 'Proof & Testing', href: '#proof' },
    ],
  },
  {
    title: 'Products',
    links: [
      { label: 'Folding Cartons', href: '#offerings' },
      { label: 'Corrugated & Mailers', href: '#offerings' },
      { label: 'Rigid Boxes', href: '#offerings' },
      { label: 'Pouches & Bags', href: '#offerings' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Sample Kit', href: '#sample' },
      { label: 'Dieline Guide', href: '#quote' },
      { label: 'Material Library', href: '#offerings' },
      { label: 'Freight Optimization', href: '#why' },
    ],
  },
];
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#top" class="footer-lockup">
          <span class="footer-mark"><FoundryMark variant="seal" /></span>
          <span class="footer-word">
            <span class="footer-name">Leeline<span>Package</span></span>
            <span class="footer-tag">Engineered in Wuhan. Unboxed everywhere.</span>
          </span>
        </a>
        <p class="footer-blurb">
          The structural brand architect behind custom packaging that protects
          the product and sells the shelf — from 500 units to half a million.
        </p>
      </div>

      <div class="footer-cols">
        {cols.map((c) => (
          <nav class="footer-col" aria-label={c.title}>
            <h4 class="footer-col-title">{c.title}</h4>
            {c.links.map((l) => <a href={l.href} class="footer-link">{l.label}</a>)}
          </nav>
        ))}
        <div class="footer-col">
          <h4 class="footer-col-title">Contact</h4>
          <a href="mailto:hello@leelinepackage.com" class="footer-link">hello@leelinepackage.com</a>
          <a href="tel:+862787600000" class="footer-link">+86 27 8760 0000</a>
          <span class="footer-link footer-addr">Wuhan, Hubei, China</span>
        </div>
      </div>
    </div>

    <div class="footer-rule" aria-hidden="true"><FoundryMark variant="foldline" /></div>

    <div class="footer-bottom">
      <div class="footer-sign">
        <span class="footer-sign-mark"><FoundryMark variant="reg" /></span>
        <span class="footer-sign-text">Protect &amp; Impress.</span>
      </div>
      <div class="footer-meta">
        <span>&copy; 2026 LeelinePackage</span>
        <span>ISO 9001</span>
        <span>FSC-certified</span>
        <span class="footer-socials">
          <a href="#top" aria-label="LinkedIn">in</a>
          <a href="#top" aria-label="Instagram">ig</a>
          <a href="#top" aria-label="YouTube">yt</a>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0 2rem;
    background: var(--foundry-ink);
    color: var(--color-brand-cream);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .footer-lockup { display: inline-flex; align-items: center; gap: 0.85rem; text-decoration: none; color: inherit; }
  .footer-mark { width: 46px; height: 46px; color: var(--color-brand-accent); }
  .footer-mark svg { width: 100%; height: 100%; }
  .footer-word { display: flex; flex-direction: column; gap: 0.35rem; }
  .footer-name { font-family: var(--font-heading); font-weight: 600; font-size: 1.5rem; letter-spacing: -0.01em; }
  .footer-name span { color: var(--color-brand-accent); }
  .footer-tag { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(250,247,242,0.5); }

  .footer-blurb {
    margin-top: 1.4rem;
    max-width: 30rem;
    color: rgba(250, 247, 242, 0.6);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }
  .footer-col { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-col-title {
    font-family: var(--font-body);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
    color: rgba(250, 247, 242, 0.4);
    margin-bottom: 0.5rem;
  }
  .footer-link {
    font-size: 0.92rem; color: rgba(250, 247, 242, 0.72);
    text-decoration: none; width: fit-content;
    transition: color 0.3s ease, transform 0.4s var(--ease-spring);
  }
  .footer-link:hover { color: var(--color-brand-accent); transform: translateX(3px); }
  .footer-addr { cursor: default; }
  .footer-addr:hover { transform: none; color: rgba(250, 247, 242, 0.72); }

  .footer-rule { color: rgba(199, 154, 99, 0.45); margin: 1rem 0 2rem; }
  .footer-rule svg { width: 100%; height: 14px; }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    align-items: flex-start;
  }
  .footer-sign { display: flex; align-items: center; gap: 0.7rem; }
  .footer-sign-mark { width: 26px; height: 26px; color: var(--color-brand-accent); }
  .footer-sign-mark svg { width: 100%; height: 100%; }
  .footer-sign-text { font-family: var(--font-heading); font-style: italic; font-weight: 480; font-size: 1.25rem; letter-spacing: -0.01em; }

  .footer-meta {
    display: flex; flex-wrap: wrap; gap: 1.2rem; align-items: center;
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em;
    color: rgba(250, 247, 242, 0.45);
  }
  .footer-socials { display: inline-flex; gap: 0.6rem; }
  .footer-socials a {
    display: grid; place-items: center;
    width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid rgba(250, 247, 242, 0.2);
    color: rgba(250, 247, 242, 0.6);
    text-decoration: none; font-size: 0.7rem; font-weight: 700;
    transition: border-color 0.3s ease, color 0.3s ease, transform 0.4s var(--ease-spring);
  }
  .footer-socials a:hover { border-color: var(--color-brand-accent); color: var(--color-brand-accent); transform: translateY(-2px); }

  @media (min-width: 860px) {
    .footer-top { grid-template-columns: 1.1fr 1.6fr; gap: 4rem; }
    .footer-cols { grid-template-columns: repeat(4, 1fr); }
    .footer-bottom { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>
