  .cr-qa-q { display: flex; align-items: baseline; gap: 0.85rem; padding: clamp(0.95rem, 2vw, 1.25rem) clamp(1rem, 2.2vw, 1.5rem); font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.28; color: var(--color-brand-text); cursor: pointer; list-style: none; }
  .cr-qa-q::-webkit-details-marker { display: none; }
  .cr-qa-q::after { content: '+'; margin-left: auto; padding-left: 1rem; font-family: var(--font-body); font-size: 1.3rem; font-weight: 700; line-height: 1; color: var(--brass); }
  .cr-qa-item[open] .cr-qa-q::after { content: '\2013'; }
  .cr-qa-n { flex: 0 0 auto; font-family: var(--font-heading); font-size: 0.78rem; letter-spacing: 0.09em; color: var(--brass); }
  .cr-qa-a { margin: 0; padding: 0 clamp(1rem, 2.2vw, 1.5rem) clamp(1rem, 2vw, 1.3rem) calc(clamp(1rem, 2.2vw, 1.5rem) + 2.1rem); font-size: 0.95rem; line-height: 1.7; color: var(--color-brand-muted); }

  /* ============ 10 · FINAL CTA (photo under a forest scrim) ============ */
  .cr-final { background: linear-gradient(150deg, rgba(20,38,27,0.84) 0%, rgba(27,51,36,0.76) 52%, rgba(46,79,61,0.7) 100%), url('https://img.leelinepackage.com/custom-child-resistant/final-cta.webp') center / cover no-repeat; color: var(--ivory); text-align: center; padding: clamp(4.5rem, 10vw, 8rem) 0; overflow: hidden; }
  .cr-final::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 62% at 50% 0%, rgba(228,181,77,0.18), transparent 70%); pointer-events: none; }
  .cr-final-inner { position: relative; z-index: 1; }
  .cr-final .eyebrow { justify-content: center; }
  .cr-final-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.85rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.028em; color: #fff; margin: 1.1rem auto 0; max-width: 22ch; text-wrap: balance; }
  .cr-final-title em { font-style: italic; color: #E3C29A; }
