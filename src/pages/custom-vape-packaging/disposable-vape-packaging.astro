  /* ============ 2 · FOUR PEN LENGTHS (ivory) ============ */
  .dp-len { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .dp-len .section-sub { max-width: 84ch; }
  .dp-len-rows { display: grid; gap: clamp(1rem, 2.2vw, 1.5rem); }
