      border-radius: 999px;
      background: rgba(201, 168, 124, 0.08);
    }

    .card-num {
      font-family: var(--font-body);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: var(--brass);
