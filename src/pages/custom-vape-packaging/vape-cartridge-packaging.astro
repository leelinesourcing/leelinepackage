  .vc-dims-fig figcaption { margin-top: 1rem; font-size: 0.82rem; line-height: 1.5; color: var(--color-brand-muted); }
  .vc-dims-spec { border-left: 1px solid rgba(31,59,44,0.16); padding-left: clamp(1.2rem, 2.6vw, 2.2rem); }
  .vc-dims-h { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.15rem, 1.7vw, 1.4rem); line-height: 1.2; color: var(--color-brand-text); margin: 0 0 1.1rem; }
  .vc-dims-line { padding: 1rem 0; border-top: 1px solid rgba(31,59,44,0.14); }
  .vc-dims-line:first-of-type { border-top: 0; padding-top: 0; }
  .vc-dims-fill { display: inline-block; font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; color: var(--forest-light); }
  .vc-dims-line dl { margin: 0.7rem 0 0; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.6rem; }
  .vc-dims-line dt { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brass); }
  .vc-dims-line dd { margin: 0.25rem 0 0; font-size: 0.9rem; font-weight: 600; color: var(--color-brand-text); }
  .vc-dims-warn { margin: 1.2rem 0 0; padding: 1rem 1.15rem; background: var(--color-brand-surface); border-radius: 0.7rem; font-size: 0.9rem; line-height: 1.62; color: var(--color-brand-muted); }

  /* ============ COMPARISON (the page's one table) ============ */
  /* ⚠️ The table has NO band CSS of its own any more — it lives inside §Pick the Structure, behind
     a `.vc-part` marker. Only the rail and the grid survive. */
  .vc-tbl-rail { overflow-x: auto; }
  /* ⚠️ ROW-major in the DOM (a header row of five, then four rows of label + four values), so the
     column template is inlined from `cmpCols.length`. `display:grid` only — NO grid-auto-flow:
     column. Switching the flow without reordering the markup scrambles all twenty cells. */
  .vc-tbl-track { display: grid; border: 1px solid rgba(96,92,78,0.3); border-top: 0; }
  /* ⚠️ A LIGHT header on purpose — the parent vape page's table runs a dark header band, and this
     one must not read as the same object. Brass hairline on top, brass numerals, no fill block. */
  .vc-tbl-name { margin: 0; background: var(--ivory); color: var(--color-brand-text); font-family: var(--font-heading); font-weight: 700; font-size: 1rem; line-height: 1.3; text-align: center; padding: 0.95rem 0.6rem 1rem; border-top: 3px solid var(--brass); display: flex; flex-direction: column; gap: 0.3rem; align-items: center; }
  .vc-tbl-idx { font-family: var(--font-heading); font-size: 0.76rem; letter-spacing: 0.1em; color: var(--brass); }
  .vc-tbl-label, .vc-tbl-cell { background-color: var(--ivory); }
  .vc-tbl-lite { background-image: linear-gradient(rgba(31,59,44,0.035), rgba(31,59,44,0.035)); }
  .vc-tbl-rule { border-top: 1px solid rgba(96,92,78,0.22); }
  /* ⚠️ The highlighted row KEEPS its row rule (house rule) and takes a brass tint, because "Not for"
     is the row a buyer actually decides on. */
  .vc-tbl-hl { background-color: rgba(176,141,76,0.14); background-image: none; font-weight: 600; }
  .vc-tbl-label { position: sticky; left: 0; z-index: 1; margin: 0; min-height: 56px; display: flex; align-items: center; padding: 0.35rem 1rem; font-size: 0.86rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-brand-text); }
  .vc-tbl-cell { margin: 0; min-height: 56px; display: flex; align-items: center; justify-content: center; padding: 0.4rem 0.6rem; font-size: 0.9rem; line-height: 1.35; text-align: center; color: var(--color-brand-text); }

  /* ============ MID CTA — the page's one mid-point ask ============ */
  /* ============ MID CTA — centred, like the hero and the final band ============ */
  .vc-mid { background: linear-gradient(rgba(46,79,61,0.84), rgba(46,79,61,0.86)), url('https://img.leelinepackage.com/custom-vape-cartridge/mid-cta.webp') center/cover no-repeat; color: var(--ivory); padding: clamp(3rem, 6.5vw, 4.8rem) 0; text-align: center; }
  .vc-mid-inner { display: flex; flex-direction: column; align-items: center; }
  .vc-mid-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.55rem, 3vw, 2.3rem); line-height: 1.08; letter-spacing: -0.025em; color: #fff; margin: 0.9rem auto 0; }
  .vc-mid-title em { font-style: italic; color: #E3C29A; }
  .vc-mid-sub { font-size: clamp(0.96rem, 1.4vw, 1.05rem); line-height: 1.68; color: rgba(245,240,229,0.84); margin: 1rem auto 0; max-width: 58ch; }
  .vc-mid-cta { display: flex; flex-direction: column; align-items: center; margin-top: 1.8rem; }

  /* ============ WHAT BUYERS SAY — byline first, avatar first, no cards ============
     ⚠️ The avatar is REQUIRED (client). */
  .vc-rev { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .vc-rev .section-head { margin-bottom: clamp(2.2rem, 4.4vw, 3.2rem); }
  .vc-rev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.6rem, 3.6vw, 3rem); align-items: start; }
  .vc-rev-card { margin: 0; padding-top: clamp(1.2rem, 2.4vw, 1.7rem); border-top: 2px solid var(--brass); }
  .vc-rev-by { display: flex; align-items: center; gap: 1rem; margin-bottom: clamp(1.1rem, 2.2vw, 1.5rem); }
  .vc-rev-av { width: 84px; height: 84px; flex: 0 0 auto; border-radius: 50%; border: 1px solid rgba(31,59,44,0.2); }
  .vc-rev-id strong { display: block; font-family: var(--font-body); font-weight: 700; font-size: 0.98rem; color: var(--color-brand-text); }
  .vc-rev-id span { display: block; margin-top: 0.22rem; font-size: 0.82rem; line-height: 1.45; color: var(--color-brand-muted); }
  .vc-rev-copy p { font-size: 0.98rem; line-height: 1.78; color: var(--color-brand-text); margin: 0 0 0.95rem; }
  .vc-rev-copy p:last-child { margin-bottom: 0; }

  /* ============ FAQ ============ */
  .vc-faq { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .vc-faq-list { max-width: 62rem; margin-inline: auto; display: grid; gap: 0.7rem; }
  .vc-faq-item { background: var(--ivory); border: 1px solid rgba(31,59,44,0.17); border-radius: 0.9rem; overflow: hidden; }
  .vc-faq-item summary { display: flex; align-items: baseline; gap: 0.9rem; cursor: pointer; list-style: none; padding: 1.05rem clamp(1.1rem, 2.2vw, 1.5rem); font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.02rem, 1.5vw, 1.14rem); line-height: 1.35; color: var(--color-brand-text); }
  .vc-faq-item summary::-webkit-details-marker { display: none; }
  .vc-faq-num { font-family: var(--font-heading); font-size: 0.85rem; color: var(--brass); flex: 0 0 auto; }
  .vc-faq-a { padding: 0 clamp(1.1rem, 2.2vw, 1.5rem) 1.15rem; }
  .vc-faq-a p { font-size: 0.95rem; line-height: 1.68; color: var(--color-brand-muted); margin: 0; }

  /* ============ FINAL CTA ============ */
  /* ⚠️ The dark bands here are GRADIENTS, not photograph backgrounds — the client's shots have not
     landed yet, and a background URL would 404 until they do. When the folder arrives this band
     (and the hero slot) are the two to revisit. */
  .vc-final { background: linear-gradient(150deg, rgba(20,38,27,0.90) 0%, rgba(31,59,44,0.85) 58%, rgba(46,79,61,0.80) 100%), url('https://img.leelinepackage.com/custom-vape-cartridge/final-cta.webp') center/cover no-repeat; color: var(--ivory); text-align: center; padding: clamp(4.5rem, 10vw, 8rem) 0; overflow: hidden; }
  .vc-final::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 62% at 50% 0%, rgba(228,181,77,0.18), transparent 70%); pointer-events: none; }
  .vc-final-inner { position: relative; z-index: 1; }
  .vc-final-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.85rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.028em; color: #fff; margin: 1.1rem auto 0; }
  .vc-final-title em { font-style: italic; color: #E3C29A; }
  .vc-final-sub { font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.7; color: rgba(245,240,229,0.84); max-width: 56ch; margin: 1.2rem auto 0; }
  .vc-final .section-cta { justify-content: center; }

  /* ============ responsive ============ */
  @media (max-width: 1024px) {
    .vc-count-row { grid-template-columns: clamp(4rem, 12vw, 6rem) minmax(0, 1fr); }
    .vc-count-ph { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
    .vc-dims-grid { grid-template-columns: 1fr; gap: clamp(1.8rem, 4vw, 2.6rem); }
    .vc-dims-spec { border-left: 0; padding-left: 0; }
    .vc-scope-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
  @media (max-width: 900px) {
    .vc-what-grid { grid-template-columns: 1fr; }
    .vc-rev-grid { grid-template-columns: 1fr; gap: 1.8rem; }
    .vc-lock-grid { grid-template-columns: 1fr; }
    .vc-slot-3 { grid-template-columns: 1fr; }
    .vc-ship-list { grid-template-columns: 1fr; }
    .vc-oil-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .vc-hero { min-height: 0; }
    .vc-figs { grid-template-columns: 1fr; gap: 0.7rem; }
    .vc-count-row { grid-template-columns: 1fr; text-align: left; }
    .vc-count-num { text-align: left; }
    .vc-slot-cradles { grid-template-columns: 1fr; }
    .vc-scope-links li { grid-template-columns: 1fr; }
    .vc-dims-line dl { grid-template-columns: 1fr 1fr; }
    .vc-hero-cta .btn, .vc-mid-cta .btn { width: 100%; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // FAQ is an accordion: opening one closes the others.
  const faqItems = Array.from(document.querySelectorAll('.vc-faq-item'));
  faqItems.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) faqItems.forEach((o) => { if (o !== d) o.open = false; });
  }));
</script>
