  .fx-quote-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.2rem, 3vw, 2rem); max-width: 1080px; margin-inline: auto; }
  .fx-quote-card { background: var(--ivory); border: 1px solid rgba(31,59,44,0.1); border-radius: 1.2rem; padding: clamp(1.5rem, 3vw, 2.1rem); display: flex; flex-direction: column; gap: 1.4rem; margin: 0; }
  .fx-quote-copy { margin: 0; }
  .fx-quote-copy p { margin: 0; font-size: 1rem; line-height: 1.72; color: var(--color-brand-text); }
  .fx-quote-copy p + p { margin-top: 1rem; }
  .fx-quote-person { display: flex; align-items: center; gap: 0.9rem; margin-top: auto; padding-top: 1.2rem; border-top: 1px solid rgba(31,59,44,0.12); }
  .fx-avatar { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .fx-quote-person strong { display: block; font-size: 0.98rem; color: var(--color-brand-text); }
  .fx-quote-person span { display: block; font-size: 0.82rem; color: var(--color-brand-muted); margin-top: 0.1rem; }

  /* ============ FAQ ============ */
  .fx-faq { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; content-visibility: auto; contain-intrinsic-size: auto 600px; }
  .fx-faq-list { display: flex; flex-direction: column; max-width: 820px; margin-inline: auto; }
  .fx-faq-item { border-top: 1px solid rgba(31,59,44,0.14); background: var(--color-brand-surface); }
  .fx-faq-item:first-child { border-radius: 1rem 1rem 0 0; }
  .fx-faq-item:last-child { border-bottom: 1px solid rgba(31,59,44,0.14); border-radius: 0 0 1rem 1rem; }
  .fx-faq-item + .fx-faq-item { margin-top: 0.6rem; }
  .fx-faq-n { font-family: var(--font-heading); font-weight: 600; color: var(--brass); margin-right: 0.9rem; }
  .fx-faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1rem; padding: 1.3rem 1.2rem; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.02rem, 1.8vw, 1.2rem); color: var(--color-brand-text); }
  .fx-faq-item summary::-webkit-details-marker { display: none; }
  .fx-faq-item summary::after { content: '+'; font-family: var(--font-body); font-weight: 400; font-size: 1.6rem; color: var(--brass); transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1); margin-left: auto; }
  .fx-faq-item[open] summary::after { transform: rotate(45deg); }
  .fx-faq-a { padding: 0 1.2rem 1.4rem; }
  .fx-faq-a p { font-size: 0.97rem; line-height: 1.7; color: var(--color-brand-muted); max-width: 68ch; margin: 0; }

  /* ============ FINAL CTA (dark) ============ */
  .fx-final {
    position: relative; overflow: hidden; color: var(--ivory);
    background: linear-gradient(180deg, rgba(20,38,27,0.68) 0%, rgba(20,38,27,0.8) 100%), url('https://img.leelinepackage.com/folding-cartons/final-cta.webp') center / cover no-repeat;
    /* 2.5cm shorter than the shared CTA padding — 1.25cm off each side, floored
       so narrow viewports do not lose all their breathing room */
    padding: max(3rem, calc(clamp(3.5rem, 9vw, 7.5rem) - 1.25cm)) 0;
  }
  .fx-final-shade { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(48% 70% at 22% 30%, rgba(228,181,77,0.13), transparent 70%); }
  .fx-final-inner { position: relative; text-align: center; }
  .fx-final-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.4rem, 6vw, 4.4rem); line-height: 1.04; letter-spacing: -0.025em; color: #fff; text-shadow: 0 2px 24px rgba(20,38,27,0.4); margin: 1.1rem auto 0; max-width: 22ch; text-wrap: balance; }
  .fx-final-title em { font-style: italic; color: #E3C29A; }
  .fx-final-sub { font-size: 1.06rem; line-height: 1.75; color: rgba(255,255,255,0.94); max-width: 62ch; margin: 1.5rem auto 0; text-shadow: 0 1px 18px rgba(20,38,27,0.4); }

  /* ============ responsive ============ */
