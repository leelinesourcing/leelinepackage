  .cb-opt { margin: 0; background: var(--ivory); border: 1px solid rgba(31,59,44,0.1); border-radius: 1rem; overflow: hidden; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease; }
