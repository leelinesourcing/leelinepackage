---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const RB = `${R2}/rigid-boxes`;

/* The nine builds, in the order a buyer usually meets them. Each card says why the
   structure earns its place and who it suits — the mechanism lives in the section
   below, so no line here describes how a box is put together. */
const types = [
  { n: '01', name: 'Magnetic Closure Rigid Box', img: `${RB}/type-magnetic.webp`, w: 550, h: 525,
    alt: 'An open pink rigid box with a floral print on the lid and a printed inner panel',
    d: 'Hidden magnets pull the lid shut, so the box opens like a book and closes with a snap — the build most often kept after the product is gone.',
    best: 'Cosmetics, gift sets, small tech' },
  { n: '02', name: 'Drawer Box', img: `${RB}/type-drawer.webp`, w: 550, h: 525,
    alt: 'A stack of pink drawer boxes, each with a ribbon pull on the drawer front',
    d: 'One pull slides the tray clear, which suits a set that has to be shown rather than tipped onto a table.',
    best: 'Jewellery sets, hampers, candles' },
  { n: '03', name: 'Shoulder-Neck Box', img: `${RB}/type-shoulder-neck.webp`, w: 550, h: 525,
    alt: 'A white and a black two-piece rigid box with their lids resting beside them',
    d: 'The lid sits over a raised shoulder, which keeps both halves lined up on every box in a run and lets the lid lift without sticking.',
    best: 'Premium retail, cosmetics, spirits' },
  { n: '04', name: 'Collapsible Rigid Box', img: `${RB}/type-collapsible.webp`, w: 550, h: 525,
    alt: 'A dark green rigid box folded part-way down to show how the corners collapse',
    d: 'The build for a brand that fills its own boxes and pays its own freight.',
    best: 'E-commerce, subscription, DTC' },
  { n: '05', name: 'Book-Style Rigid Box', img: `${RB}/type-book-style.webp`, w: 550, h: 525,
    alt: 'A silver rigid box hinged open like a book, showing a patterned inside panel',
    d: 'Hinged along one edge, the inside becomes a second surface — room for a printed story or a fitted tray.',
    best: 'Corporate gifting, keepsakes, media' },
  { n: '06', name: 'Rigid Jewelry Box', img: `${RB}/type-jewelry.webp`, w: 550, h: 525,
    alt: 'A white jewellery box with a mirrored lid open above tiered drawers of rings',
    d: 'A mirrored lid and tiered drawers, built at the scale of a ring rather than a shoebox.',
    best: 'Rings, watches, fine jewellery' },
  { n: '07', name: 'Rigid Shoe Box', img: `${RB}/type-shoe.webp`, w: 550, h: 525,
    alt: 'An open navy rigid shoe box with a brown leather shoe resting inside on tissue',
    d: 'A long, deep shell that keeps a pair in shape through courier handling.',
    best: 'Footwear, apparel, limited drops' },
  { n: '08', name: 'Cosmetic Rigid Box', img: `${RB}/type-cosmetic.webp`, w: 550, h: 525,
    alt: 'An open brown rigid box with glass bottles held upright in a fitted tray',
    d: 'A layered insert stands glass upright; nothing knocks against anything else on the way to a counter.',
    best: 'Skincare, fragrance, makeup' },
  { n: '09', name: 'Luxury Gift Box', img: `${RB}/type-gift.webp`, w: 550, h: 525,
    alt: 'A floral-printed rigid gift box tied with a gold ribbon beside macarons',
    d: 'The gifting build — printed wrap, ribbon or magnetic lid, and an insert cut to the present it holds.',
    best: 'Gifting, seasonal, confectionery' },
];

/* The hero promise, argued. Three numbers a buyer can act on: what the freight
   costs, what the fill line needs, and what changes in the box itself. */
const flatRows = [
  { v: '60%', l: 'Freight', d: 'A container is priced on the space it takes, and a knocked-down shell takes a fraction of an assembled one — up to 60% off the bill for bulk orders.' },
  { v: '0', l: 'Tools', d: 'The corners lock by hand. No glue, no jig, no fixture to hold the frame while it sets.' },
  { v: 'Same', l: 'Board', d: 'The core, the wrap and the insert are the ones a fixed box uses.' },
];

/* Four decisions taken before the press runs. */
const custom = [
  { n: '01', t: 'Structures', img: `${RB}/custom-structures.webp`, w: 600, h: 470,
    alt: 'Silver, gold and red rigid boxes die-cut into star shapes',
    d: 'Bespoke die-cut outlines, divided compartments and lids that slide instead of lift. The shape is drawn from the product\u2019s own measurements, so nothing has to be packed around a compromise.' },
  { n: '02', t: 'Inserts', img: `${RB}/custom-inserts.webp`, w: 600, h: 470,
    alt: 'A gradient-printed rigid box holding a white six-compartment insert tray',
    d: 'The insert is what holds the item still and sets the height it presents at. Foam, board or moulded pulp, cut to the exact object rather than padded out with filler.' },
  { n: '03', t: 'Surface', img: `${RB}/custom-colour.webp`, w: 600, h: 470,
    alt: 'A gold foil-stamped rigid box and its matching tray',
    d: 'Wrap and finish are settled as a single decision, before the first plate is made. What the surface feels like in the hand is chosen at the same time as what it looks like on a shelf.' },
  { n: '04', t: 'Fittings', img: `${RB}/custom-accessories.webp`, w: 600, h: 470,
    alt: 'Two pink rigid boxes with tan leather handles and printed lids',
    d: 'Ribbon pulls, leather handles, magnetic closures, elastic bands and window film. These are the details a buyer meets first, so they are never an afterthought.' },
];

/* The core a rigid box is built on, and the surface wrapped over it. */
const materials = [
  { t: 'Grey Chipboard', img: `${RB}/mat-grey-chipboard.webp`, w: 400, h: 400,
    alt: 'A stack of grey recycled chipboard sheets fanned on a pale surface',
    d: 'Recycled pulp pressed into a dense core — the reason a rigid box keeps a shape a folding carton cannot.',
    best: 'The structural core of every rigid box' },
  { t: 'Duplex Chipboard', img: `${RB}/mat-duplex-chipboard.webp`, w: 400, h: 400,
    alt: 'A stack of duplex board sheets with a kraft back and a white face',
    d: 'Grey on the back and white on the face, so a printed wrap needs no separate liner.',
    best: 'Printed wraps on a tighter budget' },
  { t: 'SBS C2S', img: `${RB}/mat-sbs-c2s.webp`, w: 400, h: 400,
    alt: 'A roll of coated bleached white carton board on a grey background',
    d: 'Bleached board coated on both faces; the smoothest sheet for fine line detail and a soft-touch lamination.',
    best: 'Cosmetics and premium retail' },
  { t: 'White Kraft', img: `${RB}/mat-white-kraft.webp`, w: 400, h: 400,
    alt: 'A fanned stack of white kraft paper on a wooden block',
    d: 'Unbleached fibre with a clean white face, for a natural look without the brown.',
    best: 'Eco ranges and natural goods' },
];

/* Finishing on any board — five processes, all of them visible in a photograph.
   Soft-touch IS the matte laminate (one look, one name), and gloss lamination was
   dropped because a clear film over the same print is indistinguishable in a flat
   shot without raking light. Window film is an aperture, not a surface finish. */
const finishes = [
  { t: 'Hot Foil', img: `${RB}/finish-hot-foil-v2.webp` },
  { t: 'Emboss', img: `${RB}/finish-emboss-v2.webp` },
  { t: 'Deboss', img: `${RB}/finish-deboss-v2.webp` },
  { t: 'Spot UV', img: `${RB}/finish-spot-uv-v2.webp` },
  { t: 'Soft-Touch', img: `${RB}/finish-soft-touch-v2.webp` },
];

/* Client scenes — the six the user supplied, captioned from what each shot shows. */
const scenes = [
  { img: `${RB}/scene-1-v2.webp`, t: 'A first order, opened at the table', alt: 'A woman lifting the lid of a black rigid box on a table' },
  { img: `${RB}/scene-2-v2.webp`, t: 'A range on the shop shelf', alt: 'A shop owner holding a white ribboned rigid box in front of shelves of packaged goods' },
  { img: `${RB}/scene-3-v2.webp`, t: 'Wrapped by hand before it ships', alt: 'Hands folding tissue paper into a cream rigid box on a wooden table' },
  { img: `${RB}/scene-4-v2.webp`, t: 'The lid comes off', alt: 'Hands opening a rigid box to show its printed black-and-white interior' },
  { img: `${RB}/scene-5-v2.webp`, t: 'Kept, and put back to work', alt: 'An open green rigid box on a wooden desk beside a mirror and a plant' },
  { img: `${RB}/scene-6-v2.webp`, t: 'A gift set, presented', alt: 'An open rigid gift box holding gold cosmetic jars, with a chain handle' },
];

/* Where buyers usually start. Each entry leads with what the buyer gets; the
   structure and insert are the small print underneath, not the pitch. */
const match = [
  { p: 'Fine jewellery', b: 'A lid that lifts clear and a tray that holds the piece at the height the eye lands, so it reads as a piece before the price is seen.', m: 'Shoulder-neck · velour tray' },
  { p: 'Skincare and fragrance', b: 'Glass stands upright in a cut cradle, so nothing shifts in a courier\u2019s van and the bottle reads as the product rather than the padding.', m: 'Magnetic closure · die-cut cradle' },
  { p: 'Watches and small tech', b: 'Travels flat, arrives rigid, and holds the product without a mark on it — at a freight cost a built box cannot match.', m: 'Collapsible magnetic · flocked cushion' },
  { p: 'Spirits and premium gifting', b: 'A two-piece shell with a cradle cut to the bottle, so the pack carries the same gravity as what is poured from it.', m: 'Two-piece lid and base · bottle cradle' },
  { p: 'Footwear and apparel', b: 'A long drawer box that holds its form in transit, so a pair arrives as crisp as it left the line.', m: 'Drawer or long shoe box · tissue wrap' },
  { p: 'Confectionery and hampers', b: 'A partitioned tray stops the contents moving, so a hamper arrives arranged instead of rearranged.', m: 'Collapsible shell · partitioned tray' },
];

/* Boxes that left the floor — what the buyer got, not how it was built. */
const cases = [
  { img: `${RB}/case-1.webp`, w: 600, h: 400, tag: 'Jewellery', t: 'A Black Shell, Printed Inside',
    alt: 'Several black and white rigid boxes, one open to show a foam insert holding a tray',
    d: 'A box that survives the counter and the journey home — the lid lifts on hidden magnets, a matte wrap that does not fingerprint, and a foam insert cut so the tray cannot shift.' },
  { img: `${RB}/case-2.webp`, w: 600, h: 400, tag: 'Custom shapes', t: 'A Shape Off the Standard Blank',
    alt: 'Hexagonal and curved rigid boxes in kraft, cream and orange',
    d: 'A silhouette a stock box cannot give you, die-cut to its own outline so the corners stay sharp and the shelf presence is unmistakable at arm\u2019s length.' },
  { img: `${RB}/case-3.webp`, w: 600, h: 400, tag: 'Retail range', t: 'Many Titles, Shared Board',
    alt: 'A colourful stack of printed rigid boxes from several brands',
    d: 'A whole range on one board thickness, so the titles line up on a shelf and adding another costs a plate rather than a fresh tooling change.' },
  { img: `${RB}/case-4.webp`, w: 600, h: 400, tag: 'Gifting', t: 'A Holiday Stack',
    alt: 'A large stack of lidded gift boxes in pink, teal and orange',
    d: 'Six wrap colours and a spread of sizes produced as a single run, so the gift table arrives looking designed rather than assembled.' },
];

/* Four steps, the same four for a sample and for a repeat order.
   `icon` is the raw inner SVG for the chip sitting at the start of each connector. */
const steps = [
  { n: '01', t: 'Brief', d: 'Bring the product dimensions, the quantity and whatever artwork exists.',
    icon: '<path d="M6 3.5h8l4 4v13H6z"/><path d="M14 3.5v4h4"/><path d="M9 12h6M9 15.5h4"/>' },
  { n: '02', t: 'Mockup, Then Sample', d: 'A 3D mockup goes out before anything is cut, and a physical sample follows for the fit and finish in the hand.',
    icon: '<path d="M12 3.2 20.2 7.6v8.8L12 20.8 3.8 16.4V7.6z"/><path d="M3.8 7.6 12 12l8.2-4.4M12 12v8.8"/>' },
  { n: '03', t: 'Quote and Order', d: 'Quoted per structure and per artwork, itemised across board, print and finish, with the unit price shown at each quantity band.',
    icon: '<path d="M11.4 3.4H20v8.6l-8.6 8.6-8.8-8.8z"/><circle cx="16.3" cy="7.3" r="1.5"/>' },
  { n: '04', t: 'Production and Shipping', d: 'Runs from the approved sample, with the floor status reported at each stage.',
    icon: '<path d="M2.5 6.6h11v9h-11z"/><path d="M13.5 9.6h3.9l3.1 3.1v2.9h-7z"/><circle cx="6.6" cy="17.6" r="1.7"/><circle cx="16.6" cy="17.6" r="1.7"/>' },
];

/* Recycling answers, not a slogan. The greyboard core's own recycled content is
   stated on the board card above, so it is not repeated here. */
const eco = [
  { t: 'FSC® chain-of-custody board', d: 'Pulp traced from a certified forest through to the delivered pallet.' },
  { t: 'Production waste reused', d: 'Trim and offcuts are baled and sold back into the paper stream rather than landfilled.' },
  { t: 'Soy inks, water-based adhesive', d: 'No solvent-borne VOC vented over the press hall.' },
  { t: 'Accepted by paper recycling', d: 'Standard rigid boxes recycle in most paper streams once the fittings come out.' },
];

/* The original site's own reviewers. The substance is theirs — every figure and
   claim below is already in their review; only the phrasing was expanded to three
   paragraphs each. Do not add claims they did not make. */
const reviews = [
  { m: '+30%', ml: 'Repeat orders', img: `${RB}/avatar-david.webp`,
    alt: 'Portrait of David Patel',
    q: [
      'We sell a premium snack line, so the packaging has to say that before anyone tastes anything. The rigid setup with window cutouts shows the products off properly, which a printed carton with a photo on it never did.',
      'The eco-friendly rigid board option also covered the sustainability goals we had already made public. Our bulk order of 2,000 units was handled without a hitch — consistent quality right across the run, and a turnaround that never became the reason a date slipped.',
      'Repeat orders are up 30% since the packaging changed. Top-notch service from start to finish.',
    ],
    n: 'David Patel', r: 'CEO, GourmetSnacks LLC' },
  { m: '0', ml: 'Units damaged', img: `${RB}/avatar-michael.webp`,
    alt: 'Portrait of Michael Rivera',
    q: [
      'We ship gadgets worldwide, so the box has to survive the courier before it has to look good. Thick chipboard and precise die-cut inserts were the two things that decided it for us.',
      'Nothing moved inside. The offset printing came out crisp, and a 500-unit rush order was accommodated without anyone asking us to move our own date.',
      'No dents and no delays — it took a recurring headache out of fulfilment, and our customer satisfaction scores moved with it.',
    ],
    n: 'Michael Rivera', r: 'Operations Manager, TechGadgets Inc.' },
];

/* Only what no section above answers. The order minimum is on the hero rail, and
   recyclability is covered in the materials section — neither is repeated.
   ⚠️ Q5 and Q6 assert operational detail (delivery addresses, tooling retention)
   that is NOT in the original site copy — confirm with the client. */
const faqs = [
  { q: 'Can I send a sketch or a reference box instead of a production file?', a: 'Yes — a dimensioned sketch, a reference box or a print-ready file all work. What matters is the product dimensions and how it should sit inside.' },
  { q: 'Can you match my brand colour exactly?', a: 'Yes. Pantone matching is used across every element, and supplying the colour codes up front gives the closest result between the screen and the ink.' },
  { q: 'How fast can a rush order run?', a: '5–7 business days plus shipping, on a rush slot. The fee depends on the quantity and how complex the build is.' },
  { q: 'What happens if a batch does not match the approved sample?', a: 'The signed sample is the reference for the whole run. Where the variance sits with us, the batch is remade or the order credited.' },
  { q: 'Can the boxes be delivered straight to our warehouse or a 3PL?', a: 'Yes. Boxes leave the plant by sea or air, and can be routed to a port, a distribution centre or straight to your own dock.' },
  { q: 'Do you keep the tooling on file for a reorder?', a: 'The die and the plate set stay against the artwork, so a second run of the same structure and print does not start from the drawing board again.' },
];

const seo = {
  title: 'Custom Rigid Boxes Manufacturer: 90° V-Cut 35% Fewer Returns',
  description: 'Custom rigid boxes built with automated corner positioning to cut unboxing defects and returns by up to 35%. 90° V-cut corners, 500-unit MOQ, samples in 5 days.',
  keywords: 'custom rigid boxes, custom rigid gift boxes, luxury rigid boxes, custom magnetic closure boxes, wholesale custom rigid boxes, custom printed rigid boxes, collapsible rigid boxes, custom luxury gift boxes, magnetic closure gift boxes, rigid box manufacturer China, rigid gift box supplier, FSC certified rigid boxes',
  canonical: 'https://www.leelinepackage.com/custom-rigid-boxes/',
  ogImage: `${RB}/hero-box.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Rigid Box Manufacturing',
      description: seo.description,
      serviceType: 'Custom rigid box design, collapsible construction, insert engineering and printing',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Rigid Boxes' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO — copy left · one large + two small images right · rail inside ============ -->
    <section class="rb-hero">
      <div class="wrap">
        <div class="rb-hero-grid">
            <div class="rb-hero-copy">
              <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Rigid box atelier &middot; China</span>
              <h1 class="rb-hero-title" data-reveal="up">Custom Rigid Boxes Manufacturer: 90&deg; V-Cut Precision, <em>Zero Corner Glueslip</em></h1>
              <p class="rb-hero-lede" data-reveal="up">Commercial-grade custom rigid boxes built with automated corner positioning to eliminate unboxing defects, reduce product return rates by up to 35%, and protect your brand margin.</p>
              <div class="rb-hero-actions" data-reveal="up">
                <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
                  Start a Rigid Box
                  <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>

            <div class="rb-hero-media" data-reveal="right">
              <figure class="rb-m1">
                <img src={`${RB}/hero-1-v2.webp`} alt="A wall of finished rigid boxes in different sizes, boards and finishes" width={1024} height={585} loading="eager" fetchpriority="high" decoding="sync" class="rb-img" />
              </figure>
              <div class="rb-m-side">
                <figure>
                  <img src={`${RB}/hero-2-v2.webp`} alt="A family of rigid boxes in teal, orange and navy with printed lids" width={650} height={500} loading="eager" decoding="async" class="rb-img" />
                </figure>
                <figure>
                  <img src={`${RB}/hero-3-v2.webp`} alt="A dark rigid box open beside a round tin and a printed compartment box" width={1100} height={734} loading="eager" decoding="async" class="rb-img" />
                </figure>
              </div>
            </div>
          </div>

          <ul class="rb-rail" data-reveal="up">
            <li><strong>500</strong><span>unit minimum</span></li>
            <li><strong>1M+</strong><span>units a month</span></li>
            <li><strong>4&ndash;6 weeks</strong><span>brief to pallet</span></li>
            <li><strong>99.8%</strong><span>on-time delivery</span></li>
          </ul>
      </div>

      <svg class="rb-hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,48 C210,90 420,10 690,32 C980,56 1210,86 1440,42 L1440,90 L0,90 Z" fill="var(--ivory)"/>
      </svg>
    </section>

    <!-- ============ CORNER — the hero's promise, explained ============ -->
    <section class="rb-corner" id="corner">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>The corner</span>
          <h2 class="section-title" data-reveal="up">A Corner That Lands in the Same Place, <em>Every Time</em></h2>
          <p class="section-sub" data-reveal="up">Four corners come out of the run aligned: no bare board along the edge, no printed panels stopping short of each other, and nothing that reads as improvised the moment the lid comes off.</p>
        </div>

        <div class="rb-corner-grid">
          <figure class="rb-corner-figure" data-reveal="left">
            <img src={`${RB}/corner-v2.webp`} alt="A printed rigid box photographed at the corner, showing the wrap turned in over the board edge" width={1024} height={1024} loading="lazy" decoding="async" class="rb-img" />
          </figure>

          <div class="rb-corner-body">
            <ul class="rb-corner-list">
              <li data-reveal="up">
                <span class="rb-corner-n">01</span>
                <div>
                  <h3>What the 90&deg; V-cut does</h3>
                  <p>The groove is cut at the corner angle, and the board is positioned by machine rather than by eye, so the wrap folds on the same line from the first box of a run to the last.</p>
                </div>
              </li>
              <li data-reveal="up" style="--d:0.08s">
                <span class="rb-corner-n">02</span>
                <div>
                  <h3>What it prevents</h3>
                  <p>The wrap riding up the board until a sliver of grey shows along the edge, and printed panels that should meet at the corner never quite touching.</p>
                </div>
              </li>
              <li data-reveal="up" style="--d:0.16s">
                <span class="rb-corner-n">03</span>
                <div>
                  <h3>Why it slips elsewhere</h3>
                  <p>A V-groove cut a fraction off the corner angle, or a wrap laid down before the board is fixed &mdash; so the paper finds its own line instead of the intended one.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ TYPES — nine builds, clay ============ -->
    <section class="rb-types" id="types">
      <div class="wrap">
        <div class="rb-types-head">
          <div>
            <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Constructions</span>
            <h2 class="section-title" data-reveal="up">Nine Rigid Box Constructions, <em>One Assembly Floor</em></h2>
          </div>
          <p class="section-sub" data-reveal="up">Magnetic, drawer, shoulder-neck or collapsible — the build is chosen for the product and the channel, then cut, wrapped and lined by the team that quoted it.</p>
        </div>

        <div class="rb-type-grid">
          {types.map((t, i) => (
            <article class="rb-type-card" data-reveal="up" style={`--d:${(i % 3) * 0.08}s`}>
              <figure class="rb-type-ph">
                <img src={t.img} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" class="rb-img" />
                <span class="rb-type-num">{t.n}</span>
              </figure>
              <div class="rb-type-body">
                <h3 class="rb-type-name">{t.name}</h3>
                <p class="rb-type-d">{t.d}</p>
                <p class="rb-type-best"><span>Best for</span>{t.best}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Match the Structure
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
