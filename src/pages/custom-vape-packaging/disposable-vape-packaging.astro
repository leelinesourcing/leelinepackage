  .dp-len-band { position: absolute; left: -3px; width: 8px; border-radius: 4px; background: var(--brass); top: calc(var(--from) * 100%); height: calc((var(--to) - var(--from)) * 100%); }
  .dp-len-tick { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.01em; color: var(--color-brand-muted); white-space: nowrap; }
