  .cr-rev-grid { margin: clamp(2rem, 4vw, 2.8rem) 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 2rem); }
  .cr-rev-card { position: relative; display: grid; gap: clamp(0.9rem, 2vw, 1.15rem); align-content: start; overflow: hidden; background: var(--ivory); border: 1px solid rgba(31, 59, 44, 0.16); border-radius: 1.1rem; padding: clamp(1.4rem, 2.8vw, 2rem); }
  .cr-rev-glyph { position: absolute; top: 0.1rem; right: 0.9rem; z-index: 0; font-family: var(--font-heading); font-size: clamp(4.5rem, 9vw, 6.5rem); line-height: 1; color: rgba(176, 141, 76, 0.2); pointer-events: none; }
  .cr-rev-who { position: relative; z-index: 1; display: flex; align-items: center; gap: 0.9rem; }
  /* the reviewer photo — a clipped CIRCLE (the siblings use a rounded rectangle; this band is the
     round one, and the whole card must not mix a round avatar with a square crop). */
  .cr-rev-av { flex: 0 0 auto; width: 76px; height: 76px; border-radius: 50%; overflow: hidden; border: 2px solid rgba(176, 141, 76, 0.55); }
  .cr-rev-av img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cr-rev-id { display: grid; gap: 0.12rem; min-width: 0; }
  .cr-rev-id strong { font-family: var(--font-heading); font-weight: 600; font-size: 1.14rem; line-height: 1.15; color: var(--color-brand-text); }
  .cr-rev-id .cr-rev-role { font-size: 0.87rem; line-height: 1.4; color: var(--color-brand-muted); }
  .cr-rev-id .cr-rev-loc { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass); }
  .cr-rev-body { position: relative; z-index: 1; display: grid; gap: 0.8rem; }
  .cr-rev-body p { margin: 0; font-size: 0.98rem; line-height: 1.72; color: var(--color-brand-text); }

  /* ============ 9 · SIX QUESTIONS (ivory) — a <details> accordion ============ */
  .cr-faq { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .cr-qa { display: grid; gap: clamp(0.7rem, 1.6vw, 1rem); }
