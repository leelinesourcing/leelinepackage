---
import Ornament from './Ornament.astro';
---

<section class="k-cta" id="quote">
  <div class="k-cta__medal" aria-hidden="true"><Ornament variant="medallion" /></div>
  <div class="container k-cta__inner">
    <p class="k-eyebrow" data-reveal="up"><Ornament variant="dot" class="k-eyebrow__dot" />Begin the Keepsake<Ornament variant="dot" class="k-eyebrow__dot" /></p>
    <h2 class="k-cta__title" data-reveal="up">
      Give them something<br /><em>to keep.</em>
    </h2>
    <p class="k-cta__lede" data-reveal="up">
      Your product deserves more than a box. It deserves a keepsake — engineered
      to protect, finished to impress, priced to scale.
    </p>
    <div class="k-cta__buttons" data-reveal="up">
      <a class="k-btn k-btn--gold k-btn--lg" href="#quote">Get a Free Quote</a>
      <a class="k-btn k-btn--line k-btn--lg" href="#quote">Request Your Sample Kit</a>
    </div>
    <p class="k-cta__micro" data-reveal="up"><Ornament variant="rule" class="k-cta__rule" />3D mockup in 24h · white-dummy sample in 3–5 days</p>
  </div>
</section>
