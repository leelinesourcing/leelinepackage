<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Trade switcher — one panel at a time. Panels carry no [data-reveal], so a
  // panel that is hidden at load cannot be left stuck at opacity 0.
  const tabBtns = Array.from(document.querySelectorAll('.pb-tab-btn'));
  const panels = Array.from(document.querySelectorAll('.pb-panel'));
  const selectTab = (key) => {
    tabBtns.forEach((b) => {
      const on = b.dataset.tab === key;
      b.classList.toggle('pb-tab-btn--active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach((p) => p.classList.toggle('pb-panel--active', p.dataset.panel === key));
  };
  tabBtns.forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.tab)));
  tabBtns.forEach((b, i) => {
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabBtns.length) % tabBtns.length;
      tabBtns[next].focus();
      selectTab(tabBtns[next].dataset.tab);
    });
  });

  // Scenes carousel — 3-up, seamless loop in both directions. A copy of the
  // last three slides sits before slide one and a copy of the first three sits
  // after the last, so stepping past either end animates onto a clone and is
  // then snapped (no transition) onto the matching real slide. No visible jump.
  const carTrack = document.querySelector('.pb-car-track');
  if (carTrack) {
    const slides = Array.from(carTrack.children);
    const N = slides.length;
    if (N > 3) {
      const clones = 3;
      for (let k = 0; k < clones; k++) {
        const c = slides[(N - clones + k) % N].cloneNode(true);
        c.classList.add('pb-car-clone');
        c.setAttribute('aria-hidden', 'true');
        carTrack.insertBefore(c, slides[0]);
      }
      for (let k = 0; k < clones; k++) {
        const c = slides[k % N].cloneNode(true);
        c.classList.add('pb-car-clone');
        c.setAttribute('aria-hidden', 'true');
        carTrack.appendChild(c);
      }
      let idx = clones;

      const step = () => {
        const gap = parseFloat(getComputedStyle(carTrack).gap) || 0;
        return carTrack.children[clones].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        carTrack.style.transition = animate ? 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        carTrack.style.transform = `translateX(${-idx * step()}px)`;
      };
      const go = (dir) => {
        if (carTrack._busy) return;
        carTrack._busy = true;
        idx += dir;
        move(true);
        setTimeout(() => {
          if (idx < clones) idx += N;
          else if (idx > clones + N - 1) idx -= N;
          move(false);
          carTrack._busy = false;
        }, 520);
      };

      const prevBtn = document.querySelector('.pb-car-btn--prev');
      const nextBtn = document.querySelector('.pb-car-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!carTrack._busy) move(false); });
    }
  }
</script>
