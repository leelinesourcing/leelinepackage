---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const CB = `${R2}/corrugated-boxes`;

/* The nine constructions. Named for the search a buyer actually types rather
   than for the trade acronym, and each `d` line is the consequence the buyer's
   own customer feels — no card restates the section intro or another card. */
const types = [
  { n: 'RSC-01', key: 'type-shipping-v2', name: 'Custom Corrugated Shipping Boxes', spec: '32–48 ECT',
    alt: 'An open natural kraft regular slotted carton with its four top flaps folded outward, photographed on a white sweep',
    d: 'A carton cut to your product\u2019s own length, width and depth, which is what stops a pallet carrying air that is charged as freight.' },
  { n: 'ML-02', key: 'type-mailer-v2', name: 'Corrugated Mailer Boxes', spec: 'Self-locking, no tape',
    alt: 'A kraft corrugated book wrap mailer lying open with a printed product carton resting inside it',
    d: 'A wrap that folds around the contents and locks without tape, taking a parcel out of a gray bag and into printed board.' },
  { n: 'DC-03', key: 'type-diecut-v2', name: 'Die-Cut Corrugated Boxes', spec: 'Any aperture, same die',
    alt: 'Two kraft cartons with die-cut apertures, a tall box with a shaped front opening and a shallow open tray, both printed with a script logo',
    d: 'A shaped front or a cut window pressed from the same die as the body. The aperture is part of the blank rather than a second operation.' },
  { n: 'HD-04', key: 'type-heavyduty-v2', name: 'Heavy Duty Corrugated Boxes', spec: 'Divided cells, die-cut handle',
    alt: 'A printed kraft six-bottle corrugated carrier with internal dividers and a die-cut handle, printed with pink lettering',
    d: 'Divided cells and a reinforced base for the carriers that end up on the bottom layer of a pallet with everything else above them.' },
  { n: 'PR-05', key: 'type-printed-v2', name: 'Custom Printed Corrugated Boxes', spec: 'Flexo, spot or full color',
    alt: 'A printed corrugated produce crate with a die-cut handle and green FRESH FRUIT lettering, holding apples and oranges',
    d: 'Full-panel print on kraft liner, holding registration on a board face that is not flat — which is where most corrugated print fails.' },
  { n: 'WS-06', key: 'type-wholesale-v4', name: 'Wholesale Corrugated Boxes', spec: '500 – 500,000 units',
    alt: 'Kraft corrugated cartons printed with a BOX 25 PACK mark, stacked and strapped on a wooden pallet',
    d: 'The same specification held across a long run, with the unit rate stepping down at the volume tier the order actually reaches.' },
  { n: 'DW-07', key: 'type-doublewall-v2', name: 'Double Wall Corrugated Boxes', spec: 'BC and EB, 6.4 mm',
    alt: 'A charcoal two-piece telescoping carton with a foil-stamped lid, lifted to show a crimson interior base',
    d: 'Two flutes bonded, for a lid-and-base box that keeps its shape under a stack and still reads as a gift.' },
  { n: 'PK-08', key: 'type-packaging-v4', name: 'Custom Corrugated Packaging Boxes', spec: 'Roll end tuck top',
    alt: 'Four plain kraft corrugated cartons: an open regular slotted carton, a tall carton, a flat tray and a roll-end box',
    d: 'A roll-end assembly that folds up from the flat blank on the packing bench, with no glue line waiting to fail in transit.' },
  { n: 'TL-09', key: 'type-tablock-v5', name: 'Tab-Lock Corrugated Boxes', spec: 'No glue, no staples',
    alt: 'A printed two-piece carton in blue with a floral pattern and a Your Open Space wordmark, shown closed and open',
    d: 'Boxes that assemble by folding and unfold the same way, which is what keeps a returns bench moving without a knife.' },
];

/* Six flute grades. The pair (mm, flutes per 300 mm) is the published nominal
   for each grade. `load` is the SAFE top-load for a 400 x 300 x 300 mm carton
   conditioned 72 h at 50% RH — the lab crush figure already divided by 15, the
   conservative end of the range — and `stack` is the number of 10 kg cartons that
   load carries, so the two columns are the same statement.  */
const flutes = [
  { id: 'a', tab: 'A-Flute', code: 'A', mm: 4.7, per: 33, pitchMM: 300 / 33, ect: 32,
    load: '14 kg', stack: '600 mm',
    best: 'Fragile contents, where the board itself has to absorb the drop rather than pass it through.',
    aria: 'Cross-section of A-flute corrugated board: a coarse 4.7 millimeter fluted medium between two liners' },
  { id: 'b', tab: 'B-Flute', code: 'B', mm: 3.0, per: 47, pitchMM: 300 / 47, ect: 32,
    load: '16 kg', stack: '600 mm',
    best: 'Die-cut and printed cartons, because the fine flute leaves the flattest single-wall face to print on.',
    aria: 'Cross-section of B-flute corrugated board: a fine 3.0 millimeter fluted medium between two liners' },
  { id: 'c', tab: 'C-Flute', code: 'C', mm: 4.0, per: 39, pitchMM: 300 / 39, ect: 39,
    load: '19 kg', stack: '600 mm',
    best: 'The default shipping carton, and the grade with the widest stock availability at any mill.',
    aria: 'Cross-section of C-flute corrugated board: a 4.0 millimeter fluted medium between two liners' },
  { id: 'e', tab: 'E-Flute', code: 'E', mm: 1.6, per: 90, pitchMM: 300 / 90, ect: 26,
    load: '8 kg', stack: '300 mm',
    best: 'Litho-laminated retail packaging and shelf-ready trays, where the wall has to look like folded board.',
    aria: 'Cross-section of E-flute corrugated board: a dense 1.6 millimeter fluted medium between two liners' },
  { id: 'bc', tab: 'BC Double Wall', code: 'BC', mm: 6.4, per: 51, pitchMM: 300 / 51, ect: 48,
    load: '34 kg', stack: '1,200 mm',
    best: 'Palletised loads and anything that spends its life on the bottom layer of a stack.',
    aria: 'Cross-section of BC double wall corrugated board: two fluted media bonded together, 6.4 millimeters thick' },
  { id: 'eb', tab: 'EB Double Wall', code: 'EB', mm: 4.8, per: 66, pitchMM: 300 / 66, ect: 44,
    load: '29 kg', stack: '900 mm',
    best: 'Heavy contents that also have to carry full-color print on the outer face.',
    aria: 'Cross-section of EB double wall corrugated board: a heavy B wall under a fine E wall, 4.8 millimeters thick' },
];

/* Four press routes, each with the job it should not be given. The "not for"
   line is the part every other corrugated page leaves out. */
const presses = [
  { key: 'press-flexo', name: 'Flexographic', spec: '1–4 colors, in-line',
    alt: 'A flexographic press with a printed web of packaging board running through the rollers',
    yes: 'Kraft liner, a logo or a short line of copy, and volumes where the plate has already paid for itself several times over. It is the only route that prints on a rough board face at speed.',
    no: 'Photographs and gradients. A flexo plate carries a logo, not a picture.' },
  { key: 'press-offset', name: 'Offset Litho', spec: 'Sheet, exact spot color',
    alt: 'An offset printing press running a sheet of full-color printed packaging through its rollers',
    yes: 'Detailed graphics and a Pantone that has to land on the chip. The printed sheet is laminated to the board afterwards, which is how a corrugated carton gets a photographic panel.',
    no: 'Short runs. The plate and wash-up are the same whether the run is 500 or 50,000.' },
  { key: 'press-digital', name: 'Digital', spec: 'No plate, no setup',
    alt: 'A digital press with a printed sheet emerging and a color control console beside it',
    yes: 'Short runs, a seasonal change, a market test and the prototype that has to be in hand this week. Each box can carry a different name from the next at no extra cost.',
    no: 'The cheapest unit rate at volume. Above a few thousand pieces, a plate route overtakes it.' },
  { key: 'press-screen', name: 'Screen', spec: 'Specialty ink and texture',
    alt: 'A screen printing frame with green ink being pulled across a printed sheet',
    yes: 'A heavy pass of ink on a specialty box, and effects that a press cannot lay down at all.',
    no: 'A long run. Every unit passes a screen by hand, and the labor is in the handling.' },
];

/* The four liners, as one comparison. Each row answers the same two questions —
   what the face is, and the run that calls for it — which is what "when you need
   each" in the H2 promises and what four free-standing cards could not deliver.
   Print behaviour lives inside `what`, because how a face prints is a property of
   the face, not a separate axis. */
const boards = [
  { name: 'Kraft', what: 'Unbleached pine fibre, and the cheapest of the four. Hides the scuffs a pallet puts on a white face.',
    pick: 'The price leads, and the print is a logo or a line of type rather than a photograph.' },
  { name: 'White', what: 'A bleached top liner, for artwork the brown of kraft would dull.',
    pick: 'The print itself is the product — a photograph, a light tint, a full-panel design.' },
  { name: '100% Recycled', what: 'Post-consumer fibre.', chip: 'FSC custody to the packing list',
    pick: 'A retailer audits the recycled claim, and the certificate has to travel with the goods.' },
  { name: 'Moisture-Resistant', what: 'An aqueous-coated face, wax-free, so the board keeps its stacking strength as humidity climbs.',
    pick: 'The carton crosses an ocean, or sits in a cold store before it is opened.' },
];

/* The six customer scenes above the reviews — real settings, not studio shots.
   `w`/`h` are the delivered files' own pixel sizes (encoded resize-only). */
const scenes = [
  { key: 'scene-1', w: 999, h: 603,
    alt: 'A woman at a desk with a laptop holding a kraft carton to one ear while she takes a call, further cartons stacked beside her' },
  { key: 'scene-2', w: 655, h: 468,
    alt: 'A woman folding a kraft carton open in front of a shelving unit stacked with cartons' },
  { key: 'scene-3', w: 1000, h: 1000,
    alt: 'A person in a dark shirt carrying a kraft carton printed with a floral pattern' },
  { key: 'scene-4-v2', w: 700, h: 466,
    alt: 'A hand truck loaded with stacked parcels and cartons on a loading bay' },  { key: 'scene-5', w: 739, h: 415,
    alt: 'A man in a work apron taping a kraft carton shut on a bench beneath a wall of tools' },
  { key: 'scene-6', w: 1000, h: 562,
    alt: 'A warehouse worker in a cap and apron carrying a stack of kraft cartons across a factory floor' },
];

/* Ranges rather than one worked example. How much a right-sized carton saves
   depends entirely on how oversized the carton in use is today, so the honest
   answer is a band. The band is arithmetic on the standard RSC blank,
   (2*(L+W)+30) x (D+W), and the 1:5000 dimensional divisor: the low end is a
   carton a size or two too big, the high end a stock carton at twice the
   product's own volume. */
const costRanges = [
  { k: 'Air inside the carton', v: '60–75% of a stock carton',
    n: 'against 20–30% once the blank is cut to the product' },
  { k: 'Board in the blank', v: '20–45% less',
    n: 'a smaller blank divides out of the same mill sheet' },
  { k: 'Billed volume per 1,000', v: '30–55% less',
    n: 'on the 1:5000 dimensional divisor' },
];

/* The test sheet, in the order a carton meets them. */
const tests = [
  { v: '76 cm', t: 'Drop', d: 'Face, edge and corner drops on a packed carton at the ISTA 3A height, on the floor of the lab rather than on a loading dock.' },
  { v: 'All axes', t: 'Random vibration', d: 'The same carton run on a vibrating table, which is what finds a score line that would open across a parcel network.' },
  { v: 'Stack load', t: 'Compression', d: 'Pressed to the load the stacked pallet pattern implies, with the figure printed on the report rather than left as a pass or fail.' },
  { v: 'AQL 2.5', t: 'Lot inspection', d: 'The sampling plan, the defect count that would fail the lot and the date of the report, all issued with the shipping papers.' },
];

/* Where the money actually goes on a corrugated carton. Buying mechanics, so
   it does not restate the constructions or the liners above it. */
const money = [
  { n: '01', t: 'Board Is Bought by the Ton',
    d: 'A mill sells liner and medium by weight, and the weight of a carton is the size of its blank. The cheapest route to a lower unit cost is a smaller blank, before any conversation about a cheaper liner.' },
  { n: '02', t: 'The Flute Grade Moves the Price Most',
    d: 'A step down a flute grade changes the board weight, the take-up of medium and the stack rating together. It is the largest line in a corrugated quote and the easiest to get wrong in the direction of over-specifying.' },
  { n: '03', t: 'The Die and the Plate Are Paid Once',
    d: 'Both are cut or made for the first run and then held. A reorder carries neither, and a design change on the same carton carries the plate only.' },
];

/* One mark per stage. The paint and the SIZE live inside each string: a scoped
   <style> cannot reach a set:html SVG, and an inline SVG carrying only a
   viewBox collapses to zero width inside a shrink-to-fit box. */
const flowIcons = [
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7v10M20 7v10M4 12h16M8 9l-4 3 4 3M16 9l4 3-4 3"/></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 10h8M8 14h5"/></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l11 10M18 3L7 13"/><circle cx="5.5" cy="18" r="2.4"/><circle cx="18.5" cy="18" r="2.4"/></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>',
];

/* Five stages. The white dummy and the printed sample run while the board is
   being booked, which is what keeps the whole run inside four to six weeks.
   Every `d` is one sentence of 119–129 characters on purpose — the five cards
   are read side by side, so an outlier reads as a different kind of card. */
const stages = [
  { when: 'Day 0', name: 'Size, Weight, Dieline', d: 'A dieline and a 3D mockup in your packed dimensions inside 24 hours, with flap and slot geometry matched to your packing line.' },
  { when: 'Day 1–4', name: 'White Dummy', d: 'A plain carton in your dimensions in 3–5 working days, loaded with the real product and dropped by hand before any plate is made.' },
  { when: 'Day 5–14', name: 'Printed Sample', d: 'A carton in the final board, flute and print in 7–10 days, with the color read against the Pantone chip and signed off.' },
  { when: 'Day 14–38', name: 'Print, Die-Cut, Glue', d: 'The run goes on the board booked at the first stage: printed, die-cut, folded and glued, with the lot inspected as it is packed.' },
  { when: 'Day 38–42', name: 'Inspect and Pallet', d: 'The finished lot inspected and flat-packed, then palletized, with the inspection report issued alongside the shipping papers.' },
];

/* The source page's own two reviewers, expanded to three short paragraphs
   each. No figure appears here that they did not state themselves. */
const quotes = [
  { name: 'Sarah Patel', role: 'Operations Director', img: `${CB}/avatar-sarah.webp`,
    alt: 'Portrait of Sarah Patel',
    p: [
      'The run was for a holiday promotion with a date we could not move, and the boxes were still being designed when we first spoke. What came back was a detailed quote and a digital mockup within 24 hours, which is what let the rest of the campaign be scheduled at all.',
      'The useful part was not the speed. It was being told that our dimensions had a little too much clearance on the long side, and that taking that out would save board without changing how the box packed. It did, and it removed waste we had been paying for on every previous run.',
      'The cartons landed in seven business days and went out with the promotion. Recycled board, printed properly, and nothing about the unboxing felt like a compromise.',
    ] },
  { name: 'Jason Williams', role: 'E-commerce Director', img: `${CB}/avatar-jason.webp`,
    alt: 'Portrait of Jason Williams',
    p: [
      'Our cartons were the plainest thing about the brand. Everything else a customer saw had been designed, and then the parcel arrived in a brown box with a label on it.',
      'The change that mattered was the size. Cartons cut to the product stopped the contents moving, and stopped the edges taking the beating they had been taking. Damage claims came down, and the cartons photograph well enough that customers post them.',
      'Customization stayed flexible as the range grew, and the production dates held. That combination is rarer than it sounds.',
    ] },
];

/* What the body does NOT already answer. Every answer below was checked against the
   sections above: wall choice now lives in the flute table's safe top load + best-for
   line, the flexo-on-kraft result lives in §Four Presses, the pallet/freight
   arithmetic lives in §Cost, and the 24-hour turnaround lives in the hero stat bar,
   §Process Day 0 and the final CTA. MOQ is here because the hero stat bar no longer
   carries it — that figure moves to the one place it is needed rather than sitting
   where the page before this one has already published it. Restating any of those
   here is the duplication the client flagged. */
const faqs = [
  { q: 'What is the minimum order for a custom corrugated box?',
    a: '500 cartons, and the wholesale band runs from there to 500,000 units. Tooling sets the floor — the cutting die and the print plate are made once and kept for the reorder — and under 500 units they cannot be spread far enough for the unit rate to be worth quoting.' },
  { q: 'Single wall or double wall — how do I decide?',
    a: 'By what sits on top of the carton, not by what goes inside it. The flute table above carries a safe top load and a line on the run it suits for each grade; send the pallet pattern and the packed weight, and the choice follows from those two figures rather than from preference.' },  { q: 'ECT or Mullen — which number should my specification carry?',
    a: 'ECT, unless a customer of yours has specified otherwise. Edge crush test measures the board\u2019s resistance to crushing on edge, which is the load a stacked carton actually sees, and it is the number that survives a change of liner without the spec having to be rewritten. Mullen burst measures puncture resistance, and it still belongs on a spec for a heavy, sharp-edged part. Both figures come off the mill certificate for the lot, and either can be carried on the packing list for the run.' },
  { q: 'White liner or litho lamination — which costs less?',
    a: 'A white liner under the print, and it is the route to ask about first. It costs less than laminating a printed sheet to the board, and it keeps the carton fully recyclable, which the laminate does not.' },
  { q: 'Can an order mix flute grades and print routes?',
    a: 'Yes, and most do. A range usually has a carton carrying the weight and several carrying the branding, which argues for a high flute grade on the shipper and a fine grade on the retail box. What cannot be mixed is the board booking: each grade is a separate mill line, each route is a separate setup, and each is quoted as its own line rather than discovered on the invoice. Two grades in an order is normal; six is worth consolidating first.' },
  { q: 'How flat does a corrugated carton ship?',
    a: 'An RSC travels folded on its glue line at roughly its own depth plus a few millimeters — a carton 300 mm deep ships around 20 mm thick. Trays, wraps and lid-and-base sets travel flatter still, and units are strapped and corner-protected inside the shipper.' },
  { q: 'What do you need from me to price a run?',
    a: 'Four things: the packed product size, the packed weight, the quantity, and whether the print covers a panel or the whole carton. Size and weight settle the flute and the blank; quantity settles the tier; the print panel settles whether a plate is involved. A photograph of the product and a line on how it is packed is usually enough to close the last gaps.' },
];

const seo = {
  title: 'Custom Corrugated Boxes Manufacturer: 500 Units in 4–6 Weeks',
  description: 'Right-sized to your product so you are not paying for oversized cartons and unused flaps. Higher pallet density in 100% recyclable board built to your ECT spec.',
  keywords: 'custom corrugated boxes manufacturer, custom corrugated shipping boxes, custom printed corrugated boxes, wholesale corrugated boxes, heavy duty corrugated boxes, custom corrugated packaging boxes, double wall corrugated boxes, corrugated mailer boxes, recycled corrugated boxes, eco friendly corrugated boxes, corrugated box manufacturer China, custom corrugated boxes wholesale, RSC shipping boxes, corrugated mailer manufacturer',
  canonical: 'https://www.leelinepackage.com/custom-corrugated-boxes/',
  ogImage: `${CB}/hero-shot.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Corrugated Box Manufacturing',
      description: seo.description,
      serviceType: 'Custom corrugated box design, printing and manufacture in single wall, double wall and litho-laminated board, with board inserts and die-cut fitments',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Corrugated Boxes' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';

/* ---- The signature module's drawings -------------------------------------
   One scale for every grade: 14 user units to the millimeter across a 60 mm
   sample, inside a fixed 840 x 150 frame. That fixed frame is what lets the
   six cross-sections be read against each other — a 1.6 mm E wall is drawn
   thin because it IS thin, not normalised to look like a BC wall. The spec
   list beside each drawing is rendered from these same fields, so the number
   and the picture cannot drift apart. */
const FLUTE_SCALE = 14;
const FLUTE_W = 60;
const FRAME_W = FLUTE_W * FLUTE_SCALE;
const FRAME_H = 150;

const fluteWave = (mm, pitchMM) => {
  const t = mm * FLUTE_SCALE;
  const p = pitchMM * FLUTE_SCALE;
  const top = (FRAME_H - t) / 2;
  const steps = Math.max(8, Math.round((FRAME_W / p) * 12));
  let d = '';
  for (let i = 0; i <= steps; i++) {
    const x = (FRAME_W * i) / steps;
    const y = FRAME_H / 2 - (t / 2) * Math.cos((Math.PI * x) / (p / 2));
    d += `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return { d, top: top.toFixed(1), bot: (top + t).toFixed(1) };
};

const fluteSVG = (f) => {
  const { d, top, bot } = fluteWave(f.mm, f.pitchMM);
  return `<svg viewBox="0 0 ${FRAME_W} ${FRAME_H}" fill="none" stroke="currentColor" role="img" aria-label="${f.aria}">`
    + `<path class="ccf-liner" d="M0 ${top}H${FRAME_W}"/>`
    + `<path class="ccf-liner" d="M0 ${bot}H${FRAME_W}"/>`
    + `<path class="ccf-medi" d="${d}"/>`
    + `</svg>`;
};

/* The hero's bottom edge is cut along the same corrugation, so the first thing
   the page says about corrugated board is made of the actual profile. 30
   flutes across the full width at a fixed amplitude — cosmetic, not to scale. */
const heroCut = (() => {
  const W = 1200, H = 60, period = 40, amp = 15, mid = 30;
  let d = '';
  for (let x = 0; x <= W; x += 4) {
    const y = mid - amp * Math.cos((Math.PI * 2 * x) / period);
    d += `${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`;
  }
  return { line: d, fill: `${d}L${W} ${H}L0 ${H}Z` };
})();
