<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');

  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Infinite 3-up carousel (clone 3 at each end for a seamless wrap in both directions)
  const track = document.querySelector('.aw-car-track');
  if (track) {
    const slides = Array.from(track.children);
    const N = slides.length;
    if (N > 0) {
      const clones = Math.min(3, N);
      // Front clones: copies of the LAST `clones` slides, placed directly before s0
      for (let k = 0; k < clones; k++) {
        const c = slides[(N - clones + k) % N].cloneNode(true);
        c.classList.add('aw-car-clone');
        track.insertBefore(c, slides[0]);
      }
      // Back clones: copies of the FIRST `clones` slides, appended after the last slide
      for (let k = 0; k < clones; k++) {
        const c = slides[k % N].cloneNode(true);
        c.classList.add('aw-car-clone');
        track.appendChild(c);
      }
      const start = clones;
      let i = start;

      const step = () => {
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        return track.children[start].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        track.style.transition = animate ? 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        track.style.transform = `translateX(${-i * step()}px)`;
      };

      const go = (dir) => {
        if (track._busy) return;
        track._busy = true;
        i += dir;
        move(true);
        setTimeout(() => {
          if (i < start) i += N;
          else if (i > start + N - 1) i -= N;
          move(false);
          track._busy = false;
        }, 520);
      };

      const prevBtn = document.querySelector('.aw-car-btn--prev');
      const nextBtn = document.querySelector('.aw-car-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!track._busy) move(false); });
    }
  }
</script>
