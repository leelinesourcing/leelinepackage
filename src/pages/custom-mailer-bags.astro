  .mb-tm-btn:hover { background: var(--brass); border-color: var(--brass); color: var(--forest-deep); }
  .mb-tm-btn svg { width: 22px; height: 22px; }
  .mb-tm-prev { left: 0; }
  .mb-tm-next { right: 0; }

  /* ============ FAQ — one centred column, stacked ============ */
  .mb-faq { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .mb-faq-grid {
    display: grid; grid-template-columns: 1fr;
    gap: 0.7rem;
    max-width: 860px; margin-inline: auto;
    align-items: start;
  }
  .mb-faq-item {
    background: var(--color-clay);
    border: 1px solid rgba(31,59,44,0.09);
    border-radius: 1rem;
    overflow: hidden;
  }
  .mb-faq-n { font-family: var(--font-heading); font-weight: 600; color: var(--brass); margin-right: 0.85rem; }
  .mb-faq-item summary {
    list-style: none; cursor: pointer; display: flex; align-items: flex-start;
    padding: 1.2rem 1.15rem;
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(1rem, 1.6vw, 1.18rem); line-height: 1.32;
    color: var(--color-brand-text);
  }
  .mb-faq-item summary::-webkit-details-marker { display: none; }
  .mb-faq-item summary::after {
    content: '+'; font-family: var(--font-body); font-weight: 400; font-size: 1.5rem; line-height: 1;
    color: var(--brass); margin-left: auto; padding-left: 1rem;
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  }
  .mb-faq-item[open] summary::after { transform: rotate(45deg); }
  .mb-faq-a { padding: 0 1.15rem 1.3rem; }
  .mb-faq-a p { font-size: 0.95rem; line-height: 1.7; color: var(--color-brand-muted); margin: 0; }

  /* ============ FINAL CTA ============ */
  .mb-final {
    position: relative;
    background: linear-gradient(180deg, rgba(20,38,27,0.66), rgba(20,38,27,0.84)), url('https://img.leelinepackage.com/mailer-bags/final-cta-v3.webp') center / cover no-repeat;
    /* 1 cm shorter than the page's other full-bleed bands, at the client's request */
    padding: clamp(3rem, 8vw, 6.3rem) 0;
    text-align: center;
  }
  .mb-final::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(52% 62% at 50% 0%, rgba(228,181,77,0.16), transparent 68%);
  }
  .mb-final-inner { position: relative; z-index: 1; }
  .mb-final-title {
    font-family: var(--font-heading); font-weight: 500;
    font-size: clamp(2.2rem, 5.4vw, 4.2rem); line-height: 1.04; letter-spacing: -0.025em;
    color: var(--ivory); margin: 1.1rem 0 0; text-wrap: balance;
  }
  .mb-final-title em { font-style: italic; color: #E3C29A; }
  .mb-final-sub { font-size: clamp(1.02rem, 1.5vw, 1.14rem); line-height: 1.72; color: rgba(245,240,229,0.82); max-width: 62ch; margin: 1.3rem auto 0; }
  .mb-final-actions { display: flex; justify-content: center; margin-top: clamp(2rem, 4vw, 2.8rem); }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 1024px) {
    .mb-hero-grid { grid-template-columns: 1fr; gap: clamp(2rem, 4vw, 3rem); align-items: start; }
    /* stacked, the plate goes under the copy at a fixed width and centres itself */
    .mb-hero-plate { max-width: 520px; margin-inline: auto; }
    /* ⚠️ The offset outline is `translate(22px, 24px)`; on desktop the wrap's side margins absorb
       the 22px, but stacked the plate is the full column width, so the outline pokes past the
       viewport and gives the page a 6px sideways scroll. Keep the drop, drop the sideways part. */
    .mb-hero-plate::before { transform: translateY(24px); }
    .mb-types-head, .mb-mat-head, .mb-fit-head, .mb-ops-head, .mb-size-head { grid-template-columns: 1fr; gap: 1.2rem; }
    .mb-size-body { grid-template-columns: 1fr; }
    .mb-type-grid { grid-template-columns: repeat(2, 1fr); }
    .mb-cmp-grid { grid-template-columns: minmax(84px, 0.55fr) 1.4fr 1.1fr; }
    .mb-use-grid { grid-template-columns: 1fr; }
    .mb-mat-grid { grid-template-columns: repeat(2, 1fr); }
    .mb-print-row { grid-template-columns: repeat(2, 1fr); }
    .mb-fit-grid { grid-template-columns: repeat(2, 1fr); gap: clamp(1.6rem, 3.4vw, 2.2rem); }
    .mb-time-rail { grid-template-columns: repeat(2, 1fr); gap: clamp(1.8rem, 4vw, 2.4rem); }
    /* two-up means the rule would run under the gap: dot the steps instead */
    .mb-time-rail::before { display: none; }
    .mb-time-rail { padding-top: 0; }
    .mb-time-step { padding-top: 1.4rem; border-top: 2px solid rgba(176,141,76,0.5); }
    .mb-time-step::before { top: -8px; left: 0; }
    .mb-ops-grid { grid-template-columns: 1fr; gap: 0; }
    .mb-ops-item { padding: clamp(1.3rem, 3vw, 1.8rem) 0 0; border-left: 0; border-top: 1px solid rgba(31,59,44,0.14); }
    .mb-ops-item:first-child { padding-top: 0; border-top: 0; }
    .mb-faq-grid { max-width: 100%; }
    .mb-sc-slide { flex-basis: calc((100% - var(--sg)) / 2); }
  }
  @media (max-width: 640px) {
    .mb-hero { padding-top: calc(clamp(3rem, 8vw, 4.2rem) + 4rem); }
    .mb-rail { grid-template-columns: repeat(2, 1fr); }
    .mb-type-grid { grid-template-columns: 1fr; }
    .mb-cmp-grid { grid-template-columns: 1fr; }
    /* stacked, the shared-label grid has nothing to align to: label above each answer */
    .mb-cmp-lab { display: none; }
    .mb-cmp-us, .mb-cmp-them { padding-left: 1rem; }
    .mb-cmp-us { border-left-width: 4px; }
    .mb-cmp-us--top, .mb-cmp-them--top { padding-top: 1.1rem; }
    .mb-mat-grid { grid-template-columns: 1fr; }
    .mb-fit-grid { grid-template-columns: 1fr; }
