  .dp-anat { background: var(--forest-deep); color: var(--ivory); padding: clamp(4.5rem, 10vw, 8.5rem) 0; overflow: hidden; }
  .dp-anat::before { content: ''; position: absolute; inset: 0; background: radial-gradient(56% 54% at 84% 8%, rgba(228,181,77,0.16), transparent 70%); pointer-events: none; }
  .dp-anat .wrap { position: relative; z-index: 1; }
  .dp-anat-title { color: #fff; }
  .dp-anat-title em { color: #E3C29A; }
