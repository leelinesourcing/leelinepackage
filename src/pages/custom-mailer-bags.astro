  .mb-tm-name { display: block; font-family: var(--font-body); font-weight: 700; font-size: clamp(0.94rem, 1.15vw, 1.02rem); line-height: 1.5; color: var(--color-brand-text); }
  .mb-tm-role { display: block; font-family: var(--font-body); font-size: clamp(0.94rem, 1.15vw, 1.02rem); line-height: 1.5; color: var(--color-brand-muted); }

  .mb-tm-btn {
    position: absolute; top: 42%; z-index: 2;
