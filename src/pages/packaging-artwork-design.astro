  .aw-check-item { display: flex; align-items: flex-start; gap: 0.8rem; font-size: 0.98rem; line-height: 1.5; color: var(--color-brand-text); }
  .aw-check-ico { width: 22px; height: 22px; flex: 0 0 auto; color: var(--brass); margin-top: 0.1rem; }
  .aw-check-ico--x { color: rgba(31, 59, 44, 0.5); }
