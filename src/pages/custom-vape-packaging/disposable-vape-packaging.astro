  /* a shared full-width line of copy under a band */
  .dp-note { margin: clamp(1.8rem, 3.6vw, 2.6rem) 0 0; padding: 1.1rem 1.5rem; background: var(--color-brand-surface); border-left: 3px solid var(--brass); border-radius: 0 0.8rem 0.8rem 0; font-size: 0.96rem; line-height: 1.66; color: var(--color-brand-muted); max-width: 92ch; }
  .dp-note strong { color: var(--color-brand-text); }
  .dp-inline-link { display: inline; padding-bottom: 0; font-size: inherit; font-weight: 600; color: var(--color-brand-primary); }
  .dp-inline-link .btn-leaf { width: 0.85em; height: 0.85em; vertical-align: -0.08em; }

  /* ============ 1 · HERO — full-bleed background, centred pitch ============ */
  .dp-hero { position: relative; display: grid; align-content: center; min-height: clamp(540px, 74vh, 740px); padding: calc(4.75rem + clamp(2.4rem, 5vw, 3.6rem)) 0 clamp(2.8rem, 5vw, 4rem); text-align: center; color: var(--ivory); background: #14261B; overflow: hidden; }
  .dp-hero-bg { position: absolute; inset: 0; z-index: 0; background: linear-gradient(165deg, rgba(20,38,27,0.78) 0%, rgba(31,59,44,0.56) 48%, rgba(20,38,27,0.86) 100%), url('https://img.leelinepackage.com/custom-disposable-vape/hero-pens.webp') center / cover no-repeat; }
  .dp-hero-grade { position: absolute; inset: 0; z-index: 1; pointer-events: none; background:
