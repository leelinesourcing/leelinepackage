  .aw-cost { align-self: flex-start; margin-top: 1rem; font-family: var(--font-heading); font-weight: 600; font-size: 1.05rem; color: var(--forest-deep); background: var(--brass-bright); padding: 0.25rem 0.7rem; border-radius: 999px; }
  .aw-cost--2 { background: rgba(176, 141, 76, 0.35); }
  .aw-cost--3 { background: var(--brass-bright); }
  .aw-swatch--foil { background: linear-gradient(120deg, #C9A87C 0%, #E4B54D 46%, #A87E39 100%); }
  .aw-swatch--emboss { background: radial-gradient(80% 80% at 50% 40%, #EDE5D4 0%, #D9C4A4 100%); box-shadow: inset 0 -6px 12px rgba(31, 59, 44, 0.2); }
  .aw-swatch--uv { background: linear-gradient(120deg, #233527 0%, #2E4F3D 55%, #1F3B2C 100%); position: relative; }
  .aw-swatch--uv::after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.55) 38%, transparent 52%); }
  .aw-swatch--lam { background: linear-gradient(115deg, #F5F0E5 0%, #E8DCC7 48%, #F5F0E5 100%); }
  .aw-swatch--soft { background: #E3D8C2; }

  /* ============ QUOTE BANNER ============ */
  .aw-quote { background: linear-gradient(180deg, rgba(20, 38, 27, 0.5), rgba(20, 38, 27, 0.68)), url('https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev/artwork/cta.webp') center / cover no-repeat; color: var(--ivory); padding: clamp(4rem, 9vw, 7rem) 0; }
  .aw-quote-inner { text-align: center; max-width: 60rem; }
  .aw-quote-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.06; letter-spacing: -0.02em; color: #FFFFFF; text-shadow: 0 2px 24px rgba(20, 38, 27, 0.35); margin: 1.2rem auto 0; max-width: 24ch; text-wrap: balance; }
  .aw-quote-title em { font-style: italic; color: #E3C29A; }
  .aw-quote-sub { font-size: 1.05rem; line-height: 1.7; color: rgba(245, 240, 229, 0.9); max-width: 52ch; margin: 1.3rem auto 0; }
  .aw-quote .section-cta { margin-top: clamp(1.8rem, 4vw, 2.6rem); }

  /* ============ 4. FILE SPEC + DIELINE ============ */
  .aw-spec { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .aw-spec-body .section-head { margin-bottom: 0; }
  .aw-spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.8rem, 4vw, 3rem); align-items: center; }
  .aw-dieline { order: 2; position: relative; top: 0.3cm; margin: 0; background: #fff; border: 1px solid rgba(31, 59, 44, 0.12); border-radius: 1.3rem; padding: clamp(0.8rem, 1.8vw, 1.2rem); box-shadow: 0 28px 60px -42px rgba(31, 59, 44, 0.4); }
  .aw-dl { width: 100%; height: auto; display: block; }
  .aw-dl .aw-dl-bleed { fill: url(#awHatch); }
