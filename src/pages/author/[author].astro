---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { CATEGORY_ORDER, getPublishedPosts, type Post } from '../../lib/blog';
import '../../styles/blog.css';

/*
  The author profile. Modelled on the structure the client pointed at
  (lantaobags.com/authors/steven-zhang): identity + figures, then Background, Areas of
  Expertise and Credentials as labelled bands down the left, and only a short sample of the
  writing at the end. The page introduces the person; the article library lives at /blog/.

  Everything below is either read from the collection or restated from `author.bio` — the bio
  is the only source of fact about her, so no claim here goes beyond it.
*/
export const getStaticPaths: GetStaticPaths = async () => {
  const authors = await getCollection('authors');
  const posts = await getPublishedPosts();
  return authors.map((author) => ({
    params: { author: author.id },
    props: {
      author: author.data,
      posts: posts.filter((p) => {
        const ref = p.data.author as { id?: string } | string;
        return (typeof ref === 'string' ? ref : ref?.id) === author.id;
      }),
    },
  }));
};

interface Props { author: { name: string; title?: string; bio: string; avatar: string; avatarWidth: number; avatarHeight: number }; posts: Post[] }
const { author, posts } = Astro.props;

const canonical = `https://www.leelinepackage.com/author/${Astro.params.author}/`;
const bioParagraphs = author.bio.split('\n\n').map((p) => p.trim()).filter(Boolean);

/* The opening sentence, on its own, for the hero — the full bio reads in the Background band. */
const intro = bioParagraphs[0]?.split(/(?<=\.)\s/)[0] ?? '';

/*
  Both lengths are tuned to the count the page actually ships: at 122 articles the title is
  exactly 60 characters and the description exactly 160, and they track the collection from
  there rather than freezing today's figure into the markup.
*/
const seo = {
  title: `${author.name}, Packaging Author | ${posts.length} Articles | LeelinePackage`,
  description:
    `${author.name} is an IoPP-CPP certified packaging engineer. ${posts.length} factory-floor guides on materials, sourcing, manufacturing, QC and shipping for global brand owners.`,
};

/*
  The figures rail. Only three are true of her and countable — the decade is the bio's own
  "over a decade of specialized experience", and the chapters are derived from the collection.
*/
const chapters = CATEGORY_ORDER.filter((slug) => posts.some((p) => p.data.category === slug));
const stats = [
  { n: String(posts.length), label: 'Articles Published' },
  { n: '10+', label: 'Years in Packaging' },
  { n: String(chapters.length), label: 'Chapters Covered' },
];

/*
  Areas of Expertise — each entry is one competence named in the bio, opened out into what it
  means in practice. Nothing here is a figure, because the bio carries none.
*/
const EXPERTISE = [
  {
    title: 'Medical Device Packaging',
    body: 'Protective packaging built around the device itself, so product integrity holds from manufacturing through to end-use.',
  },
  {
    title: 'Cold-Chain Logistics',
    body: 'Protective solutions for temperature-sensitive and high-value equipment, where the journey is treated as part of the specification.',
  },
  {
    title: 'Regulatory Navigation',
    body: 'The rigorous regulatory landscape of the healthcare and pharmaceutical sectors, handled as a design input rather than a final check.',
  },
  {
    title: 'Cross-Functional Project Management',
    body: 'Running a packaging program across the teams that each own a piece of it, from the first requirement to the released specification.',
  },
  {
    title: 'Supply Chain and Vendor Management',
    body: 'Supply chain efficiency and vendor management — from choosing the supplier to the performance of the delivered pack.',
  },
  {
    title: 'Engineering to Cost',
    body: 'Bridging the gap between complex engineering requirements and operational cost-effectiveness, so a program can afford the answer.',
  },
];

const CREDENTIALS = [
  {
    mark: 'IoPP-CPP',
    title: 'Certified Packaging Professional',
    body: 'Certified through the Institute of Packaging Professionals — the professional credential behind the packaging decisions on this site.',
  },
  {
    mark: 'ISO 11607',
    title: 'Medical Device Packaging Standard',
    body: 'Deep working knowledge of the ISO 11607 standards governing packaging for terminally sterilized medical devices.',
  },
  {
    mark: 'ASTM / ISTA',
    title: 'Testing Protocols',
    body: 'The ASTM and ISTA test protocols used to put a number behind a packaging claim before a program is signed off.',
  },
];

const featured = posts.slice(0, 3);

const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        name: author.name,
        jobTitle: author.title,
        description: bioParagraphs[0],
        knowsAbout: EXPERTISE.map((e) => e.title),
        worksFor: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/' },
      },
      url: canonical,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.leelinepackage.com/blog/' },
        { '@type': 'ListItem', position: 3, name: author.name },
      ],
    },
  ],
};
---
<Layout
  title={seo.title}
  description={seo.description}
  canonical={canonical}
  jsonLd={JSON.stringify(jsonLd)}
>
  <Navbar />
  <ScrollReveal />
  <main id="top">
    <section class="au-hero">
      <div class="wrap au-hero-inner">
        <img
          class="au-avatar"
          src={author.avatar}
          alt={author.name}
          width={author.avatarWidth}
          height={author.avatarHeight}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
        <div class="au-hero-copy">
          <p class="eyebrow" data-reveal="up"><Fragment set:html={leaf} />Author</p>
          <h1 class="au-name" data-reveal="up" style="--d:.06s">{author.name}</h1>
          {author.title && <p class="au-role">{author.title}</p>}
          {intro && <p class="au-intro" data-reveal="up" style="--d:.12s">{intro}</p>}
          <div class="au-hero-actions" data-reveal="up" style="--d:.18s">
            <a class="au-hero-link" href="/blog/" target="_blank" rel="noopener">
              Read the guides
              <svg class="au-hero-link-arrow" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="au-hero-link" href="/contact/" target="_blank" rel="noopener">
              Get in touch
              <svg class="au-hero-link-arrow" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="wrap">
        <ul class="au-stats" data-reveal="up">
          {stats.map((s) => (
            <li class="au-stat">
              <span class="au-stat-n">{s.n}</span>
              <span class="au-stat-l">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="au-about">
      <div class="wrap">
        <p class="eyebrow" data-reveal="up"><Fragment set:html={leaf} />Background</p>
        <h2 class="section-title" data-reveal="up" style="--d:.06s">About {author.name}</h2>
        <div class="au-prose" data-reveal="up" style="--d:.12s">
          {bioParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="au-expertise">
      <div class="wrap">
        <p class="eyebrow eyebrow--light" data-reveal="up"><Fragment set:html={leaf} />Core Competencies</p>
        <h2 class="section-title au-on-dark" data-reveal="up" style="--d:.06s">Areas of Expertise</h2>
        <p class="au-sub au-on-dark-sub" data-reveal="up" style="--d:.12s">
          Where a packaging brief usually lands, and what she brings to each one.
        </p>

        <ul class="au-exp-grid">
          {EXPERTISE.map((item, i) => (
            <li class="au-exp" data-reveal="up" style={`--d:${(i % 2) * 0.08}s`}>
              <span class="au-exp-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="au-exp-title">{item.title}</h3>
              <p class="au-exp-body">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="au-credentials">
      <div class="wrap">
        <p class="eyebrow" data-reveal="up"><Fragment set:html={leaf} />Credentials</p>
        <h2 class="section-title" data-reveal="up" style="--d:.06s">Certifications and Standards</h2>
        <p class="au-sub" data-reveal="up" style="--d:.12s">
          The qualifications and the published standards the work is measured against.
        </p>

        <ul class="au-cert-grid">
          {CREDENTIALS.map((c, i) => (
            <li class="au-cert" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="au-cert-mark">{c.mark}</span>
              <h3 class="au-cert-title">{c.title}</h3>
              <p class="au-cert-body">{c.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="au-writing">
      <div class="wrap">
        <p class="eyebrow" data-reveal="up"><Fragment set:html={leaf} />Published Work</p>
        <h2 class="section-title" data-reveal="up" style="--d:.06s">Recent Writing</h2>
        <p class="au-sub" data-reveal="up" style="--d:.12s">
          Three of the {posts.length} guides she has written for this library. The rest are on the blog.
        </p>

        <div class="au-writing-grid">
          {featured.map((post) => <PostCard post={post} />)}
        </div>

        <p class="au-writing-more" data-reveal="up">
          <a class="btn btn-primary" href="/blog/" target="_blank" rel="noopener">
            All {posts.length} articles
            <svg class="btn-leaf" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </p>
      </div>
    </section>

    <section class="au-cta">
      <div class="wrap au-cta-inner">
        <p class="eyebrow eyebrow--light" data-reveal="up"><Fragment set:html={leaf} />Next Step</p>
        <h2 class="au-cta-title" data-reveal="up" style="--d:.06s">Have a Packaging Question</h2>
        <p class="au-cta-sub" data-reveal="up" style="--d:.12s">
          Send the product, the run size and where it ships. An engineer comes back with a
          structure, a material and a price.
        </p>
        <div class="au-cta-actions" data-reveal="up" style="--d:.18s">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Talk to an Engineer
            <svg class="btn-leaf" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /*
    Every band carries its own vertical padding — `site.css` has no `section` rule, so a band
    that only sets a background ships touching the next one.
  */
  .au-hero { background: var(--color-clay); padding: calc(clamp(4rem, 8vw, 6.5rem) + 4.75rem) 0 clamp(2.5rem, 5vw, 3.5rem); }
  /* Single centred column: portrait, name, role, intro, links — all stacked and centred. */
  .au-hero-inner { display: grid; grid-template-columns: minmax(0, 1fr); text-align: center; gap: clamp(1.4rem, 3vw, 2rem); max-width: 54rem; margin-inline: auto; }
  /* 400×600 portrait in a circle — crop from the top or the frame lands on a chin. */
  .au-avatar {
    width: clamp(120px, 15vw, 176px);
    height: clamp(120px, 15vw, 176px);
    margin-inline: auto;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    box-shadow: 0 22px 48px -30px rgba(31, 59, 44, 0.5);
  }
  .au-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-brand-text);
    margin: 1rem 0 0;
  }
  .au-role { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass); margin: 0.6rem 0 0; }
  .au-intro { font-size: 1.08rem; line-height: 1.7; color: var(--color-brand-muted); max-width: 56ch; margin: 1.2rem auto 0; }

  .au-hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.6rem; margin-top: 1.4rem; }
  .au-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 45%, transparent);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brand-text);
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .au-hero-link:hover { color: var(--brass); border-bottom-color: var(--brass); }
  .au-hero-link-arrow { width: 1.05em; height: 0.63em; flex: none; transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .au-hero-link:hover .au-hero-link-arrow { transform: translateX(4px); }

  /*
    The figures rail, centred with the rest of the hero. The brass spine that used to mark each
    cell is gone: a left rule reads as left-alignment, and every cell is centred now.
  */
  .au-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.6rem);
    list-style: none;
    margin: clamp(2.6rem, 5vw, 3.6rem) auto 0;
    padding: 0;
    max-width: 44rem;
  }
  .au-stat { text-align: center; }
  .au-stat-n {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-brand-text);
  }
  .au-stat-l {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-moss);
  }

  /*
    The eyebrow is the standing label for each band (`Background`, `Core Competencies`,
    `Credentials`, `Published Work`) and sits directly above the heading — the same order the
    blog index and the category pages use.
  */
  .au-about { background: var(--ivory); padding: clamp(4rem, 9vw, 7rem) 0; }
  .au-prose { margin-top: 1.6rem; }
  .au-prose p { font-size: 1.05rem; line-height: 1.78; color: var(--color-brand-muted); margin: 0 0 1.1rem; max-width: 68ch; }
  .au-prose p:last-child { margin-bottom: 0; }

  .au-sub { font-size: 1.04rem; line-height: 1.7; color: var(--color-brand-muted); max-width: 62ch; margin: 1rem 0 0; }

  /* ── areas of expertise — the page's dark centre of gravity ─────────────── */
  .au-expertise { background: var(--color-forest); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .au-on-dark { color: var(--ivory); }
  .au-on-dark-sub { color: rgba(245, 240, 229, 0.78); }

  .au-exp-grid { list-style: none; margin: clamp(2.2rem, 4vw, 3rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(0.9rem, 1.8vw, 1.3rem); }
  /*
    Framed cells rather than ruled rows: a row of `border-top` reads as a table, and a grid
    still needs a visible cell boundary on a dark ground.
  */
  .au-exp {
    padding: clamp(1.4rem, 2.6vw, 1.9rem) clamp(1.2rem, 2.4vw, 1.7rem);
    border: 1px solid rgba(245, 240, 229, 0.16);
    border-radius: 1rem;
    background: rgba(245, 240, 229, 0.04);
    transition: background 0.4s ease, border-color 0.4s ease;
  }
  .au-exp:hover { background: rgba(245, 240, 229, 0.09); border-color: rgba(245, 240, 229, 0.34); }
  /* the number carries the sequence — brass, italic, the loudest mark in the cell */
  .au-exp-n { display: block; font-family: var(--font-heading); font-style: italic; font-size: 1.2rem; line-height: 1; color: var(--color-brass-light); }
  .au-exp-title { font-family: var(--font-heading); font-size: clamp(1.1rem, 1.9vw, 1.32rem); font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; color: var(--ivory); margin: 0.7rem 0 0.55rem; }
  .au-exp-body { font-size: 0.95rem; line-height: 1.65; color: rgba(245, 240, 229, 0.78); margin: 0; }

  /* ── credentials ───────────────────────────────────────────────────────── */
  .au-credentials { background: var(--ivory); padding: clamp(4rem, 9vw, 7rem) 0; }
  .au-cert-grid { list-style: none; margin: clamp(2.2rem, 4vw, 3rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.1rem, 2.2vw, 1.6rem); }
  .au-cert {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.6vw, 2rem) clamp(1.3rem, 2.2vw, 1.7rem);
    background: var(--color-parchment);
    border: 1px solid color-mix(in srgb, var(--color-kraft) 45%, transparent);
    border-radius: 1.1rem;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease, border-color 0.4s ease;
  }
  .au-cert:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--color-kraft) 75%, transparent); box-shadow: 0 26px 54px -34px rgba(31, 59, 44, 0.45); }
  .au-cert-mark {
    align-self: flex-start;
    padding: 0.3rem 0.78rem;
    border: 1px solid color-mix(in srgb, var(--brass) 45%, transparent);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .au-cert-title { font-family: var(--font-heading); font-size: 1.16rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; color: var(--color-brand-text); margin: 1rem 0 0.55rem; }
  .au-cert-body { font-size: 0.95rem; line-height: 1.65; color: var(--color-brand-muted); margin: 0; }

  /* ── recent writing ────────────────────────────────────────────────────── */
  .au-writing { background: var(--color-clay); padding: clamp(4rem, 9vw, 7rem) 0; }
  .au-writing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 2.4vw, 1.8rem); margin-top: clamp(2.2rem, 4vw, 3rem); }
  .au-writing-more { margin: clamp(2.2rem, 4vw, 3rem) 0 0; }

  /* ── closing CTA ───────────────────────────────────────────────────────── */
  .au-cta { background: var(--forest-deep); padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .au-cta-inner { text-align: center; max-width: 46rem; margin-inline: auto; }
  .au-cta-title { font-family: var(--font-heading); font-weight: 700; font-size: clamp(1.8rem, 3.6vw, 2.7rem); line-height: 1.08; letter-spacing: -0.025em; color: var(--ivory); margin: 1rem 0 0; }
  .au-cta-sub { font-size: 1rem; line-height: 1.7; color: rgba(245, 240, 229, 0.78); max-width: 54ch; margin: 1rem auto 0; }
  .au-cta-actions { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 1.8rem; }

  @media (max-width: 1080px) {
    .au-writing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .au-exp-grid, .au-cert-grid, .au-writing-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
