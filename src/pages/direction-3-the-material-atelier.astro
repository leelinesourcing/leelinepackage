const materials = [
  { name: 'Kraft Paper', spec: 'Unbleached · 100% recyclable', img: IMG.kraft },
  { name: 'Corrugated Fiberboard', spec: 'B / C / E flute · crush-tested', img: IMG.fiberboard },
  { name: 'Cardboard', spec: 'Rigid chipboard · foil-ready', img: IMG.cardboard },
