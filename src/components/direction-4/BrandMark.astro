---
interface Props {
  size?: number;
  tone?: 'dark' | 'light';
}
const { size = 42, tone = 'dark' } = Astro.props;
const ink = tone === 'light' ? '#F7F8F7' : '#171A1E';
const cobalt = '#2B4BD6';
---
<svg class="st-brand" width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="6" y="6" width="36" height="36" stroke={ink} stroke-width="2.4" />
  <rect x="15" y="15" width="18" height="18" stroke={ink} stroke-width="1.4" stroke-dasharray="2.6 2.6" />
  <path d="M6 6 L15 15 M42 6 L33 15 M6 42 L15 33 M42 42 L33 33" stroke={ink} stroke-width="1.4" />
  <path d="M6 6 H22 L6 22 Z" fill={cobalt} />
  <circle cx="24" cy="24" r="1.8" fill={cobalt} />
</svg>
