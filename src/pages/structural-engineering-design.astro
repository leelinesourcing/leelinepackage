  .eng-mat-card { display: flex; align-items: flex-start; gap: 1rem; background: var(--color-brand-surface); border: 1px solid rgba(31, 59, 44, 0.1); border-radius: 1.4rem; padding: 1.1rem; min-height: 120px; }
  .eng-mat-thumb { margin: 0; width: 128px; height: 128px; flex: 0 0 auto; border-radius: 1rem; overflow: hidden; background: var(--ivory); }
