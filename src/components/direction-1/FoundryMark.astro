---
// The Foundry — recurring visual signature.
// Derived from engineered print / structural line work:
// a registration crosshair + broken circle (press registration),
// fold/crease dashed rules, and a dieline corner.
interface Props {
  variant?: 'seal' | 'reg' | 'foldline' | 'corner' | 'notch';
  class?: string;
}
const { variant = 'seal', class: className = '' } = Astro.props;
---

{
  variant === 'seal' ? (
    <svg class={className} viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <rect x="3.5" y="3.5" width="41" height="41" rx="3" stroke="currentColor" stroke-width="1.4" />
      <rect x="9.5" y="9.5" width="29" height="29" rx="1" stroke="currentColor" stroke-width="0.7" opacity="0.4" />
      <circle cx="24" cy="24" r="12" stroke="currentColor" stroke-width="1" stroke-dasharray="0.6 2.8" opacity="0.55" />
      <path d="M24 9.5v6M24 32.5v6M9.5 24h6M32.5 24h6" stroke="currentColor" stroke-width="1.5" />
      <circle cx="24" cy="24" r="1.9" fill="currentColor" />
    </svg>
  ) : variant === 'reg' ? (
    <svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <circle cx="16" cy="16" r="12.5" stroke="currentColor" stroke-width="1" stroke-dasharray="0.6 2.6" opacity="0.6" />
      <path d="M16 1.5v6M16 24.5v6M1.5 16h6M24.5 16h6" stroke="currentColor" stroke-width="1.3" />
      <circle cx="16" cy="16" r="1.6" fill="currentColor" />
    </svg>
  ) : variant === 'foldline' ? (
    <svg class={className} viewBox="0 0 160 14" fill="none" aria-hidden="true" preserveAspectRatio="none">
      <path d="M0 7h58" stroke="currentColor" stroke-width="1" />
      <path d="M102 7h58" stroke="currentColor" stroke-width="1" />
      <path d="M63 7h33" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4" />
      <path d="M97 2.5l5.5 4.5-5.5 4.5z" fill="currentColor" />
    </svg>
  ) : variant === 'corner' ? (
    <svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M2 2h22v22" stroke="currentColor" stroke-width="1.2" />
      <path d="M8.5 2v17.5H26" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" opacity="0.7" />
      <path d="M2 8.5h6M8.5 2v6" stroke="currentColor" stroke-width="0.8" opacity="0.5" />
      <circle cx="2" cy="2" r="1.5" fill="currentColor" />
    </svg>
  ) : (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="currentColor" stroke-width="1.4" />
      <circle cx="12" cy="12" r="1.6" fill="currentColor" />
    </svg>
  )
}
