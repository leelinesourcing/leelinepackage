  .dp-nowrap { white-space: nowrap; }
  .dp-hero, .dp-len, .dp-tbl, .dp-anat, .dp-fork-sec, .dp-fail-sec, .dp-midcta, .dp-say-sec, .dp-faq, .dp-final { position: relative; }

  /* the labelled image placeholder every photograph slot on this page uses */
