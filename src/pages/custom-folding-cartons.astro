    .fx-spec-rows dt { padding-bottom: 0; border-bottom: 0; }
    .fx-sc-slide { flex: 0 0 100%; }
    .fx-sc-btn--prev { left: 6px; }
    .fx-sc-btn--next { right: 6px; }
    .fx-hero-actions .btn { width: 100%; }
