  <script>
    const nav = document.getElementById('nav');
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const toggleMenu = (open) => {
      document.body.classList.toggle('menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
    };
    menuBtn.addEventListener('click', () => toggleMenu(!document.body.classList.contains('menu-open')));
    mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggleMenu(false)));

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          revealIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    const ready = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
    ready(() => document.querySelectorAll('[data-reveal]').forEach((el) => revealIO.observe(el)));

    if (!reduce) {
      const easeOut = (t) => 1 - Math.pow(1 - t, 4);
      const counterIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          const target = parseFloat(el.dataset.count);
          const suffix = el.dataset.suffix || '';
          const dur = 1600;
          const start = performance.now();
          const tick = (now) => {
            const p = Math.min((now - start) / dur, 1);
            el.textContent = Math.round(target * easeOut(p)) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          counterIO.unobserve(el);
        });
      }, { threshold: 0.5 });
      ready(() => document.querySelectorAll('[data-count]').forEach((el) => counterIO.observe(el)));
    }
  const sceneTrack = document.getElementById('sceneTrack');
  if (sceneTrack) {
    const real = Array.from(sceneTrack.children);
    const N = real.length;
    const sg = () => parseFloat(getComputedStyle(sceneTrack).columnGap) || 0;
    const sper = () => window.innerWidth <= 640 ? 1 : (window.innerWidth <= 900 ? 2 : 3);
    const stripClones = () => { const kids = Array.from(sceneTrack.children); kids.forEach((k) => { if (!real.includes(k)) k.remove(); }); };
    const buildClones = () => { stripClones(); const pp = sper(); const lead = real.slice(N - pp).slice().reverse(); const trail = real.slice(0, pp); lead.forEach((c) => sceneTrack.insertBefore(c.cloneNode(true), sceneTrack.firstChild)); trail.forEach((c) => sceneTrack.appendChild(c.cloneNode(true))); return pp; };
    let p = buildClones();
    const skids = () => sceneTrack.children;
    const srun = () => (skids()[0].offsetWidth + sg());
    let sc = p;
    const sapply = () => sceneTrack.style.transform = 'translateX(' + (-sc * srun()) + 'px)';
    sceneTrack.style.transition = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
    sapply();
    const ssnap = (v) => { sceneTrack.style.transition = 'none'; sc = v; sapply(); void sceneTrack.offsetWidth; sceneTrack.style.transition = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)'; };
    document.getElementById('sceneNext').addEventListener('click', () => { sc += 1; sapply(); if (sc >= p + N) setTimeout(() => ssnap(sc - N), 620); });
    document.getElementById('scenePrev').addEventListener('click', () => { sc -= 1; sapply(); if (sc < p) setTimeout(() => ssnap(sc + N), 620); });
    window.addEventListener('resize', () => { p = buildClones(); sc = p; sceneTrack.style.transition = 'none'; sapply(); void sceneTrack.offsetWidth; sceneTrack.style.transition = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)'; });
  }
  const logoTrack = document.getElementById('logoTrack');
  if (logoTrack) {
    const items = logoTrack.children, gap = 1.6 * 16;
    let li = 0;
    const per = () => window.innerWidth <= 640 ? 3 : (window.innerWidth <= 900 ? 5 : 8);
    const maxLi = () => Math.max(0, items.length - per());
    const applyL = () => logoTrack.style.transform = 'translateX(' + (-li * (items[0].offsetWidth + gap)) + 'px)';
    document.getElementById('logoPrev').addEventListener('click', () => { li = Math.max(0, li - 1); applyL(); });
    document.getElementById('logoNext').addEventListener('click', () => { li = Math.min(maxLi(), li + 1); applyL(); });
    window.addEventListener('resize', () => { li = Math.min(li, maxLi()); applyL(); });
  }
  const edgeTrack = document.getElementById('edgeTrack');
  if (edgeTrack) {
    const real = Array.from(edgeTrack.children);
    const N = real.length;
    const egap = 1.6 * 16;
    const eper = () => window.innerWidth <= 640 ? 1 : (window.innerWidth <= 900 ? 2 : 4);
    const stripClones = () => { const kids = Array.from(edgeTrack.children); kids.forEach((k) => { if (!real.includes(k)) k.remove(); }); };
    const buildClones = () => { stripClones(); const pp = eper(); const lead = real.slice(N - pp).slice().reverse(); const trail = real.slice(0, pp); lead.forEach((c) => edgeTrack.insertBefore(c.cloneNode(true), edgeTrack.firstChild)); trail.forEach((c) => edgeTrack.appendChild(c.cloneNode(true))); return pp; };
    let p = buildClones();
    const kids = () => edgeTrack.children;
    const step = () => (kids()[0].offsetWidth + egap);
    let left = p;
    const apply = () => edgeTrack.style.transform = 'translateX(' + (-left * step()) + 'px)';
    edgeTrack.style.transition = 'transform 0.65s cubic-bezier(0.22, 1, 0.36, 1)';
    apply();
    const snap = (v) => { edgeTrack.style.transition = 'none'; left = v; apply(); void edgeTrack.offsetWidth; edgeTrack.style.transition = 'transform 0.65s cubic-bezier(0.22, 1, 0.36, 1)'; };
    document.getElementById('edgeNext').addEventListener('click', () => { left += 1; apply(); if (left >= p + N) setTimeout(() => snap(left - N), 660); });
    document.getElementById('edgePrev').addEventListener('click', () => { left -= 1; apply(); if (left < p) setTimeout(() => snap(left + N), 660); });
    window.addEventListener('resize', () => { p = buildClones(); left = p; edgeTrack.style.transition = 'none'; apply(); void edgeTrack.offsetWidth; edgeTrack.style.transition = 'transform 0.65s cubic-bezier(0.22, 1, 0.36, 1)'; });
  }
  </script>
