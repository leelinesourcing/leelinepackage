---
import Layout from '../layouts/Layout.astro';
import Motif from '../components/direction-2/Motif.astro';

const products = [
  { name: 'Folding Carton', img: '/images/首页/image-04.avif', spec: 'Retail-ready · 300–500gsm', note: 'FSC board · matte / gloss lam' },
  { name: 'Corrugated', img: '/images/首页/image-05.avif', spec: 'E · B · BC flute', note: 'ISTA-tested · flexo print' },
  { name: 'Rigid', img: '/images/首页/image-06.avif', spec: '2.5–3mm greyboard', note: 'Magnetic close · foil stamp' },
  { name: 'Mailer', img: '/images/首页/image-07.avif', spec: 'Self-locking · tear strip', note: 'DTC favorite · flat-packed' },
  { name: 'Display', img: '/images/首页/image-08.avif', spec: 'PDQ · countertop', note: 'Retail-ready · high impact' },
  { name: 'Pouches', img: '/images/首页/image-09.avif', spec: 'Stand-up · flat-bottom', note: 'Food-safe · matte / kraft' },
  { name: 'Paper Bag', img: '/images/首页/image-10.avif', spec: 'Twisted · flat handle', note: 'Kraft / art paper' },
  { name: 'Tin Box', img: '/images/首页/image-11.avif', spec: 'Embossed metal', note: 'Keepsake · tea / candy' },
  { name: 'Acrylic Box', img: '/images/首页/image-12.avif', spec: 'Crystal clear', note: 'Gift / cosmetic / display' },
  { name: 'Reusable Shopping Bag', img: '/images/首页/image-13.avif', spec: 'Reusable · non-woven', note: 'Branded tote' },
  { name: 'Satin Bag', img: '/images/首页/image-14.avif', spec: 'Drawstring · jewelry', note: 'Soft-touch finish' },
  { name: 'Labels & Stickers', img: '/images/首页/image-15.avif', spec: 'Die-cut · waterproof', note: 'Custom shape & foil' },
];

const stats = [
  { value: 500, suffix: 'K+', label: 'Boxes shipped', sub: 'since 2015' },
  { value: 10, suffix: '+', label: 'Years engineering', sub: 'founded 2015' },
  { value: 24, suffix: 'h', label: 'Digital mockups', sub: 'to your inbox' },
  { value: 500, suffix: '', label: 'Min. order', sub: 'up to 500K runs' },
];

const logos = [
  { name: 'NORDIC GLOW', font: "'Bodoni Moda Variable', serif", weight: 500, style: 'normal', tracking: '0.28em' },
  { name: 'Fieldfare', font: "'Fraunces Variable', serif", weight: 560, style: 'italic', tracking: '0.02em' },
  { name: 'BLOOM+CO', font: "'Sora Variable', sans-serif", weight: 700, style: 'normal', tracking: '0.08em' },
  { name: 'Ridgeline', font: "'Newsreader Variable', serif", weight: 520, style: 'normal', tracking: '0.04em' },
  { name: 'KINDLE & CO', font: "'Manrope Variable', sans-serif", weight: 800, style: 'normal', tracking: '0.22em' },
  { name: 'atlas supply', font: "'Archivo Variable', sans-serif", weight: 600, style: 'normal', tracking: '0.02em' },
  { name: 'Morning Ritual', font: "'Instrument Sans Variable', sans-serif", weight: 500, style: 'italic', tracking: '0.01em' },
  { name: 'TERRAFORM', font: "'Outfit Variable', sans-serif", weight: 700, style: 'normal', tracking: '0.3em' },
];
---

<Layout title="The Standard — LeelinePackage">
  <style is:global>
    :root {
      --color-brand-primary:   #135E6C;
      --color-brand-secondary: #0E3A42;
      --color-brand-accent:    #D85424;
      --color-brand-bg:        #F8F4F0;
      --color-brand-surface:   #FFFFFF;
      --color-brand-text:      #1A2A2E;
      --color-brand-muted:     #6E7F82;
      --font-heading: 'Sora Variable', system-ui, sans-serif;
      --font-body:    'DM Sans Variable', system-ui, sans-serif;
    }

    /* Direction-2 derived design tokens (global so scoped styles resolve var()) */
    :root {
      --lp-navy: #135E6C;
      --lp-ink: #0E3A42;
      --lp-ink-deep: #0A2E34;
      --lp-orange: #D85424;
      --lp-orange-dark: #BD471E;
      --lp-bg: #F8F4F0;
      --lp-bg-deep: #EFE9E2;
      --lp-surface: #FFFFFF;
      --lp-text: #1A2A2E;
      --lp-muted: #6E7F82;
      --lp-line: rgba(19, 94, 108, 0.16);
      --lp-navy-soft: #1C6B7A;
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-bounce: cubic-bezier(0.68, -0.4, 0.32, 1.4);
    }

    html { scroll-behavior: smooth; scroll-padding-top: 92px; }
    body { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  </style>

  <style>
    /* ─────────────────────────  REVEAL SYSTEM  ───────────────────────── */
    .reveal {
      opacity: 0;
      will-change: opacity, transform, clip-path;
      transition:
        opacity 0.85s var(--ease-out),
        transform 0.85s var(--ease-out),
        clip-path 1s var(--ease-out);
      transition-delay: var(--d, 0s);
    }
    .reveal[data-reveal="up"]    { transform: translateY(30px); }
    .reveal[data-reveal="left"]  { transform: translateX(-40px); }
    .reveal[data-reveal="right"] { transform: translateX(40px); }
    .reveal[data-reveal="scale"] { transform: scale(0.92); }
    .reveal[data-reveal="clip"]  { clip-path: inset(0 0 100% 0); transition: clip-path 1.05s var(--ease-out); }
    .reveal.in { opacity: 1; transform: none; }
    .reveal[data-reveal="clip"].in { clip-path: inset(0 0 0% 0); }

    @media (prefers-reduced-motion: reduce) {
      .reveal, .hero-anim { opacity: 1 !important; transform: none !important; clip-path: none !important; transition: none !important; animation: none !important; }
    }

    /* ─────────────────────────  SHARED PRIMITIVES  ───────────────────────── */
    .wrap { width: min(1200px, 100% - 48px); margin-inline: auto; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--lp-muted);
    }
    .eyebrow .module-mark { color: var(--lp-orange); flex: none; }
    .eyebrow.on-dark { color: rgba(255, 255, 255, 0.66); }

    .section-title {
      font-size: clamp(2rem, 4vw, 3.15rem);
      font-weight: 700; letter-spacing: -0.025em; line-height: 1.05;
      color: var(--lp-text); margin-top: 18px;
    }
    .section-title .accent { color: var(--lp-orange); }
    .section-title.on-dark { color: #fff; }

    .lede {
      margin-top: 18px; max-width: 56ch;
      font-size: clamp(1.02rem, 1.4vw, 1.16rem); line-height: 1.65;
      color: var(--lp-muted);
    }
    .lede.on-dark { color: rgba(255, 255, 255, 0.72); }

    .crease-rule { display: block; margin-top: 22px; }
    .crease-rule line { stroke: var(--lp-orange); }

    .btn {
      display: inline-flex; align-items: center; gap: 10px;
      font-weight: 600; font-size: 0.98rem; letter-spacing: 0.01em;
      padding: 15px 26px; border-radius: 12px; border: 1.5px solid transparent;
      cursor: pointer; text-decoration: none; line-height: 1;
      transition: transform 0.35s var(--ease-spring), box-shadow 0.35s var(--ease-out), background 0.25s var(--ease-out), border-color 0.25s var(--ease-out), color 0.25s var(--ease-out);
      will-change: transform;
    }
    .btn .arrow { transition: transform 0.35s var(--ease-spring); }
    .btn:hover .arrow { transform: translateX(4px); }
    .btn-primary {
      background: var(--lp-orange); color: #fff;
      box-shadow: 0 10px 26px -8px rgba(216, 84, 36, 0.6);
    }
    .btn-primary:hover { background: var(--lp-orange-dark); transform: translateY(-2px); box-shadow: 0 16px 32px -8px rgba(216, 84, 36, 0.55); }
    .btn-ghost {
      background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.35);
    }
    .btn-ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.65); transform: translateY(-2px); }
    .btn-navy {
      background: var(--lp-navy); color: #fff;
      box-shadow: 0 10px 26px -10px rgba(14, 58, 66, 0.6);
    }
    .btn-navy:hover { background: var(--lp-ink); transform: translateY(-2px); }
    .btn-on-light {
      background: var(--lp-surface); color: var(--lp-navy); border-color: var(--lp-line);
    }
    .btn-on-light:hover { border-color: var(--lp-navy); transform: translateY(-2px); }

    /* ─────────────────────────  NAV  ───────────────────────── */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 60;
      height: 84px; display: flex; align-items: center;
      transition: height 0.45s var(--ease-out), background 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
    }
    .nav-inner { width: min(1240px, 100% - 40px); margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .nav.scrolled {
      height: 66px;
      background: rgba(14, 58, 66, 0.86);
      backdrop-filter: blur(14px) saturate(1.2);
      box-shadow: 0 8px 30px -12px rgba(10, 46, 52, 0.6);
    }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: #fff; }
    .brand .module-mark { color: #fff; }
    .brand-name { font-family: var(--font-heading); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; line-height: 1; }
    .brand-name em { font-style: normal; color: var(--lp-orange); }
    .brand-sub { display: block; font-size: 0.6rem; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-top: 3px; font-weight: 500; }

    .nav-links { display: flex; align-items: center; gap: 30px; list-style: none; margin: 0; padding: 0; }
    .nav-links a {
      position: relative; text-decoration: none; color: rgba(255,255,255,0.82);
      font-size: 0.9rem; font-weight: 500; letter-spacing: 0.01em;
      transition: color 0.25s var(--ease-out);
    }
    .nav-links a::after {
      content: ''; position: absolute; left: 0; bottom: -6px; height: 2px; width: 100%;
      background: var(--lp-orange); transform: scaleX(0); transform-origin: left;
      transition: transform 0.35s var(--ease-spring);
    }
    .nav-links a:hover { color: #fff; }
    .nav-links a:hover::after { transform: scaleX(1); }
    .nav-cta { display: flex; align-items: center; gap: 12px; }
    .nav .btn { padding: 12px 20px; font-size: 0.88rem; }

    .burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
    .burger span { width: 24px; height: 2px; background: #fff; border-radius: 2px; transition: transform 0.35s var(--ease-spring), opacity 0.25s; }
    .burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger.open span:nth-child(2) { opacity: 0; }
    .burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      position: fixed; inset: 0; z-index: 55; background: var(--lp-ink-deep);
      padding: 120px 32px 40px; display: flex; flex-direction: column; gap: 6px;
      opacity: 0; pointer-events: none; transition: opacity 0.4s var(--ease-out);
    }
    .mobile-menu.open { opacity: 1; pointer-events: auto; }
    .mobile-menu a {
      font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.6rem, 7vw, 2.4rem);
      color: #fff; text-decoration: none; padding: 10px 0; letter-spacing: -0.02em;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      transform: translateY(16px); opacity: 0; transition: transform 0.5s var(--ease-out), opacity 0.5s var(--ease-out);
    }
    .mobile-menu.open a { transform: none; opacity: 1; }
    .mobile-menu a:nth-child(1) { transition-delay: 0.05s; }
    .mobile-menu a:nth-child(2) { transition-delay: 0.1s; }
    .mobile-menu a:nth-child(3) { transition-delay: 0.15s; }
    .mobile-menu a:nth-child(4) { transition-delay: 0.2s; }
    .mobile-menu a:nth-child(5) { transition-delay: 0.25s; }
    .mobile-menu .mm-cta { margin-top: 24px; }

    /* ─────────────────────────  HERO  ───────────────────────── */
    .hero {
      position: relative; overflow: hidden; color: #fff;
      background:
        radial-gradient(120% 90% at 80% -10%, rgba(28, 107, 122, 0.55) 0%, transparent 55%),
        linear-gradient(160deg, var(--lp-ink) 0%, var(--lp-navy) 62%, var(--lp-ink-deep) 100%);
      padding: 168px 0 96px;
    }
    .hero-grid-bg {
      position: absolute; inset: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: radial-gradient(85% 70% at 50% 30%, #000 0%, transparent 78%);
    }
    .hero-orbit { position: absolute; right: -140px; top: -140px; width: 460px; height: 460px; opacity: 0.5; animation: spinSlow 60s linear infinite; color: rgba(255,255,255,0.14); }
    .hero .wrap { position: relative; z-index: 2; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }

    .hero-pill {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 8px 16px 8px 10px; border-radius: 999px;
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
      font-size: 0.78rem; font-weight: 500; letter-spacing: 0.04em; color: rgba(255,255,255,0.85);
    }
    .hero-pill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lp-orange); position: relative; }
    .hero-pill .dot::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; background: var(--lp-orange); opacity: 0.5; animation: pulse 2.4s ease-out infinite; }

    .hero-title {
      font-size: clamp(2.6rem, 6.2vw, 4.7rem);
      font-weight: 800; letter-spacing: -0.035em; line-height: 0.98; margin: 26px 0 0;
    }
    .hero-title .line { display: block; }
    .hero-title .line > span { display: block; }
    .hero-title .accent-word { color: var(--lp-orange); }
    .hero-title .underline {
      position: relative; display: inline-block;
    }
    .hero-title .underline svg { position: absolute; left: 0; bottom: -0.08em; width: 100%; height: 0.16em; }
    .hero-sub {
      margin-top: 26px; max-width: 52ch;
      font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.65; color: rgba(255,255,255,0.78);
    }
    .hero-sub strong { color: #fff; font-weight: 600; }
    .hero-ctas { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 34px; }
    .hero-trust { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 34px; font-size: 0.82rem; color: rgba(255,255,255,0.6); }
    .hero-trust span { display: inline-flex; align-items: center; gap: 7px; }
    .hero-trust .tick { color: var(--lp-orange); font-weight: 700; }

    .hero-visual { position: relative; }
    .hero-frame {
      position: relative; border-radius: 20px; overflow: visible;
      padding: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
      clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 0 100%);
    }
    .hero-frame img {
      display: block; width: 100%; height: 460px; object-fit: cover; border-radius: 12px;
    }
    .hero-frame .frame-glow { position: absolute; inset: 0; border-radius: 20px; box-shadow: 0 40px 80px -30px rgba(10, 46, 52, 0.9); pointer-events: none; }
    .chip {
      position: absolute; z-index: 3; display: flex; align-items: center; gap: 10px;
      background: #fff; color: var(--lp-text); border-radius: 12px; padding: 12px 16px;
      box-shadow: 0 18px 40px -18px rgba(10, 46, 52, 0.7);
      font-size: 0.82rem; font-weight: 600; letter-spacing: 0.02em;
    }
    .chip small { display: block; font-weight: 500; color: var(--lp-muted); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
    .chip .module-mark { color: var(--lp-navy); flex: none; }
    .chip-a { top: -26px; left: -18px; animation: floatY 6s ease-in-out infinite; }
    .chip-b { bottom: 30px; right: -22px; animation: floatY 7s ease-in-out 0.8s infinite; }
    .chip-c { bottom: -24px; left: 40px; animation: floatY 6.5s ease-in-out 0.4s infinite; }

    .hero-metrics {
      position: relative; z-index: 3; margin-top: 52px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.14); border-radius: 18px; overflow: hidden;
      backdrop-filter: blur(6px);
    }
    .hero-metric { padding: 22px 20px; background: rgba(10, 46, 52, 0.5); }
    .hero-metric .num { font-family: var(--font-heading); font-weight: 700; font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: -0.02em; color: #fff; }
    .hero-metric .num em { font-style: normal; color: var(--lp-orange); }
    .hero-metric .lbl { margin-top: 4px; font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.55); }

    /* ─────────────────────────  MARQUEE / TICKER  ───────────────────────── */
    .ticker {
      background: var(--lp-orange); color: #fff; overflow: hidden; padding: 14px 0;
      border-top: 1px solid rgba(255,255,255,0.15); border-bottom: 1px solid rgba(255,255,255,0.15);
    }
    .ticker-track { display: flex; gap: 40px; white-space: nowrap; width: max-content; animation: ticker 30s linear infinite; }
    .ticker-track span { display: inline-flex; align-items: center; gap: 40px; font-family: var(--font-heading); font-weight: 600; font-size: 0.92rem; letter-spacing: 0.14em; text-transform: uppercase; }
    .ticker-track i { font-style: normal; opacity: 0.55; }

    /* ─────────────────────────  SERVICES  ───────────────────────── */
    .services { padding: 96px 0 80px; background: var(--lp-bg); position: relative; }
    .services-head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 32px; }
    .services-grid {
      margin-top: 56px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px;
    }
    .s-card {
      position: relative; background: var(--lp-surface); border-radius: 16px; overflow: hidden;
      border: 1px solid var(--lp-line); display: flex; flex-direction: column;
      transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-out), border-color 0.4s var(--ease-out);
    }
    .s-card:hover { transform: translateY(-8px); box-shadow: 0 30px 50px -28px rgba(14, 58, 66, 0.4); border-color: rgba(19, 94, 108, 0.35); }
    .s-card:nth-child(2n) { transform: translateY(0); }
    .s-card .img {
      position: relative; height: 168px; overflow: hidden;
      clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);
    }
    .s-card .img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-out); }
    .s-card:hover .img img { transform: scale(1.08); }
    .s-card .img::after {
      content: ''; position: absolute; top: 0; right: 0; width: 22px; height: 22px;
      background: linear-gradient(225deg, transparent 48%, var(--lp-surface) 48%, var(--lp-surface) 54%, var(--lp-orange) 54%, var(--lp-orange) 100%);
    }
    .s-card .corner { position: absolute; top: 12px; right: 12px; z-index: 2; color: rgba(255,255,255,0.9); filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3)); }
    .s-card .body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 5px; flex: 1; }
    .s-card h3 { font-size: 1.08rem; font-weight: 600; letter-spacing: -0.01em; color: var(--lp-text); margin: 0; }
    .s-card .spec { font-size: 0.8rem; color: var(--lp-orange); font-weight: 600; letter-spacing: 0.02em; }
    .s-card .note { font-size: 0.82rem; color: var(--lp-muted); line-height: 1.5; }
    .s-card .tag { margin-top: auto; padding-top: 12px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lp-navy); font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
    .s-card .tag::before { content: ''; width: 18px; height: 1px; background: var(--lp-navy); opacity: 0.5; }

    /* ─────────────────────────  FEATURED WORK  ───────────────────────── */
    .work { padding: 88px 0 96px; background: var(--lp-surface); position: relative; }
    .work::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--lp-line) 30%, var(--lp-line) 70%, transparent);
    }
    .work-head { text-align: left; max-width: 680px; }
    .work-feature {
      margin-top: 56px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center;
    }
    .work-feature .media { position: relative; }
    .work-feature .media img { width: 100%; height: 480px; object-fit: cover; border-radius: 18px; }
    .work-feature .media .panel {
      position: absolute; inset: auto -20px -34px 34px; right: 34px; bottom: -34px;
      background: var(--lp-navy); color: #fff; border-radius: 16px; padding: 22px 24px;
      display: flex; align-items: center; gap: 16px; box-shadow: 0 24px 50px -24px rgba(14, 58, 66, 0.7);
    }
    .work-feature .media .panel .big { font-family: var(--font-heading); font-weight: 700; font-size: 2rem; letter-spacing: -0.02em; color: #fff; }
    .work-feature .media .panel .big em { font-style: normal; color: var(--lp-orange); }
    .work-feature .media .panel p { margin: 0; font-size: 0.82rem; color: rgba(255,255,255,0.75); line-height: 1.4; }

    .case-eyebrow { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--lp-orange); font-weight: 600; }
    .case-title { font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 700; letter-spacing: -0.02em; margin: 12px 0 0; color: var(--lp-text); line-height: 1.1; }
    .case-body { margin-top: 16px; color: var(--lp-muted); line-height: 1.65; font-size: 1rem; }
    .case-specs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
    .case-specs span {
