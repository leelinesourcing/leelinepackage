---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const seo = {
  title: 'Page Not Found | LeelinePackage Custom Packaging Specialists',
  description: 'That page has moved, or never existed. Jump to our custom boxes, paper bags, rigid boxes or folding cartons, or get a free quote for your packaging in 24 hours.',
  keywords: 'LeelinePackage page not found, custom packaging manufacturer, custom packaging quote',
};

/* The four constructions buyers ask about most. */
const pages = [
  { pill: 'Boxes', title: 'Custom Boxes', url: '/custom-box-manufacturer/',
    d: 'Corrugated and mailer constructions, scored so a full pallet stacks without the base giving way.' },
  { pill: 'Bags', title: 'Custom Paper Bags', url: '/custom-paper-bag/',
    d: 'Kraft and laminated bags with the handle and base set to a tested load weight.' },
  { pill: 'Rigid', title: 'Custom Rigid Boxes', url: '/custom-rigid-boxes/',
    d: 'Greyboard keepsake boxes, wrapped and lined for a luxury unboxing.' },
  { pill: 'Cartons', title: 'Custom Folding Cartons', url: '/custom-folding-cartons/',
    d: 'Printed paperboard cartons creased to feed and close at line speed.' },
];

const leaf = 'M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z';
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogType="website"
>
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow" /></Fragment>

  <main id="top">
    <Navbar />

    <!-- ============ NOT FOUND ============ -->
    <section class="nf-hero">
      <div class="wrap nf-hero-inner">
        <span class="nf-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20.5 20.5-4.2-4.2" /></svg>
        </span>
        <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d={leaf} fill="currentColor" /></svg>Error 404</span>
        <h1 class="nf-title">We Couldn&#8217;t Find That Page</h1>
        <p class="nf-sub">The link may be out of date, or the page has been renamed or retired. Pick a direction below, or start a quote.</p>
        <div class="nf-actions">
          <a class="btn btn-primary" href="/" target="_blank" rel="noopener">
            Back to Home
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <p class="nf-alt">Still stuck? <a href="mailto:info@leelinepackage.com">info@leelinepackage.com</a></p>
      </div>
    </section>

    <!-- ============ WHERE TO GO NEXT ============ -->
    <section class="nf-pages">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d={leaf} fill="currentColor" /></svg>Keep Browsing</span>
          <h2 class="section-title">Where to Go Next</h2>
          <p class="section-sub">The four constructions buyers ask about most, each with its structure and stock already settled.</p>
        </div>

        <div class="nf-grid">
          {pages.map((p) => (
            <a class="nf-card" href={p.url} target="_blank" rel="noopener">
              <span class="nf-pill">{p.pill}</span>
              <h3 class="nf-card-title">{p.title}</h3>
              <p class="nf-card-d">{p.d}</p>
              <span class="nf-card-go">View details
                <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))}
        </div>

        <div class="section-cta">
          <a class="btn btn-ghost" href="/services/" target="_blank" rel="noopener">
            View All Services
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ NOT FOUND ============ */
  .nf-hero {
    position: relative;
    background: var(--ivory);
    padding: calc(clamp(3.5rem, 7vw, 6rem) + 4.5rem) 0 clamp(3.4rem, 7vw, 5.5rem);
    overflow: hidden;
  }
  .nf-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(52% 58% at 50% 0%, rgba(228,181,77,0.18), transparent 70%);
  }
  .nf-hero-inner { position: relative; z-index: 1; max-width: 46rem; margin-inline: auto; text-align: center; }
  .nf-hero .eyebrow { justify-content: center; }

  .nf-badge {
    width: 76px; height: 76px; margin: 0 auto 1.5rem;
    border-radius: 50%; display: grid; place-items: center;
    background: rgba(31, 59, 44, 0.08);
    border: 1px solid rgba(31, 59, 44, 0.14);
    color: var(--forest-light);
  }
  .nf-badge svg { width: 34px; height: 34px; }

  .nf-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-brand-text);
    margin: 1rem 0 0;
    text-wrap: balance;
  }
  .nf-sub {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: var(--color-brand-muted);
    max-width: 56ch;
    margin: 1.5rem auto 0;
  }
  .nf-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1rem; margin-top: clamp(2rem, 4vw, 2.6rem); }
  .nf-alt { font-size: 0.9rem; color: var(--color-brand-muted); margin: 1.3rem 0 0; }
  .nf-alt a { color: var(--color-brand-primary); font-weight: 600; }
  .nf-alt a:hover { text-decoration: underline; }

  /* ============ WHERE TO GO NEXT ============ */
  .nf-pages { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .nf-pages .section-sub { max-width: 64ch; }
  .nf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2.2vw, 1.6rem); }
  .nf-card {
    display: flex; flex-direction: column;
    background: var(--color-brand-surface);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.3rem;
    padding: clamp(1.4rem, 2.6vw, 1.9rem);
    box-shadow: 0 26px 54px -48px rgba(31, 59, 44, 0.55);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease, border-color 0.4s ease;
  }
  .nf-card:hover { transform: translateY(-4px); border-color: rgba(176, 141, 76, 0.5); box-shadow: 0 34px 64px -42px rgba(31, 59, 44, 0.6); }
  .nf-pill {
    align-self: flex-start;
    display: inline-flex; align-items: center;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: rgba(201, 168, 124, 0.36);
    color: var(--forest-deep);
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .nf-card-title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.15rem, 1.8vw, 1.35rem); line-height: 1.25; letter-spacing: -0.015em; color: var(--color-brand-text); margin: 1rem 0 0; }
  .nf-card-d { font-size: 0.95rem; line-height: 1.7; color: var(--color-brand-muted); margin: 0.7rem 0 0; }
  .nf-card-go { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: auto; padding-top: 1.3rem; font-size: 0.87rem; font-weight: 600; color: var(--brass); }
  .nf-card-go .arrow { width: 1.1em; height: 1.1em; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .nf-card:hover .nf-card-go .arrow { transform: translateX(4px); }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 1024px) {
    .nf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .nf-actions .btn { width: 100%; }
    .nf-grid { grid-template-columns: 1fr; }
  }
</style>
