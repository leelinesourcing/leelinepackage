  .cb-midcta .section-cta { margin-top: clamp(2rem, 5vw, 3rem); }

  /* ============ COMPARE: 5 CUSTOM OPTIONS (tabs) ============ */
  .cb-tabs { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 8rem) 0; }
  .cb-tabs-bar { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(0.7rem, 1.6vw, 1.1rem); margin-top: clamp(2.4rem, 5vw, 3.4rem); padding-bottom: clamp(1.4rem, 3vw, 2rem); border-bottom: 1px solid rgba(31,59,44,0.16); }
  .cb-tab-btn { font-family: var(--font-body); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.01em; padding: 0.65rem 1.2rem; border-radius: 999px; border: 1px solid rgba(31,59,44,0.22); background: transparent; color: var(--color-brand-text); cursor: pointer; transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease; }
