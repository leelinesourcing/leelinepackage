     column. Switching the flow without reordering the markup scrambles all twenty-four cells. */
  .dp-tbl-track { display: grid; border: 1px solid rgba(96,92,78,0.28); border-top: 0; border-radius: 0 0 0.4rem 0.4rem; overflow: hidden; }
  /* ⚠️ The dark header band is what neither sibling's table runs — it is the page's own move. */
  .dp-tbl-head { margin: 0; background: var(--forest-deep); color: var(--ivory); font-family: var(--font-heading); font-weight: 700; font-size: 0.98rem; line-height: 1.3; text-align: center; padding: 0.95rem 0.6rem 1.05rem; border-top: 3px solid var(--brass); display: flex; flex-direction: column; gap: 0.3rem; align-items: center; }
  .dp-tbl-idx { font-family: var(--font-heading); font-size: 0.74rem; letter-spacing: 0.1em; color: var(--color-brass-light); }
  .dp-tbl-label, .dp-tbl-cell { background-color: var(--ivory); }
  .dp-tbl-label { position: sticky; left: 0; z-index: 1; margin: 0; min-height: 58px; display: flex; align-items: center; padding: 0.35rem 1rem; border-top: 1px solid rgba(96,92,78,0.22); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-brand-text); }
  .dp-tbl-cell { margin: 0; min-height: 58px; display: flex; align-items: center; justify-content: center; padding: 0.4rem 0.6rem; border-top: 1px solid rgba(96,92,78,0.22); font-size: 0.9rem; line-height: 1.35; text-align: center; color: var(--color-brand-text); }
  .dp-tbl-cell--pill { padding-inline: 0.45rem; }
  .dp-tbl-pill { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; border: 1px solid rgba(176,141,76,0.55); background: rgba(176,141,76,0.1); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.02em; color: #7A5F2E; }

