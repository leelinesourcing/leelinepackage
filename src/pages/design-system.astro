---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TeamSection from '../components/TeamSection.astro';
import LegalDoc from '../components/LegalDoc.astro';
import MobileCta from '../components/MobileCta.astro';
import BackToTop from '../components/BackToTop.astro';
import PostCard from '../components/PostCard.astro';
import AuthorCard from '../components/AuthorCard.astro';
import BlogIndex from '../components/BlogIndex.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { getEntry } from 'astro:content';
import { getPublishedPosts, POSTS_PER_PAGE } from '../lib/blog';

// One real post drives the PostCard preview — the card is data-shaped, so a hand-written stub
// would not prove it renders.
const demoPosts = await getPublishedPosts();
const demoPost = demoPosts[0];
const demoLastPage = Math.max(1, Math.ceil(demoPosts.length / POSTS_PER_PAGE));

// AuthorCard takes a real `authors` entry for the same reason.
const demoAuthorEntry = await getEntry('authors', 'lofty-shen');
const demoAuthor = demoAuthorEntry?.data;

const demoLegalSections = [
  { id: 'preview-first', label: 'First Section' },
  { id: 'preview-second', label: 'Second Section' },
];

const AB = 'https://img.leelinepackage.com/about';

// Demo data for the TeamSection preview below.
const demoTeam = {
  id: 'preview-team',
  eyebrow: 'The Team',
  tone: 'ivory' as const,
  title: 'The Nine People Behind Every <em>Order</em>',
  sub: 'Design, operations, sales and warehouse all sit on the same floor. Whoever takes your brief stays with it, from the first drawing to the loaded container.',
  members: [
    { name: 'Mia Lin', role: 'Design', img: `${AB}/team-mia-lin.webp`, alt: 'Mia Lin, packaging designer at LeelinePackage' },
    { name: 'Ryan Li', role: 'Design', img: `${AB}/team-ryan-li.webp`, alt: 'Ryan Li, structural designer at LeelinePackage' },
    { name: 'Ryan Sun', role: 'Operations', img: `${AB}/team-ryan-sun.webp`, alt: 'Ryan Sun, operations manager at LeelinePackage' },
  ],
};

// Values mirror src/styles/theme.css (@theme static) and index.astro CSS tokens.
const colors = [
  { name: 'forest', hex: '#1F3B2C' },
  { name: 'kraft', hex: '#C9A87C' },
  { name: 'brass', hex: '#B08D4C' },
  { name: 'ivory', hex: '#F5F0E5' },
  { name: 'clay', hex: '#EDE5D4' },
  { name: 'charcoal', hex: '#21241C' },
  { name: 'moss', hex: '#8C8676' },
];
---

<Layout title="Design System" description="Component inventory and brand reference" canonical="https://leelinepackage.com/design-system">
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow" /></Fragment>

  <main id="top" class="ds">
    <header class="ds-hero">
      <h1>Design System</h1>
      <p>Component inventory and brand reference</p>
    </header>

    <!-- ============ COLORS ============ -->
    <section class="ds-section">
      <h2>Colors</h2>
      <div class="ds-colors">
        {colors.map((c) => (
          <div class="ds-swatch">
            <span class="ds-chip" style={`background: ${c.hex}`}></span>
            <div class="ds-swatch-meta">
              <strong>{c.name}</strong>
              <code>bg-{c.name}</code>
              <code>{c.hex}</code>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ TYPOGRAPHY ============ -->
    <section class="ds-section">
      <h2>Typography</h2>
      <div class="ds-type">
        <div class="ds-type-row"><span class="ds-tag">H1 / hero</span><h1 class="ds-h1">Custom Packaging, Made to Measure</h1></div>
        <div class="ds-type-row"><span class="ds-tag">H2 / section</span><h2 class="ds-h2">Every Detail Is Made to Measure</h2></div>
        <div class="ds-type-row"><span class="ds-tag">H3 / card</span><h3 class="ds-h3">Finishes &amp; Effects</h3></div>
        <div class="ds-type-row"><span class="ds-tag">H4 / label</span><h4 class="ds-h4">Fully Customisable</h4></div>
        <div class="ds-type-row"><span class="ds-tag">Body</span><p class="ds-body">Dielines cut to fit your product exactly — any length, width, height or corner radius.</p></div>
        <div class="ds-type-row"><span class="ds-tag">Caption</span><span class="ds-caption">Rigid keepsake box — beauty &amp; skincare</span></div>
        <div class="ds-type-row"><span class="ds-tag">Eyebrow</span><span class="ds-eyebrow">Industries We Serve</span></div>
      </div>
    </section>

    <!-- ============ COMPONENTS ============ -->
    <section class="ds-section">
      <h2>Components</h2>

      <h3 class="ds-sub">Sections</h3>
      <div class="ds-component">
        <div class="ds-frame"><Navbar /></div>
        <p class="ds-comp-name"><strong>Navbar</strong> · <code>src/components/Navbar.astro</code></p>
      </div>
      <div class="ds-component">
        <div class="ds-frame"><Footer /></div>
        <p class="ds-comp-name"><strong>Footer</strong> · <code>src/components/Footer.astro</code></p>
      </div>
      <div class="ds-component">
        <div class="ds-frame"><TeamSection {...demoTeam} /></div>
        <p class="ds-comp-name"><strong>TeamSection</strong> · <code>src/components/TeamSection.astro</code> — department band: eyebrow + title + sub + a 2- or 3-across portrait grid, sized to the number of members.</p>
      </div>
      <div class="ds-component">
        <div class="ds-frame">
          <LegalDoc
            title="Page Title"
            subtitle="One short paragraph explaining how to read the page."
            updated="September 2026"
            sections={demoLegalSections}
          >
            <h2 id="preview-first">First Section</h2>
            <p>Body copy set at 1.02rem / 1.8 in <code>--color-brand-muted</code>. Headings are Newsreader, lists carry a brass dot.</p>
            <ul>
              <li><strong>A term:</strong> the bullet style used for definitions and clauses.</li>
            </ul>
            <h2 id="preview-second">Second Section</h2>
            <p>A second section shows the top rule and spacing between blocks.</p>
          </LegalDoc>
        </div>
        <p class="ds-comp-name"><strong>LegalDoc</strong> · <code>src/components/LegalDoc.astro</code> — legal-document shell: ivory hero (eyebrow + bold title + optional sub + optional &ldquo;Last updated&rdquo;) over a kraft &ldquo;On This Page&rdquo; card and a 78ch article column. Pass <code>sections</code> for the TOC and put the h2/h3/h4 + lists in the default slot. Used by <code>privacy-policy</code>, <code>disclaimer</code>, <code>editorial-policy</code> and <code>fact-checking-process</code>.</p>
      </div>

      <div class="ds-component">
        <div class="ds-frame ds-frame--mobile"><MobileCta /></div>
        <p class="ds-comp-name"><strong>MobileCta</strong> · <code>src/components/MobileCta.astro</code> — fixed bottom &ldquo;Contact Us&rdquo; pill, brass on forest-deep, shown at &le; 900px, fixed width so the pill is the same length on every page. Rendered once in <code>src/layouts/Layout.astro</code>, so every page gets it. (Preview below forces it into view.)</p>
      </div>

      <div class="ds-component">
        <div class="ds-frame ds-frame--mobile"><BackToTop /></div>
        <p class="ds-comp-name"><strong>BackToTop</strong> · <code>src/components/BackToTop.astro</code> — 38px ivory circle, right:1.5rem, anchored <code>#top</code>, shown at &le; 900px. Rendered once in <code>src/layouts/Layout.astro</code>. Every page's <code>&lt;main&gt;</code> carries <code>id=&quot;top&quot;</code>, so the anchor works without JS. (Preview below forces it into view.)</p>
      </div>

      <h3 class="ds-sub">Blog</h3>
      {demoPost ? (
        <div class="ds-component">
          <div class="ds-frame ds-frame--blog-card"><PostCard post={demoPost} /></div>
          <p class="ds-comp-name"><strong>PostCard</strong> · <code>src/components/PostCard.astro</code> — one article tile: 16/10 image, category link, serif title, excerpt, date + reading time. One shape only — the old <code>variant=&quot;lead&quot;</code> full-row card was removed. Used by the blog index and the category pages.</p>
        </div>
      ) : (
        <p class="ds-note">PostCard preview needs at least one published post in <code>src/content/blog/</code>.</p>
      )}

      <div class="ds-component">
        <div class="ds-frame ds-frame--band">
          <BlogIndex posts={demoPosts.slice(0, POSTS_PER_PAGE)} page={1} lastPage={demoLastPage} />
        </div>
        <p class="ds-comp-name"><strong>BlogIndex</strong> · <code>src/components/BlogIndex.astro</code> — the whole listing band: clay hero (eyebrow + bold H1 + sub), the card grid with a lead card, and numbered pagination. Shared by <code>/blog/</code> (page 1) and <code>/blog/page/[page]/</code>. Shown here as a full-width band rather than inside a card-sized frame.</p>
      </div>

      {demoAuthorEntry && demoAuthor ? (
        <div class="ds-component">
          <div class="ds-frame ds-frame--blog-card"><AuthorCard author={demoAuthor} authorId={demoAuthorEntry.id} posts={demoPosts.slice(0, 5)} /></div>
          <p class="ds-comp-name"><strong>AuthorCard</strong> · <code>src/components/AuthorCard.astro</code> — the article's closing author block: portrait, name, job title, an About the Author / Latest Posts tablist, both biography paragraphs, the Areas of Expertise list, social links and the &quot;Fact Checked &amp; Editorial Guidelines&quot; disclosure. Content mirrors the live site's author box; the tabs are a real ARIA tablist and the disclosure is a native <code>&lt;details&gt;</code>. Used by every article page.</p>
        </div>
      ) : (
        <p class="ds-note">AuthorCard preview needs an entry in <code>src/data/authors.json</code>.</p>
      )}

      <div class="ds-component">
        <p class="ds-comp-name"><strong>ScrollReveal</strong> · <code>src/components/ScrollReveal.astro</code> — behaviour only, so there is nothing to preview: a global <code>[data-reveal]</code> / <code>[data-reveal].in</code> pair plus the IntersectionObserver that adds <code>.in</code>, with a <code>prefers-reduced-motion</code> opt-out. The rule is global because every marked element belongs to the page, not to this component. Rendered once per blog page.</p>
      </div>

      <h3 class="ds-sub">Atoms</h3>
      <p class="ds-note">
        No standalone atom components exist yet. The homepage defines its buttons, cards, badges and
        section heads as CSS classes inside <code>src/pages/index.astro</code> &mdash; e.g.
        <code>.btn</code> / <code>.btn-gold</code> / <code>.btn-light</code>, <code>.eyebrow</code>,
        <code>.section-title</code>, <code>.product-card</code>, <code>.industry-card</code>,
        <code>.edge-dot</code>, <code>.faq-item</code>. As these are extracted into
        <code>src/components/</code>, they should be imported and listed here.
      </p>
    </section>
  </main>

  <style>
    .ds { max-width: 1200px; margin-inline: auto; padding: clamp(3.5rem, 7vw, 6rem) clamp(1.5rem, 4vw, 3rem); }
    .ds-hero { margin-bottom: clamp(3rem, 6vw, 5rem); }
    .ds-hero h1 { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.7rem, 6vw, 4.6rem); line-height: 0.97; letter-spacing: -0.03em; color: var(--color-charcoal); margin: 0; text-wrap: balance; }
    .ds-hero p { font-size: 1.06rem; line-height: 1.7; color: var(--color-moss); margin-top: 1.2rem; max-width: 46ch; }

    .ds-section { border-top: 1px solid rgba(31, 59, 44, 0.12); padding-top: clamp(2.5rem, 5vw, 4rem); margin-top: clamp(2.5rem, 5vw, 4rem); }
    .ds-section > h2 { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.2rem); letter-spacing: -0.02em; color: var(--color-charcoal); margin: 0 0 1.4rem; }
    .ds-sub { font-family: var(--font-heading); font-weight: 600; font-size: 1.3rem; color: var(--color-charcoal); margin: 2rem 0 1rem; }

    .ds-colors { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
    .ds-swatch { background: var(--color-ivory); border: 1px solid rgba(31, 59, 44, 0.1); border-radius: 1rem; padding: 1rem; }
    .ds-chip { display: block; height: 72px; border-radius: 0.7rem; border: 1px solid rgba(31, 59, 44, 0.12); }
    .ds-swatch-meta { display: grid; gap: 0.2rem; margin-top: 0.8rem; }
    .ds-swatch-meta strong { font-family: var(--font-heading); font-weight: 600; font-size: 1.05rem; color: var(--color-charcoal); }
    .ds-swatch-meta code { font-size: 0.78rem; color: var(--color-moss); }

    .ds-type-row { display: grid; grid-template-columns: 130px 1fr; gap: 1.5rem; align-items: baseline; padding: 1.1rem 0; border-top: 1px solid rgba(31, 59, 44, 0.08); }
    .ds-type-row:first-child { border-top: 0; }
    .ds-tag { font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-moss); }
    .ds-h1 { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.7rem, 6.6vw, 5.6rem); line-height: 0.97; letter-spacing: -0.03em; color: var(--color-charcoal); max-width: 22ch; text-wrap: balance; margin: 0; }
    .ds-h2 { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.04; letter-spacing: -0.02em; color: var(--color-charcoal); margin: 0; }
    .ds-h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.45rem; letter-spacing: -0.01em; color: var(--color-charcoal); margin: 0; }
    .ds-h4 { font-family: var(--font-heading); font-weight: 600; font-size: 1.2rem; color: var(--color-charcoal); margin: 0; }
    .ds-body { font-family: var(--font-body); font-size: 1rem; line-height: 1.65; color: var(--color-moss); max-width: 46ch; margin: 0; }
    .ds-caption { font-family: var(--font-heading); font-weight: 600; font-size: 0.92rem; line-height: 1.25; letter-spacing: -0.01em; color: var(--color-charcoal); }
    .ds-eyebrow { font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-brass); }

    .ds-component { border: 1px dashed rgba(31, 59, 44, 0.25); border-radius: 1.2rem; overflow: hidden; }
    .ds-frame { padding: 0.8rem; background: var(--color-ivory); }
    .ds-frame--mobile { display: flex; justify-content: center; align-items: center; gap: 1rem; padding: 2rem 0.8rem; }
    .ds-frame--mobile :global(.mobile-cta) { display: flex; position: static; left: auto; transform: none; }
    .ds-frame--mobile :global(.back-to-top) { display: flex; position: static; right: auto; }
    /* one card wide, so the tile is previewed at the size it actually renders */
    .ds-frame--blog-card { max-width: 420px; background: transparent; }
    /* BlogIndex is a full-bleed band (its own `wrap` supplies the gutters) */
    .ds-frame--band { padding: 0; background: transparent; overflow: hidden; }
    .ds-frame--band :global(.blog-hero) { padding-top: clamp(2.5rem, 5vw, 4rem); }
    .ds-comp-name { font-size: 0.85rem; color: var(--color-moss); margin: 0.8rem 0 0; }
    .ds-comp-name code { font-size: 0.8rem; }
    .ds-note { font-size: 0.95rem; line-height: 1.65; color: var(--color-moss); max-width: 68ch; }
    .ds-note code { font-size: 0.85rem; }

    @media (max-width: 720px) {
      .ds-type-row { grid-template-columns: 1fr; gap: 0.4rem; }
    }
  </style>
</Layout>
