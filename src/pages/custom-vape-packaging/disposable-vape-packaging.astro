  .dp-len-top { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .dp-len-fill { font-family: var(--font-heading); font-weight: 700; font-size: 0.82rem; line-height: 1; letter-spacing: -0.01em; color: var(--forest-deep); background: var(--brass-soft); border-radius: 999px; padding: 0.26rem 0.62rem; }
  .dp-len-title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.18; color: var(--color-brand-text); margin: 0.5rem 0 0; }
  .dp-len-title em { font-style: italic; font-weight: 500; color: var(--brass); }
  .dp-len-spec { margin: auto 0 0; padding-top: clamp(1rem, 2vw, 1.4rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.85rem clamp(1rem, 2.4vw, 2rem); }
  .dp-len-spec > div { display: grid; gap: 0.2rem; }
  .dp-len-spec dt { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--brass); }
  .dp-len-spec dd { margin: 0; font-size: 0.94rem; font-weight: 600; line-height: 1.4; color: var(--color-brand-text); }
  .dp-len-no dd { color: var(--color-moss); }

  /* ============ 3 · FIVE STRUCTURES (clay) — the page's one table ============ */
  .dp-tbl { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .dp-tbl .section-head { margin-bottom: clamp(1.7rem, 3.6vw, 2.7rem); }
  .dp-tbl .section-sub { max-width: 86ch; }
  .dp-tbl-rail { overflow-x: auto; }
  /* ⚠️ ROW-major in the DOM (a header row of six, then four rows of label + five values), so the
