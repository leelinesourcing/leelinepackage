</Layout>

<style>
  /* ============ THE PAGE'S THREE DEVICES ============
     An acrylic box is judged on what can be seen through it, so the page keeps
     its surfaces open and lets type, colour and composition carry the character:
       — `.ac-tag`  one number in a pill, sitting beside the copy it decides
       — the brass-hairline frame on every large photograph
       — a display-serif + italic-brass numeral pairing, always on real sequence
     Nothing here is delimited by a horizontal rule. Blocks are separated by
     gap. A row with a rule over it is a table, whatever it is called. */

  .ac-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.3;
    color: var(--color-brand-primary);
    background: rgba(176, 141, 76, 0.15);
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
  }
  .ac-tag--light { background: rgba(201, 168, 124, 0.18); color: var(--brass-soft); }
  .ac-sub { max-width: 82ch; }
  .ac-sub-light { color: rgba(245, 240, 229, 0.8); max-width: 62ch; }

  .ac-hero-fig {
    margin: 0;
    padding: 0.55rem;
    border: 1px solid rgba(176, 141, 76, 0.42);
    border-radius: 1.5rem;
    background: rgba(245, 240, 229, 0.5);
  }
  .ac-hero-fig img {
    width: 100%;
    border-radius: 1.05rem;
    display: block;
  }
  .ac-hero-fig figcaption, .ac-joint figcaption {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-brand-muted);
    padding: 0.85rem 0.6rem 0.25rem;
  }

  /* ======================== 1. HERO ========================
     The Specimen: copy in a column, one tall portrait photograph running the
     full height of the section beside it, and a single scale for the wall
     range underneath. Six elements, no more.
     ⚠️ The nav is `position: fixed` — 74 px at 1440 and 76 px at 390 — so the
     hero's own top padding is added to 4.75rem rather than trusted alone. */
  .ac-hero {
    padding: calc(clamp(2.8rem, 6vw, 4.6rem) + 4.75rem) 0 clamp(3.4rem, 7vw, 5.4rem);
    background: var(--color-ivory);
  }
  .ac-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: clamp(2rem, 5vw, 4.4rem);
    align-items: start;
  }
  .ac-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.1rem, 3.9vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--color-brand-text);
    text-wrap: balance;
    margin: 1.1rem 0 0;
  }
  .ac-title em { font-style: italic; color: var(--brass); }
  .ac-lede {
    font-size: clamp(1rem, 1.3vw, 1.07rem);
    line-height: 1.74;
    color: var(--color-brand-muted);
    max-width: 56ch;
    margin-top: 1.3rem;
  }
  .ac-actions { margin-top: 1.9rem; }
  .ac-hero-fig img { aspect-ratio: 750 / 820; object-fit: cover; }

  /* the hero's one specification element — a scale, not a pill row */
  .ac-wall { margin-top: 2rem; }
  .ac-wall-cap {
    display: block;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
  }
  .ac-wall-scale {
    list-style: none;
    display: flex;
    margin-top: 0.7rem;
    border-top: 1px solid rgba(31, 59, 44, 0.2);
  }
  .ac-wall-scale li {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0;
  }
  .ac-wall-scale i {
    display: block;
    width: 2px;
    height: 0.78rem;
    background: var(--brass);
    margin-left: 0;
  }
  .ac-wall-scale span {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-brand-text);
  }

  /* ======================== 2. NINE FAMILIES ======================== */
  .ac-types { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .ac-type-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 1.7rem);
  }
  .ac-type {
    background: var(--ivory);
    border: 1px solid rgba(31, 59, 44, 0.09);
    border-radius: 1.15rem;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease;
  }
  .ac-type:hover { transform: translateY(-6px); box-shadow: 0 24px 50px -30px rgba(31, 59, 44, 0.5); }
  .ac-type-fig { position: relative; margin: 0; }
  .ac-type-fig img {
    width: 100%;
    /* ~0.3cm shorter than square at 3-up, which is where the row read too tall */
    aspect-ratio: 1 / 0.97;
    object-fit: cover;
    border-radius: 0.7rem;
  }
  .ac-type-code {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ivory);
    background: rgba(20, 38, 27, 0.72);
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
  }
  .ac-type-body { padding: 1.05rem 0.5rem 0.5rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .ac-type-body h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.22rem;
    line-height: 1.24;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0;
  }
  .ac-type-body p { font-size: 0.93rem; line-height: 1.62; color: var(--color-brand-muted); margin: 0; }
  .ac-type-body .ac-tag { align-self: flex-start; }

  /* ======================== 3. HOW THE BOX IS BUILT ========================
     The page's one drawn module, chosen because a buyer acts differently for
     having read it: they stop asking for "clear acrylic" and start asking for a
     polished edge and a solvent bond. */
  .ac-built {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: linear-gradient(180deg, var(--color-forest), var(--forest-deep));
    color: var(--ivory);
  }
  .ac-title-light { color: var(--ivory); }
  /* A second entry point in the head of the section. The bottom CTA sits after
     four mechanism cards, which is a long scroll for the page's signature block.
     It promises something DIFFERENT from the foot — "Specify My Build" asks for
     the drawing-level conversation, the foot asks to see a bonded sample — so
     two buttons in one section do not make the same offer. */
  .ac-head-cta { margin-top: clamp(1.5rem, 3vw, 2rem); }
  .ac-built-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 4.5vw, 3.6rem);
    align-items: center;
  }
  .ac-joint {
    margin: 0;
    padding: 0.55rem;
    border: 1px solid rgba(176, 141, 76, 0.42);
    border-radius: 1.5rem;
  }
  .ac-joint-draw { display: block; width: 100%; height: auto; }
  .ac-joint figcaption { color: rgba(245, 240, 229, 0.62); }

  /* The box is drawn the way acrylic behaves: almost nothing in the middle,
     everything in the edges. */
  .ac-jd-panel { fill: rgba(245, 240, 229, 0.07); stroke: rgba(245, 240, 229, 0.42); stroke-width: 1; }
  .ac-jd-polish { stroke: var(--brass-soft); stroke-width: 3; stroke-linecap: round; }
  .ac-jd-bond { stroke: rgba(201, 168, 124, 0.95); stroke-width: 2.2; stroke-linecap: round; }
  .ac-jd-lead, .ac-jd-dim { fill: none; stroke: rgba(245, 240, 229, 0.36); stroke-width: 1; }
  .ac-jd-lead { stroke-dasharray: 3 4; }
  .ac-jd-lab {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: rgba(245, 240, 229, 0.72);
  }

  .ac-pairs { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; }
  .ac-pair-row { display: flex; flex-wrap: wrap; gap: 0.5rem 0.7rem; margin: 0; }
  .ac-pair-yes, .ac-pair-no {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: 999px;
    padding: 0.32rem 0.85rem 0.36rem;
  }
  .ac-pair-yes { color: var(--ivory); background: rgba(201, 168, 124, 0.2); }
  .ac-pair-no { color: rgba(245, 240, 229, 0.5); background: rgba(245, 240, 229, 0.06); }
  .ac-pair-yes i { font-style: normal; color: var(--brass-soft); }
  .ac-pair-no i { font-style: normal; color: rgba(245, 240, 229, 0.38); }
  .ac-pair-d { font-size: 0.93rem; line-height: 1.65; color: rgba(245, 240, 229, 0.72); margin: 0.5rem 0 0; }

  .ac-mech-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(3rem, 6vw, 4.6rem);
  }
  .ac-mech { display: flex; flex-direction: column; gap: 0.6rem; }
  .ac-mech img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 1.05rem;
    border: 1px solid rgba(176, 141, 76, 0.34);
  }
  .ac-mech h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    color: var(--ivory);
    margin: 0.35rem 0 0;
  }
  .ac-mech .ac-tag { align-self: flex-start; }
  .ac-mech p { font-size: 0.9rem; line-height: 1.62; color: rgba(245, 240, 229, 0.7); margin: 0; }

  /* ======================== 4. WHAT GOES WRONG ========================
     Five cards on a SIX-column track, each spanning two. A plain 3-column grid
     leaves the odd two ragged against the left edge on the second row; forcing
     them to columns 2-3 and 4-5 of six centres that row with a half-column of
     air at each end, which is what makes five read as deliberate. */
  .ac-faults { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .ac-fault-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 1.7rem);
  }
  .ac-fault { grid-column: span 2; }
  .ac-fault:nth-child(4) { grid-column: 2 / span 2; }
  .ac-fault:nth-child(5) { grid-column: 4 / span 2; }
  .ac-fault {
    position: relative;
    background: var(--color-forest);
    border-radius: 1.15rem;
    padding: 2rem 1.4rem 1.5rem;
    overflow: hidden;
  }
  /* The numeral sits WHOLLY inside the card. It used to hang above the top edge
     at `top: -0.9rem`, which the card's own `overflow: hidden` then guillotined
     — the digits lost their tops. It is a watermark, not a bleed, so it belongs
     inside the frame. */
  .ac-fault-n {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 4.6rem;
    line-height: 1;
    color: rgba(201, 168, 124, 0.2);
    pointer-events: none;
  }
  .ac-fault h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--ivory);
    margin: 0 0 0.7rem;
    position: relative;
  }
  .ac-fault p { font-size: 0.92rem; line-height: 1.64; color: rgba(245, 240, 229, 0.72); margin: 0; position: relative; }
  /* The payoff line. A brass arrow in front of it marks the outcome rather than
     the explanation, so the three parts of a card stay distinguishable at a
     glance: fault, control, worth. */
  .ac-fault p.ac-fault-win {
    margin-top: 0.95rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--brass-soft);
  }
  .ac-fault p.ac-fault-win::before {
    content: '→';
    font-family: var(--font-body);
    font-style: normal;
    margin-right: 0.45rem;
    color: var(--brass);
  }

  /* ======================== 11. THE FIELD (carousel) ========================
     Six installations, three visible at a time, looping in both directions.
     Three slides are cloned to EACH end of the track, so advancing past the last
     real slide lands on a clone; the track is then reset to the real one with no
     transition, and the wrap reads as continuous.
     ⚠️ The clone count MUST be at least the slides-per-view or a gap opens at the
     seam. Three clones covers 3-up, 2-up and 1-up, so the media queries below are
     free to change the visible count without touching the script. */
  .ac-uses { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-ivory); }
  .ac-car-wrap { position: relative; }
  .ac-car { overflow: hidden; }
  .ac-car-track {
    --ac-car-gap: clamp(1rem, 2vw, 1.5rem);
    list-style: none;
    display: flex;
    gap: var(--ac-car-gap);
  }
  .ac-car-slide {
    position: relative;
    flex: 0 0 calc((100% - 2 * var(--ac-car-gap)) / 3);
    border-radius: 1.2rem;
    overflow: hidden;
  }
  /* 3:2, not the source's own 4:5. Portrait tiles stood half again as tall as
     the row needed and made the section about the photographs instead of the
     positions; the images are cropped, not stretched, so nothing is distorted. */
  .ac-car-slide img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .ac-car-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.6rem 1.1rem 0.9rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
    color: var(--ivory);
    background: linear-gradient(180deg, transparent 26%, rgba(20, 38, 27, 0.52) 60%, rgba(20, 38, 27, 0.86));
  }
  /* The arrows sit ON the row rather than in a line under it: the control then
     belongs to the picture it moves, and the section loses a whole row of
     height. The padding mirrors `.wrap`'s gutter so they land on the outer
     tiles' own edges at every width — `max()` covers the viewport wider than
     1200 px, where the gutter stops growing. */
  .ac-car-ctl {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: max(clamp(1rem, 3vw, 3rem), calc((100% - 1200px) / 2));
    pointer-events: none;
  }
  .ac-car-ctl .ac-car-btn { pointer-events: auto; }
  .ac-car-btn {
    width: 2.9rem;
    height: 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(31, 59, 44, 0.12);
    /* Opaque, because these now sit on a photograph rather than on the page. */
    background: rgba(245, 240, 229, 0.94);
    color: var(--color-brand-text);
    box-shadow: 0 12px 24px -14px rgba(20, 38, 27, 0.75);
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }
  .ac-car-btn svg { width: 1.15rem; height: 1.15rem; }
  .ac-car-btn:hover { background: var(--color-forest); border-color: var(--color-forest); color: var(--ivory); transform: translateY(-2px); }

  /* ======================== 6. WHAT THE SHEET CAN BE ========================
     Two blocks, GRADE first. The H1 promises 92% light transmittance and three
     years without yellowing, and both of those are properties of the grade
     (Cast PMMA, UV-stabilized) rather than of the finish — so the grade is the
     block that has to answer the headline, and it leads. The finish is the
     separate question of what the shelf sees, and it follows.
     ⚠️ **THE FINISH BLOCK IS A SHORT TABLE ON PURPOSE, and it is the page's
     only one.** It was built three ways: CSS swatch chips (rejected — at chip
     size clear, frosted and smoke are three pale rectangles), six photo plates
     (rejected — a secondary block carrying six large plates competes with the
     block meant to lead), and finally this. The client's words: *"你不是说这个
     不重要吗，那么不需要这么详细的都放图片吧，直接表格列举一下"*. A finish → what it
     is lookup is the one kind of content the house rule allows a real `<table>`
     for, so it is a `<table>`, not a hairline grid. **Do not add a second table
     to this page and do not put the plates back.**
     The two blocks are separated by SIZE: grade names at
     `clamp(1.3rem,1.7vw,1.6rem)` as cards, finish names at 1.14rem as rows. */
  .ac-sheet { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-ivory); }

  /* Standard visually-hidden. The table's accessible name comes from the kicker
     via aria-labelledby; this carries the longer description for screen readers. */
  .ac-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* A label and its value on one line, so the reader knows which axis the block
     below is answering. Same tracking as `.ac-wall-cap`. */
  .ac-sheet-kick {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass);
    margin: 0 0 clamp(1.2rem, 2.4vw, 1.7rem);
  }
  .ac-sheet-kick span {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--color-brand-muted);
  }

  .ac-grade-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.4rem);
    margin-bottom: clamp(3.2rem, 6vw, 4.6rem);
  }
  /* Real cards, not free-floating copy: the block LEADS the section now, so it
     gets the frame the client asked for (*"变成卡片，加一点标志，有颜色的"*). */
  .ac-grade {
    display: flex;
    flex-direction: column;
    padding: clamp(1.15rem, 2.2vw, 1.5rem);
    border-radius: 1.2rem;
    border: 1px solid rgba(31, 59, 44, 0.12);
    background: var(--color-brand-surface);
  }
  /* One mark per grade, in its own colour. The run is brass → bright → sage →
     forest rather than four arbitrary hues, and the mark flips to the dark
     forest ink on the two golds so every badge clears 3:1. */
  .ac-grade-ico {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    margin-bottom: 0.9rem;
    background: var(--brass);
    color: var(--forest-deep);
  }
  .ac-grade--bright .ac-grade-ico { background: var(--brass-bright); }
  .ac-grade--sage .ac-grade-ico { background: var(--color-sage); color: var(--ivory); }
  .ac-grade--forest .ac-grade-ico { background: var(--color-forest); color: var(--ivory); }
  .ac-grade h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.3rem, 1.7vw, 1.6rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--color-brand-text);
    margin: 0 0 0.45rem;
  }
  .ac-grade .ac-tag { align-self: flex-start; margin-bottom: 0.7rem; }
  .ac-grade p { font-size: 0.94rem; line-height: 1.66; color: var(--color-brand-muted); margin: 0; }

  .ac-fin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    /* Fixed layout, because the three columns have to hold their share as the
       measure shrinks. Auto layout sized column 2 by its longest sentence and
       pushed the other two around. */
    table-layout: fixed;
    /* A frame, not just rules. The client asked twice — *"边框留下，不然很奇怪"*
       then *"边框要明显一点，现在还是隐藏"* — so the table reads as a bounded thing
       and not as text with lines through it. */
    border: 1px solid rgba(31, 59, 44, 0.26);
  }
  .ac-fin-table thead th:nth-child(1) { width: 16%; }
  .ac-fin-table thead th:nth-child(2) { width: 58%; }
  /* The header carries the SAME indent as its column or the label and the
     values below it sit 40 px apart — the boxes line up, the text does not. */
  .ac-fin-table thead th:nth-child(3) { width: 26%; padding-left: clamp(1rem, 3vw, 2.5rem); }
  /* Padding lives on the OUTER CELLS, never on the table, so the row rules still
     run the full width and meet the frame. */
  .ac-fin-table tbody th:first-child,
  .ac-fin-table thead th:nth-child(1) { padding-left: 1.15rem; }
  .ac-fin-table tbody td:last-child,
  .ac-fin-table thead th:nth-child(3) { padding-right: 1.15rem; }
  .ac-fin-table thead th {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    padding: 0.95rem 0 0.7rem;
    border-bottom: 1px solid rgba(31, 59, 44, 0.3);
  }
  .ac-fin-table td,
  .ac-fin-table tbody th {
    padding: 1rem 0;
    vertical-align: baseline;
    border-bottom: 1px solid rgba(31, 59, 44, 0.16);
  }
  .ac-fin-table tbody tr:last-child th,
  .ac-fin-table tbody tr:last-child td { border-bottom: 0; }
  .ac-fin-name {
    padding-right: clamp(1rem, 3vw, 2rem) !important;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.14rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
  }
  /* Two rows carry a pill — the default, and the row that is not one colour.
     The pill alone was not enough (client: *"不够突出，底色可以直接绿色"*), so the two
     rows take the brand green itself. Everything inside flips to ivory, and the
     pill flips to the warm brass so it still reads as a badge on a dark band. */
  .ac-fin-name-t { display: block; }
  .ac-fin-badge {
    margin-top: 0.45rem;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 0.24rem 0.62rem;
  }
  .ac-fin-table tbody tr.ac-fin-row--on > th,
  .ac-fin-table tbody tr.ac-fin-row--on > td {
    background: var(--color-forest);
    /* The row rule STAYS — a highlighted row with its border deleted reads as a
       broken table (client: *"边框留下，不然很奇怪"*). On the dark band it has to be
       the light hairline, because the ivory-ground rule vanishes into forest. */
    border-bottom-color: rgba(245, 240, 229, 0.42);
  }
  .ac-fin-table tbody tr.ac-fin-row--on .ac-fin-name,
  .ac-fin-table tbody tr.ac-fin-row--on td.ac-fin-use { color: var(--color-ivory); }
  .ac-fin-table tbody tr.ac-fin-row--on td { color: rgba(245, 240, 229, 0.84); }
  .ac-fin-table tbody tr.ac-fin-row--on .ac-fin-badge {
    background: var(--brass-soft);
    color: var(--forest-deep);
  }
  /* A dark band butts straight against the row above it otherwise, and the two
     greens would read as one block. */
  .ac-fin-table tbody tr.ac-fin-row--on > * { padding-top: 1.15rem; padding-bottom: 1.15rem; }
  .ac-fin-table tbody td { font-size: 0.94rem; line-height: 1.66; color: var(--color-brand-muted); }
  /* The answer, not the description — serif italic, in the text colour, so the
     row reads "what it is" → "when you would pick it". */
  .ac-fin-table tbody td.ac-fin-use {
    padding-left: clamp(1rem, 3vw, 2.5rem);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-brand-text);
  }

  /* ======================== 7. WHAT CAN BE PUT ON IT ========================
     Four routes, one photograph each, laid as a 2x2. A 4-up rail here would
     repeat §How the Box Is Built's row of four mechanism cards. The photograph
     used to run the full width of its cell and stood taller than the copy it
     was meant to illustrate; it is now a narrow plate beside the text, so the
     route itself — not the picture of it — is what a buyer reads. */
  .ac-print {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: linear-gradient(180deg, var(--color-forest), var(--forest-deep));
    color: var(--ivory);
  }
  .ac-route-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.8rem, 3.4vw, 2.6rem) clamp(1.8rem, 3.4vw, 2.8rem);
  }
  .ac-route {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(0, 1fr);
    gap: clamp(1.1rem, 2.2vw, 1.6rem);
    align-items: start;
  }
  .ac-route-body { display: flex; flex-direction: column; align-items: flex-start; }
  /* The frame owns the shape, so the plate and the swatch that stands in for the
     missing photograph are the same box to the pixel. */
  .ac-route-fig {
    margin: 0;
    padding: 0.5rem;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(201, 168, 124, 0.34);
    border-radius: 1.25rem;
    background: rgba(245, 240, 229, 0.04);
  }
  .ac-route-fig img { width: 100%; height: 100%; object-fit: cover; border-radius: 0.9rem; display: block; }
  /* UV digital stands in for a photograph it does not have, with a swatch rather
     than a borrowed picture. It is a gradient in the page's own hues — which is
     the one thing the route is actually for — and it is deliberately not shaped
     or framed like a photograph. Swap it for a real print sample when one exists. */
  .ac-route-swatch {
    display: block;
    aspect-ratio: 4 / 3;
    padding: 0.5rem;
    border: 1px solid rgba(201, 168, 124, 0.34);
    border-radius: 1.25rem;
    background: linear-gradient(122deg, var(--brass-bright) 0%, var(--kraft) 28%, var(--color-forest) 62%, var(--brass-soft) 100%) content-box;
  }
  .ac-route h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--ivory);
    margin: 0 0 0.5rem;
  }
  .ac-route .ac-tag { align-self: flex-start; margin-bottom: 0.6rem; }
  .ac-route p { font-size: 0.93rem; line-height: 1.66; color: rgba(245, 240, 229, 0.72); margin: 0; }

  /* ======================== 8. WHAT MOVES THE PRICE ========================
     Two columns, not a single stack. As one column each row left ~40% of the
     measure empty beside it and the section ran twice as tall as its content
     needed — the numeral hung in a 4.4rem gutter built for a paragraph that
     never reached it. */
  .ac-cost { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .ac-cost-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.8rem, 3.4vw, 2.8rem) clamp(2rem, 4vw, 3.4rem);
  }
  .ac-cost-list li { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 1rem; align-items: start; }
  .ac-cost-n {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--brass);
  }
  .ac-cost-list h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.22rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0 0 0.5rem;
  }
  .ac-cost-list p { font-size: 0.94rem; line-height: 1.66; color: var(--color-brand-muted); margin: 0; }

  /* ======================== 5. AGAINST THE ALTERNATIVES ======================== */
  .ac-fit { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-ivory); }
  .ac-fit-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 1.7rem);
    align-items: stretch;
  }
  .ac-fit-panel {
    display: flex;
    flex-direction: column;
    border-radius: 1.2rem;
    padding: 1.8rem 1.5rem 1.5rem;
    background: var(--color-clay);
    border: 1px solid rgba(31, 59, 44, 0.1);
  }
  .ac-fit-panel--lead {
    background: linear-gradient(160deg, var(--color-forest), var(--forest-deep));
    border-color: rgba(201, 168, 124, 0.34);
  }
  .ac-fit-panel h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.42rem;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0 0 0.35rem;
  }
  .ac-fit-panel--lead h3 { color: var(--ivory); }
  .ac-fit-tag {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.98rem;
    color: var(--brass);
    margin: 0 0 1rem;
  }
  .ac-fit-panel--lead .ac-fit-tag { color: var(--brass-soft); }
  .ac-fit-d { font-size: 0.94rem; line-height: 1.68; color: var(--color-brand-muted); margin: 0 0 1.4rem; }
  .ac-fit-panel--lead .ac-fit-d { color: rgba(245, 240, 229, 0.78); }
  .ac-fit-facts { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; margin: auto 0 0; }

  /* ======================== 10. FIVE STOPS ========================
     The rule is the timeline. This is the one place on the page where a
     horizontal line means something rather than delimiting a row. */
  .ac-flow { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .ac-flow-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .ac-flow-list li {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(31, 59, 44, 0.22);
    position: relative;
  }
  .ac-flow-list li::before {
    content: '';
    position: absolute;
    top: -3.5px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brass);
  }
  .ac-flow-when {
    display: block;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.6rem;
  }
  .ac-flow-list h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0 0 0.5rem;
  }
  .ac-flow-list p { font-size: 0.9rem; line-height: 1.62; color: var(--color-brand-muted); margin: 0; }

  /* ======================== 11. REVIEWS ========================
     Two panels side by side rather than two quotes stacked down the page. As a
     stack each one ran its full three paragraphs down a 62rem column with the
     rest of the band empty beside it, which is what made it read as a wall of
     italic. Side by side the pair fills the measure and halves the height.
     Both footers are pushed to the bottom so the two panels end level. */
  .ac-quotes {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--color-ivory);
    color: var(--color-brand-text);
  }
  .ac-quote-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.6rem, 3.4vw, 2.8rem);
    align-items: stretch;
  }
  .ac-quote {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.6vw, 2.2rem);
    border: 1px solid rgba(176, 141, 76, 0.32);
    border-radius: 1.2rem;
    background: var(--color-clay);
  }
  .ac-quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 3.4rem;
    line-height: 0.6;
    color: var(--brass);
    margin-bottom: 0.5rem;
  }
  .ac-quote p {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.7;
    color: var(--color-brand-text);
    margin: 0 0 0.9rem;
  }
  .ac-quote footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(31, 59, 44, 0.16);
    margin-top: auto;
  }
  .ac-quote footer img { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .ac-quote footer span { display: flex; flex-direction: column; gap: 0.15rem; font-family: var(--font-body); font-size: 0.88rem; color: var(--color-brand-muted); }
  .ac-quote footer b { font-size: 1.06rem; font-weight: 600; color: var(--color-brand-text); }

  /* ======================== 12. FAQ ========================
     One column. As a 2-up the open item made its row twice the height of the
     closed item beside it, which left a hole in the grid and read as broken
     rather than as open. */
  .ac-faq { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--color-clay); }
  .ac-faq-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(0.7rem, 1.4vw, 1rem);
    max-width: 58rem;
    margin-inline: auto;
  }
  .ac-faq-grid details {
    background: var(--ivory);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.1rem;
    padding: 1.25rem 1.4rem;
    height: fit-content;
  }
  .ac-faq-grid summary {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.08rem, 1.4vw, 1.26rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }
  .ac-faq-grid summary::-webkit-details-marker { display: none; }
  .ac-faq-grid summary::after {
    content: '+';
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1;
    color: var(--brass);
    flex: 0 0 auto;
    transition: transform 0.3s ease;
  }
  .ac-faq-grid details[open] summary::after { transform: rotate(45deg); }
  .ac-faq-grid details p { font-size: 0.95rem; line-height: 1.72; color: var(--color-brand-muted); margin: 0.9rem 0 0; }

  /* ======================== 13. FINAL CTA ========================
     No photograph behind this band. Every candidate on the source page carries
     either a third-party product name or a watermarked stock frame, and at a
     veil heavy enough to hide those the image stops contributing anything. The
     band is a pure typographic close on the page's own forest, with a brass
     bloom off the right shoulder so it is not flat. */
  .ac-final {
    position: relative;
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background:
      radial-gradient(120% 96% at 84% 10%, rgba(176, 141, 76, 0.17) 0%, rgba(176, 141, 76, 0) 58%),
      linear-gradient(165deg, var(--color-forest) 0%, var(--forest-deep) 70%);
    color: var(--ivory);
    overflow: hidden;
  }
  .ac-final-inner {
    position: relative;
    z-index: 1;
    max-width: 54rem;
    margin-inline: auto;
    text-align: center;
  }
  .ac-final-inner .section-title { margin-bottom: 0; }
  .ac-final-inner .ac-sub-light { margin-top: 1.2rem; margin-inline: auto; max-width: 48ch; }
  .ac-final-inner .ac-actions { margin-top: 2rem; }

  /* ======================== REVEAL ======================== */
  [data-reveal] { opacity: 0; transform: translateY(36px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: var(--d, 0s); }
  [data-reveal].in { opacity: 1; transform: none; }

  /* ======================== RESPONSIVE ======================== */
  @media (max-width: 1024px) {
    .ac-type-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* four tracks, so the fault cards pair up and the odd fifth centres alone */
    .ac-fault-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .ac-fault:nth-child(4) { grid-column: span 2; }
    .ac-fault:nth-child(5) { grid-column: 2 / span 2; }
    .ac-mech-grid, .ac-grade-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ac-car-slide { flex: 0 0 calc((100% - var(--ac-car-gap)) / 2); }
    .ac-flow-list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.2rem; }
  }
  @media (max-width: 900px) {
    .ac-hero-grid, .ac-built-grid { grid-template-columns: minmax(0, 1fr); }
    .ac-hero-grid { gap: 2.4rem; }
    .ac-built-grid { gap: 2.4rem; }
    .ac-route-grid { grid-template-columns: minmax(0, 1fr); }
    .ac-fit-grid { grid-template-columns: minmax(0, 1fr); }
    .ac-quote-list { grid-template-columns: minmax(0, 1fr); }
    .ac-cost-list li { grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; }
  }
  @media (max-width: 640px) {
    .ac-type-grid, .ac-fault-grid, .ac-mech-grid, .ac-grade-grid, .ac-flow-list { grid-template-columns: minmax(0, 1fr); }
    /* Below this width the finish table has no room for two columns, so each
       row becomes its own block. The row rule moves from the cells to the row. */
    .ac-fin-table thead { display: none; }
    .ac-fin-table, .ac-fin-table tbody, .ac-fin-table tr, .ac-fin-table th, .ac-fin-table td { display: block; width: auto; }
    .ac-fin-table tbody tr { padding: 0.95rem 1.15rem; border-bottom: 1px solid rgba(31, 59, 44, 0.16); }
    .ac-fin-table tbody tr:last-child { border-bottom: 0; }
    .ac-fin-table td, .ac-fin-table tbody th { padding: 0; border-bottom: 0; }
    .ac-fin-name { padding-right: 0 !important; }
    .ac-fin-table tbody td { margin-top: 0.3rem; }
    /* the third column's indent only means something beside the copy */
    .ac-fin-table tbody td.ac-fin-use { padding-left: 0; }
    /* Stacked, the row owns the padding, so the marked rows have to paint the
       ROW — painting only the cells leaves ivory gutters through the band — and
       the rule moves to the row too. */
    .ac-fin-table tbody tr.ac-fin-row--on { background: var(--color-forest); border-bottom-color: rgba(245, 240, 229, 0.42); }
    .ac-fin-table tbody tr.ac-fin-row--on > * { padding-top: 0; padding-bottom: 0; }
    /* Below this width the plate beside the copy leaves too thin a measure, so
       the route stacks again — the one place the photograph goes full width. */
    .ac-route { grid-template-columns: minmax(0, 1fr); }
    .ac-car-slide { flex: 0 0 100%; }
    .ac-fault:nth-child(4), .ac-fault:nth-child(5) { grid-column: auto; }
    .ac-type-fig img { aspect-ratio: 4 / 3; }
    .ac-mech img { aspect-ratio: 4 / 3; }
    /* The drawing scales to ~0.55x at this width, so the label size has to go UP
       to stay legible rather than inherited from the desktop value. */
    .ac-jd-lab { font-size: 20px; letter-spacing: 0.04em; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));

  if ('IntersectionObserver' in window && !reduce) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // One answer open at a time.
  const faqItems = Array.from(document.querySelectorAll('.ac-faq-grid details'));
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) faqItems.forEach((o) => { if (o !== d) o.open = false; });
    });
  });

  // ---------------------------------------------------------------------------
  // Seamless 3-up carousel: six installations, looping in both directions.
  // CLONES slides are copied to BOTH ends of the track. Advancing onto a clone
  // and then resetting the track to the matching real slide with no transition
  // is what makes the wrap continuous — there is no visible jump because the two
  // frames are identical. CLONES must be >= the slides on screen at any width
  // (3 / 2 / 1), so three covers every breakpoint below.
  // ---------------------------------------------------------------------------
  const carTrack = document.querySelector('.ac-car-track');
  if (carTrack) {
    const CLONES = 3;
    const slides = Array.from(carTrack.children);
    const N = slides.length;
    if (N > 0) {
      const n = Math.min(CLONES, N);
      for (let k = 0; k < n; k++) {
        carTrack.insertBefore(slides[(N - n + k) % N].cloneNode(true), slides[0]);
      }
      for (let k = 0; k < n; k++) {
        carTrack.appendChild(slides[k % N].cloneNode(true));
      }
      const start = n;
      let i = start;
      let busy = false;

      const step = () => {
        const gap = parseFloat(getComputedStyle(carTrack).gap) || 0;
        return carTrack.children[start].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        carTrack.style.transition = animate ? 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        carTrack.style.transform = `translateX(${-i * step()}px)`;
      };
      const go = (dir) => {
        if (busy) return;
        busy = true;
        i += dir;
        move(true);
        window.setTimeout(() => {
          if (i < start) i += N;
          else if (i > start + N - 1) i -= N;
          move(false);
          busy = false;
        }, 570);
      };

      const prev = document.querySelector('.ac-car-btn--prev');
      const next = document.querySelector('.ac-car-btn--next');
      if (prev) prev.addEventListener('click', () => go(-1));
      if (next) next.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!busy) move(false); });

      // Keyboard, so the control is not mouse-only.
      const ctl = document.querySelector('.ac-car-ctl');
      if (ctl) {
        ctl.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') go(-1);
          if (e.key === 'ArrowRight') go(1);
        });
      }
    }
  }
</script>
