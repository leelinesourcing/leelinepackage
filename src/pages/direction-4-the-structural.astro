---
import Layout from '../layouts/Layout.astro';
import BrandMark from '../components/direction-4/BrandMark.astro';
---

<Layout
  title="The Structural — LeelinePackage"
  description="Custom structural packaging engineered for the unboxing advantage. Dieline engineering, ISTA-tested load-bearing design, and premium finishes — from 500 units to 500,000."
>
  <style is:global>
    :root {
      --color-brand-primary:   #1C2126;
      --color-brand-secondary: #5B6470;
      --color-brand-accent:    #2B4BD6;
      --color-brand-bg:        #F7F8F7;
      --color-brand-surface:   #ECEEEC;
      --color-brand-text:      #171A1E;
      --color-brand-muted:     #737B84;
      --font-heading: 'Archivo Variable', system-ui, sans-serif;
      --font-body:    'Outfit Variable', system-ui, sans-serif;
    }
  </style>

  <style is:global>
    html { scroll-behavior: smooth; }
    body { overflow-x: clip; }
    .st-mono {
      font-family: ui-monospace, 'SFMono-Regular', 'JetBrains Mono', 'Cascadia Code', 'Segoe UI Mono', Menlo, Consolas, monospace;
      font-variant-ligatures: none;
      letter-spacing: 0.02em;
    }

    /* ─────────────────────────────────────────────
       Tokens
    ───────────────────────────────────────────── */
    .st4 {
      --ink: #171A1E;
      --ink-2: #1C2126;
      --slate: #5B6470;
      --cobalt: #2B4BD6;
      --cobalt-deep: #1F37A8;
      --paper: #F7F8F7;
      --surface: #ECEEEC;
      --muted: #737B84;
      --line: rgba(23, 26, 30, 0.12);
      --line-strong: rgba(23, 26, 30, 0.22);
      --dark: #14171A;
      --dark-2: #101215;
      --dark-line: rgba(247, 248, 247, 0.14);
      --dark-muted: #9AA1AA;
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      --ease-snap: cubic-bezier(0.65, 0, 0.35, 1);
      color: var(--ink);
      background: var(--paper);
      font-family: 'Outfit Variable', system-ui, sans-serif;
      font-weight: 400;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    .st4 * { box-sizing: border-box; }

    .st4 h1, .st4 h2, .st4 h3, .st4 h4 {
      font-family: 'Archivo Variable', system-ui, sans-serif;
      margin: 0;
      font-weight: 780;
      line-height: 0.98;
      letter-spacing: -0.025em;
    }

    .st4 p { margin: 0; }

    .st4 a { color: inherit; text-decoration: none; }

    .st4 img { display: block; max-width: 100%; }

    .st-wrap {
      width: 100%;
      max-width: 1320px;
      margin-inline: auto;
      padding-inline: clamp(20px, 4vw, 56px);
    }

    /* Eyebrow micro-label */
    .st-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'Archivo Variable', system-ui, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .st-eyebrow::before {
      content: '';
      width: 26px;
      height: 2px;
      background: var(--cobalt);
    }
    .st-eyebrow--light { color: var(--dark-muted); }

    /* Buttons */
    .st-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-family: 'Archivo Variable', system-ui, sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 17px 26px;
      border: 0;
      cursor: pointer;
      transition: transform 0.45s var(--ease-spring), box-shadow 0.45s var(--ease-out), background 0.3s var(--ease-out), color 0.3s var(--ease-out);
      white-space: nowrap;
    }
    .st-btn .st-btn__arrow { transition: transform 0.45s var(--ease-spring); }
    .st-btn:hover .st-btn__arrow { transform: translateX(5px); }
    .st-btn--solid {
      background: var(--cobalt);
      color: #fff;
      box-shadow: 0 1px 0 rgba(0,0,0,0.1) inset, 0 10px 24px -14px rgba(43,75,214,0.9);
    }
    .st-btn--solid:hover {
      background: var(--cobalt-deep);
      transform: translateY(-2px);
      box-shadow: 0 2px 0 rgba(0,0,0,0.12) inset, 0 18px 34px -14px rgba(43,75,214,0.9);
    }
    .st-btn--ghost {
      background: transparent;
      color: var(--ink);
      box-shadow: inset 0 0 0 1.5px var(--line-strong);
    }
    .st-btn--ghost:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1.5px var(--ink); }
    .st-btn--ghost-light {
      background: transparent;
      color: #F7F8F7;
      box-shadow: inset 0 0 0 1.5px var(--dark-line);
    }
    .st-btn--ghost-light:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1.5px #F7F8F7; }

    /* ─────────────────────────────────────────────
       Reveal system (multiple types)
    ───────────────────────────────────────────── */
    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s var(--ease-out),
        transform 0.9s var(--ease-out),
        clip-path 1s var(--ease-snap),
        filter 0.9s var(--ease-out);
      will-change: transform, opacity, clip-path, filter;
    }
    [data-reveal='up']   { transform: translateY(42px); }
    [data-reveal='down'] { transform: translateY(-42px); }
    [data-reveal='left'] { transform: translateX(-48px); }
    [data-reveal='right']{ transform: translateX(48px); }
    [data-reveal='clip'] { clip-path: inset(0 100% 0 0); }
    [data-reveal='clipv']{ clip-path: inset(100% 0 0 0); }
    [data-reveal='scale']{ transform: scale(0.92) rotate(1.6deg); }
    [data-reveal='blur'] { filter: blur(12px); transform: translateY(22px); }
    [data-reveal].is-in {
      opacity: 1;
      transform: none;
      clip-path: none;
      filter: none;
    }

    /* SVG line-draw reveal */
    [data-draw] path, [data-draw] line, [data-draw] rect, [data-draw] circle, [data-draw] polyline {
      stroke-dasharray: var(--dash, 600);
      stroke-dashoffset: var(--dash, 600);
    }
    [data-draw].is-in path, [data-draw].is-in line, [data-draw].is-in rect, [data-draw].is-in circle, [data-draw].is-in polyline {
      transition: stroke-dashoffset 1.6s var(--ease-snap);
      stroke-dashoffset: 0;
    }

    /* ─────────────────────────────────────────────
       Keyframes
    ───────────────────────────────────────────── */
    @keyframes stRise { from { opacity: 0; transform: translateY(34px); } to { opacity: 1; transform: none; } }
    @keyframes stClip { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    @keyframes stSpin { to { transform: rotate(360deg); } }
    @keyframes stSpinRev { to { transform: rotate(-360deg); } }
    @keyframes stScan { 0%, 8% { transform: translateY(0); } 50%, 58% { transform: translateY(240px); } 100% { transform: translateY(0); } }
    @keyframes stPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    @keyframes stMarquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes stBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    @keyframes stFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

    /* ─────────────────────────────────────────────
       Navigation
    ───────────────────────────────────────────── */
    .st-nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 60;
      padding: 18px 0;
      transition: padding 0.5s var(--ease-snap), background 0.5s var(--ease-snap), box-shadow 0.5s var(--ease-snap);
    }
    .st-nav__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .st-nav__brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }
    .st-nav__word {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }
    .st-nav__word strong {
      font-family: 'Archivo Variable', system-ui, sans-serif;
      font-weight: 820;
      font-size: 17px;
      letter-spacing: -0.01em;
    }
    .st-nav__word span {
      font-family: ui-monospace, monospace;
      font-size: 9px;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 4px;
    }
    .st-nav__links {
      display: flex;
      align-items: center;
      gap: 30px;
    }
    .st-nav__links a {
      position: relative;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: var(--ink);
      opacity: 0.82;
      transition: opacity 0.3s var(--ease-out), color 0.3s var(--ease-out);
    }
    .st-nav__links a::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 100%;
      height: 2px;
      background: var(--cobalt);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.45s var(--ease-spring);
    }
    .st-nav__links a:hover { opacity: 1; }
    .st-nav__links a:hover::after { transform: scaleX(1); transform-origin: left; }
    .st-nav__cta {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .st-nav__coords {
      font-family: ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--muted);
      text-align: right;
      line-height: 1.5;
    }
    .st-nav.is-scrolled {
      background: rgba(247, 248, 247, 0.82);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      backdrop-filter: blur(14px) saturate(1.4);
      box-shadow: 0 1px 0 var(--line), 0 14px 40px -28px rgba(20, 23, 26, 0.55);
      padding: 10px 0;
    }
    .st-nav__btn {
      padding: 12px 20px;
      font-size: 12.5px;
    }

    /* Burger */
    .st-burger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 10px;
      background: transparent;
      border: 1.5px solid var(--line-strong);
      cursor: pointer;
    }
    .st-burger span {
      display: block;
      height: 2px;
      background: var(--ink);
      transition: transform 0.4s var(--ease-spring), opacity 0.3s;
    }
    .st-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .st-burger.is-open span:nth-child(2) { opacity: 0; }
    .st-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Mobile menu */
    .st-menu {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: var(--dark-2);
      color: #F7F8F7;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 120px 28px 40px;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.6s var(--ease-snap);
      overflow-y: auto;
    }
    .st-menu.is-open { clip-path: inset(0 0 0 0); }
    .st-menu__links { display: flex; flex-direction: column; gap: 4px; }
    .st-menu__links a {
      font-family: 'Archivo Variable', system-ui, sans-serif;
      font-weight: 820;
      font-size: clamp(34px, 9vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: #F7F8F7;
      display: flex;
      align-items: baseline;
      gap: 16px;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    }
    .st-menu.is-open .st-menu__links a { opacity: 1; transform: none; }
    .st-menu__links a:nth-child(1) { transition-delay: .06s; }
    .st-menu__links a:nth-child(2) { transition-delay: .11s; }
    .st-menu__links a:nth-child(3) { transition-delay: .16s; }
    .st-menu__links a:nth-child(4) { transition-delay: .21s; }
    .st-menu__links a:nth-child(5) { transition-delay: .26s; }
    .st-menu__links a .idx {
      font-family: ui-monospace, monospace;
      font-size: 12px;
      letter-spacing: 0.2em;
      color: var(--cobalt);
    }
    .st-menu__links a:hover { color: var(--cobalt); }
    .st-menu__foot {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* ─────────────────────────────────────────────
       Hero
    ───────────────────────────────────────────── */
    .st-hero {
      position: relative;
      padding: 168px 0 90px;
      overflow: hidden;
      background: var(--paper);
    }
    .st-hero__grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(40px, 6vw, 96px);
      align-items: center;
    }
    .st-hero__orbit {
      position: absolute;
      z-index: 0;
      top: 50%;
      left: 52%;
      width: min(760px, 80vw);
      aspect-ratio: 1;
      transform: translate(-50%, -50%);
      opacity: 0.5;
      color: var(--ink);
      animation: stSpin 70s linear infinite;
      pointer-events: none;
    }
    .st-hero__orbit svg { width: 100%; height: 100%; }
    .st-hero__gridline {
      position: absolute;
      z-index: 1;
      background: var(--line);
    }
    .st-hero__gridline--v { left: 52%; top: 0; bottom: 0; width: 1px; }
    .st-hero__gridline--h { left: 0; right: 0; top: 60%; height: 1px; }

    .st-hero__left { display: flex; flex-direction: column; gap: 30px; }
    .st-hero__title {
      font-family: 'Archivo Variable', system-ui, sans-serif;
      font-weight: 860;
      font-size: clamp(3rem, 8.2vw, 7.4rem);
      line-height: 0.9;
      letter-spacing: -0.03em;
      font-variation-settings: 'wdth' 82;
    }
    .st-hero__title .line { display: block; overflow: hidden; }
    .st-hero__title .line > span { display: inline-block; }
    .st-hero__title .accent { color: var(--cobalt); }
    .st-hero__sub {
      max-width: 44ch;
      font-size: clamp(16px, 1.5vw, 19px);
      line-height: 1.6;
      color: var(--slate);
      font-weight: 400;
    }
    .st-hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; }

    .st-hero__specstrip {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      border-top: 1px solid var(--line-strong);
      border-bottom: 1px solid var(--line-strong);
      margin-top: 8px;
    }
    .st-hero__specstrip > div {
      flex: 1 1 auto;
      min-width: 120px;
      padding: 14px 18px 14px 0;
    }
    .st-hero__specstrip .k {
      display: block;
      font-family: ui-monospace, monospace;
      font-size: 9.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .st-hero__specstrip .v {
      font-family: ui-monospace, monospace;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    /* Hero right — spec panel */
    .st-panel {
      position: relative;
      background: #fff;
      box-shadow: 0 1px 0 var(--line), 0 40px 80px -48px rgba(20,23,26,0.4);
      padding: 22px;
    }
    .st-panel__head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 18px;
    }
    .st-panel__head .t {
      font-family: ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .st-panel__img {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 28px), calc(100% - 28px) 100%, 0 100%);
      background: var(--surface);
    }
    .st-panel__img img { width: 100%; height: 100%; object-fit: cover; }
    .st-panel__img::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 55%, rgba(20,23,26,0.28));
    }
    .st-panel__dieline {
      position: absolute;
      inset: 0;
      color: #fff;
      opacity: 0.9;
      mix-blend-mode: screen;
    }
    .st-panel__rows { display: grid; gap: 0; margin-top: 6px; }
    .st-panel__row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 11px 0;
      border-bottom: 1px dashed var(--line);
      font-family: ui-monospace, monospace;
      font-size: 12.5px;
      letter-spacing: 0.02em;
    }
    .st-panel__row .k { color: var(--muted); }
    .st-panel__row .v { font-weight: 600; text-align: right; }
    .st-panel__row .v.hl { color: var(--cobalt); }
    .st-panel__scan {
      position: absolute;
      left: 22px;
      right: 22px;
      top: 22px;
      height: 2px;
      background: var(--cobalt);
      box-shadow: 0 0 12px rgba(43,75,214,0.7);
      animation: stScan 5s var(--ease-snap) infinite;
      pointer-events: none;
    }

    /* Dimension annotation crossing the panel edge */
    .st-dim {
      position: absolute;
      z-index: 4;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--ink);
    }
    .st-dim--w {
      top: -26px;
      left: -42px;
    }
    .st-dim .bar { height: 1px; background: var(--cobalt); width: 42px; }
    .st-dim .tick { width: 7px; height: 7px; border-left: 1px solid var(--cobalt); border-bottom: 1px solid var(--cobalt); }
    .st-dim--h {
      right: -64px;
      top: 42%;
      transform: rotate(90deg);
    }

    /* Cobalt ticker */
    .st-ticker {
      background: var(--cobalt);
      color: #fff;
      overflow: hidden;
      padding: 13px 0;
      position: relative;
      z-index: 3;
    }
    .st-ticker__track {
      display: flex;
      width: max-content;
      gap: 0;
      animation: stMarquee 32s linear infinite;
    }
    .st-ticker__track span {
      display: inline-flex;
      align-items: center;
      gap: 22px;
      padding-right: 22px;
      font-family: ui-monospace, monospace;
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .st-ticker__track span::after { content: '◆'; font-size: 8px; opacity: 0.7; }

    /* ─────────────────────────────────────────────
       Section scaffolding
    ───────────────────────────────────────────── */
    .st-section { position: relative; padding: clamp(72px, 9vw, 130px) 0; }
    .st-section--surface { background: var(--surface); }
    .st-section--dark { background: var(--dark); color: #F7F8F7; }
    .st-section--dark h1, .st-section--dark h2, .st-section--dark h3 { color: #F7F8F7; }

    .st-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
      margin-bottom: clamp(40px, 6vw, 72px);
    }
    .st-head__title {
      font-size: clamp(2rem, 4.6vw, 4rem);
      letter-spacing: -0.03em;
      font-variation-settings: 'wdth' 88;
    }
    .st-head__side {
      max-width: 36ch;
      color: var(--slate);
      font-size: 15.5px;
      line-height: 1.6;
    }

    /* Registration rule divider (motif) */
    .st-rule {
      position: relative;
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 18px 0 0;
      margin-bottom: 0;
    }
    .st-rule__label {
      font-family: ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--muted);
      white-space: nowrap;
    }
    .st-rule__line { flex: 1; height: 1px; background: var(--line-strong); position: relative; }
    .st-rule__line::before,
    .st-rule__line::after {
      content: '';
      position: absolute;
      top: -4px;
      width: 9px;
      height: 9px;
      border: 1px solid var(--cobalt);
    }
    .st-rule__line::before { left: 18%; }
    .st-rule__line::after { right: 12%; border-radius: 50%; border-color: var(--muted); }

    /* Angular divider (light→dark / dark→light) */
    .st-divider { line-height: 0; position: relative; z-index: 2; }
    .st-divider svg { display: block; width: 100%; height: clamp(44px, 6vw, 88px); }

    /* ─────────────────────────────────────────────
       Services / offerings
    ───────────────────────────────────────────── */
    .st-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: clamp(16px, 2vw, 24px);
      align-items: start;
    }
    .st-card {
      position: relative;
      display: flex;
      flex-direction: column;
      background: #fff;
      box-shadow: 0 1px 0 var(--line);
      transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-out);
    }
    .st-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 1px 0 var(--line), 0 34px 60px -34px rgba(20,23,26,0.5);
    }
    .st-card__img {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--surface);
    }
    .st-card__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.9s var(--ease-out);
    }
    .st-card:hover .st-card__img img { transform: scale(1.06); }
    .st-card--clip-a .st-card__img { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 26px)); }
    .st-card--clip-b .st-card__img { clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 100%, 0 100%); }
