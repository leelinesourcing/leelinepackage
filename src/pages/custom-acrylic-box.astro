---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const AC = `${R2}/acrylic-box`;

/* The nine families that carry the searches a buyer types. Each `d` line is a
   consequence the buyer's own customer feels, and no card restates the section
   intro or the card above it. */
const types = [
  { n: 'AD-01', key: 'type-display', name: 'Custom Acrylic Display Boxes', spec: 'Counter and shelf',
    alt: 'A clear acrylic display box with a slim black base and a printed ribbon, standing on a pale table',
    d: 'The product is the display. Branding goes on the base and the product sits behind nothing at all, which is what a printed carton cannot do.' },
  { n: 'WG-02', key: 'type-gift', name: 'Wholesale Acrylic Gift Boxes', spec: 'Long programs',
    alt: 'A row of clear acrylic gift boxes on colored bases, each tied with a ribbon, against a two-tone backdrop',
    d: 'A single specification held across a long program, with the unit rate stepping down at the volume tier a reorder actually reaches.' },
  { n: 'CL-03', key: 'type-lid', name: 'Clear Acrylic Boxes With Lids', spec: 'Lift-off, hinged or clasped',
    alt: 'A clear acrylic box closed by a small metal clasp, photographed against a pale blue sweep',
    d: 'A lid is where a box is judged. The lid here seats the same way on the thousandth unit as on the first, which is a jig, not a technique.' },
  { n: 'OE-04', key: 'type-oem', name: 'OEM Acrylic Boxes', spec: 'Drawn to your size',
    alt: 'An unbranded stepped clear acrylic organizer holding cosmetic bottles and tubes',
    d: 'Any footprint inside the sheet, cut to your drawing. There is no nearest stock size to compromise a product against.' },
  { n: 'PR-05', key: 'type-printed', name: 'Custom Printed Acrylic Boxes', spec: 'Four print routes',
    alt: 'Two small clear acrylic cubes, each carrying a printed round insert under its lid, on a white plate',
    d: 'Artwork goes on the box rather than on a label, either cured under the surface or cut into it. Nothing to peel, nothing to sit crooked.' },
  { n: 'JW-06', key: 'type-jewelry', name: 'Acrylic Jewelry Boxes', spec: 'Divided compartments',
    alt: 'A stacked clear acrylic box with narrow divided compartments, holding slim cosmetic tubes',
    d: 'Compartments and a tray built to the piece rather than a stock tray, so a chain arrives unknotted.' },
  { n: 'ST-07', key: 'type-storage', name: 'Acrylic Storage Boxes', spec: 'Stackable, load-rated',
    alt: 'A clear acrylic drawer tower with a hand pulling one drawer open, holding small cosmetic pots',
    d: 'Walls sized to the weight above rather than to a default, which is the difference between a stack of four that stays square and a stack that leans.' },
  { n: 'PX-08', key: 'type-plexiglass', name: 'Custom Plexiglass Packaging', spec: 'Cast PMMA sheet',
    alt: 'A stack of clear cast acrylic sheet offcuts photographed edge-on, showing the thickness of each wall',
    d: 'The same material under its trade name, sheet and fabrication in the same building, which is what holds the wall to the grade that was quoted.' },
  { n: 'LK-09', key: 'type-lockable', name: 'Lockable Collection Boxes', spec: 'Cam lock and a slot',
    alt: 'A clear acrylic collection box with a cam lock, a chalkboard sign reading TIPS and banknotes inside',
    d: 'For donations, ballots and anything emptied by a single person and counted by another, with the lock and the slot set into the panels themselves.' },
];

/* Four pairs. The left column is what a bonded box does; the right is what a
   sawn-and-glued one does. Every pair is anchored in the drawing beside it, and
   none of them is repeated in §Where an Acrylic Order Goes Wrong — that section
   owns the faults this one does not. */
const pairs = [
  { good: 'Polished edge', bad: 'Sawn edge',
    d: 'A cut edge is milled or flame-polished until it transmits light like the face. A sawn edge stays whitish and reads as a sheet someone cut.' },
  { good: 'Solvent bond', bad: 'Glue line and trapped air',
    d: 'Solvent softens both faces until they fuse, leaving a faint continuous line. Adhesive sits between them as a cloudy seam with bubbles in it.' },
  { good: 'Lid set on a jig', bad: 'Lid fitted by eye',
    d: 'The gap is a dimension held on a jig and gauged on the first box off it. Fitted by hand the gap drifts, and a drifting gap rocks.' },
  { good: 'Wall from the span', bad: 'Wall from the price',
    d: 'Thickness follows the footprint and the weight above it. Chosen from the price list instead, a long shelf shows a bow inside a month.' },
];

/* Four closures, four photographs of the closure itself. */
const mechs = [
  { key: 'mech-lid', name: 'Lift-off lid', tag: 'No hinge to fail',
    alt: 'Two stacked clear acrylic boxes with lift-off lids, gold lettering bonded to the front face',
    d: 'A straight lift with a rebated lip. Nothing to wear out, and the whole top face stays clear for print.' },
  { key: 'mech-hinge', name: 'Hinged lid', tag: 'Jig-set barrels',
    alt: 'Two clear acrylic handbag-style boxes with hinged lids and pearl handles, holding gift bottles',
    d: 'Barrels are jig-drilled rather than eyed in, and the lid still seats square a thousand openings later.' },
  { key: 'mech-drawer', name: 'Sliding tray', tag: 'Runner or friction',
    alt: 'A clear acrylic drawer unit with a hand pulling the lower drawer out, holding cosmetic bottles',
    d: 'A tray that pulls out under the product, for anything that gets handled rather than looked at.' },
  { key: 'mech-step', name: 'Stepped shelf', tag: 'Nothing hidden',
    alt: 'A rose-tinted stepped acrylic desk organizer with three tiers and a pen resting on it',
    d: 'Tiers cut from the same sheet and bonded at the same rake: a whole range reads from the door.' },
];

/* Each card runs problem → control → what the control is worth. The third line
   is the point of the section: a fault list on its own tells a buyer what can go
   wrong and gives them nothing. Scoped to what the buyer RECEIVES — the edge,
   the joint and the lid gap belong to §How the Box Is Built. */
const faults = [
  { n: '01', s: 'The face arrives hazed, with every mark the bench made on it',
    d: 'Both faces are masked through cutting and fabrication, and the film comes off at packing rather than on the bench.',
    win: 'What is unwrapped has not been touched by anything but a glove.' },
  { n: '02', s: 'The second order is a different color of clear',
    d: 'Sheet grade is recorded against the SKU, so a reorder runs to the same standard as the first run rather than from memory.',
    win: 'Order twelve looks like order one, and a shelf does not drift over a season.' },
  { n: '03', s: 'The print lifts along an edge',
    d: 'Ink is cured into the face instead of laid on top of it, and the print route is chosen while the artwork is still being drawn.',
    win: 'A mark that survives a wipe-down, with no label edge to catch.' },
  { n: '04', s: 'A hinge seizes, or a lock corrodes, in a humid shop',
    d: 'Hardware is specified for the room the box lives in: stainless or solid brass, and a barrel rated for the opening count the piece will see.',
    win: 'It opens as smoothly in year three as it did on day one.' },
  { n: '05', s: 'One unit cracks in transit and there is no spare to send',
    d: 'Corner blocks are written into the pack and a spare into the run, so a replacement comes out of the same batch.',
    win: 'One damaged box costs a courier label, not a remake and a wait.' },
];

/* Six installations, walked through by the carousel. Captions name the setting;
   the alt text describes the photograph. Three are the frames the old grid used,
   plus three more cut from sources the page carries elsewhere but framed here on
   the SETTING rather than on the product — which is what makes them scenes. */
/* Six positions, each cropped 3:2 from the source's own 4:5 frame — the tiles
   used to run portrait and stood half again as tall as the row needed, which
   made the section about the photographs rather than about the positions. The
   `-v2` suffix is not cosmetic: re-uploading an existing R2 key does NOT change
   what the CDN serves, so a re-crop always lands on a new key. */
const scenes = [
  { key: 'scen-vitrine-v2', cap: 'A gallery',
    alt: 'A dark museum room with lit acrylic vitrines on plinths, holding sculpture and glassware' },
  { key: 'scen-retail-v2', cap: 'A shop window',
    alt: 'Three translucent acrylic boxes in deep green, red and amber, with pencils resting inside them' },
  { key: 'scen-vanity-v2', cap: 'A counter',
    alt: 'A tiered clear acrylic cosmetic organizer holding lipsticks, tubes and compacts in a bright room' },
  { key: 'use-event-v2', cap: 'A launch',
    alt: 'Two stacked clear acrylic boxes carrying gold lettering, standing on white fur with planting behind' },
  { key: 'use-gifting-v2', cap: 'A gifting suite',
    alt: 'Clear acrylic handbag-style boxes with pearl handles, held up outdoors, holding perfumes and gifts' },
  { key: 'use-favour-v2', cap: 'A celebration',
    alt: 'Two small clear acrylic cubes carrying printed round labels, on a white plate beside two rings' },
];

/* §What the Sheet Can Be, in two blocks: the four sheet GRADES lead, the six
   FINISHES follow.
   The order is deliberate. The H1 promises 92% light transmittance and three
   years without yellowing, and both of those are properties of the grade
   (Cast PMMA, UV-stabilized) — not of the finish. The grade is therefore the
   block that has to answer the headline, and the finish is the separate
   question of what the shelf sees.
   The finishes get the SHORT treatment — one lookup table, no photographs.
   They were briefly built as six photo plates; the client cut them back
   (*"你不是说这个不重要吗，那么不需要这么详细的都放图片吧，直接表格列举一下"*), which is
   the right call: a secondary block that carries six large plates competes with
   the block that is meant to lead. THIS IS THE PAGE'S ONE TABLE — everything
   else is separated by gap, type scale or colour. Do not add a second. */
/* Two rows carry a badge, because they are the only two that change what a
   buyer does. `Clear` is the default — the old section intro said so and the
   line was lost when the intro was rewritten for the grade-first order.
   `Amber tint` reads like a single colour, and it is not: it is the row for ANY
   colour ("Any Pantone in any transparency"), so the badge stops the name
   understating it. Nothing else here is marked. */
const finishes = [
  { name: 'Clear', badge: 'The default',
    use: 'A product that is the display',
    d: 'The hardest of the six to get right. Cast rather than extruded, which keeps the machined edge clear.' },
  { name: 'Frosted',
    use: 'A piece that gets handled',
    d: 'A diffuse surface that scatters a spotlight and forgives fingerprints in a way a polished face never does.' },
  { name: 'Smoke',
    use: 'Reading solid from the door',
    d: 'A gray tint deep enough to read as a solid from across a room and still let the product be seen up close.' },
  { name: 'Amber tint', badge: 'Any Pantone',
    use: 'Matching a brand palette',
    d: 'Any Pantone in any transparency. The tint runs through the sheet, which means a scratch cannot cut down to clear.' },
  { name: 'Mirror gold',
    use: 'A shelf moment that has to carry',
    d: 'A metallised face that throws the shelf light back out. The loudest of the six, and it wants a quiet product.' },
  { name: 'Neon edge',
    use: 'An edge that carries the light',
    d: 'A fluorescing edge that lights along the wall thickness. The face stays clear and the edge does the work.' },
];

/* The four grades, as cards, each with its own mark. The icons are literal SVG
   strings carrying `stroke="currentColor"` and their own width/height — the
   colour is inherited from the scoped `.ac-grade-ico` wrapper, which is safe,
   but SIZE must live inside the string or a scoped rule cannot reach it. The
   `tone` picks the badge from the palette: brass → bright → sage → forest, a
   gold-to-green run rather than four arbitrary hues. Icon colour flips with the
   badge so every pair clears 3:1 (brass and brass-bright both need the dark
   forest mark; sage and forest take ivory). */
const grades = [
  { t: 'Cast PMMA', tag: '92% light transmission', tone: 'brass',
    ico: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="12" height="12" rx="1.6"/><path d="M8 3h11a2 2 0 0 1 2 2v11"/></svg>',
    d: 'The baseline sheet, and the grade that machines and polishes without clouding. Extruded sheet is cheaper and is the reason a cut edge sometimes looks milky.' },
  { t: 'UV-stabilized', tag: 'Stabilized through the sheet', tone: 'bright',
    ico: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.6"/><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"/></svg>',
    d: 'For a box that stands in daylight. The inhibitor runs through the thickness rather than sitting in a coating, which is why it cannot be washed off a front face.' },
  { t: 'Impact-modified', tag: 'To seventeen times glass', tone: 'sage',
    ico: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 5 5.6v5.3c0 4 2.8 7.2 7 8.9 4.2-1.7 7-4.9 7-8.9V5.6z"/></svg>',
    d: 'Tougher than standard PMMA at the same wall. The grade for a counter with children at it, and for anything that has to travel.' },
  { t: 'Structural wall', tag: 'Sized to the span', tone: 'forest',
    ico: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M6 6v12M18 6v12"/><path d="M12 9.5v5M9.6 12.2 12 14.6l2.4-2.4"/></svg>',
    d: 'For a plinth or a shelf carrying weight rather than showing product. The wall is derived from the span and the load, then quoted on its own line.' },
];

/* Four routes. Three carry a photograph; UV digital does NOT, and that is
   deliberate. The source page has no frame of full-colour print lying on an
   acrylic face — the only full-colour candidate is a clear holder with printed
   MAGAZINES standing inside it, which is not print on the sheet at all, and
   every other printed frame in the set is a card insert or carries a
   third-party wordmark. A card whose copy says "printed straight to the face"
   cannot sit under a picture of something else, so it ships with no figure
   until a real print sample is photographed. `key: null` renders text-only. */
const prints = [
  { key: 'print-silk', t: 'Silkscreen', tag: 'Exact Pantone',
    alt: 'A red cast acrylic box carrying a solid white script printed across its lid',
    d: 'A solid color laid through a screen. The route for a logo in a spot color or two that has to match a brand book under a shop light.' },
  { key: null, t: 'UV digital', tag: 'No plate, full color',
    alt: '',
    d: 'Artwork printed straight to the face and cured under a lamp. No plate, which is what makes a short run carrying a photograph worth quoting.' },
  { key: 'print-marks', t: 'Laser engraving', tag: 'Cut into the sheet',
    alt: 'A close crop of a script wordmark engraved into the underside of a clear acrylic lid, catching the light',
    d: 'A frosted mark taken below the surface. It cannot rub away, it reads best where a light can catch it, and it survives cleaning.' },
  { key: 'print-foil', t: 'Hot foil', tag: 'Real metal',
    alt: 'Gold metal lettering standing proud of the front face of two stacked clear acrylic boxes',
    d: 'Gold, silver or rose gold laid as foil rather than as ink. The only route that produces a genuinely metallic face rather than a suggestion of it.' },
];

/* The four lines a quote is actually built from. Three of them are settled on
   the drawing, before a sheet is cut. */
const cost = [
  { n: '01', t: 'The sheet and the wall',
    d: 'The sheet is the largest line in the box. A wall matched to the load carries it for less material than a thickness picked off a price list, and that gap is the first place to look.' },
  { n: '02', t: 'How the parts nest',
    d: 'Each panel comes out of a standard sheet. A footprint drawn to tile with little waste costs materially less than the same box at a size that throws half a sheet away.' },
  { n: '03', t: 'The polish',
    d: 'A polished edge is bench time per part, and it is the first line cut when a price has to come down. It is also the difference a buyer sees across a counter.' },
  { n: '04', t: 'The print route',
    d: 'A screen carries a setup and digital carries none, so on a short run the screen setup can be the biggest line on the quote. Above that they cross over.' },
];

const fit = [
  { name: 'Acrylic', tag: 'Shaped, then bonded', lead: true,
    d: 'Ten to seventeen times the impact resistance of glass at half the weight, and it can be cut, polished and bonded into shapes glass cannot be made in at all. The face is softer than glass, where a scratch shows rather than disappears.',
    facts: ['92% light transmission', 'Half the weight of glass', 'Bonded, not framed'] },
  { name: 'Glass', tag: 'Resists scratching',
    d: 'A harder face than any plastic and no yellowing at any age. It is heavy, it breaks into whatever is inside it, and anything other than flat panels has to be bought rather than made.',
    facts: ['Hardest face', 'Breaks into the product', 'Flat panels only'] },
  { name: 'PET-G or polycarbonate', tag: 'Where it gets knocked',
    d: 'The toughest of the three, and the grade to specify where a box gets knocked rather than admired. It is less clear than PMMA of equal thickness and it drifts faster under daylight.',
    facts: ['Highest impact', 'Less clear than PMMA', 'Drifts under daylight'] },
];

/* The only place the two timings are stated. */
const stops = [
  { when: 'Day 0', name: 'Drawing and mockup',
    d: 'A dimensioned drawing of each panel with the sheet nesting shown on it, plus a 3D mockup of the closed box. The wall and the lid are settled here rather than at the saw.' },
  { when: 'Day 1\u20134', name: 'Sheet and white sample',
    d: 'The sheet grade is confirmed against the drawing and an unprinted box is made at the finished size, held against the product and opened and closed by hand.' },
  { when: 'Day 5\u20137', name: 'Printed sample',
    d: 'The same box carrying the final artwork, with the color read against the signed chip. Nothing goes to the bench until this is signed off.' },
  { when: 'Day 8\u201335', name: 'Cut, polish, bond, assemble',
    d: 'Panels are cut from the sheet booked at the first stop, edged, bonded and fitted with hardware down the bench in sequence rather than in batches.' },
  { when: 'Day 36\u201342', name: 'Inspection and pallet',
    d: 'Every unit is checked for haze and for lid seating, the lot is masked, corner-blocked and palleted, and the packing sheet travels with the shipping papers.' },
];

/* The source page's own two reviewers. No figure appears here that either of
   them did not state. */
const quotes = [
  { name: 'Rachel Brooks', role: 'Brand Merchandising Lead \u00b7 United States', img: `${AC}/avatar-rachel.webp`,
    alt: 'Portrait of Rachel Brooks',
    p: [
      'We ordered 500 display boxes with the logo engraved for a necklace line, and the brief was mostly a warning: the box had to disappear. What arrived was clearer than the samples we had been sent by two other suppliers, and the engraving read without a label anywhere on it.',
      'The turnaround was twelve days including the crossing to California, which put the boxes on the counter for the launch instead of after it.',
      'The unboxing is the part customers keep mentioning. We have already placed a reorder for a thousand more.',
    ] },
  { name: 'Priya Sharma', role: 'Owner and Creative Director \u00b7 United Kingdom', img: `${AC}/avatar-priya.webp`,
    alt: 'Portrait of Priya Sharma',
    p: [
      'We bought 150 heart-shaped boxes for a preserved rose line, which is a product where the box is most of the gift. The laser-cut edges came out mirror-smooth and the shape held on all hundred and fifty.',
      'The courier held the pallet for three days, which is the only reason this is not a five. What mattered was being told: the tracking was checked daily and pushed to us rather than us going looking for it.',
      'The boxes are the part we would buy again. The delay cost three days and no customers.',
    ] },
];

/* Answers only what the body does not already cover — that is a hard rule here,
   because a FAQ that re-asks a question a section has answered reads as filler.
   Checked 2026-09-18: no 5-gram of any answer appears in the body above.
   Wall thickness and how the box is built are §How the Box Is Built, the timings
   are §Five Stops, the materials are §Against the Alternatives, the grades and
   finishes are §The Sheet Can Be, the print routes are §What Can Be Put On It,
   and the price levers are §Four Things Move the Unit Price.
   ⚠️ Three answers were REWRITTEN that day because they restated a section even
   though no wording was shared: the yellowing answer was re-explaining the
   UV-stabilized grade card, the damage answer was re-listing the packing that
   §Where an Acrylic Order Goes Wrong already covers, and the inside-face answer
   was repeating the laser-engraving card. Each now answers the DECISION the
   body does not: when you do NOT need the stabilized grade, what a claim runs
   on, and where a mark should sit. **Overlap here is topical, not lexical — a
   shared-ngram check will not catch it.** */
const faqs = [
  { q: 'What is the minimum order for a custom acrylic box?',
    a: '500 units, which is roughly where the sheet cost and the bench time stop dominating the unit rate. A size already in production reordered in new artwork carries no new setup at all, and a market test can go below that on a shape we have run before. Send the size and the quantity and the tier comes back as its own line rather than as a surprise on the invoice.' },
  { q: 'Will the acrylic yellow or cloud in a shop window?',
    a: 'Only where the box actually faces daylight. A box on an interior aisle, or on a counter away from a window, does not need the stabilized grade at all, and specifying it there buys nothing. A position in direct sun does, and the position is what decides — say which way the box faces when the drawing goes out.' },
  { q: 'Can the inside face be printed or engraved?',
    a: 'Yes, and it is worth doing wherever the lid comes off and the interior ends up on show. A mark on the inside face reads from the front while the surface the customer actually touches stays unbroken. Either comes back quoted separately.' },
  { q: 'What happens if a box arrives damaged?',
    a: 'Send a photograph of the damage. The pallet was photographed before it left and the packing record travels inside the carton, so the claim is settled against a record instead of a description, and the replacement is raised against the batch record.' },
  { q: 'Can one order carry several sizes and several print methods?',
    a: 'Yes, and most ranges do. A shelf set with three tiers, or a range in four sizes, is a single order with several drawings, each size carrying its own rate. Print routes can be mixed inside the order, which is what lets a logo be screened while a photograph beside it goes down digitally.' },
  { q: 'What do you need to quote a run?',
    a: 'The product\u2019s own dimensions, the quantity, where the box will stand, and whether the artwork covers the lid or the whole outer face. Size and quantity settle the sheet grade and the tier, the position settles the grade, and the print area settles which route is quoted. All of it comes off our own bench in Wuhan, China, with nobody in between the drawing and the saw. A ruler laid against the product closes the last gap.' },
];

const seo = {
  title: 'Custom Acrylic Box Manufacturers: 6 Finishes, 4 Sheet Grades',
  description: 'Crystal-clear custom acrylic boxes with polished edges and solvent-bonded seams. Half the weight of glass, 92% light transmission. MOQ 500, samples in 5–7 days.',
  keywords: 'custom acrylic box manufacturers, custom acrylic display boxes, wholesale acrylic gift boxes, clear acrylic box with lid manufacturer, OEM acrylic box manufacturer China, custom printed acrylic boxes, acrylic jewelry box manufacturer, acrylic storage box manufacturer, custom plexiglass packaging manufacturer, cast PMMA acrylic box supplier, acrylic box manufacturer China, custom acrylic boxes wholesale, plexiglass display box maker',
  canonical: 'https://www.leelinepackage.com/custom-acrylic-box/',
  ogImage: `${AC}/hero-case.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Acrylic Box Manufacturing',
      description: seo.description,
      serviceType: 'Custom acrylic box design and fabrication — cast PMMA sheet selection, panel nesting, edge polishing, solvent bonding, hardware fitting and screen, digital, laser or foil decoration',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Acrylic Box' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

/* The hero's one specification element: the wall range, drawn as a scale. The
   ticks are positioned from the same numbers the labels read, so the two cannot
   drift apart. */
const walls = [3, 4, 5, 8, 10];

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${AC}/hero-case.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ 1. HERO ============ -->
    <section class="ac-hero" id="ac-hero">
      <div class="wrap ac-hero-grid">
        <div class="ac-hero-copy">
          <span class="eyebrow" data-reveal="up"><Fragment set:html={leaf} />Cast sheet, polished and bonded</span>
          <h1 class="ac-title" data-reveal="up" style="--d:0.08s">Custom Acrylic Box Manufacturers: <em>92% Light Transmittance</em> &amp; 3-Year Anti-Yellowing</h1>
