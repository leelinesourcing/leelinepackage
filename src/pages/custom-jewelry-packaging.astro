---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const JK = `${R2}/jewelry`;

/* Small marks for the finish steps — one idea each, coloured, set left of the label. */
const fico = (d) => '<svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">' + d + '</svg>';

/* Header from direction 1, sections from direction 2. This pass carries ten adjustments:
    1 hero image is the BACKGROUND (not a band below)
    2 §Types — head moved LEFT, nine cards, warm ground
    3 §Inserts — slots at 16:9, every plate a placeholder, and each item states WHY this shape,
      WHEN it suits, WHAT the buyer gets
    4 §Structure — a bigger plate and more copy, still image left / text right
    5 §Linings — the copy moves INTO cards with a benefit line; the figures band is gone, because
      it repeated the hero
    6 §Finish — a five-step numbered run, so it can no longer look like the card grid above it
    7 §Box or Gift Box — smaller plates, and When / How / What you get
    8 §Case study — the link is a real button with a border and a fill
    9 §Reviews — one mark only: the small pair. The big corner glyph is gone
   10 §Final — less vertical padding
*/

const types = [
  { n: 'JT-01', name: 'Custom Ring Boxes', spec: 'One or two wells', img: 'struct-book', w: 550, h: 525,
    alt: 'Two white square ring boxes foil-stamped with an irregular gold mark, one open on a black ring slot',
    d: 'The well is cut to the band, so the stone never touches anything solid.' },
  { n: 'JT-02', name: 'Custom Necklace Boxes', spec: 'Card or tray', img: 'type-necklace', w: 550, h: 525,
    alt: 'A white lid-and-base box with its lid set aside, a grey suede lining inside and a fine gold chain beside it',
    d: 'A card carries the chain in one curve, so it arrives ready to hang.' },
  { n: 'JT-03', name: 'Custom Earring Boxes', spec: 'Paired wells', img: 'type-earring', w: 550, h: 525,
    alt: 'Pale lilac jewelry boxes stacked with a small open box holding a pair of earrings',
    d: 'Two wells instead of one cavity, so the pair never meets in transit.' },
  { n: 'JT-04', name: 'Custom Pendant Boxes', spec: 'Deep slot', img: 'type-pendant', w: 550, h: 525,
    alt: 'Grey and black pendant boxes open on their inserts, a pendant and a chain set into each',
    d: 'Depth holds a swinging drop still and keeps the bail off the chain.' },
  { n: 'JT-05', name: 'Custom Jewelry Gift Boxes', spec: 'Ribbon or magnet', img: 'type-gift', w: 550, h: 525,
    alt: 'A white paper bag and a black jewelry box grouped with a pale green box on an orange ground',
    d: 'The lid is the first thing photographed — the opening is the product here.' },
  { n: 'JT-06', name: 'Custom Jewelry Drawer Boxes', spec: 'Sliding tray', img: 'type-drawer', w: 550, h: 525,
    alt: 'A hand sliding open a green jewelry drawer box printed with a gold script name and flowers',
    d: 'A drawer shows the piece before it is lifted. Worth it at a counter, not at volume.' },
  { n: 'JT-07', name: 'Custom Jewelry Travel Cases', spec: 'Cut compartments', img: 'type-travel', w: 430, h: 385,
    alt: 'An open tan jewelry case with cut compartments holding rings, earrings and a chain',
    d: 'Cut compartments let a mixed run travel as one case, apart.' },
  { n: 'JT-08', name: 'Custom Jewelry Set Boxes', spec: 'Two levels', img: 'type-set', w: 550, h: 525,
    alt: 'An open jewelry case with a pale lining holding a necklace, earrings, a ring tray and a bracelet',
    d: 'One level for what is seen first, one for the papers that follow.' },
  { n: 'JT-09', name: 'High-End Wooden Jewelry Chests', spec: 'Lid and base', img: 'chest', w: 550, h: 525,
    alt: 'A wooden jewelry chest standing open, its tray lined and divided for rings and a bracelet',
    d: 'The one build a customer keeps, refills and leaves on display.' },
];

/* Every plate here is a SLOT — the source page's insert frames did not show the shape the caption
   named, so a labelled slot is more honest than a photograph of something else.
   why / when / get are the three things a buyer is actually deciding between. */
const inserts = [
  { n: '01', name: 'Ring slot',
    why: 'Two wells, measured from the band itself rather than from a standard ring size, and cut shallow enough that the piece finishes below the lid line.',
    when: 'Rings and earrings — anything with a stone that must not come to rest on the board.',
    get: 'Nothing leans on the stone.' },
  { n: '02', name: 'Cut tray',
    why: 'Laser-cut pockets, one cavity per SKU, drawn from measurements rather than from a product-page photograph.',
    when: 'A mixed run that has to travel in a single outer box.',
    get: 'Mixed SKUs ride without contact.' },
  { n: '03', name: 'Necklace card',
    why: 'Satin or velvet wrapped over board, with two notches cut at the top so the chain hangs in one curve and the clasp sits clear of the wrap.',
    when: 'Necklaces and chains, where a tangle is what the customer complains about.',
    get: 'The chain arrives ready to hang.' },
  { n: '04', name: 'Pillow pad',
    why: 'A shaped pad cut to the inside curve of the piece, so it holds a shape rather than a corner and the clasp carries no weight.',
    when: 'Watches, bangles and cuffs — anything with no flat side to rest on.',
    get: 'The shape survives the trip.' },
  { n: '05', name: 'Two-level tray',
    why: 'Two floors cut from the same measurements: the trays ride above, the chain card or the certificate sits in the level beneath, held flat rather than folded.',
    when: 'Sets that ship with papers, a certificate or a second piece.',
    get: 'A set travels as a set.' },
];

const structures = [
  { n: '01', name: 'Magnetic Book-Style', img: 'type-pendant', w: 550, h: 525,
    alt: 'Grey and black pendant boxes open on their fitted inserts',
    why: 'A hinged lid gives the piece a frame and shuts on a magnet, so the box opens one-handed and stays shut in a bag.',
    best: 'Rings, earrings, small pendants', avoid: 'The box has to pack flat for freight' },
  { n: '02', name: 'Lid and Base', img: 'type-set', w: 550, h: 525,
    alt: 'An open jewelry case with a pale lining holding a necklace, earrings and a ring tray',
    why: 'A separate lid lifts clear, so a wide or deep tray comes out in one movement instead of being angled past a hinge.',
    best: 'A necklace with a tray, watches, multi-piece sets', avoid: 'You need a one-hand open on camera' },
  { n: '03', name: 'Drawer With Ribbon', img: 'type-drawer', w: 550, h: 525,
    alt: 'A hand sliding open a green jewelry drawer box with a gold script name',
    why: 'The tray slides toward the customer, so the piece is seen before it is touched — a counter gesture rather than a packing one.',
    best: 'Retail counter, gift-with-purchase', avoid: 'High e-commerce volume, where it is slow to pack' },
  { n: '04', name: 'Two-Piece With Neck', ph: true,
    why: 'The shoulder holds a tall or standing piece upright, which is why a bottle or a display stand needs it and a ring does not.',
    best: 'Tall bottles and standing display', avoid: 'Thin rings that need a deep slot' },
];

/* `get` is the buyer's side of each cloth — the client asked for this on every tile. */
const linings = [
  { name: 'Velvet', img: 'velvet', w: 420, h: 400, alt: 'A deep red velvet ring box open on its hinge',
    use: 'Rings and branded retail boxes', note: 'Soft contact, and the widest color range of the four',
    get: 'A polished stone meets nothing abrasive.' },
  { name: 'Suede or microfiber', img: 'suede', w: 420, h: 400, alt: 'A tan suede drawstring pouch with a gold script mark on a knitted throw',
    use: 'Modern lines where shine is unwanted', note: 'Sits flatter than velvet and snags less on a chain',
    get: 'A matte face, and a chain that comes out unmarked.' },
  { name: 'EVA or foam', img: 'insert-tray', w: 700, h: 600, alt: 'An orange cut tray and a black foam tray with cut pockets',
    use: 'Transit and mixed-SKU trays', note: 'Cut for fit, then covered wherever a customer will see it',
    get: 'A cavity that fits, so freight cannot move the piece.' },
  { name: 'Satin over card', img: 'satin', w: 420, h: 400, alt: 'A blush box open on a white satin-wrapped card holding a gold necklace',
    use: 'Necklaces and certificates', note: 'A surface, not a slot — on its own it holds nothing in place',
    get: 'A bright surface that makes a chain look deliberate.' },
];

/* §Finish — a five-step run. Each step carries a small coloured mark so the run scans.
   Client: "加一点小标志在小标题的左侧，有颜色的". */
const specs = [
  { n: '01', label: 'Board thickness', tone: 'brass',
    ico: fico('<rect x="3" y="8" width="18" height="11" rx="2"/><path d="M3 12h18"/>'),
    d: 'Greyboard, 1.5–3.0 mm. Everything above it is measured from here, so it is the first line and not the last.' },
  { n: '02', label: 'Wrap paper and color', tone: 'forest',
    ico: fico('<path d="M5 19 19 5"/><path d="M6 4h6"/><path d="M13 20h5"/>'),
    d: 'The wrap carries the texture, and the texture is what decides how the color reads in a hand rather than on a screen.' },
  { n: '03', label: 'Logo method', tone: 'brass',
    ico: fico('<path d="M12 3l2.4 5.7L20 11l-5.6 2.3L12 19l-2.4-5.7L4 11l5.6-2.3z"/>'),
    d: 'Foil, deboss or print, settled with the wrap — each one bites differently into a texture, and foil is the one that flakes.' },
  { n: '04', label: 'Magnet grade and lid gap', tone: 'forest',
    ico: fico('<rect x="8" y="8" width="8" height="8" rx="1.4"/><path d="M4 4l3 3M20 4l-3 3M4 20l3-3M20 20l-3-3"/>'),
    d: 'The magnet sets the pull; the gap sets how evenly the lid meets the base. Together they are what a hand feels before looking.' },
  { n: '05', label: 'Insert and pouch', tone: 'brass',
    ico: fico('<rect x="3" y="4" width="18" height="7" rx="1.6"/><rect x="7" y="14" width="10" height="6" rx="1.6"/>'),
    d: 'Last, because both are cut from the piece rather than from the box.' },
];

const numbers = [
  { v: '94%', k: 'Less transit damage, inside four months' },
  { v: '30%', k: 'Better storage density, from flat packs' },
  { v: '4 months', k: 'To full payback on the tooling' },
  { v: '$47,000', k: 'A month of shipping margin the old boxes were eating' },
];

const reviews = [
  { name: 'Lisa Harrington', role: 'Founder, Artisan Jewel Studio', img: 'avatar-lisa', w: 300, h: 300,
    alt: 'Lisa Harrington, founder of Artisan Jewel Studio',
    paras: [
      'We moved our handmade range onto velvet pouches with matching rigid boxes, and the interior color came back matched to our palette exactly.',
      'Delicate pieces arrive the way they left the bench. Nothing shifts in the post, nothing scuffs against a wall, and the lid closes the same on the fiftieth box as on the first.',
      'We opened at 500 units and have reordered three times since. Every run has landed on the same swatch.',
      'The reorder is the real test. We send the same sizes and get the same box back, which is all we ever wanted from a packaging supplier.',
    ] },
  { name: 'James Kowalski', role: 'Operations Manager', img: 'avatar-james', w: 300, h: 300,
    alt: 'James Kowalski, operations manager',
    paras: [
      'Rigid gift boxes with ribbon pulls, on FSC-certified board. They survive shipping, which the stock mailers we used before simply did not.',
      'Sampling came back in 5–7 days, and the first production run was 12,000 units across two formats with nothing rejected at intake.',
      'The unboxing is the marketing now. Customers photograph the box before they open it.',
      'The die is on file, so the second run skipped the artwork stage entirely and went straight to press.',
    ] },
];

/* ⚠️ Every question below had to be one the page does NOT already answer. The first set
   repeated three sections — the 500-unit minimum (stated at the end of §Structure), the
   5–7 day sample (already a figure in the header) and the two-level tray (stated in §Inserts).
   A FAQ that restates the body is dead copy. */
const faqs = [
  { n: '01', q: 'What do you need to start a quote?',
    a: 'A SKU list with the dimensions of each piece and the quantity per size, plus the structure if one is already set. If the structure is still open, photographs of the piece are enough to recommend one.' },
  { n: '02', q: 'Can you copy a box we already use?',
    a: 'Send a physical sample, or photographs with the outside dimensions. The dieline and the insert are rebuilt to match, and both files are filed against your pattern so a reorder repeats it exactly.' },
  { n: '03', q: 'How is the price built?',
    a: 'Four lines: board and wrap, assembly, the mark, and the insert with its pouch. The mark is the line a reorder does not carry, because the die is made once and kept.' },
  { n: '04', q: 'What artwork do you need?',
    a: 'A vector file — AI, EPS or PDF — with the mark at the size it will print, or the mark as a high-resolution image and we set it. Artwork is checked against the dieline before a sheet is cut, not after.' },
  { n: '05', q: 'How do the boxes ship?',
    a: 'Flat where the structure folds and assembled where it does not, on pallets or in cartons. The carton count and the weight come with the despatch papers, so the receiving end is not guessing.' },
  { n: '06', q: 'Do you work with our own designer?',
    a: 'Yes. The dieline is sent as a digital file, so a designer you already use can lay artwork against it and return it to size. Two revision rounds are included on each dieline.' },
];

const seo = {
  title: 'Custom Jewelry Boxes: 18-Month Tarnish Protection, 5 Inserts',
  description: 'Jewelry boxes with a fitted insert cut to each SKU, so the piece stays put in transit. Sulfur-free lining holds silver bright 18 months. Samples go in 5-7 days.',
  keywords: 'custom jewelry packaging manufacturer, custom jewelry boxes manufacturer, custom ring boxes manufacturer, custom necklace boxes manufacturer, anti-tarnish jewelry box lining, custom jewelry box inserts, velvet jewelry box manufacturer, jewelry box manufacturer China, wholesale custom jewelry packaging, custom jewelry pouches manufacturer, personalized jewelry gift boxes, low MOQ jewelry boxes',
  canonical: 'https://www.leelinepackage.com/custom-jewelry-packaging/',
  ogImage: `${JK}/hero-quad.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: 'Custom Jewelry Packaging Manufacturing', description: seo.description,
      serviceType: 'Custom jewelry packaging across nine builds with inserts cut to each piece from a physical sample, sulfur-free anti-tarnish linings, four box structures chosen before the wrap, wrap and lining chips filed for reorder, the five finish decisions in order, and sampling in 5–7 days from approval. Runs from 500 units per structure, size and wrap',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide', offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://www.leelinepackage.com/#industries' },
      { '@type': 'ListItem', position: 3, name: 'Custom Jewelry Packaging' } ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};


const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
const gem = '<svg width="14" height="14" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6 18.4 10 10 18.4 1.6 10z" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M10 5.6 14.4 10 10 14.4 5.6 10z" fill="currentColor" opacity="0.45"/></svg>';
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${JK}/hero-quad.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <Navbar />
  <main id="top" class="jk">

    <!-- ═══ 1 · HEADER — the plate is the section's BACKGROUND, not a band under the copy ═══ -->
    <section class="hero">
      <div class="wrap hero-in">
        <span class="eyebrow"><Fragment set:html={leaf} />Box, insert and pouch as one set</span>
        <h1>Custom Jewelry Packaging: <em>18-Month Anti-Tarnish Protection</em> &amp; Premium Shelf Appeal</h1>
        <p class="lede">Certified sulfur-free linings keep sterling silver and gold plating brilliant through long-term storage and ocean freight — slashing return rates and keeping inventory display-ready.</p>
        <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">Get My Jewelry Quote<Fragment set:html={arrow} /></a>
        <ul class="figs">
          <li><b>9</b><span>Types of box, each with its own insert</span></li>
          <li><b>500</b><span>Units per size and wrap</span></li>
          <li><b>5–7 days</b><span>To a physical sample, after sign-off</span></li>
          <li><b>4–6 weeks</b><span>A container crossing, door to door</span></li>
        </ul>
      </div>
    </section>

    <!-- ═══ 2 · TYPES — head LEFT, nine cards, warm ground ═══ -->
    <section class="s s--warm">
      <div class="wrap">
        <header class="hd hd--left"><h2>Custom Jewelry Packaging <em>Types</em></h2><p>Nine builds. The type you pick changes the insert underneath it, the board that carries it and the wrap over the top.</p></header>
        <ul class="t3">
          {types.map((t) => (
            <li data-reveal="up">
              <figure><img src={`${JK}/${t.img}.webp`} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" /></figure>
              <div class="b"><span class="code">{t.n}</span><h3>{t.name}</h3><p>{t.d}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ 3 · INSERTS — 16:9 slots; why / when / what you get ═══ -->
    <section class="s">
      <div class="wrap">
        <header class="hd hd--light"><span class="orn orn--light"><Fragment set:html={gem} /></span><h2>Custom Jewelry Box <em>Inserts</em></h2><p>The insert is what holds the piece still. Every shape is cut from a physical sample or from the exact measurements of each SKU.</p></header>
        <ul class="ins">
          {inserts.map((x) => (
            <li data-reveal="up">
              <figure class="slot slot--wide"><span>{x.n}</span><i>{x.name}</i></figure>
              <h3>{x.name}</h3>
              <p>{x.why}</p>
              <p class="when">{x.when}</p>
              <p class="get">{x.get}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ 4 · STRUCTURE — a bigger plate and more copy, still image left / text right ═══ -->
    <section class="s s--light">
      <div class="wrap">
        <header class="hd"><span class="orn"><Fragment set:html={gem} /></span><h2>How to Choose the Box <em>Structure</em></h2><p>Structure is settled before the wrap paper, because changing it re-cuts the dieline and the insert together.</p></header>
        <ul class="st">
          {structures.map((x) => (
            <li data-reveal="up">
              <figure class="plate">
                {x.ph ? <div class="slot">Photo to come</div> : <img src={`${JK}/${x.img}.webp`} alt={x.alt} width={x.w} height={x.h} loading="lazy" decoding="async" />}
              </figure>
              <div>
                <span class="note">{x.n}</span><h3>{x.name}</h3><p class="why">{x.why}</p>
                <dl><dt>Best for</dt><dd>{x.best}</dd><dt>Avoid when</dt><dd>{x.avoid}</dd></dl>
              </div>
            </li>
          ))}
        </ul>
        <p class="close">One run at 500 units covers a mixed range, because mixed SKUs share an outer box when they share one insert layout.</p>
      </div>
    </section>

    <!-- ═══ 5 · LININGS — cards carry the copy; the figures band is gone (it repeated the hero) ═══ -->
    <section class="s s--deepest">
      <div class="wrap">
        <header class="hd hd--light"><span class="orn orn--light"><Fragment set:html={gem} /></span><h2>Linings and <em>Anti-Tarnish Protection</em></h2><p>Silver and gold plate darken in a container weeks before a shop sees them, so the cloth that touches the piece is the fix — and it holds silver bright for 18 months, against 3–4 weeks unlined.</p></header>
        <ul class="ln">
          {linings.map((l) => (
            <li data-reveal="up">
              <figure><img src={`${JK}/${l.img}.webp`} alt={l.alt} width={l.w} height={l.h} loading="lazy" decoding="async" /></figure>
              <div class="b">
                <h3>{l.name}</h3><p class="use">{l.use}</p><p>{l.note}</p><p class="get">{l.get}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══ 6 · FINISH — a five-step run, deliberately unlike the grids above ═══ -->
    <section class="s s--light">
      <div class="wrap">
        <header class="hd"><span class="orn"><Fragment set:html={gem} /></span><h2>Printing and Finishing a Jewelry <em>Box</em></h2><p>Five lines, settled in this order — a wrap chosen after the logo method is a wrap re-cut.</p></header>
        <ol class="runs">
          {specs.map((x) => (
            <li data-reveal="up">
              <span class="n">{x.n}</span>
              <h3><span class={`runs-ico runs-ico--${x.tone}`}><Fragment set:html={x.ico} /></span>{x.label}</h3>
              <p>{x.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ═══ 7 · BOX OR GIFT BOX — smaller plates, and when / how / what you get ═══ -->
    <section class="s">
      <div class="wrap">
        <header class="hd hd--light"><span class="orn orn--light"><Fragment set:html={gem} /></span><h2>Jewelry Box or <em>Gift Box</em></h2><p>Both are boxes. Only one is built to hold a piece in place, and ordering the wrong one is how a range ends up quoted twice.</p></header>
        <div class="pair">
          <article data-reveal="up">
            <figure class="plate plate--sm"><img src={`${JK}/chest.webp`} alt="A wooden jewelry chest standing open, its tray lined and divided for rings and a bracelet" width="550" height="525" loading="lazy" decoding="async" /></figure>
            <h3>A jewelry box is built around the insert</h3>
            <p class="lead"><b>When</b> the piece has to arrive in one position and hold it — rings, chains, bangles and sets.</p>
            <p><b>How</b> the lid, the board and the wrap are cut to the insert, and the insert is shaped to the piece.</p>
            <p class="get"><b>You get</b> nothing left over, so nothing moves on the way to the customer.</p>
          </article>
          <article data-reveal="up">
            <figure class="plate plate--sm"><img src={`${JK}/type-gift.webp`} alt="A white paper bag and a black jewelry box grouped with a pale green box on an orange ground" width="550" height="525" loading="lazy" decoding="async" /></figure>
            <h3>A gift box presents an occasion</h3>
            <p class="lead"><b>When</b> the moment matters more than the piece — a presentation, a launch, a gift-with-purchase.</p>
            <p><b>How</b> it is sized to the occasion, with the cavity left for tissue and a ribbon.</p>
            <p class="get"><b>You get</b> a box that can carry jewelry once a tray is added; without one, quote it as a gift box.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ═══ 8 · CASE STUDY — the link is a real button, with a border and a fill ═══ -->
    <section class="s s--tint">
      <div class="wrap">
        <header class="hd"><span class="orn"><Fragment set:html={gem} /></span><h2>Jewelry Packaging <em>Case Studies</em></h2><p>The figures come from a program we published in full — the problem, the rebuild and what it cost before and after.</p></header>
        <div class="feat">
          <figure class="plate"><img src={`${JK}/cs-cover.webp`} alt="Pastel jewelry boxes and pouches lined up beside a printed sleeve" width="800" height="500" loading="lazy" decoding="async" /></figure>
          <div>
            <h3>Jewelry Packaging Case Study: 94% Damage Reduction</h3>
            <p>The brand had pushed its average order past $300 and the packaging had not moved with it. Stock mailers crushed under courier handling, and the generic foam inside left an inch of air around each piece, so rings rattled their way to micro-scratches — enough to lift the return rate to 12%.</p>
            <p>The rebuild used a 1200 GSM magnetic rigid box, a 157 GSM soft-touch wrap, a molded EVA insert over black velvet and hidden N45 magnets.</p>
            <a class="btn btn-gold" href="https://www.leelinepackage.com/jewelry-packaging-case-study/" target="_blank" rel="noopener">Read the Full Case Study<Fragment set:html={arrow} /></a>
          </div>
        </div>
