---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import ScrollReveal from '../../../components/ScrollReveal.astro';
import { getPublishedPosts, POSTS_PER_PAGE, type Post } from '../../../lib/blog';
import '../../../styles/blog.css';

/*
  Page 1 lives at /blog/ (see blog/index.astro) and is deliberately NOT generated here, so
  the paginated URLs are exactly /blog/page/2/ … /blog/page/N/ — the same shape the current
  live site exposes.
*/
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        page,
        lastPage,
      },
    };
  });
};

interface Props { posts: Post[]; page: number; lastPage: number }
const { posts, page, lastPage } = Astro.props;

const canonical = `https://www.leelinepackage.com/blog/page/${page}/`;
const seo = {
  title: `LeelinePackage Insights & Guides — Page ${page} of ${lastPage}`,
  description: `Page ${page} of the LeelinePackage packaging blog: materials, printing, structural design, shipping and quality control, written from the factory floor.`,
};
---
<Layout title={seo.title} description={seo.description} canonical={canonical}>
  <Navbar />
  <ScrollReveal />
  <main id="top">
    <BlogIndex posts={posts} page={page} lastPage={lastPage} />
  </main>
  <Footer />
</Layout>
