  folding: '/images/首页/image-04.avif',
  corrugated: '/images/首页/image-05.avif',
  rigid: '/images/首页/image-06.avif',
  mailer: '/images/首页/image-07.avif',
  display: '/images/首页/image-08.avif',
  pouches: '/images/首页/image-09.avif',
  paperbag: '/images/首页/image-10.avif',
  tin: '/images/首页/image-11.avif',
  acrylic: '/images/首页/image-12.avif',
  reusable: '/images/首页/image-13.avif',
  satin: '/images/首页/image-14.avif',
  labels: '/images/首页/image-15.avif',
  kraft: '/images/首页/image-16.avif',
  fiberboard: '/images/首页/image-17.avif',
  cardboard: '/images/首页/image-18.avif',
  plastic: '/images/首页/image-19.avif',
  fsc: '/images/首页/image-20.avif',
