  .dp-rules p { margin: 0.6rem 0 0; font-size: 0.92rem; line-height: 1.66; color: rgba(245,240,229,0.78); }

  /* ============ 5 · ONE CARTON FOR THE SHELF, ANOTHER FOR THE MAIL (ivory) ============ */
  .dp-fork-sec { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .dp-fork-sec .section-sub { max-width: 76ch; }
  .dp-fork { display: grid; gap: clamp(1.4rem, 3vw, 2.2rem); }
  /* ⚠️ NO origin pill and NO forking bar: the section-sub already says the same pen leaves down
