    color: var(--ivory); padding: clamp(5.5rem, 13.5vw, 10.5rem) 0 clamp(3.5rem, 7vw, 5rem);
  }
  .cb-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,38,27,0.44) 0%, rgba(20,38,27,0.28) 42%, rgba(20,38,27,0.5) 100%); }
  .cb-hero-inner { position: relative; z-index: 2; text-align: center; }
  .cb-hero-title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.02; letter-spacing: -0.03em; color: #fff; max-width: 20ch; margin: 1.2rem auto 0; text-wrap: balance; text-shadow: 0 2px 30px rgba(20,38,27,0.45); }
  .cb-hero-title em { font-style: italic; color: #E3C29A; }
  .cb-hero-sub { font-size: clamp(1.04rem, 1.7vw, 1.22rem); line-height: 1.7; color: rgba(245,240,229,0.94); max-width: 56ch; margin: 1.5rem auto 0; text-shadow: 0 1px 18px rgba(20,38,27,0.5); }
  .cb-hero-cta { display: flex; justify-content: center; margin-top: 2.2rem; }
  .cb-hero-stats { list-style: none; margin: clamp(2.4rem, 5vw, 3.4rem) auto 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: space-between; max-width: min(1040px, 100%); gap: clamp(1rem, 3vw, 2rem); }
  .cb-hero-stats li { text-align: center; }
  .cb-hero-stats strong { display: block; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.5rem, 3.2vw, 2.4rem); color: #E3C29A; line-height: 1; }
  .cb-hero-stats span { display: block; font-size: 0.78rem; letter-spacing: 0.02em; color: #FFFFFF; margin-top: 0.4rem; }

  /* ============ WHY (editorial numbers) ============ */
  .cb-why { position: relative; background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; overflow: hidden; }
  .cb-why::after { content: ''; position: absolute; bottom: -6%; right: -4%; width: clamp(260px, 38vw, 560px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 38% 34%, rgba(201,168,124,0.20), rgba(201,168,124,0) 66%); pointer-events: none; z-index: 0; }
  .cb-ghost { position: absolute; top: 4%; right: -1%; font-family: var(--font-heading); font-weight: 600; font-size: clamp(6rem, 22vw, 20rem); line-height: 1; color: rgba(176,141,76,0.07); letter-spacing: -0.04em; pointer-events: none; }
  .cb-why-grid { position: relative; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; z-index: 1; }
  .cb-why .section-cta { position: relative; z-index: 1; }
