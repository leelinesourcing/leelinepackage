  .cb-type-desc { font-size: 0.9rem; line-height: 1.5; color: var(--color-brand-muted); margin: 0; padding: 0 1.1rem 1.2rem; }

  /* ============ CAPABILITY (diagonal forest band) ============ */
  .cb-cap { position: relative; color: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; overflow: visible; }
  .cb-wave { position: absolute; top: -89px; left: 0; width: 100%; height: 90px; display: block; pointer-events: none; z-index: 1; }
  .cb-wave--bottom { top: calc(100% - 90px); bottom: auto; }
  .cb-cap-bg { position: absolute; inset: 0; clip-path: url(#cb-wave-clip); background: linear-gradient(180deg, rgba(20,38,27,0.8) 0%, rgba(20,38,27,0.6) 55%, rgba(20,38,27,0.82) 100%), url('https://img.leelinepackage.com/custom-bag/capability.webp') center / cover no-repeat; }
  .cb-cap-bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(55% 75% at 55% 52%, rgba(228,181,77,0.14), transparent 72%); }
  .cb-cap-inner { position: relative; z-index: 2; }
  .cb-cap-head { margin-bottom: calc(clamp(3rem, 7vw, 5.5rem) - 0.5cm); }
  .cb-cap-head .section-title { color: #fff; }
  .cb-cap-head .section-title em { color: #E3C29A; }
  .cb-cap-head .section-sub { color: rgba(245,240,229,0.85); }
  .cb-cap-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2.2vw, 1.5rem); }
  .cb-cap-card { position: relative; background: rgba(245,240,229,0.06); border: 1px solid rgba(245,240,229,0.16); border-radius: 1.1rem; padding: clamp(1.4rem, 2.6vw, 1.9rem) clamp(1.1rem, 2.2vw, 1.5rem); transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), background-color 0.4s ease; }
  .cb-cap-card:hover { transform: translateY(-6px); background: rgba(245,240,229,0.1); }
  .cb-cap-num { font-family: var(--font-heading); font-weight: 600; font-size: 1.05rem; color: var(--brass-soft); }
  .cb-cap-card h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.22rem; color: #fff; margin: 0.7rem 0 0.5rem; }
  .cb-cap-card p { font-size: 0.92rem; line-height: 1.6; color: rgba(245,240,229,0.82); margin: 0; }
  .cb-cap .section-cta { margin-top: clamp(2.4rem, 5vw, 3.2rem); }

  /* ============ BRAND WALL (same as homepage) ============ */
  .brand-logos { background: var(--ivory); padding: clamp(3.5rem, 7vw, 5rem) 0; }
  .logo-wall { text-align: center; }
  .logo-wall-label { font-size: 0.86rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-brand-muted); margin-bottom: 2rem; }
  .logo-slider { position: relative; overflow: hidden; padding: 0 3.4rem; }
  .logo-track { display: flex; gap: 1.6rem; align-items: center; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .logo-item { flex: 0 0 calc((100% - 8rem) / 6); display: grid; place-items: center; }
  .logo-item img { max-height: 150px; width: auto; max-width: 100%; object-fit: contain; filter: grayscale(0.45); opacity: 0.92; transition: filter 0.3s ease, opacity 0.3s ease; }
  .logo-item img:hover { filter: grayscale(0); opacity: 1; }
  .logo-pager { position: absolute; top: 50%; transform: translateY(-50%); width: 50px; height: 50px; border-radius: 50%; border: 1px solid rgba(31, 59, 44, 0.2); background: #fff; color: var(--color-brand-primary); cursor: pointer; z-index: 2; display: grid; place-items: center; transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease; }
