  { name: 'Corrugated', img: IMG.corrugated, blurb: 'Mailers & shippers, engineered to survive the last mile.', span: 's-4' },
  { name: 'Rigid Box', img: IMG.rigid, blurb: 'Keepsake boxes with magnetic closures and foil.', span: 's-4' },
  { name: 'Mailer Box', img: IMG.mailer, blurb: 'Custom-sized, self-locking, unboxing-ready.', span: 's-4' },
  { name: 'Display Box', img: IMG.display, blurb: 'Retail-ready counter and floor displays.', span: 's-4' },
  { name: 'Pouches', img: IMG.pouches, blurb: 'Flexible, food-safe, resealable, compostable.', span: 's-4' },
  { name: 'Paper Bag', img: IMG.paperbag, blurb: 'Kraft and coated totes for retail carry-out.', span: 's-4' },
  { name: 'Tin Box', img: IMG.tin, blurb: 'Reusable metal keepsakes and food tins.', span: 's-4' },
