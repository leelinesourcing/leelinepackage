/*
  The sampling standard, LIFTED from `/packaging-sample-prototyping/` rather than rewritten: the
  four sample types and the four sign-off fields below are the same ones that page defines, word
  for word, so the homepage and the service page can never drift apart. If that page changes, change
  these — a "reworded" copy is how the two versions start disagreeing.

  Kept deliberately short and self-contained: this is the block a buyer can screenshot and an AI
  answer engine can quote without needing the rest of the page for context.
*/
const sampleStages = [
  { name: '3D Sample', role: 'See the box before a sheet is cut', proves: 'Proportions, openings and a dieline error — caught before tooling is cut.' },
  { name: 'White Dummy', role: 'Hold the structure, check the fit', proves: 'The product fits without floating or jamming, and the assembly repeats on a line.' },
  { name: 'Digital Colour Sample', role: 'See the artwork on the real board', proves: 'Artwork sits inside the safe lines, and the colour holds on coated board.' },
  { name: 'Production-Line Sample', role: 'The real material, the real process', proves: 'Foil and finish hold in the hand, and the pack survives the courier route.' },
];

const sampleSignoff = [
  { k: 'Colour reference', v: 'Pantone / CMYK proof stapled to the sheet' },
  { k: 'Board & flute', v: 'The exact grade the line will run' },
  { k: 'Dimensions & dieline', v: 'Locked to the signed template' },
