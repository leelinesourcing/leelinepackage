---
import FoundryMark from './FoundryMark.astro';

const offerings = [
  { n: '01', title: 'Folding Carton', spec: '12–18pt SBS · aqueous, matte & soft-touch', img: '/images/首页/image-04.avif' },
  { n: '02', title: 'Corrugated', spec: 'B / E / F flute · ISTA drop-tested', img: '/images/首页/image-05.avif' },
  { n: '03', title: 'Rigid', spec: '2.5mm greyboard · foil + soft-touch laminate', img: '/images/首页/image-06.avif' },
  { n: '04', title: 'Mailer', spec: 'E-flute · self-locking, tear-strip', img: '/images/首页/image-07.avif' },
  { n: '05', title: 'Display', spec: 'POP-ready · custom dieline + headers', img: '/images/首页/image-08.avif' },
  { n: '06', title: 'Pouches', spec: 'food-grade · matte, gloss & window', img: '/images/首页/image-09.avif' },
  { n: '07', title: 'Paper Bag', spec: 'kraft + rope, ribbon or die-cut handle', img: '/images/首页/image-10.avif' },
  { n: '08', title: 'Tin Box', spec: 'embossed tinplate · hinged lid', img: '/images/首页/image-11.avif' },
  { n: '09', title: 'Acrylic Box', spec: 'laser-cut · crystal clarity', img: '/images/首页/image-12.avif' },
  { n: '10', title: 'Reusable Bag', spec: 'non-woven · 80gsm+ · print-ready', img: '/images/首页/image-13.avif' },
  { n: '11', title: 'Satin Bag', spec: 'organza / satin · grosgrain drawcord', img: '/images/首页/image-14.avif' },
  { n: '12', title: 'Labels & Stickers', spec: 'CMYK / Pantone · kiss-cut', img: '/images/首页/image-15.avif' },
];
---

<section class="services" id="offerings">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal="up">
        <span class="mark"><FoundryMark variant="notch" /></span>
        What we build
      </p>
      <div class="head-grid">
        <h2 class="h-display" data-reveal="clip">Twelve ways to ship <em>your brand.</em></h2>
        <p class="lede head-lede" data-reveal="up" style="--d:120ms">
          Every structure begins as a custom dieline and ends as a proofed, load-tested
          container. Pick a category — we engineer the rest, from flute profile to foil.
        </p>
      </div>
    </div>

    <div class="grid">
      {offerings.map((o, i) => (
        <article class="card" data-reveal="up" style={`--d:${(i % 3) * 90}ms`}>
          <div class="card-img">
            <img src={o.img} alt={`${o.title} custom packaging`} loading="lazy" decoding="async" />
            <span class="card-idx">{o.n}</span>
            <span class="card-corner" aria-hidden="true"><FoundryMark variant="corner" /></span>
          </div>
          <div class="card-body">
            <div class="card-row">
              <h3 class="card-title">{o.title}</h3>
              <span class="card-arrow" aria-hidden="true">&nearr;</span>
            </div>
            <p class="card-spec">{o.spec}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background:
      radial-gradient(70% 40% at 88% 4%, rgba(199, 154, 99, 0.08), transparent 60%),
      var(--color-brand-bg);
  }

  .section-head { margin-bottom: clamp(2.6rem, 5vw, 4rem); }
  .head-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
    margin-top: 1.4rem;
    align-items: end;
  }
  .head-lede { justify-self: start; }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .card {
    background: var(--color-brand-surface);
    border: 1px solid var(--foundry-line);
    border-radius: 18px;
    padding: 0.7rem 0.7rem 1.35rem;
    position: relative;
    transition: transform 0.6s var(--ease-spring), box-shadow 0.6s var(--ease-spring), border-color 0.4s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--foundry-line-strong);
    box-shadow: 0 30px 60px -42px rgba(30, 26, 22, 0.55);
  }

  .card-img {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 26px 100%, 0 calc(100% - 26px));
    background: #ded6c8;
  }
  .card-img img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 1s var(--ease-out-expo), filter 0.6s ease;
    filter: saturate(0.92);
  }
  .card:hover .card-img img { transform: scale(1.08); filter: saturate(1.05); }

  .card-idx {
    position: absolute; top: 0.7rem; left: 0.7rem;
    font-family: var(--font-heading);
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em;
    color: #1E1A16;
    background: var(--color-brand-cream);
    padding: 0.28rem 0.5rem;
    border-radius: 6px;
    opacity: 0.92;
  }
  .card-corner {
    position: absolute; right: 0.7rem; bottom: 0.7rem;
    width: 26px; height: 26px;
    color: #1E1A16;
    opacity: 0.6;
    transition: opacity 0.4s ease, transform 0.5s var(--ease-spring);
  }
  .card-corner svg { width: 100%; height: 100%; }
  .card:hover .card-corner { opacity: 1; transform: rotate(8deg); }

  .card-body { padding: 1rem 0.45rem 0; }
  .card-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .card-title {
    font-family: var(--font-heading);
    font-weight: 570;
    font-size: 1.18rem;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .card-arrow { font-size: 1.05rem; color: var(--color-brand-muted); transition: color 0.3s ease, transform 0.5s var(--ease-spring); }
  .card:hover .card-arrow { color: var(--color-brand-accent); transform: translate(3px, -3px); }
  .card-spec {
    margin-top: 0.45rem;
    font-size: 0.84rem;
    letter-spacing: 0.02em;
    color: var(--color-brand-muted);
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 1.8rem; }
  }
  @media (min-width: 980px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .head-grid { grid-template-columns: 1.4fr 1fr; gap: 3rem; }
    .head-lede { justify-self: end; }
    .card:nth-child(3n + 2) { margin-top: 3.4rem; }
    .card:nth-child(3n) { margin-top: 1.7rem; }
  }
</style>
