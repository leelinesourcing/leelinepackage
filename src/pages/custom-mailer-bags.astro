    .mb-rev { padding-bottom: clamp(5rem, 12vw, 7.5rem); }
    .mb-sc-slide { flex-basis: 100%; }
    .mb-sc-btn { width: 42px; height: 42px; }
    .mb-sc-prev { left: calc(clamp(1rem, 3vw, 2.5rem) + 0.5rem); }
    .mb-sc-next { right: calc(clamp(1rem, 3vw, 2.5rem) + 0.5rem); }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // One panel at a time, so the list stays scannable as answers open and close.
  const faqItems = document.querySelectorAll('.mb-faq-item');
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) faqItems.forEach((o) => { if (o !== d) o.open = false; });
    });
  });

  // Seamless carousel: `clones` copies of the last slides sit before slide one and
  // `clones` of the first sit after the last, so stepping past either end animates
  // onto a clone and is then snapped (transition: none) onto the matching real
  // slide. It loops in both directions with no visible jump. Clones are JS-only, so
  // the static HTML keeps just the real slides.
  function loopCarousel(trackSel, prevSel, nextSel, clones) {
    const track = document.querySelector(trackSel);
    if (!track) return;
    const slides = Array.from(track.children);
    const N = slides.length;
    if (N <= clones) return;

    for (let k = 0; k < clones; k++) {
      const c = slides[(N - clones + k) % N].cloneNode(true);
      c.setAttribute('aria-hidden', 'true');
      c.classList.add('is-clone');
      track.insertBefore(c, slides[0]);
    }
    for (let k = 0; k < clones; k++) {
      const c = slides[k % N].cloneNode(true);
      c.setAttribute('aria-hidden', 'true');
      c.classList.add('is-clone');
      track.appendChild(c);
    }

    let idx = clones;
    const step = () => {
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return track.children[clones].getBoundingClientRect().width + gap;
    };
    const move = (animate) => {
      track.style.transition = animate ? 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
      track.style.transform = `translateX(${-idx * step()}px)`;
    };
    const go = (dir) => {
      if (track._busy) return;
      track._busy = true;
      idx += dir;
      move(true);
      setTimeout(() => {
        if (idx < clones) idx += N;
        else if (idx > clones + N - 1) idx -= N;
        move(false);
        track._busy = false;
      }, 570);
    };

    const prev = document.querySelector(prevSel);
    const next = document.querySelector(nextSel);
    if (prev) prev.addEventListener('click', () => go(-1));
    if (next) next.addEventListener('click', () => go(1));
    move(false);
    window.addEventListener('resize', () => { if (!track._busy) move(false); });
  }

  // One review per view, so a single clone on each side is enough to close the loop.
  if (!reduce) loopCarousel('.mb-tm-track', '.mb-tm-prev', '.mb-tm-next', 1);
  // Three scenes per view again, so three clones on each side are needed — with fewer the track
  // would show a gap at the moment the last real slide is on screen.
  if (!reduce) loopCarousel('.mb-sc-track', '.mb-sc-prev', '.mb-sc-next', 3);
</script>
