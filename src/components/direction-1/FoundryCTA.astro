---
import FoundryMark from './FoundryMark.astro';
---

<section class="cta" id="quote">
  <div class="cta-mark" aria-hidden="true"><FoundryMark variant="seal" /></div>
  <div class="container cta-inner">
    <p class="eyebrow" data-reveal="up">
      <span class="mark"><FoundryMark variant="notch" /></span>
      Start your run
    </p>
    <h2 class="cta-title" data-reveal="clip">
      From 500 units to <em>500,000</em> —<br />seamlessly.
    </h2>
    <div class="cta-row">
      <p class="lede" data-reveal="up" style="--d:120ms">
        Send a spec, a dieline, or a napkin sketch. Get a 3D mockup in 24 hours
        and a white-dummy sample in 3–5 days — before you commit a single unit.
      </p>
      <div class="cta-actions" data-reveal="up" style="--d:200ms">
        <a href="mailto:hello@leelinepackage.com?subject=Free%20Quote" class="btn btn-primary btn-lg">Get a Free Quote <span class="arr" aria-hidden="true">&rarr;</span></a>
        <a href="mailto:hello@leelinepackage.com?subject=Sample%20Kit" id="sample" class="btn btn-ink btn-lg">Request Your Sample Kit</a>
      </div>
    </div>
    <div class="cta-meta" data-reveal="up" style="--d:280ms">
      <span>24h mockups</span>
      <span class="dot"></span>
      <span>3–5 day samples</span>
      <span class="dot"></span>
      <span>No minimum beyond 500</span>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: clamp(5rem, 10vw, 9rem) 0;
    background:
      radial-gradient(70% 60% at 90% 20%, rgba(199, 154, 99, 0.14), transparent 55%),
      var(--color-brand-bg);
    overflow: hidden;
  }
  .cta-mark {
    position: absolute; right: -60px; top: 50%; transform: translateY(-50%);
    width: clamp(200px, 30vw, 380px); height: clamp(200px, 30vw, 380px);
    color: rgba(199, 154, 99, 0.16);
    animation: cta-float 9s ease-in-out infinite;
  }
  .cta-mark svg { width: 100%; height: 100%; }
  @keyframes cta-float {
    0%, 100% { transform: translateY(-50%) rotate(0deg); }
    50% { transform: translateY(calc(-50% - 16px)) rotate(5deg); }
  }

  .cta-inner { position: relative; z-index: 1; }
  .cta-title {
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: clamp(2.4rem, 6.4vw, 5rem);
    line-height: 0.99;
    letter-spacing: -0.035em;
    margin: 1.5rem 0 2rem;
    text-wrap: balance;
  }
  .cta-title em { font-style: italic; font-weight: 470; color: var(--color-brand-accent); }

  .cta-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
    max-width: 64rem;
  }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .btn-lg { padding: 1.05rem 1.8rem; font-size: 0.96rem; }

  .cta-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;
    margin-top: 2.4rem; padding-top: 1.6rem;
    border-top: 1px solid var(--foundry-line);
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-brand-muted);
  }
  .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--color-brand-accent); }

  @media (min-width: 880px) {
    .cta-row { grid-template-columns: 1.2fr 1fr; align-items: end; }
    .cta-actions { justify-content: flex-end; }
  }
</style>
