---
import '../styles/global.css';
// The two latin subsets every page actually renders with. Imported so Vite emits the same
// content-hashed URLs the bundled @font-face rules point at, which lets us preload them.
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import instrumentSansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import MobileCta from '../components/MobileCta.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  /** `og:image:alt` + `twitter:image:alt`. Ignored without an `ogImage`. */
  ogImageAlt?: string;
  /** Intrinsic size of `ogImage`, so a social card can be laid out before the image downloads. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** ISO 8601. Feeds `article:published_time` — only the posts have a real publish date. */
  publishedTime?: string;
  /** Feeds `article:author`. The byline name from the `authors` collection. */
  articleAuthor?: string;
  /**
   * The full `content` for `<meta name="robots">`, e.g. `noindex, nofollow`.
   *
   * Emitted only when passed. `index, follow` is already the crawler default, so writing it on
   * all 174 indexable pages would be 174 tags of noise — this stays opt-out, and the three
   * `noindex` pages pass it instead of injecting a `<Fragment slot="head">`.
   */
  robots?: string;
  jsonLd?: string;
  preloadFont?: string;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = '',
  keywords = '',
  canonical = '',
  ogType = 'website',
  ogImage = '',
  ogImageAlt = '',
  ogImageWidth,
  ogImageHeight,
  publishedTime = '',
  articleAuthor = '',
  robots = '',
  jsonLd = '',
  preloadFont = '',
  preloadImage = '',
  preloadImageSrcset = '',
  preloadImageSizes = '',
} = Astro.props;

/*
  Not props. `og:site_name` and `og:locale` are identical on all 177 pages, so a per-page
  override could only ever be a mistake. SITE_NAME matches the JSON-LD `publisher.name` and the
  logo's `alt` — keep the three in sync.
*/
const SITE_NAME = 'LeelinePackage';
const LOCALE = 'en_US';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {preloadFont && <link rel="preload" href={preloadFont} as="font" type="font/woff2" crossorigin="anonymous" />}
    <!-- Preloaded on every page. Without these the browser only discovers the fonts after the
         global stylesheet parses, so the swap lands after first paint and reflows the headline
         (measured 0.08–0.20 CLS on mobile). These URLs are the bundled @font-face src values. -->
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={instrumentSansLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadImageSrcset || undefined} imagesizes={preloadImageSizes || undefined} fetchpriority="high" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImage && ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}

    <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!--
      Google Analytics 4 — Measurement ID G-1SW1ZD9R55 (Data Stream, leelinepackage.com).

      Only the QUEUE is inline, not the library. The official snippet pulls ~100 KB of gtag.js on
      parse; this site's LCP is already gated by image TTFB measured between 1 s and 11 s
      (docs/seo.md §10), so a third-party script competing for the same connection is the one
      thing the critical path cannot afford. `gtag()` queues into `dataLayer` exactly as the
      official snippet does, and gtag.js is injected afterwards — on idle, 3 s at the latest, or
      on the first real interaction, whichever comes first, so a fast bounce still gets counted.

      ⚠️ `is:inline` is required. Without it Astro bundles this into a module script, and a
      bundled `gtag()` would no longer be defined by the time anything calls it.

      ⚠️ GA4 sets cookies. There is no consent banner on this site — see docs/seo.md §10.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-1SW1ZD9R55');

      (function () {
        var src = 'https://www.googletagmanager.com/gtag/js?id=G-1SW1ZD9R55';
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = src;
          document.head.appendChild(s);
        }
        if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
        else setTimeout(load, 1500);
        ['pointerdown', 'keydown', 'touchstart'].forEach(function (type) {
          window.addEventListener(type, load, { once: true, passive: true });
        });
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
    <MobileCta />
    <BackToTop />
  </body>
</html>
