        <div class="rb-cust-grid">
          {custom.map((c, i) => (
            <article class="rb-cust-card" data-reveal="up" style={`--d:${(i % 2) * 0.08}s`}>
              <figure class="rb-cust-ph">
                <img src={c.img} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" class="rb-img" />
