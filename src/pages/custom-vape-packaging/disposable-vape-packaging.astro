  .dp-hero-title em { font-style: italic; color: #E3C29A; }
  .dp-hero-sub { margin: 1.3rem auto 0; font-size: clamp(1rem, 1.5vw, 1.14rem); line-height: 1.72; color: rgba(245,240,229,0.88); max-width: 60ch; }
