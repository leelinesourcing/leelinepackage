---
import FoundryMark from './FoundryMark.astro';
---

<section class="work" id="work">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal="up">
        <span class="mark"><FoundryMark variant="notch" /></span>
        Featured work
      </p>
      <h2 class="h-display" data-reveal="clip">Cases that carry <em>their weight.</em></h2>
    </div>

    <!-- Case 01 -->
    <article class="case">
      <div class="case-media" data-reveal="left">
        <img src="/images/首页/image-07.avif" alt="Custom E-flute mailer boxes for a DTC accessories brand" loading="lazy" decoding="async" />
        <span class="case-tag">DTC / E-commerce</span>
      </div>
      <div class="case-body" data-reveal="right" style="--d:100ms">
        <span class="case-kicker">01 · DTC Danny</span>
        <h3 class="case-title">The mailer that made the feed.</h3>
        <p class="case-copy">
          A $2M accessories founder needed a box strong enough to survive a 40lb crush
          test and pretty enough to film. We cut an E-flute dieline with a self-locking
          base and a matte-soft-touch print — no tape, no tears, no crushed corners.
        </p>
        <div class="case-metrics">
          <div class="metric"><span class="metric-num">3.4&times;</span><span class="metric-label">unboxing shares</span></div>
          <div class="metric"><span class="metric-num">0</span><span class="metric-label">transit damage reports</span></div>
        </div>
      </div>
    </article>

    <!-- Case 02 — text overlapping the photo -->
    <article class="case case--overlap">
      <div class="case-media case-media--wide" data-reveal="scale">
        <img src="/images/首页/image-06.avif" alt="Rigid boxes with gold foil for a skincare line" loading="lazy" decoding="async" />
        <span class="case-tag">Beauty / Luxury</span>
        <div class="case-panel" data-reveal="up" style="--d:180ms">
          <span class="case-kicker">02 · Cosmetic Carla</span>
          <h3 class="case-title">A rigid box worth <em>keeping.</em></h3>
          <p class="case-copy">
            2.5mm greyboard, gold foil on a deep matte field, and a magnetic closure that
            clicks. The kind of box that lives on a vanity, not in the recycling.
          </p>
          <div class="case-metrics">
            <div class="metric"><span class="metric-num">$80&rarr;$200</span><span class="metric-label">perceived value lift</span></div>
          </div>
        </div>
      </div>
    </article>

    <!-- Case 03 — full-bleed image with overlaid caption -->
    <article class="case case--bleed">
      <div class="case-media case-media--full" data-reveal="clip">
        <img src="/images/首页/image-09.avif" alt="Food-safe compostable pouches" loading="lazy" decoding="async" />
        <div class="case-caption" data-reveal="up" style="--d:200ms">
          <span class="case-kicker">03 · Foodie Fred</span>
          <h3 class="case-title">Compostable, not compromised.</h3>
          <p class="case-copy">
            Grease-resistant, food-safe pouches with a compostable film window. Zero
            grease-through at 30 days, zero plastic in the liner.
          </p>
          <div class="case-metrics">
            <div class="metric"><span class="metric-num">100%</span><span class="metric-label">compostable film</span></div>
            <div class="metric"><span class="metric-num">30</span><span class="metric-label">day grease barrier</span></div>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .work {
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background:
      linear-gradient(180deg, var(--color-brand-surface), var(--color-brand-surface) 60%, #eee7d9 100%);
    position: relative;
    overflow: hidden;
  }
  .work::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(90deg, transparent 0 119px, rgba(96, 82, 72, 0.05) 119px 120px);
    pointer-events: none;
  }

  .section-head { margin-bottom: clamp(2.8rem, 5vw, 4.2rem); position: relative; }
  .section-head .h-display { margin-top: 1.3rem; max-width: 18ch; }

  .case {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
    margin-bottom: clamp(3.2rem, 6vw, 5.5rem);
    align-items: center;
    position: relative;
  }
  .case:last-child { margin-bottom: 0; }

  .case-media {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #ddd5c5;
  }
  .case-media img {
    display: block; width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }
  .case-tag {
    position: absolute; top: 1rem; left: 1rem;
    font-size: 0.64rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: #1E1A16;
    background: rgba(250, 247, 242, 0.9);
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .case-kicker {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--color-brand-accent);
  }
  .case-title {
    font-family: var(--font-heading);
    font-weight: 560;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0.8rem 0 1rem;
  }
  .case-title em { font-style: italic; color: var(--color-brand-primary); }
  .case-copy {
    color: var(--color-brand-muted);
    line-height: 1.7;
    font-size: 1rem;
    max-width: 32rem;
  }

  .case-metrics { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 1.4rem; }
  .metric { display: flex; flex-direction: column; gap: 0.3rem; }
  .metric-num {
    font-family: var(--font-heading);
    font-weight: 560; font-size: 1.7rem; letter-spacing: -0.02em;
    color: var(--color-brand-text);
  }
  .metric-label {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-brand-muted);
  }

  /* Case 02 — wide image, text panel overlapping the photo */
  .case--overlap .case-media--wide { border-radius: 22px; }
  .case--overlap .case-media--wide img { aspect-ratio: 16 / 11; }
  .case-panel {
    background: var(--color-brand-bg);
    border: 1px solid var(--foundry-line);
    border-radius: 18px;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    margin: 1rem;
    box-shadow: 0 40px 80px -40px rgba(21, 17, 12, 0.5);
  }

  /* Case 03 — full-bleed image */
  .case--bleed { display: block; margin-top: clamp(3rem, 6vw, 5rem); }
  .case-media--full { border-radius: 0; }
  .case-media--full img { aspect-ratio: 16 / 10; }
  .case-media--full .case-tag { display: none; }
  .case-caption {
    background: var(--foundry-ink);
    color: var(--color-brand-cream);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3.5rem);
  }
  .case-caption .case-title { color: var(--color-brand-cream); }
  .case-caption .case-title em { color: var(--color-brand-accent); }
  .case-caption .case-copy { color: rgba(250, 247, 242, 0.78); }
  .case-caption .metric-num { color: var(--color-brand-cream); }
  .case-caption .metric-label { color: rgba(250, 247, 242, 0.55); }

  @media (min-width: 860px) {
    .case { grid-template-columns: 1.15fr 1fr; gap: 3rem; }
    .case--overlap { grid-template-columns: 1fr; }
    .case--overlap .case-media--wide img { aspect-ratio: 21 / 9; }
    .case-panel {
      position: absolute; left: clamp(2rem, 6vw, 6rem); bottom: 2.2rem;
      max-width: 26rem;
    }
    .case-media--full img { aspect-ratio: 21 / 10; }
    .case-caption {
      display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: end;
    }
  }
</style>
