---
/*
  ScrollReveal — the house entrance animation, as a component.

  Every existing page repeats the same two rules plus the same IntersectionObserver inline.
  The blog needed it on four pages, so it lives here once instead of five times.

  ⚠️ The style block is `is:global` on purpose. Scoped styles only reach elements written in
  THIS component's template, and every `[data-reveal]` element belongs to the page that uses
  it — so a scoped selector would silently match nothing and leave the page with no entrance
  animation at all.

  Motion is opt-out: with `prefers-reduced-motion` (or no IntersectionObserver) everything is
  revealed immediately rather than left hidden.
*/
---

<style is:global>
  [data-reveal] {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0s);
  }
  [data-reveal].in { opacity: 1; transform: none; }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');

  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          revealIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }
</script>
