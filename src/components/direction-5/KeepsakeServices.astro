---
import Ornament from './Ornament.astro';

const featured = {
  no: '06',
  name: 'Rigid Boxes',
  img: '/images/首页/image-06.avif',
  alt: 'Luxury rigid gift boxes with gold foil finish',
  title: 'The keepsake, engineered.',
  copy: 'Magnetic-lid and two-piece setup boxes wrapped in premium paper, hot-stamped in antique gold. Foam and satin-cushioned inserts hold the product still — so the reveal feels like a ceremony, not a rummage.',
  specs: ['Gold foil & sculpted emboss', 'Soft-touch / linen / velvet wrap', 'Magnetic closure, 800gsm–2mm board', 'MOQ from 500 units'],
};

const grid = [
  { no: '04', name: 'Folding Carton', img: '/images/首页/image-04.avif', alt: 'Folding carton boxes', desc: 'Precision tuck-end cartons, food-safe and retail-ready.' },
  { no: '05', name: 'Corrugated', img: '/images/首页/image-05.avif', alt: 'Corrugated boxes', desc: 'ISTA-tested E-flute that survives the drop, every time.' },
  { no: '07', name: 'Mailer', img: '/images/首页/image-07.avif', alt: 'Mailer boxes', desc: 'Self-locking mailers engineered for the unboxing film.' },
  { no: '08', name: 'Display', img: '/images/首页/image-08.avif', alt: 'Display boxes', desc: 'Counter displays that sell before they are opened.' },
  { no: '09', name: 'Pouches', img: '/images/首页/image-09.avif', alt: 'Flexible pouches', desc: 'Foil-lined mylar and compostable, heat-sealed tight.' },
  { no: '10', name: 'Paper Bag', img: '/images/首页/image-10.avif', alt: 'Paper bags', desc: 'Rope-handled kraft that carries the brand home.' },
  { no: '11', name: 'Tin Box', img: '/images/首页/image-11.avif', alt: 'Tin boxes', desc: 'Keepsake tins with soft-touch lids and gold stamping.' },
  { no: '12', name: 'Acrylic Box', img: '/images/首页/image-12.avif', alt: 'Acrylic boxes', desc: 'Museum-clear vitrines for jewellery and fragrance.' },
  { no: '13', name: 'Reusable Bag', img: '/images/首页/image-13.avif', alt: 'Reusable shopping bags', desc: 'Woven and canvas totes, built to be kept.' },
  { no: '14', name: 'Satin Bag', img: '/images/首页/image-14.avif', alt: 'Satin bags', desc: 'Blush satin drawstrings for the soft reveal.' },
  { no: '15', name: 'Labels & Stickers', img: '/images/首页/image-15.avif', alt: 'Labels and stickers', desc: 'Foil and kiss-cut labels, matched to the micron.' },
];
---

<section class="k-services" id="atelier">
  <div class="container">
    <header class="k-sechead" data-reveal="up">
      <p class="k-eyebrow"><Ornament variant="dot" class="k-eyebrow__dot" />The Atelier<Ornament variant="dot" class="k-eyebrow__dot" /></p>
      <h2 class="k-h2">Every vessel,<br /><em>considered.</em></h2>
      <div class="k-sechead__rule"><Ornament variant="rule" /></div>
      <p class="k-sechead__lede">
        Twelve ways to wrap a product. One standard of finish. We lead with the
        rigid box — the vessel your customer will never throw away.
      </p>
    </header>

    <article class="k-feature" data-reveal="up">
      <div class="k-feature__media">
        <span class="k-feature__no">No. {featured.no}</span>
        <img src={featured.img} alt={featured.alt} loading="lazy" decoding="async" />
        <span class="k-feature__corner k-feature__corner--tl"><Ornament variant="corner" /></span>
        <span class="k-feature__corner k-feature__corner--br"><Ornament variant="corner" /></span>
      </div>
      <div class="k-feature__body">
        <p class="k-feature__kicker">The signature</p>
        <h3 class="k-h3">{featured.name}</h3>
        <p class="k-feature__title">{featured.title}</p>
        <p class="k-feature__copy">{featured.copy}</p>
        <ul class="k-feature__specs">
          {featured.specs.map((s) => <li><Ornament variant="dot" class="k-feature__dot" /><span>{s}</span></li>)}
        </ul>
        <a class="k-link" href="#quote">Spec your rigid box <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>

    <div class="k-grid">
      {grid.map((item) => (
        <article class="k-card" data-reveal="up">
          <div class="k-card__media">
            <img src={item.img} alt={item.alt} loading="lazy" decoding="async" />
            <span class="k-card__no">No. {item.no}</span>
            <span class="k-card__corner k-card__corner--tl"><Ornament variant="corner" /></span>
          </div>
          <div class="k-card__body">
            <h4 class="k-card__name">{item.name}</h4>
            <p class="k-card__desc">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
