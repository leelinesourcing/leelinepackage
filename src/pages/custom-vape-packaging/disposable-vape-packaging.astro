  .dp-an-lab { font-family: var(--font-body); font-size: 14px; font-weight: 600; fill: rgba(245,240,229,0.88); }
  .dp-an-lab--stop { fill: var(--color-brass-light); }
  .dp-rules { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1.1rem, 2.2vw, 1.6rem); }
  .dp-rules li { padding-left: clamp(0.9rem, 1.8vw, 1.2rem); border-left: 1px solid rgba(245,240,229,0.22); }
  .dp-rule-n { font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 0.1em; color: var(--color-brass-light); }
