  .cr-word-tag { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--brass); padding: 0.28rem 0.62rem; border: 1px solid rgba(176, 141, 76, 0.5); border-radius: 999px; }
  .cr-word-d { margin: 0.7rem 0 0; font-size: 0.98rem; line-height: 1.68; color: var(--color-brand-text); }
  /* ⚠️ NOT `margin-top: auto`. Bottom-aligning the footer put its divider rule at a different height
     in every card (the footer text lengths differ), so the three horizontal rules read ragged. The
     definition block above is the same height on all three, so anchoring the footer straight after it
     lines the rules up. */
  .cr-word-foot { margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid rgba(31, 59, 44, 0.14); display: grid; gap: 0.65rem; }
  .cr-word-no { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--color-brand-muted); }
  .cr-word-nolabel { display: inline-block; margin-right: 0.5rem; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass); }
  .cr-word-pay { margin: 0; font-size: 0.92rem; line-height: 1.6; font-weight: 600; color: var(--color-brand-primary); }
  .cr-word-paylabel { display: inline-block; margin-right: 0.5rem; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass); }

  /* ⚠️ Lining up the three divider rules. Anchoring the footer after the definition (above) fixes it
     only where the definitions match — at mid widths they wrap to 4/5/6 lines, so the rules drifted
     again. Subgrid makes the four rows (index · term+tag · definition · footer) share tracks across
     the three cards, so the rules line up at EVERY width. The flex fallback stays for old browsers. */
  @supports (grid-template-rows: subgrid) {
    .cr-word-card { display: grid; grid-template-rows: subgrid; grid-row: span 4; }
    .cr-word-foot { align-content: start; }
  }

  /* ============ 6 · HOW AN ORDER RUNS (clay) ============ */
  /* the client's factory plate as the band's background, under a soft clay scrim so the dark copy
