    .m-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .m-meta { display: flex; flex-direction: column; }
    .m-name { font-family: var(--font-heading); font-weight: 600; font-size: 1.05rem; color: var(--color-brand-primary); }
    .m-spec { font-size: 0.8rem; color: var(--color-brand-muted); }
    .m-leaf { width: 20px; height: 20px; color: var(--brass); opacity: 0.7; }

    /* ============ OFFERINGS ============ */
    .offerings { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }


    .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0 1.8rem; padding: 0; }
    .chips li {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--color-brand-primary);
      border: 1px solid rgba(31, 59, 44, 0.5);
