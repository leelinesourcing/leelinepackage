---
import Ornament from './Ornament.astro';
---

<header class="k-nav" id="siteNav">
  <div class="k-nav__inner">
    <a class="k-brand" href="#top" aria-label="LeelinePackage home">
      <span class="k-brand__mark"><Ornament variant="mark" class="k-brand__svg" /></span>
      <span class="k-brand__text">
        <span class="k-brand__name">Leeline<em>Package</em></span>
        <span class="k-brand__sub">Structural Brand Architect</span>
      </span>
    </a>

    <nav class="k-nav__links" aria-label="Primary">
      <a href="#atelier">The Atelier</a>
      <a href="#work">Keepsakes</a>
      <a href="#craft">Craft</a>
      <a href="#proof">Proof</a>
    </nav>

    <div class="k-nav__cta">
      <a class="k-btn k-btn--gold" href="#quote">Get a Free Quote</a>
      <button class="k-burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="k-nav__hairline" aria-hidden="true"></div>
</header>

<div class="k-mobile" id="mobileMenu" aria-hidden="true">
  <div class="k-mobile__inner">
    <div class="k-mobile__top">
      <span class="k-brand__mark"><Ornament variant="mark" class="k-brand__svg" /></span>
      <button class="k-mobile__close" id="mobileClose" aria-label="Close menu">Close</button>
    </div>
    <nav class="k-mobile__links" aria-label="Mobile">
      <a href="#atelier">The Atelier</a>
      <a href="#work">Keepsakes</a>
      <a href="#craft">Craft</a>
      <a href="#proof">Proof</a>
      <a href="#quote">Get a Free Quote</a>
    </nav>
    <div class="k-mobile__foot">
      <Ornament variant="rule" class="k-mobile__rule" />
      <p class="k-mobile__tagline">Protect &amp; Impress.<br />Engineered, not just printed.</p>
    </div>
  </div>
</div>
