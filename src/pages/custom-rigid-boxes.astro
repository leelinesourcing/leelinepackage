                </figure>
              ))}
            </div>
          </div>
          <button class="rb-sc-btn rb-sc-prev" type="button" aria-label="Previous scenes">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="rb-sc-btn rb-sc-next" type="button" aria-label="Next scenes">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ REVIEWS ============ -->
    <section class="rb-rev" id="reviews">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Two buyers</span>
          <h2 class="section-title" data-reveal="up">Two First Runs, <em>Both Still Ordering</em></h2>
        </div>

        <div class="rb-rev-grid">
          {reviews.map((r, i) => (
            <article class="rb-rev-card" data-reveal="up" style={`--d:${i * 0.09}s`}>
              <div class="rb-rev-top">
                <strong>{r.m}</strong>
                <span>{r.ml}</span>
              </div>
              <div class="rb-rev-q">
                {r.q.map((para) => <p>{para}</p>)}
              </div>
              <div class="rb-rev-by">
                <img src={r.img} alt={r.alt} width={240} height={240} loading="lazy" decoding="async" class="rb-rev-img" />
                <div>
                  <span class="rb-rev-n">{r.n}</span>
                  <span class="rb-rev-r">{r.r}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="rb-faq" id="faq">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Questions</span>
          <h2 class="section-title" data-reveal="up">The Answers <em>Before You Write</em></h2>
        </div>

        <div class="rb-faq-list">
          {faqs.map((f, i) => (
            <details class="rb-faq-item" data-reveal="up" style={`--d:${i * 0.05}s`}>
              <summary><span class="rb-faq-n">{String(i + 1).padStart(2, '0')}</span>{f.q}</summary>
              <div class="rb-faq-a"><p>{f.a}</p></div>
            </details>
