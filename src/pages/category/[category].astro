---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { CATEGORY_ORDER, categoryLabel, getPublishedPosts, type Post } from '../../lib/blog';
import '../../styles/blog.css';

/*
  Every category the live site exposes is generated, not just the ones that currently hold
  posts, so the /category/<slug>/ URL set matches. A category with nothing published yet
  still resolves and says so rather than 404-ing.
*/
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return CATEGORY_ORDER.map((slug) => ({
    params: { category: slug },
    props: { slug, posts: posts.filter((p) => p.data.category === slug) },
  }));
};

interface Props { slug: string; posts: Post[] }
const { slug, posts } = Astro.props;
const label = categoryLabel(slug);
const canonical = `https://www.leelinepackage.com/category/${slug}/`;

const seo = {
  title: `${label} — Packaging Guides | LeelinePackage`.slice(0, 60),
  description: `${posts.length} packaging ${posts.length === 1 ? 'article' : 'articles'} in ${label}. Practical guidance from a working custom packaging factory, for brands and buyers.`.slice(0, 160),
};
---
<Layout title={seo.title} description={seo.description} canonical={canonical}>
  <Navbar />
  <ScrollReveal />
  <main id="top">
    <section class="cat-hero">
      <div class="wrap cat-hero-inner">
        <p class="eyebrow" data-reveal="up">
          <svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>
          Blog Category
        </p>
        <h1 class="cat-hero-title" data-reveal="up" style="--d:.06s">{label}</h1>
        <p class="cat-hero-sub" data-reveal="up" style="--d:.12s">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this chapter.
        </p>
      </div>
    </section>

    <section class="cat-list">
      <div class="wrap">
        {posts.length > 0 ? (
          <div class="cat-grid">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <div class="cat-empty">
            <p class="cat-empty-title">Nothing published here yet</p>
            <p class="cat-empty-body">This chapter has no articles at the moment. The full library is on the blog index.</p>
            <a class="btn btn-primary" href="/blog/" target="_blank" rel="noopener">
              Browse all articles
              <svg class="btn-leaf" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cat-hero { background: var(--color-clay); padding: calc(clamp(4rem, 9vw, 7rem) + 4.75rem) 0 clamp(3.5rem, 7vw, 6rem); }
  .cat-hero-inner { max-width: 54rem; }
  .cat-hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-brand-text);
    text-wrap: balance;
    margin: 1.1rem 0 0;
  }
  .cat-hero-sub { font-size: 1.05rem; line-height: 1.7; color: var(--color-brand-muted); margin-top: 1.1rem; }

  .cat-list { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .cat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.4rem, 2.8vw, 2.2rem); }

  .cat-empty {
    max-width: 34rem;
    padding: clamp(2rem, 4vw, 3rem);
    background: var(--color-parchment);
    border: 1px solid color-mix(in srgb, var(--color-kraft) 45%, transparent);
    border-radius: 1.1rem;
  }
  .cat-empty-title { font-family: var(--font-heading); font-size: 1.4rem; font-weight: 600; color: var(--color-brand-text); margin: 0 0 0.6rem; }
  .cat-empty-body { font-size: 0.98rem; line-height: 1.7; color: var(--color-brand-muted); margin: 0 0 1.6rem; }

  @media (max-width: 900px) { .cat-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
