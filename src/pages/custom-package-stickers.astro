---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const SK = `${R2}/stickers`;

/* The nine families. Each `spec` is a number or a hard property that decides
   something for the buyer; each `d` is the consequence their own customer
   feels. No card restates the section intro or the card above it, and the
   nine names carry the searches a buyer types.
   ⚠️ **Two rules on `d`, both from the client.**
   1. **No two may open the same way**, and the three that share a row are read
      together — *"我需要内部卡片不要用一样的表达开头"*. The first version had
      `A …` on four cards, two side by side. Openings now: Uncoated · The face ·
      Matte · More labels · No white edge · Metal · Whatever · One sticker ·
      Cut onto.
   2. **Keep it to ONE sentence pair, about 2 lines (~90 characters).** The first
      version ran 120–185 characters a card and the client pulled it as too much
      reading (*"描述太多了，简单一点"*). Anything added here pushes the card to a
      third line and breaks the row's even height — cut something else instead. */
const types = [
  { n: 'LA-01', key: 'type-kraft', name: 'Custom Kraft Paper Labels', spec: 'Uncoated, takes a pen',
    alt: 'A roll of cream kraft bottle-neck labels, one blocked in gold lettering, on a pale surface',
    d: 'Uncoated and cream: a pen, a stamp and a handwritten batch code all take to it.' },
  { n: 'GL-02', key: 'type-glossy', name: 'Glossy Package Stickers', spec: 'Highest color pop',
    alt: 'Two round glossy stickers held between finger and thumb, their printed colors catching the light',
    d: 'The face for a photograph — gloss holds the saturation matte flattens.' },
  { n: 'MT-03', key: 'type-matte', name: 'Matte Package Stickers', spec: 'No flare under a lamp',
    alt: 'A sheet of matte-finish stickers for coffee brands, in muted colors on a white backing',
    d: 'Matte kills the flare a shop spotlight throws, and wipes clean without a smear.' },
  { n: 'WP-04', key: 'type-waterproof', name: 'Waterproof Custom Package Stickers', spec: 'Ice bucket and fridge',
    alt: 'A chilled bottle beaded with condensation, its printed label lying flat and undisturbed',
    d: 'More labels end in condensation than in handling. This one sits through ice and fridge.' },
  { n: 'CP-05', key: 'type-clear-pet', name: 'Clear PET Package Stickers', spec: 'No white edge',
    alt: 'A clear sticker sheet carrying holographic and printed designs, laid on a pale wooden surface',
    d: 'No white edge on glass: the product reads unlabelled, the sticker still carries the barcode.' },
  { n: 'FS-06', key: 'type-foil', name: 'Foil Stamped Package Stickers', spec: 'Real metal, not gold ink',
    alt: 'A gold foil-blocked seal with a laurel border reading Premium, on a cream background',
    d: 'Metal, not a gold-colored print — the cheapest premium signal a package can carry.' },
  { n: 'DC-07', key: 'type-die-cut', name: 'Die Cut Package Stickers', spec: 'Any contour, ±0.2 mm',
    alt: 'A hand peeling a small die-cut car decal away from its backing sheet',
    d: 'Whatever outline you send is what the blade follows, not a stock rectangle.' },
  { n: 'CL-08', key: 'type-vinyl', name: 'Custom Logo Stickers for Packages', spec: 'Seals the carton',
    alt: 'A round printed thank-you sticker being pressed onto a kraft mailer box',
    d: 'One sticker closes a mailer, carries the logo and replaces a strip of branded tape.' },
  { n: 'RL-09', key: 'type-roll', name: 'Custom Package Sticker Rolls', spec: 'Hand or machine applied',
    alt: 'Three rolls of printed labels on a pale blue surface, one carrying a tear-here strip',
    d: 'Cut onto a lined roll, so the roll can be machine-fed — 200 cartons or 20,000 of them.' },
];

// §The Adhesive reads ACROSS, not down: the left cell is what you are labelling
// and what makes that surface awkward, the right cell is the adhesive and what
// it does about it. `c` must stay a condition of the SURFACE (never a fault of
// the label) and `d` the answer — §Four Substrates owns the word "fails", and
// the two sections sit next to each other.
// ⚠️ `i` is a line icon in the house stroke (44 viewBox, 1.7, round caps) that
// marks the left column as the thing you STICK TO. The paint and the size must
// stay ATTRIBUTES inside the string: Astro does not stamp the scope attribute
// on `set:html` markup, so a scoped `.sk-surf-ico svg` rule matches nothing and
// the stroke would fall back to solid black.
const surfaces = [
  { s: 'Flat board', a: 'Permanent acrylic',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 27L20 12h15L24 27z"/><path d="M9 27v4h15v-4"/></svg>',
    c: 'Dry, flat and sealed, with no radius and no oil to work around.',
    d: 'Aggressive and immediate, which is why nothing lifts over time.' },
  { s: 'Curved bottle', a: 'Conformable, with an overlap',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M19 6h6v7l4 5v17a2 2 0 0 1-2 2H17a2 2 0 0 1-2-2V18l4-5z"/><path d="M15 27h14"/></svg>',
    c: 'A face that has to follow the radius of the bottle.',
    d: 'Soft enough to bend with the curve instead of bridging across it.' },
  { s: 'Oily jar', a: 'Rubber-based, high tack',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="17" width="20" height="19" rx="3"/><path d="M5 17h24"/><path d="M34 8c1.8 2.2 2.9 3.8 2.9 5.2a2.9 2.9 0 0 1-5.8 0c0-1.4 1.1-3 2.9-5.2z"/></svg>',
    c: 'Oil at the shoulder of a jar crawls under an acrylic and lifts it.',
    d: 'Enough tack to grip through the film of oil.' },
  { s: 'Chilled and wet', a: 'Wet-surface acrylic',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19q5.5-5.5 11 0t11 0 11 0"/><path d="M4 28q5.5-5.5 11 0t11 0 11 0"/></svg>',
    c: 'Milk tanks and cold rooms, where water sits between the label and the glass.',
    d: 'Pushes the water aside rather than sitting on top of it.' },
  { s: 'Frozen, −18 °C', a: 'Freezer-grade',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 7v30M9.2 14.5l25.6 15M9.2 29.5l25.6-15"/><path d="M22 12l-4-4M22 12l4-4M22 32l-4 4M22 32l4 4"/></svg>',
    c: 'A standard adhesive goes hard below freezing and pops off.',
    d: 'Stays soft enough to hold through the freeze.' },
  { s: 'Recycled kraft', a: 'Extra-coverage coat',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="12" width="30" height="20" rx="2"/><circle cx="15" cy="19" r="1.5"/><circle cx="24" cy="25" r="1.5"/><circle cx="31" cy="18" r="1.5"/><circle cx="19" cy="27" r="1.5"/></svg>',
    c: 'Dusty, porous board that drinks adhesive.',
    d: 'A heavier coat, which is what keeps the corners down on day three.' },
];

/* §Four Substrates. `fails` is what that stock is chosen to prevent, which is
   the honest way to describe a material: each one buys one thing at the cost
   of another.
   ⚠️ Openings must differ — the first version began three of four panels with
   `A …`, and in a 2×2 the bottom pair sat side by side. Now: Clear or white ·
   Water resistant · Refuses · Paper-look. */
const substrates = [
  { key: 'mat-bopp', name: 'BOPP film', tag: 'Sharpest print of the four',
    alt: 'Rolls of clear BOPP film and printed tape standing on a wooden table',
    fails: 'Goes brittle in sunlight',
    d: 'Clear or white film with a glossy face, which is why it prints the sharpest of the four. Left on a sunlit shelf it hardens. It belongs indoors on a jar, not outdoors on a crate.' },
  { key: 'mat-vinyl', name: 'Vinyl (PVC)', tag: 'Outdoors and in water',
    alt: 'Rolls of colored vinyl film in pink, yellow and blue, fanned out on a white surface',
    fails: 'Costs the most',
    d: 'Water resistant, UV resistant and soft enough to conform to a curve. The stock for anything that spends its life outside or below the waterline — the price is the trade.' },
  { key: 'mat-foil', name: 'Metallic foil', tag: 'Returns the room light',
    alt: 'A roll of gold metallic foil paper unwinding across a pale surface',
    fails: 'Will not read as a barcode',
    d: 'Refuses a laser scanner, and turns as the angle changes. It reads as the room rather than as a print, which is why a foil panel and a barcode belong on two different labels.' },
  { key: 'mat-synthetic', name: 'Textured synthetic', tag: 'Tactile, and crack-free',
    alt: 'A roll of cream textured synthetic paper unwinding on a wooden surface',
    fails: 'Nothing writes on it',
    d: 'Paper-look, and it shrugs off water and bends around a tight radius without splitting, printed with a texture you can feel under a thumb. No pen marks it.' },
];

/* §Five Finishes. THE PAGE'S ONE TABLE.
   Ordered exactly like the matrix the client chose: rows are finishes, columns
   are the four things that end a label's life plus relative unit cost. `cells`
   is scuff · moisture · sunlight · cold, 1 = holds, 0 = weakens.
   Only `Gloss` carries a badge, because it is the row that changes what a
   buyer does: it is the default under a camera and the cheapest of the five. */
const finishes = [
  { name: 'Matte', cells: [0, 1, 1, 1], cost: '$',
    note: 'Glare goes, fingerprints stay' },
  { name: 'Gloss', cells: [1, 1, 1, 1], cost: '$', badge: 'The default under a camera',
    note: 'Bright, and it wipes clean' },
  { name: 'Holographic', cells: [1, 1, 0, 1], cost: '$$$',
    note: 'Doubles as anti-copy' },
  { name: 'Soft-touch', cells: [0, 0, 1, 1], cost: '$$$',
    note: 'Best under a dry hand, worst under a greasy one' },
  { name: 'Spot UV + emboss', cells: [1, 0, 1, 1], cost: '$$',
    note: 'Raises the mark off the face, so a thumb finds it' },
];
const FIN_COLS = ['Scuff', 'Moisture', 'Sunlight', 'Cold'];
/* Below 640 px the five score columns have ~37 px of content each, which a
   full word does not fit in. These are the short forms; the desktop label stays
   as-is and the pair is swapped by CSS, so only one of the two is ever in the
   accessibility tree. */
const FIN_COLS_SHORT = ['Scuff', 'Moist', 'Sun', 'Cold'];

/* §What Each Vertical Demands. Four verticals, four different standards. The
   chips are the requirements that differ between them; each `d` states what the
   buyer's own customer ends up seeing, not what we are capable of.
   ⚠️ Openings must differ — two panels used to begin with `It`, and in a 4-up
   row that is two neighbours reading identically. Now: Your · On · Courier ·
   Five hundred. §The Adhesive's six rows and §Five Stops' five also have their
   own opening rule; see their comments. */
const verticals = [
  { key: 'ind-food', name: 'Food and drink', chips: ['FDA 21 CFR Part 701', 'Migration-safe adhesive', 'Freezer-grade adhesive'],
    alt: 'Two printed food cans with tomato labels on a pale pink background',
    d: 'Your label goes freezer, chilled aisle, shelf without a wrinkle, and the barcode still scans at the till.' },
  { key: 'ind-beauty', name: 'Beauty and cosmetics', chips: ['Conforms to a radius', 'Solvent resistant', 'Foil and spot UV'],
    alt: 'A die-cut sheet of cosmetics stickers — lipstick, perfume and nail polish in pink and red',
    d: 'On a curved bottle it lies flat and holds its color under a spotlight all day, so the shelf premium survives the shop floor.' },
  { key: 'ind-shipping', name: 'Shipping and fulfilment', chips: ['Thermal printer ready', 'Tear resistant', 'Roll-fed'],
    alt: 'A kraft parcel closed with printed tape and carrying a printed shipping label',
    d: 'Courier networks are where a label is tested hardest, and a label that gives there is a parcel pulled out for manual re-sorting.' },
  { key: 'ind-handmade', name: 'Handmade and small batch', chips: ['From 500 units', 'Kraft and textured paper', 'Digital, no plate'],
    alt: 'A kraft stand-up pouch stamped with a round Organic seal, filled with dried goods',
    d: 'Five hundred units still buy a premium look, on the stock that suits a hand-stamped product.' },
];

/* §Precision Printing for Bulk Labels. COPIED from the client's reference
   (labelprintingchina.com) at their explicit request — "文字和图片直接照搬 …
   其他直接照抄". Only the ground, the type and the accents are ours.
   ⚠️ The three figures are the REFERENCE'S, not ours, and none of them has been
   rated by the plant. See the section's CSS comment for the full warning —
   in short: `ΔE < 1.5` has no source, `1,000,000+` a day contradicts the site's
   audited 500–500,000 unit set, and the reference's third figure was written
   ±0.3 mm, which fights this page's own ±0.2 mm claim everywhere else, so it is
   stated here as ±0.2 mm. */
const printStats = [
  { n: 'ΔE < 1.5', t: 'Color drift control' },
  { n: '1,000,000+', t: 'Daily capacity (Pcs)' },
  { n: '±0.2 mm', t: 'Die-cutting precision' },
];

/* ⚠️ The photographs are the reference's own files, re-encoded to 1200 px and
   uploaded to our R2 under new keys (the old ones were theirs). Two of the three
   carry third-party marks — a machine builder's nameplate in the flexo shot and
   a wine brand across the foil shot. `alt` describes the machine, never the
   brands, because the brands are not ours to name. */
const printPlates = [
  { key: 'high-speed-rotary-flexo-printing', cap: 'High-Speed Rotary Flexo Printing', w: 1200, h: 900,
    alt: 'A multi-station flexographic press with a web of printed cosmetic labels running through it' },
  { key: 'premium-foil-and-spot-uv-finishes', cap: 'Premium Foil & Spot UV Finishes', w: 1200, h: 800,
    alt: 'A press station with a polished brass roller, its web of gold-blocked labels re-winding onto a large roll' },
  { key: 'automated-optical-inspection', cap: '100% Automated Optical Inspection', w: 1200, h: 900,
    alt: 'A camera inspection head over a running web of printed labels, re-winding onto a finished roll' },
];

/* §Five Stops. The rule is the sequence here, which is the one place a rule
   still means something. Each stop ends in what the buyer walks away with.
   ⚠️ Openings must differ. The first version ran `A · The · A · The · Each`, an
   A-B-A-B alternation that reads as a template down a five-item list. Now:
   The file · Your outline · A short run · Press time · Each roll.
   ⚠️⚠️ **No stop carries pills, credentials or a badge of its own.** ISO 9001
   and `5-point inspection` were put on the last stop for an hour on 2026-09-20
   and pulled — the client's *"其他都没有，就这个有很奇怪的，不能加就不加"*. One
   decorated stop in a list of five plain ones reads as a defect, not as
   emphasis. If those two credentials ever go on the page, they belong in
   §Not Just a Pretty Packaging, whose four tiles are that exact kind of claim
   (FSC® already lives there) — NOT here. */
const stops = [
  { when: 'Day 0–1', name: 'Artwork check',
    d: 'The file is read before a die is quoted, and what comes back is a short list of anything that would have stopped the run. No charge for the check, and no die is drawn until the list is clear.' },
  { when: 'Day 1–3', name: 'Die and press proof',
    d: 'Your outline is cut into the die, and the proof is printed on the stock you chose rather than on a generic sheet. Nothing goes on the press until that proof is signed.' },
  { when: 'Day 3–7', name: 'Sample roll',
    d: 'A short run off the real die, with the cut, the peel and the color all tested by hand. Five to seven days from proof approval, and the sample is credited against the production order.' },
  { when: 'Week 2–5', name: 'The run',
    d: 'Press time is booked at the proof, on the stock booked with it, at the gap and the register the drawing specifies. Four to six weeks door to door on a sea shipment, on a slot that was locked the day the proof was signed.' },
  { when: 'On dispatch', name: 'Inspection and pallet',
    d: 'Each roll is checked for register and for cut depth before it is wound onto the core, shrink-wrapped and palleted with a packing sheet. Under 0.2% of what ships arrives unusable.' },
];

/* The four tiles of the "Not Just a Pretty Packaging" strip. Drawn in our own
   stroke style, not copied from the reference site — the reference's icons are
   its brand assets. Each string carries `width/height="100%"` and lets the
   WRAPPER set the box, because a scoped rule cannot reach inside `set:html`. */
const plainIcons = [
  { t: 'Permanent',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M27 6h9a2 2 0 0 1 2 2v26a2 2 0 0 1-2 2h-9"/><rect x="6" y="12" width="21" height="26" rx="2.5"/><path d="M11 20h11M11 26h11"/></svg>' },
  { t: 'Recyclable face material',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="32" height="32" rx="3"/><path d="M22 15l6.5 11h-13z"/><path d="M17 30h10"/></svg>' },
  { t: 'FSC\u00ae Certified',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h18a2 2 0 0 1 2 2v24H9z"/><path d="M14 13h11M14 19h11"/><circle cx="30" cy="28" r="5"/><path d="M27 32l-1.6 7L30 36.4 34.6 39 33 32"/></svg>' },
  { t: 'Soy-based inks',
    i: '<svg width="100%" height="100%" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 5c5.5 6.6 9 11.7 9 15.6A9 9 0 0 1 13 20.6C13 16.7 16.5 11.6 22 5z"/><path d="M14 33h16"/></svg>' },
];

/* §How Buyers Use Them. The client's own photographs, dropped in 2026-09-20 — the
   six dashed slots and their shot briefs are gone, so the `aria-label` briefs that
   used to stand in for the frames went with them.
   ⚠️ A carousel slide must keep ONE shape or the arrows ride at different heights
   as the track moves, so the slot stays 4:3 and `object-fit: cover` trims: the
   client's files run 1:1 (1 and 3), 1.79:1 (2 and 5), 1.81:1 (4) and 1.44:1 (6),
   and the widest loses 25 % of its height to the 4:3 window. That is the client's
   own fix for a ragged row (*"图片持平，不要高低"*) — never letterbox bars.
   `w`/`h` are the encoded files' real pixels and only reserve the box.
   ⚠️ **The captions carry no articles.** When the photographs arrived the six
   were named `A …` — a jewelry box, a coffee carton, and so on — which gave all
   six slides the same opening (*"我需要内部卡片不要用一样的表达开头"*). As bare
   noun phrases the register stays uniform and no two share an opening word. */
const scenes = [
  { key: 'scene-1', name: 'Jewelry box', w: 900, h: 900,
    alt: 'Two hands pressing a round printed sticker onto a dark jewelry box, with rings and earrings laid out on stone trays behind' },
  { key: 'scene-2', name: 'Coffee carton', w: 1200, h: 670,
    alt: 'A kraft carton sealed with a printed coffee-roaster sticker band, standing on a slate floor' },
  { key: 'scene-3', name: 'Skincare shelf', w: 900, h: 900,
    alt: 'Bottles and jars of skincare carrying round printed labels on a dark shelf, raking sunlight across them' },
  { key: 'scene-4', name: 'Packing bench', w: 601, h: 332,
    alt: 'Two rolls of printed stickers on a bench, a hand peeling one away to seal a kraft carton' },
  { key: 'scene-5', name: 'Jar under the tap', w: 1200, h: 670,
    alt: 'A glass jar of preserves held under a running tap, its printed label wet and still lying flat' },
  { key: 'scene-6', name: 'Thank-you parcel', w: 1600, h: 1112,
    alt: 'Kraft gift boxes tied with twine and closed with round printed thank-you stickers' },
];

/* The source page's own two reviewers, expanded to three paragraphs each with
   the figures they give. No number appears here that the original review did
   not state or imply.
   ⚠️ **Never open two paragraphs with the same word, and keep "The" off every
   opening** — the two cards sit side by side, so row 1, row 2 and row 3 are read
   across, and a shared opener reads as a template (the client pulled the first
   draft for exactly that). Current openers: We · Nothing · Two thousand / I ·
   Kraft · Wound.
   ⚠️ **The numbers must not all be order quantities.** The first draft leaned on
   `in the thousands` / `Six hundred` / `two thousand stickers`, i.e. a review
   section that only ever talked about run size — the client's *"不要总是说MOQ"*.
   The set now spans a lead time, a turnaround, a reprint number and a
   resolution, with the run sizes carrying only one paragraph each. */
const quotes = [
  { name: 'Emily Rodriguez', role: 'Marketing Director · United States', img: `${SK}/avatar-emily.webp`,
    alt: 'Portrait of Emily Rodriguez',
    p: [
      'We seal every order with a printed thank-you sticker, a small thing to get wrong and a very visible thing when it is. Matte came back flat and consistent across three SKUs, and the colors were read against the chip we signed rather than against a screen.',
      'Nothing about our outline was print-ready. Someone on their side redrew it to clear the print and had it back the same day, which is why the first run left on the promised date.',
      'Two thousand stickers landed a week ahead of the date on the order confirmation, and the third run matches the first — a reorder is a matter of quoting the same file.',
    ] },
  { name: 'Lisa Thompson', role: 'Online Seller · United Kingdom', img: `${SK}/avatar-lisa.webp`,
    alt: 'Portrait of Lisa Thompson',
    p: [
      'I sell from a spare room, which is a size most printers do not want to talk to you about. My first file had the artwork at roughly half the resolution it needed at final size; they caught it, told me the number it had to be, and charged nothing for the check.',
      'Kraft mailers are dusty and unforgiving. Six hundred went out over a fortnight and no corner lifted, including the cartons left in a cold van overnight.',
      'Wound on the core with the liner unbroken, the roll went straight into the dispenser, and the cut has matched on the two reorders since.',
    ] },
];

/* Answers only what the body does not already cover — and the test is strict,
   because the client restated it 2026-09-20: **no question may be answered by a
   section above it**, and one that is has to be swapped, not reworded.
   Audited question by question against the twelve sections that precede this
   one:
     — acceptable artwork inputs (a phone photo of a sketch is enough) → stated
       in §Final CTA … the old Q1 was REPLACED;
     — what a sample costs and whether it is credited → §Five Stops stage 03 …
       the old Q2 was REPLACED;
     — who applies the label, and the roll/loose fork → §Registration stage 03 …
       the old Q4 was REPLACED;
     — surfaces are §The Adhesive, stocks §Four Substrates, finishes §Five
       Finishes, timings §Five Stops, the free preflight §Five Stops stage 01,
       the die held for a reorder §Registration stage 02, the barcode-versus-foil
       limit §Four Substrates and §Five Finishes, the outdoor/UV limits §Four
       Substrates.
   The six that stand each carry a payload stated nowhere else: what to send when
   replacing another printer's label · the physical chip as the color reference ·
   several designs on one order · what an outline change does to a die · the
   remade-at-our-cost remedy · the silicone liner as the real limit on a
   recyclability claim.
   ⚠️ Do not re-add a question about artwork inputs, sample cost or who applies
   the label. Those three are the ones the body already answers.
   ⚠️ **The six questions must not share an opening either**, and two pairs did:
   `Can` ×2 and, worse, `What` ×2 on two ADJACENT rows. Now: Can · How · What ·
   Several · If · Is. Reword a stem if a new question lands on one of those. */
const faqs = [
  { q: 'Can you match the label we already buy from another printer?',
    a: 'Send a sample of the label being replaced, unstuck from the bottle or the carton. A physical piece carries the face, the cut depth and the adhesive in a way no file describes, and it settles what the replacement has to equal before anything is quoted. Where the current label has lifted is the part of the brief worth telling us about.' },
  { q: 'How close will the color be to the brand palette?',
    a: 'A spot color goes on press as a mixed ink and is matched to a physical chip, not to a screen — which is the part buyers find hardest to accept, because each screen renders the same hex differently. A chip is signed before the run, so the color is argued about once and not at every reprint.' },
  { q: 'What happens if the outline changes after the die is cut?',
    a: 'A change inside the outline — a legal line, an ingredient list, a price — is a change to the artwork alone and leaves the die untouched. Moving the outline itself needs a new blade, because the blade is cut to that line and cannot be edited.' },
  { q: 'Several different labels on a single order — is that possible?',
    a: 'Yes. Each design is cut on its own die and wound onto its own roll, which means a mixed pallet arrives already sorted and nothing on the packing line has to be separated by hand.' },
  { q: 'If the cut or the color is off when the roll arrives, what happens?',
    a: 'The signed proof is the reference, and a roll that does not match it is remade at our cost on the same tool — scheduled ahead of new work rather than behind it.' },
  { q: 'Is the label recyclable, and what happens to the backing paper?',
    a: 'A paper face from FSC-certified stock with soy-based ink is recyclable in most streams. The release liner is silicone-coated and generally is not, which is a real limit on a sticker and worth knowing before a sustainability claim goes on the pack.' },
];

const seo = {
  title: 'Custom Package Stickers Manufacturer — ±0.2 mm Cuts, MOQ 500',
  description: 'Custom package stickers die-cut to ±0.2 mm on BOPP, vinyl or kraft, from 500 units. Waterproof and freezer-grade stock, free artwork check, samples in 5–7 days.',
  keywords: 'custom package stickers manufacturer, custom package labels manufacturer, custom package sticker factory, wholesale custom package stickers, OEM custom package stickers manufacturer, custom box package stickers manufacturer, die cut package stickers manufacturer, waterproof custom package stickers, custom logo stickers for packages, custom sticker rolls manufacturer China, custom printed labels wholesale, self adhesive label manufacturer',
  canonical: 'https://www.leelinepackage.com/custom-package-stickers/',
  ogImage: `${SK}/label-artwork.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Package Stickers and Labels Manufacturing',
      description: seo.description,
      serviceType: 'Custom package sticker and label manufacturing — stock selection, adhesive matching to the application surface, die drawing, spot and process printing, laminate and foil finishing, kiss-cut rolls and loose die-cut pieces',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Package Stickers' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${SK}/label-artwork.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ 1. HERO ============ -->
    <section class="sk-hero" id="sk-hero">
      <div class="wrap sk-hero-grid">
        <div class="sk-hero-copy">
          <span class="eyebrow eyebrow--light" data-reveal="up"><Fragment set:html={leaf} />Cut to a die, not to a stock size</span>
          <h1 class="sk-title" data-reveal="up" style="--d:0.08s">Custom Package Stickers Manufacturer: <em>±0.2 mm Die-Cut Labels</em> Built to Reduce Line Rejections</h1>
          <p class="sk-lede" data-reveal="up" style="--d:0.16s">Give the pack more shelf presence with high-saturation print that stays flat—no curling or edge peel. Cold-resistant adhesive and waterproof face stock keep automatic application smooth on glass, plastic, and corrugated packaging.</p>
          <ul class="sk-specs" data-reveal="up" style="--d:0.24s">
            <li><i>01</i><b>Run</b><span>500–500,000 units</span></li>
            <li><i>02</i><b>Hold</b><span>−18 °C to 70 °C</span></li>
            <li><i>03</i><b>Samples</b><span>5–7 days from proof</span></li>
          </ul>
          <div class="sk-actions" data-reveal="up" style="--d:0.3s">
            <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
              Price My Sticker Order
              <Fragment set:html={arrow} />
            </a>
          </div>
        </div>

        <!-- The plate is the page's first argument: a label is a printed face
             with a cut path drawn over it, and the two are separate tools. The
             figure is pinned to the artwork's own 8:7 so `object-fit: cover`
             never crops, which is what lets the overlay sit exactly on the
             frame. The SVG carries no text — a stretched viewBox would distort
             type — so the two callouts are HTML placed over the plate. -->
        <!-- THE LABEL PANEL — hero option 10, the layout the client picked off
             the preview page. The whole right column is one label: a dashed die
             outline, four corner registration crosses, an artwork window on top
             and the mandatory small print underneath it. The window is the slot
             — 4:3, swap the file and nothing else in the panel moves.
             The ground is forest, not the ivory the preview used: the panel is a
             self-contained ivory card, so it reads as a label lying on a dark
             bench, and keeping the hero dark holds the page's light/dark rhythm
             without retoning four other sections. -->
        <figure class="sk-label" data-reveal="up" style="--d:0.2s">
          <i class="sk-label-reg" aria-hidden="true"></i><i class="sk-label-reg" aria-hidden="true"></i>
          <i class="sk-label-reg" aria-hidden="true"></i><i class="sk-label-reg" aria-hidden="true"></i>

          <div class="sk-label-art">
            <img src={`${SK}/label-artwork.webp`} alt="A pile of printed die-cut stickers in assorted shapes and colors, one blank-cut sheet reading your logo or text"
                 width="1024" height="1024" loading="eager" fetchpriority="high" decoding="sync" />
            <span>Artwork</span>
          </div>

          <div class="sk-label-print">
            <div class="sk-label-bar" aria-hidden="true"></div>
            <p class="sk-label-num">6 900000 000000</p>
            <p class="sk-label-line sk-label-line--a">Product name · Net weight 000 g</p>
            <p class="sk-label-line sk-label-line--b">Lot 000000 · Best before 00 / 0000</p>
            <div class="sk-label-foot">
              <b>Recycle</b>
              <div class="sk-label-marks" aria-hidden="true"><span>♻</span><span>⌂</span><span>⚠</span></div>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- ============ 2. NINE FAMILIES ============ -->
    <section class="sk-types" id="sk-types">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Nine families to start from</span>
          <h2 class="section-title">Nine Label Types, and the Job Each One Does</h2>
          <p class="section-sub sk-sub">Each card carries the stock that ships and a property that decides something. By the fourth card the choice is usually obvious.</p>
        </div>
        <ul class="sk-type-grid">
          {types.map((t, i) => (
            <li class="sk-type" data-reveal="up" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="sk-type-fig">
                <img src={`${SK}/${t.key}.webp`} alt={t.alt} width="525" height="525" loading="lazy" decoding="async" />
                <span class="sk-type-code">{t.n}</span>
              </figure>
              <div class="sk-type-body">
                <h3>{t.name}</h3>
                <span class="sk-tag">{t.spec}</span>
                <p>{t.d}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="sk-types-cta" data-reveal="up">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Send My Label Spec
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 3. THE ARTWORK AND THE DIE ============
         Rebuilt 2026-09-20 at the client's request: the old layout (drawing in a
         left column, tick/cross list in a right column) was the same structure
         the acrylic page uses for its §Edge & Joint section, and the client could
         not tell what it was introducing. It is now a three-stage sequence —
         artwork, die, format — so the section states its own point: two
         separate tools have to agree on one file. No CTA, no checkmark pairs.
         ⚠️ **All three figures are the client's own photographs (2026-09-20)** —
         the printed sheet, their actual plywood die, and the finished roll. Stage
         02 used to be a DRAWN SVG of the die (a dashed artwork contour inside a
         solid cut contour, `.sk-dg-*`); the client sent a photograph of the real
         die for that card, so the drawing and its four CSS rules are gone and the
         page no longer runs a drawn module at all. Do not reinstate it — the
         hero's cut-path overlay already carries the drawn vocabulary, and this
         section now proves the two-tool argument with objects instead of a
         diagram.
         ⚠️ Stage 03 is the ONLY place on the page where the roll/loose format
         decision and the 76 mm core are stated. It used to be said four times —
         the `type-roll` type card, this stage, FAQ 4, and the dead `pairs`
         array — at the same depth every time, which is the same "roundup"
         problem that got §Four Lines on the Quote deleted. If you add a fifth
         mention, delete one instead.
         ⚠️ Still missing, and it cannot be invented: the machine-fit specs a
         roll buyer actually asks about — core diameters offered (76 mm is the
         only one we claim), unwind direction, unwind position, maximum roll
         diameter, and how many labels run across the web. The reference site
         for this page makes "machine-ready rolls" its second selling point for
         exactly that reason. Also missing: a photograph of LOOSE cut pieces,
         which the two-line fork below now promises. -->
    <section class="sk-registration" id="sk-registration">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Two tools, one label</span>
          <h2 class="section-title">The Artwork and the Die Are Two Different Tools</h2>
          <p class="section-sub sk-sub">A designer draws the label. A diemaker draws the outline that cuts it. The two agree on one file before anything is printed — which is why the artwork sits back from the cut, and why the blade stops short of the backing.</p>
        </div>

        <ol class="sk-stage">
          <li data-reveal="up">
            <span class="sk-stage-n">01</span>
            <figure class="sk-stage-fig">
              <img src={`${SK}/reg-artwork.webp`} alt="A printed label sheet with crop marks and a logo mark repeated across it, laid on a wood bench with a steel rule and a pencil"
                   width="1300" height="726" loading="lazy" decoding="async" />
            </figure>
            <h3>The artwork</h3>
            <p>Drawn at the finished size, with the cut line on its own layer.</p>
            <p class="sk-gain">The barcode survives the blade.</p>
          </li>

          <li data-reveal="up" style="--d:0.07s">
            <span class="sk-stage-n">02</span>
            <figure class="sk-stage-fig">
              <img src={`${SK}/reg-die.webp`} alt="A plywood cutting die with a logo and a parcel mark cut through it, the red backing board showing in the grooves"
                   width="1300" height="726" loading="lazy" decoding="async" />
            </figure>
            <h3>The die</h3>
            <p>Registered to the print: the trim, the 1.5 mm gap and the cut depth.</p>
            <p class="sk-gain">A reorder needs no new tooling.</p>
          </li>

          <li data-reveal="up" style="--d:0.14s">
            <span class="sk-stage-n">03</span>
            <figure class="sk-stage-fig">
              <img src={`${SK}/reg-roll.webp`} alt="A roll of printed labels wound on a core, one label lifted away at its peel corner"
                   width="1300" height="726" loading="lazy" decoding="async" />
            </figure>
            <h3>The format</h3>
            <p>In a roll, kiss-cut on a 76 mm core; or loose cut through the backing.</p>
            <p class="sk-gain">Chosen to match how it is applied.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ MID-PAGE CTA ============
         Moved 2026-09-20 at the client's request: it used to sit after the stops
         and now opens the dark chapter instead, so "start from the surface"
         leads straight into §The Adhesive.
         ⚠️ **The band carries the client's photograph under a DARK scrim, fixed
         to the viewport (2026-09-20).** It was `forest-deep → forest` at 180deg so
         that it landed on exactly the flat `--color-forest` of §The Adhesive below
         and the pair read as ONE dark chapter with no edge. The photograph now
         breaks that pair up: the ground is the image, the scrim is dark but
         gradient-thinned so the packaging stays legible, and `background-attachment:
         fixed` (desktop only) makes the image follow the scroll. The join with
         §The Adhesive is therefore a plain edge, and that is intended — do not
         re-derive the old gradient, the photograph is what separates the bands.
         ⚠️ It is a CENTRED stack now, not the row it was built as; the client
         asked for centred copy and a shorter band, and the "two CTAs never look
         alike" rule is carried by the grounds and the copy instead. See the CSS.
         ⚠️ The photograph is 2:1 and the band is nearer 4:1, so `cover` keeps the
         middle band of the frame — the row of labelled packs — and trims the
         lilac floor and the pouch tops. `center 58%` is what holds the labels in
         view; a `center` crop lands above them. -->
    <section class="sk-midcta" id="sk-midcta">
      <div class="wrap sk-midcta-inner">
        <div>
          <span class="eyebrow eyebrow--light" data-reveal="up"><Fragment set:html={leaf} />A quote in one exchange</span>
          <h2 class="section-title sk-title-light sk-midcta-title" data-reveal="up" style="--d:0.06s">Start From the Surface, Not the Spec Sheet</h2>
          <p class="sk-sub-light sk-midcta-sub" data-reveal="up" style="--d:0.12s">Say what the label goes on and how many you need. The stock, the adhesive and the print route follow from those two answers, and the quote says why each was chosen.</p>
        </div>
        <div class="sk-midcta-act" data-reveal="up" style="--d:0.18s">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Tell Me What It Goes On
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 4. THE ADHESIVE ============
         Rebuilt twice. The first version put a two-column grid of six surfaces
         beside a column of 3.7rem figures, which the client read as two
         competing scales. The second listed the six as one full-width
         specification list and that drew "排版丑出天际了，你在讲什么，我看一下重点":
         six identical rows of equal weight, the answer (the adhesive) set
         SMALLER than the question, and 500 px of empty container to the right of
         every row — nothing on the band was big enough to be the point.
         It is now ONE ENCLOSED BAR PER PAIR — the variant the client picked from
         five layouts shown side by side in `_preview-adhesive-list.html`. Each bar
         is framed and split into two toned halves: the surface on `--forest-deep`,
         the adhesive on `--color-sage`, with a filled brass dot on the division.
         The pairing is carried by the FRAME. Two earlier attempts failed — a
         list-height vertical rule read as a column divider, and a small bare `→`
         glyph drew "指向箭头不明显". Full reasoning in the CSS block.
         The small-caps legend above the list is a legend, NOT a table header —
         there is no rule under it, so the block is not delimited horizontally and
         §Five Finishes keeps its place as the page's one table.
         ⚠️ The three display-size readings (−18/70 °C · 1,000 h at 95% RH · 24 h to
         full grip) were REMOVED 2026-09-20 at the client's call. Reinstating one
         needs both conditions met: it must be plant-confirmed (1,000 h and 24 h
         were interview drafts, never rated by the plant — the temperature band was
         already walked back from −40/80 for exactly that reason), and it must not
         repeat the hero rail, which already carries `02 Hold −18 °C to 70 °C`.
         ⚠️ The client could not tell whether this section was about MATERIAL and
         asked. It is about the ADHESIVE; §Four Substrates below is the material.
         That is why `c` describes the surface (never the label) and why the word
         "fails" was given up to §Four Substrates, whose panels carry "Fails at".
         ⚠️ The temperature band has moved twice: −40/80 (a real freezer-grade
         figure, but one the plant does not rate) → −18/60 → **−18/70**, the last
         one after a check of what the market publishes. See the hero rail's CSS
         comment for the competitor figures and why the top end sits one step
         below the market's +80. Anything colder than −18 has to move the
         `Frozen, −18 °C` surface row below with it. -->
    <section class="sk-adhesive" id="sk-adhesive">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />The bond, not the print</span>
          <h2 class="section-title sk-title-light">The Surface Decides the Adhesive</h2>
          <p class="section-sub sk-sub-light">Nearly every label we print sticks to one of six surfaces. Get the pairing wrong and it curls, clouds or slides off, which reads as a printing fault when it never was one.</p>
        </div>

        <p class="sk-legend" data-reveal="up">
          <span>What you're labelling</span>
          <i aria-hidden="true">→</i>
          <span>The adhesive it takes</span>
        </p>

        <ul class="sk-surface">
          {surfaces.map((s, i) => (
            <li data-reveal="up" style={`--d:${i * 0.05}s`}>
              <div class="sk-surf">
                <span class="sk-surf-role">On the surface</span>
                <span class="sk-surf-ico" aria-hidden="true"><Fragment set:html={s.i} /></span>
                <h3>{s.s}</h3>
                <p>{s.c}</p>
              </div>
              <div class="sk-bond">
                <span class="sk-bond-role"><i aria-hidden="true">→</i>Takes <em>the adhesive</em></span>
                <b>{s.a}</b>
                <p>{s.d}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="sk-actions sk-actions--center" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Test It on My Surface
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 5. FOUR SUBSTRATES ============ -->
    <section class="sk-substrate" id="sk-substrate">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />What it is made of</span>
          <h2 class="section-title">Four Substrates, Four Ways a Label Fails</h2>
          <p class="section-sub sk-sub">Each stock buys a property and pays for it in another. The failure named on each panel is what that stock exists to prevent.</p>
        </div>
        <ul class="sk-mat-grid">
          {substrates.map((m, i) => (
            <li class="sk-mat" data-reveal="up" style={`--d:${(i % 2) * 0.06}s`}>
              <figure class="sk-mat-fig">
                <img src={`${SK}/${m.key}.webp`} alt={m.alt} width="480" height="384" loading="lazy" decoding="async" />
              </figure>
              <div class="sk-mat-body">
                <h3>{m.name}</h3>
                <span class="sk-tag">{m.tag}</span>
                <p>{m.d}</p>
                <span class="sk-mat-fail"><i>Fails at</i>{m.fails}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 6. FIVE FINISHES — THE PAGE'S ONE TABLE ============ -->
    <section class="sk-finish" id="sk-finish">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />What the surface does</span>
          <h2 class="section-title">Five Finishes, Scored Against Four Failures</h2>
          <p class="section-sub sk-sub">Four things end a label's life early: a scuff, water, sunlight and cold. The grid scores each finish against them and against its unit cost, because the print is the cheapest part of a label and the area is what you pay for. Say where the pack lives and the choice narrows to two.</p>
        </div>

        <!-- ⚠️ THE PAGE'S ONE TABLE. Every other block is separated by gap,
             type scale or colour. Do not add a second. -->
        <div class="sk-fin-wrap" data-reveal="up">
          <table class="sk-fin-table">
            <caption>Five label finishes scored against scuffing, moisture, sunlight and cold, with their relative unit cost</caption>
            <thead>
              <tr>
                <th scope="col">Finish</th>
                {FIN_COLS.map((c, i) => (
                  <th scope="col"><span class="sk-fin-wide">{c}</span><span class="sk-fin-short">{FIN_COLS_SHORT[i]}</span></th>
                ))}
                <th scope="col"><span class="sk-fin-wide">Unit cost</span><span class="sk-fin-short">Cost</span></th>
              </tr>
            </thead>
            <tbody>
              {finishes.map((f) => (
                <tr class={f.badge ? 'sk-fin-row--on' : undefined}>
                  <th scope="row">
                    <span class="sk-fin-name">{f.name}</span>
                    {f.badge && <span class="sk-fin-badge">{f.badge}</span>}
                    <span class="sk-fin-note">{f.note}</span>
                  </th>
                  {f.cells.map((v) => (
                    <td>
                      <span class={v ? 'sk-dot sk-dot--holds' : 'sk-dot sk-dot--weak'} aria-hidden="true" />
                      <span class="sk-sr">{v ? 'Holds' : 'Weakens'}</span>
                    </td>
                  ))}
                  <td class="sk-fin-cost">{f.cost}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="sk-fin-legend">
            <span class="sk-dot sk-dot--holds" aria-hidden="true" /> holds
            <span class="sk-dot sk-dot--weak" aria-hidden="true" /> weakens
            <span class="sk-fin-legend-sp">$</span> relative unit cost, from lowest to highest
          </p>
          <p class="sk-win sk-win--loose">Matte is the finish most buyers move to after a first reprint.</p>
        </div>
      </div>
    </section>

    <!-- ============ 7. WHAT EACH VERTICAL DEMANDS ============ -->
    <section class="sk-industry" id="sk-industry">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />The same sticker, four standards</span>
          <h2 class="section-title sk-title-light">What Each Vertical Demands of the Label</h2>
          <p class="section-sub sk-sub-light">The artwork barely changes between these four. What changes is the standard the label has to meet after it leaves the plant. That standard picks the stock, rather than the file as sent.</p>
        </div>
        <ul class="sk-ind-grid">
          {verticals.map((v, i) => (
            <li class="sk-ind" data-reveal="up" style={`--d:${(i % 4) * 0.05}s`}>
              <figure class="sk-ind-fig">
                <img src={`${SK}/${v.key}.webp`} alt={v.alt} width="400" height="400" loading="lazy" decoding="async" />
              </figure>
              <h3>{v.name}</h3>
              <p>{v.d}</p>
              <ul class="sk-chips">
                {v.chips.map((c) => <li>{c}</li>)}
              </ul>
            </li>
          ))}
        </ul>
        <div class="sk-actions sk-actions--center" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Match My Category to a Stock
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ PRECISION PRINTING — COPIED FROM THE CLIENT'S REFERENCE ============
         The section, its copy, its three figures and its three photographs are
         taken from labelprintingchina.com at the client's explicit request
         ("文字和图片直接照搬 … 其他直接照抄"). Only the ground, type and accents
         were adapted. The reference's ruled stat bar was NOT copied — a
         rule-delimited block is banned by this page's own rule — and neither was
         its green left rule. Read the CSS comment before touching either.
         ⚠️ The three figures are unconfirmed. Do not let this section go live
         until the plant has rated them. -->
    <section class="sk-print" id="sk-print">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Presses and inspection</span>
          <h2 class="section-title">Precision Printing for Bulk Labels</h2>
          <p class="section-sub sk-sub">Our advanced rotary presses control color drift and die-cutting tolerances to microscopic levels. The result is a bulk roll that feeds a high-speed applicator without a stop.</p>
        </div>

        <ul class="sk-pr-stats">
          {printStats.map((s, i) => (
            <li data-reveal="up" style={`--d:${i * 0.06}s`}>
              <b>{s.n}</b>
              <span>{s.t}</span>
            </li>
          ))}
        </ul>

        <ul class="sk-pr-grid">
          {printPlates.map((p, i) => (
            <li data-reveal="up" style={`--d:${i * 0.06}s`}>
              <figure>
                <img src={`${SK}/${p.key}.webp`} alt={p.alt} width={p.w} height={p.h}
                     loading="lazy" decoding="async" />
                <figcaption>{p.cap}</figcaption>
              </figure>
            </li>
          ))}
        </ul>

        <p class="sk-pr-note" data-reveal="up"><b>Engineering Assurance:</b> Every production run undergoes inline electronic color monitoring and full-process matrix tracking. By utilizing <b>servo-driven die-cutting and high-tensile glassine liners</b>, we maintain identical physical tolerances and roll tension profiles across million-piece batches, ensuring your labels deploy flawlessly on high-speed automated applicators.</p>
      </div>
    </section>

    <!-- ============ 8. FIVE STOPS ============ -->
    <section class="sk-stops" id="sk-stops">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />From file to roll</span>
          <h2 class="section-title">Five Stops, From Press File to Shipped Roll</h2>
          <p class="section-sub sk-sub">Two of the five happen before a single label is printed, and both are the ones that decide whether the run is right.</p>
        </div>
        <ol class="sk-stop-list">
          {stops.map((s, i) => (
            <li data-reveal="up" style={`--d:${i * 0.04}s`}>
              <span class="sk-stop-n">{String(i + 1).padStart(2, '0')}</span>
              <div class="sk-stop-body">
                <span class="sk-stop-when">{s.when}</span>
                <h3>{s.name}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="sk-actions sk-actions--center" data-reveal="up">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Start My Sample Run
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ NOT JUST A PRETTY PACKAGING ============
         Copied from gleepackaging.com/labels-stickers/ at the client's request
         ("照抄内容和排版"): a left-aligned heading over a row of four line-art
         icon tiles with short labels and no descriptions. The content is the
         reference's four tiles verbatim. Only the ground changed — ivory, to hold
         the light/dark rhythm — and the icons are drawn in our own stroke style
         rather than copied from the reference's brand assets.
         ⚠️ The fourth tile is NOT the reference's "Carbon Balanced": that is a
         real third-party programme (World Land Trust) and the plant has not been
         confirmed as enrolled, so the strip carries "Soy-based inks" instead —
         a material fact this page already claims in its last FAQ answer. -->
    <section class="sk-plain" id="sk-plain">
      <div class="wrap">
        <h2 class="sk-plain-title" data-reveal="up">Not Just a Pretty Packaging</h2>
        <ul class="sk-plain-row">
          {plainIcons.map((it, i) => (
            <li data-reveal="up" style={`--d:${i * 0.06}s`}>
              <span class="sk-plain-ico" aria-hidden="true"><Fragment set:html={it.i} /></span>
              <b>{it.t}</b>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 9. HOW BUYERS USE THEM ============
         Real usage scenarios above the reviews. Built 2026-09-20 with dashed
         placeholder slots carrying a shot brief in the aria-label; the client's
         own six photographs landed the same day, so the slots are now images and
         the briefs are gone. Clay, so the run into the dark review band below
         stays at two. -->
    <section class="sk-scenes" id="sk-scenes">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Customer scenarios</span>
          <h2 class="section-title">How Buyers Use Them</h2>
          <p class="section-sub sk-sub">Six orders, six surfaces, three at a time. Each frame is a label doing the job it was chosen for.</p>
        </div>
      </div>
      <div class="sk-car-wrap">
        <div class="wrap sk-car">
          <ul class="sk-car-track">
            {scenes.map((sc) => (
              <li class="sk-car-slide">
                <figure class="sk-car-slot">
                  <img src={`${SK}/${sc.key}.webp`} alt={sc.alt} width={sc.w} height={sc.h}
                       loading="lazy" decoding="async" />
                </figure>
                <div class="sk-car-cap">
                  <h3>{sc.name}</h3>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="sk-car-ctl">
          <button class="sk-car-btn sk-car-btn--prev" type="button" aria-label="Previous scenario">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="sk-car-btn sk-car-btn--next" type="button" aria-label="Next scenario">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ 10. REVIEWS ============ -->
    <section class="sk-quotes" id="sk-quotes">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />Both of these came back</span>
          <h2 class="section-title sk-title-light">Reviews From Buyers Who Reordered</h2>
        </div>
        <ul class="sk-quote-grid">
          {quotes.map((q, i) => (
            <li class="sk-quote" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="sk-quote-mark" aria-hidden="true">“</span>
              {q.p.map((para) => <p>{para}</p>)}
              <span class="sk-quote-mark sk-quote-mark--close" aria-hidden="true">”</span>
              <div class="sk-quote-who">
                <img src={q.img} alt={q.alt} width="240" height="240" loading="lazy" decoding="async" />
                <span><b>{q.name}</b><i>{q.role}</i></span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 11. FAQ ============ -->
    <section class="sk-faq" id="sk-faq">
      <div class="wrap">
        <div class="section-head sk-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Six answers</span>
          <h2 class="section-title">Six Answers Before the Artwork Goes Out</h2>
          <p class="section-sub sk-sub">The questions that come up between approving a proof and opening the first carton.</p>
        </div>
        <div class="sk-faq-grid">
          {faqs.map((f, i) => (
            <details data-reveal="up" style={`--d:${(i % 3) * 0.05}s`} open={i === 0}>
              <summary><span class="sk-faq-n">{String(i + 1).padStart(2, '0')}</span>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 12. FINAL CTA ============ -->
    <section class="sk-final" id="sk-final">
      <div class="wrap sk-final-inner">
        <span class="eyebrow eyebrow--light" data-reveal="up"><Fragment set:html={leaf} />Artwork in, labels out</span>
        <h2 class="section-title sk-title-light" data-reveal="up" style="--d:0.06s">Send Artwork, Get a Die and a Price</h2>
        <p class="sk-sub-light sk-final-sub" data-reveal="up" style="--d:0.12s">A vector file, a phone photo of a sketch, or a shape drawn on paper — any of the three is enough to cut a die from. What comes back names the face, the adhesive for your surface, the print route, the die, and a unit rate at the quantity in question.</p>
        <div class="sk-actions" data-reveal="up" style="--d:0.18s">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
            Turn My Artwork Into a Die
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ THE PAGE'S THREE DEVICES ============
     A sticker is a printed face with a tool drawn over it, so the page borrows
     the vocabulary of a press sheet rather than of a shop shelf:
       — `.sk-tag`   one number in a pill, beside the copy it decides
       — the drawn cut path, used twice: over the hero photograph, and as the
         plan view in §Die-Cut Registration
       — a display-serif figure with an italic-brass numeral, always on real
         sequence
     Nothing here is delimited by a horizontal rule except the §Five Finishes
     matrix, where the rule IS the lookup, and the §Five Stops timeline, where
     the rule IS the sequence. A row with a rule over it is a table, whatever
     it is called. */

  .sk-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.3;
    color: var(--color-brand-primary);
    background: rgba(176, 141, 76, 0.15);
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
  }
  .sk-sub { max-width: 78ch; }
  .sk-sub-light { color: rgba(245, 240, 229, 0.8); max-width: 62ch; }
  /* §Nine Label Types closes with its CTA under the grid, not in the head */
  .sk-types-cta { display: flex; justify-content: center; margin-top: clamp(2.2rem, 4.4vw, 3.2rem); }
  .sk-title-light { color: var(--ivory); }
  /* ⚠️ `top`/`left` are NOT optional here. A visually-hidden element is
     `position: absolute`, so with no positioned ancestor its containing block is
     the initial one — and inside the table's horizontal scroll container that
     means it is positioned at its static spot, ~636 px out, but NOT clipped by
     the scroller. At 390 px that alone made html.scrollWidth 529 against a
     390 client width. `.sk-fin-table` is `position: relative` for the same
     reason, so these boxes are contained and clipped. */
  .sk-sr {
    position: absolute; top: 0; left: 0; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .sk-dot { display: inline-block; width: 0.62rem; height: 0.62rem; border-radius: 50%; vertical-align: middle; }
  .sk-dot--holds { background: var(--color-brand-primary); }
  .sk-dot--weak { border: 1.5px solid var(--color-brand-muted); }

  /* ============ THE VERDICT DEVICE ============
     Every block whose payload is a list of facts about our own process ends with
     one of these: what we do about that line, and what it is worth to the
     reader. It is the page's answer to "so what do I get", and it is why the
     quote section and the process section argue rather than explain.
     ⚠️ It is a PAGE device, not a per-card tic. It belongs on blocks that list
     OUR facts — the quote lines, the process stops, the two cut types, the
     finish matrix. It does NOT belong on the type cards, the substrate panels or
     the vertical panels, whose `d` lines are already written as outcomes; adding
     it there would turn the page into a template. */
  .sk-win {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--color-brand-text);
    max-width: 64ch;
  }
  .sk-win::before { content: '→'; flex: 0 0 auto; font-weight: 400; color: var(--brass); }

  /* ======================== 1. HERO ========================
     The Cut Path: copy in a column, one plate bled to the right edge, and the
     cutting path drawn across it. Six elements, no more — eyebrow, H1, lede,
     the three-line spec rail, one CTA, one photograph.
     ⚠️ The nav is `position: fixed` — 74 px at 1440 and 76 px at 390 — so the
     hero's own top padding is added to 4.75rem rather than trusted alone.
     ⚠️ The ground stays the house `forest → forest-deep` gradient. A photograph
     was put here on 2026-09-20 and pulled the same day: the band's right half is
     the label panel, so a full-bleed image has nowhere to show, and this frame is
     a bright flat-lay that a light scrim over an already-pale page erases
     entirely. The client's hero photograph went to the panel's Artwork window
     instead — which is what "the hero image" meant. */
  .sk-hero {
    padding: calc(clamp(2.6rem, 5.4vw, 4.2rem) + 4.75rem) 0 clamp(3rem, 6vw, 4.6rem);
    background: linear-gradient(160deg, var(--color-forest) 0%, var(--forest-deep) 78%);
    position: relative;
    overflow: hidden;
  }
  .sk-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 4.6vw, 3.6rem);
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .sk-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.1rem, 3.7vw, 3.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ivory);
    text-wrap: balance;
    margin: 1.1rem 0 0;
  }
  .sk-title em { font-style: italic; color: var(--brass-soft); }
  .sk-lede {
    font-size: clamp(1rem, 1.3vw, 1.06rem);
    line-height: 1.74;
    color: rgba(245, 240, 229, 0.8);
    /* 64ch, not 56 — the client's subtitle is 239 characters and a narrower
       measure sets it to five lines. Widen the measure, never cut the copy. */
    max-width: 64ch;
    margin-top: 1.3rem;
  }
  .sk-actions { margin-top: 1.9rem; }
  /* Centred action row — for a CTA that closes a block, rather than one sitting
     inside a copy column. */
  .sk-actions--center {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.2rem, 4.4vw, 3.2rem);
  }

  /* the hero's one specification element — a numbered rail, not a pill row
     ⚠️⚠️ **Two bans on this rail, both from the client, both still live.**
     1. **No figure the page cannot stand behind.** `0.06 mm` kiss-cut depth and
        `8 spot colors + white` were in here for an hour on 2026-09-20 and were
        pulled (*"你的数据不要是不存在的"*) — neither is stated anywhere on the
        site, both came off the raw interview sheet, and the plant has never rated
        either. The `1,000 h @ 95% RH` and `24 h to full grip` drafts are under the
        same ban; see §The Adhesive's comment.
     2. **Nothing already in the H1.** The H1 is `±0.2 mm Die-Cut Labels … Reduce
        Line Rejections`, so `±0.2 mm` cannot be a rail figure — the client
        restated this as *"不要和标题有重复"*.
     The rail therefore answers "what am I ordering" rather than "how well is it
     cut" — the cut argument already belongs to the headline:
       `500–500,000 units` — the site's AUDITED order range, and the one figure
         here that appears in no other copy on this page (only in the comments).
       `−18 °C to 70 °C` — the client's call, see the temperature note below.
       `5–7 days from proof` — §Five Stops stage 03 and the SEO description.
     ⚠️ **THE TEMPERATURE — researched 2026-09-20, settled by the client.** They
     challenged `−18 °C to 60 °C` (*"关于温度，你看过竞争对手怎么说吗，我觉得你说的很
     夸张"*), so the market was checked:
       — Fastlabels rates its custom waterproof **BOPP** labels `−18 °C to +80 °C`
         (freezer-safe to −30 °C) — the same face stock and permanent acrylic
         adhesive this page sells;
       — Avery rates its waterproof plastic labels `−40 °C to +150 °C` (a
         different material: Teslin / PE);
       — general permanent acrylics are applied above +10 °C and served to
         about +80 °C;
       — the reference site this page was built from publishes **no number at
         all**, and proves cold performance with a 72-hour condensation test
         (2–4 °C) plus an ice bucket instead.
     So `−18 to 60` was NARROWER than the market, not exaggerated — the market's
     top end is +80, not +60. The client's instruction was *"按照市面上的去写，但是
     不要写的很满，不要过度的去夸张"*: write to the market, one notch back from
     full. The rail therefore carries `−18 °C to 70 °C` — the **+70** takes one
     step off the market's +80 so nothing is maxed out, and the **−18** stays
     because it is not an optional figure: §The Adhesive names `Frozen, −18 °C` as
     a surface and the food vertical claims a `Freezer-grade adhesive`, so a
     shallower cold end would contradict the page's own body.
     ⚠️ **This is still a market-derived claim, not a plant rating.** It is the
     one number on the page that the client authorised on that basis. If the plant
     ever rates the build, use the plant's figure — and if it rates BELOW −18,
     §The Adhesive's freezer row and the food chip have to move with it. */
  .sk-specs {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 2.2rem;
  }
  .sk-specs li { display: flex; align-items: baseline; gap: 0.55rem; }
  .sk-specs i {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--brass-soft);
    letter-spacing: 0.02em;
  }
  .sk-specs b {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 240, 229, 0.6);
  }
  .sk-specs span {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--ivory);
  }

  /* THE LABEL PANEL. Every dimension here is in service of one idea: this is a
     real label, so it carries the die line on its outside and the compliance
     text inside it, in the sizes a label actually uses. */
  .sk-label {
    position: relative;
    margin: 0;
    background: var(--ivory);
    border-radius: 1.1rem;
    padding: clamp(0.7rem, 1.4vw, 1rem);
    /* The panel is an ivory card on the dark hero gradient, so the shadow is the
       large soft one the dark ground wants. */
    box-shadow: 0 48px 80px -48px rgba(0, 0, 0, 0.72), 0 1px 0 rgba(255, 255, 255, 0.05);
    outline: 2px dashed rgba(201, 168, 124, 0.6);
    outline-offset: 9px;
  }
  .sk-label-reg {
    position: absolute;
    width: 15px;
    height: 15px;
    color: var(--brass-soft);
    background:
      linear-gradient(currentColor, currentColor) center/100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) center/1px 100% no-repeat;
  }
  .sk-label-reg:nth-of-type(1) { top: -26px; left: -26px; }
  .sk-label-reg:nth-of-type(2) { top: -26px; right: -26px; }
  .sk-label-reg:nth-of-type(3) { bottom: -26px; left: -26px; }
  .sk-label-reg:nth-of-type(4) { bottom: -26px; right: -26px; }

  .sk-label-art { position: relative; aspect-ratio: 4 / 3; border-radius: 0.7rem; overflow: hidden; background: var(--color-clay); }
  .sk-label-art img { width: 100%; height: 100%; object-fit: cover; }
  .sk-label-art span {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ivory);
    background: rgba(20, 38, 27, 0.62);
    border: 1px solid rgba(201, 168, 124, 0.45);
    border-radius: 999px;
    padding: 0.34rem 0.68rem;
  }
  .sk-label-print { padding: clamp(0.9rem, 1.8vw, 1.3rem) clamp(0.4rem, 1vw, 0.8rem) clamp(0.3rem, 0.7vw, 0.5rem); }
  /* three repeating gradients at different periods — a barcode is exactly this
     kind of irregular pattern, and it costs one declaration */
  .sk-label-bar {
    height: clamp(44px, 5vw, 62px);
    color: var(--color-brand-text);
    background:
      repeating-linear-gradient(90deg, currentColor 0 3px, transparent 3px 11px),
      repeating-linear-gradient(90deg, currentColor 0 5px, transparent 5px 19px),
      repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 27px);
  }
  .sk-label-num { font-family: var(--font-heading); font-size: 0.72rem; letter-spacing: 0.34em; color: var(--color-brand-muted); margin: 0.5rem 0 0; word-break: break-all; }
  .sk-label-line { font-family: var(--font-heading); line-height: 1.2; letter-spacing: -0.015em; color: var(--color-brand-text); margin: clamp(0.5rem, 1vw, 0.8rem) 0 0; }
  .sk-label-line--a { font-size: clamp(0.9rem, 1.3vw, 1.05rem); }
  .sk-label-line--b { font-size: clamp(0.98rem, 1.5vw, 1.18rem); }
  .sk-label-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(0.6rem, 1.2vw, 0.9rem);
    padding-top: clamp(0.55rem, 1.1vw, 0.85rem);
    border-top: 1px solid rgba(31, 59, 44, 0.22);
  }
  .sk-label-foot b { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.35rem, 2.2vw, 1.9rem); line-height: 1; letter-spacing: -0.025em; color: var(--color-brand-text); }
  .sk-label-marks { display: flex; gap: 0.45rem; }
  .sk-label-marks span {
    display: inline-grid;
    place-items: center;
    width: clamp(28px, 2.8vw, 36px);
    aspect-ratio: 1 / 1;
    border: 1.5px solid var(--color-forest);
    border-radius: 5px;
    font-size: clamp(0.75rem, 1.1vw, 0.95rem);
    color: var(--color-forest);
  }

  /* ======================== 2. NINE FAMILIES ======================== */
  .sk-types { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-ivory); }
  .sk-type-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 2.6vw, 2.1rem);
  }
  .sk-type {
    display: flex;
    flex-direction: column;
    background: var(--color-brand-surface);
    border: 1px solid rgba(31, 59, 44, 0.12);
    border-radius: 1.3rem;
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  .sk-type:hover { transform: translateY(-5px); box-shadow: 0 24px 50px -30px rgba(31, 59, 44, 0.5); }
  .sk-type-fig { position: relative; margin: 0; }
  /* 100/97, not 1/1 — the client asked for the image 0.3 cm shorter. At the
     3-up desktop column (~378 px) that is 11.3 px off the height, i.e. exactly
     0.3 cm. Slightly landscape, still no crop worth noticing. */
  .sk-type-fig img { width: 100%; aspect-ratio: 100 / 97; object-fit: cover; }
  .sk-type-code {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ivory);
    background: rgba(20, 38, 27, 0.66);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    backdrop-filter: blur(4px);
  }
  .sk-type-body { padding: 1.25rem 1.3rem 1.45rem; display: flex; flex-direction: column; gap: 0.7rem; align-items: flex-start; }
  .sk-type-body h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.24;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0;
  }
  .sk-type-body p { font-size: 0.94rem; line-height: 1.66; color: var(--color-brand-muted); margin: 0; }

  /* ======================== 3. THE ARTWORK AND THE DIE ========================
     Three stages across, a brass arrow in each gap. The middle stage is drawn
     rather than photographed, because the die is the one part of the process
     nobody can photograph: it is a line. */
  .sk-registration { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-clay); }
  .sk-stage {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.6vw, 2rem);
  }
  .sk-stage > li { position: relative; }
  /* the connector lives in the gutter, so it disappears the moment the grid
     stacks and there is no gutter left to sit in */
  .sk-stage > li + li::before {
    content: '→';
    position: absolute;
    left: calc(-1 * (clamp(1.2rem, 2.6vw, 2rem) / 2) - 0.55rem);
    top: 34%;
    transform: translateX(-50%);
    font-size: 1.15rem;
    color: var(--brass);
    line-height: 1;
  }
  .sk-stage-n {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--brass);
    margin-bottom: 0.7rem;
  }
  .sk-stage-fig {
    margin: 0 0 1.15rem;
    border-radius: 1.1rem;
    overflow: hidden;
    border: 1px solid rgba(176, 141, 76, 0.42);
    /* the client's three photographs are all 16:9, so the window matches them and
       nothing is trimmed; on a clay section the panel behind a slow-loading image
       is clay too, not the forest the drawn die used to need */
    background: var(--color-brand-surface);
  }
  .sk-stage-fig img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .sk-stage h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    line-height: 1.24;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0;
  }
  .sk-stage p { font-size: 0.93rem; line-height: 1.66; color: var(--color-brand-muted); margin: 0.65rem 0 0; }
  /* ⚠️ **THE CARD SHAPE — read before editing any of the three stages.**
     Every stage is ONE two-line description plus ONE PILL, so:
       — the three cards are the SAME height (the client's *"高度不一"*);
       — the colour and the shape appear in the SAME place on all three. It used
         to sit only on stage 03, as `In a roll.` / `Loose cut.` lead-ins on a
         `<b>` — the client's *"为什么只有最后一个是有不同颜色的字体呢"*. A single
         coloured card in a row of three reads as an inconsistency, not emphasis;
       — and each card answers "what does this buy the buyer", not "what do we
         do" (*"你可以写这样做的好处，我们这么做给客户带来什么好处"*).
     ⚠️ The benefit is a PILL, at 1rem against the 0.93rem body and on a brass
     wash, because the client asked for it to read as a distinct element and be
     *"稍微大一点点，区分一下"*. It is a paragraph set to `inline-block`, not a
     badge inside the body copy, so it can never wrap mid-pill at these widths.
     **Keep every description ≤ 2 lines and every pill ≤ 1 line at the section's
     column width (~41 characters).** The longest pill is 34 characters, which
     with its padding still clears the column. Do not re-split the fork into two
     paragraphs, and do not add a fourth line to any card. */
  .sk-stage .sk-gain {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--color-forest);
    background: rgba(201, 168, 124, 0.3);
    border-radius: 999px;
    padding: 0.42rem 0.95rem;
  }
  /* ⚠️ A closing pull-line used to sit under the three cards — italic display
     serif, `max-width: 84ch`, no rule above it: *"A die drawn without the
     artwork, or artwork drawn without the die, is the most common reason a label
     run comes back wrong."* It was deleted 2026-09-20: the client could not tell
     what it was (*"这是什么，如果不需要就删掉，需要就冒号标明一下"*), and they were
     right that it was doing nothing — the section sub already states the
     requirement (*"The two agree on one file before anything is printed"*), so the
     line was the third statement of the same point, and the three cards now close
     on their own benefit pills. **Do not re-add a closing sentence here.** If a
     fact ever needs to close a section, it needs a labelled lead-in and a reason
     to exist, not a floating italic paragraph. */

  /* ======================== 4. THE ADHESIVE ========================
     Read ACROSS, not down. Six stacked rows of equal weight gave the eye no
     landing point: the answer was set smaller than the question and half the
     container sat empty to the right of every row.
     ⚠️⚠️ **A vertical rule does NOT work here and was removed on the client's
     report — "无法知道左边对应的是右边的胶".** A rule running the full height of
     the list reads as a COLUMN DIVIDER, which is the exact opposite of the
     intent: it says "these are two columns", not "each left item owns the right
     item beside it". At 1200 px wide the two names are ~500 px apart, so
     proximity can never group a pair either.
     **The pairing is carried by three things, and all three are load-bearing:**
     1. a brass `→` per row, sitting in its own grid column ON the row's
        baseline — the explicit connector the eye can follow across the gap;
     2. `align-items: baseline` on the row, so the surface name, that arrow and
        the adhesive name sit on ONE line;
     3. a row `gap` (~3.6rem) that is visibly larger than the inline gutter, so
        the rows separate while each pair stays together.
     ⚠️ `align-items: baseline` only works while `.sk-surf-ico` is a SIBLING of
     the two cells, with `align-self: start` to keep it out of the alignment.
     Move the icon back inside `.sk-surf` and that cell's baseline becomes the
     icon's bottom edge, which throws the row's line out.
     ⚠️ The two small-caps labels above the list are a legend, NOT a table
     header — there is deliberately no rule under them, because a horizontally
     delimited block is a table and this page's one table is §Five Finishes. */
  .sk-adhesive { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-forest); }
  .sk-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.7rem;
    margin: clamp(2.6rem, 5vw, 3.6rem) 0 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-soft);
  }
  .sk-legend i { font-style: normal; color: var(--brass); }
  .sk-surface {
    list-style: none;
    margin: clamp(2rem, 3.6vw, 2.8rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* ⚠️ ONE FRAME PER PAIR. The pairing is carried by the BORDER: two halves inside
     a single enclosed bar cannot be read apart.
     ⚠️⚠️ THIS IS THE EXACT LAYOUT THE CLIENT PICKED from the five side-by-side
     options in the repo-root `_preview-adhesive-list.html`. It has now been
     rebuilt twice for deviating from that preview — first by dropping the two
     role labels and the inline arrow in favour of a brass dot, then by replacing
     the answer half's `rgba(245,240,229,.05)` wash with `--color-sage`, which
     drew "你的区分颜色太丑了". **Do not re-tone these halves and do not remove the
     role labels: the labels and their `→` ARE the pairing device in this variant,
     and the wash is deliberately faint.** The two earlier pairing attempts — a
     list-height vertical rule (read as a column divider) and a small bare `→`
     glyph ("指向箭头不明显") — are both dead ends.
     ⚠️ The role labels carry the arrow, so there is no separate connector
     element. If you find yourself adding one, you are rebuilding the version the
     client rejected. */
  .sk-surface li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid rgba(201, 168, 124, 0.3);
    border-radius: 1rem;
    overflow: hidden;
  }
  /* Explicit placement: the role label spans the top, then the icon holds column
     one across the name and the description. */
  .sk-surf {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(0.7rem, 1.3vw, 1rem);
    padding: 1.15rem 1.4rem 1.3rem;
  }
  .sk-surf-role,
  .sk-bond-role {
    display: block;
    grid-column: 1 / -1;
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass-soft);
    margin-bottom: 0.55rem;
  }
  .sk-bond-role i { font-style: normal; color: var(--brass); margin-right: 0.35rem; }
  .sk-bond-role em { font-style: normal; color: rgba(245, 240, 229, 0.4); }
  /* ⚠️ The icon's paint and size stay ATTRIBUTES inside the `set:html` string.
     Astro does not stamp the scope attribute on set:html markup, so a rule like
     `.sk-surf-ico svg` matches nothing and the stroke falls back to solid black.
     Only `color` is set here — `currentColor` resolves by inheritance and does
     not need the scope attribute. `display: flex` blockifies the inline `<svg>`
     so it fills the square with no baseline gap; do not switch it to `block`. */
  .sk-surf-ico {
    grid-column: 1;
    grid-row: 2 / span 2;
    align-self: start;
    display: flex;
    width: clamp(24px, 2.2vw, 30px);
    aspect-ratio: 1 / 1;
    color: var(--brass-soft);
  }
  .sk-surf h3 {
    grid-column: 2;
    grid-row: 2;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ivory);
    margin: 0;
  }
  .sk-surf p {
    grid-column: 2;
    grid-row: 3;
    font-size: 0.87rem;
    line-height: 1.6;
    color: rgba(245, 240, 229, 0.6);
    margin: 0.5rem 0 0;
    max-width: 44ch;
    text-wrap: pretty;
  }
  /* The answer half. The wash is deliberately faint — see the warning above. */
  .sk-bond {
    padding: 1.15rem 1.4rem 1.3rem;
    background: rgba(245, 240, 229, 0.05);
    border-left: 1px solid rgba(201, 168, 124, 0.3);
  }
  .sk-bond b {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--ivory);
    margin: 0;
  }
  .sk-bond p { font-size: 0.87rem; line-height: 1.6; color: rgba(245, 240, 229, 0.72); margin: 0.5rem 0 0; max-width: 44ch; text-wrap: pretty; }

  /* ======================== 5. FOUR SUBSTRATES ======================== */
  .sk-substrate { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-ivory); }
  .sk-mat-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.4rem, 2.6vw, 2rem);
  }
  .sk-mat {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
    background: var(--color-brand-surface);
    border: 1px solid rgba(31, 59, 44, 0.12);
    border-radius: 1.3rem;
    overflow: hidden;
  }
  .sk-mat-fig { margin: 0; }
  .sk-mat-fig img { width: 100%; height: 100%; aspect-ratio: 5 / 4; object-fit: cover; }
  .sk-mat-body { padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.1rem, 2vw, 1.5rem) clamp(1.1rem, 2vw, 1.5rem) 0; display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .sk-mat-body h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.24;
    color: var(--color-brand-text);
    margin: 0;
  }
  .sk-mat-body p { font-size: 0.92rem; line-height: 1.64; color: var(--color-brand-muted); margin: 0; }
  .sk-mat-fail { font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; color: var(--color-brand-text); margin-top: auto; }
  .sk-mat-fail i {
    font-style: normal;
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
    margin-right: 0.5rem;
  }

  /* ======================== 6. FIVE FINISHES — THE ONE TABLE ========================
     ⚠️ The frame is deliberate. The client has asked twice on a sibling page
     for the table to keep a visible border; a row rule alone does not read as
     a boundary. Padding lives on the outer cells, never on the table, so the
     row rules still run the full width and meet the frame.
     ⚠️ `table-layout: fixed` — auto layout sizes the note column by its longest
     sentence and pushes the other four around. */
  .sk-finish { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-clay); }
  .sk-fin-wrap { overflow-x: auto; }
  .sk-fin-table {
    width: 100%;
    min-width: 620px;
    /* `relative` so the hidden caption and the `.sk-sr` dot labels are
       positioned against the table and clipped by it, rather than against the
       initial containing block and escaping the scroll container */
    position: relative;
    /* separate, not collapse — a collapsed table does not clip to a radius */
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    border: 1px solid rgba(31, 59, 44, 0.26);
    border-radius: 1.1rem;
    overflow: hidden;
    background: rgba(245, 240, 229, 0.5);
  }
  .sk-fin-table caption {
    position: absolute; top: 0; left: 0; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  /* the header row carries the column widths — with `table-layout: fixed` these
     are the ones that decide, and auto layout would size the note column by its
     longest sentence and push the other five around */
  .sk-fin-table thead th:first-child { width: 40%; }
  .sk-fin-table thead th:not(:first-child) { width: 12%; text-align: center; }
  .sk-fin-table thead th {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
    text-align: left;
    padding: 1.1rem clamp(1rem, 2vw, 1.6rem);
    border-bottom: 1px solid rgba(31, 59, 44, 0.3);
  }
  .sk-fin-table tbody th, .sk-fin-table tbody td {
    padding: 1.15rem clamp(1rem, 2vw, 1.6rem);
    border-bottom: 1px solid rgba(31, 59, 44, 0.16);
  }
  .sk-fin-table tbody tr:last-child th, .sk-fin-table tbody tr:last-child td { border-bottom: 0; }
  .sk-fin-table tbody th { text-align: left; font-weight: 400; }
  .sk-fin-name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.14rem;
    line-height: 1.25;
    color: var(--color-brand-text);
  }
  .sk-fin-note {
    display: block;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-brand-muted);
    margin-top: 0.4rem;
  }
  .sk-fin-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-primary);
    background: rgba(176, 141, 76, 0.24);
    border-radius: 999px;
    padding: 0.24rem 0.6rem;
    margin-top: 0.5rem;
  }
  /* ⚠️ A highlighted row KEEPS its rule — deleting the rule under a band reads
     as a broken table, not as restraint. The rule goes to 0.30 alpha so it
     survives the brass tint underneath it. */
  .sk-fin-table tr.sk-fin-row--on th, .sk-fin-table tr.sk-fin-row--on td {
    background: rgba(201, 168, 124, 0.2);
    border-bottom-color: rgba(31, 59, 44, 0.3);
  }
  .sk-fin-table tbody td { text-align: center; }
  .sk-fin-cost {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--brass);
  }
  .sk-fin-short { display: none; }
  .sk-fin-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.4rem;
    margin: 1.2rem 0 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-brand-muted);
  }
  .sk-fin-legend .sk-dot { margin-right: 0.45rem; }
  .sk-fin-legend-sp { color: var(--brass); font-family: var(--font-heading); font-size: 1rem; }
  .sk-fin-wrap > .sk-win { margin-top: 1.15rem; font-size: 0.94rem; }

  /* ======================== 7. WHAT EACH VERTICAL DEMANDS ======================== */
  .sk-industry { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-forest); }
  .sk-ind-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.6rem);
  }
  .sk-ind {
    display: flex;
    flex-direction: column;
    background: rgba(245, 240, 229, 0.06);
    border: 1px solid rgba(245, 240, 229, 0.14);
    border-radius: 1.25rem;
    padding: 0.85rem 0.85rem 1.35rem;
  }
  .sk-ind-fig { margin: 0 0 1rem; border-radius: 0.95rem; overflow: hidden; }
  .sk-ind-fig img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .sk-ind h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.14rem;
    line-height: 1.28;
    color: var(--ivory);
    margin: 0 0 0.6rem;
    padding-inline: 0.35rem;
  }
  .sk-ind > p { font-size: 0.88rem; line-height: 1.62; color: rgba(245, 240, 229, 0.74); margin: 0 0 1rem; padding-inline: 0.35rem; }
  .sk-chips { list-style: none; margin: auto 0 0; padding: 0 0.35rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .sk-chips li {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--brass-soft);
    background: rgba(201, 168, 124, 0.16);
    border-radius: 999px;
    padding: 0.3rem 0.62rem;
  }

  /* ======================== PRECISION PRINTING (COPIED CONTENT) ========================
     The copy and the photographs are the client's reference site's, reproduced at
     their request. Only this page's ground, type scale and accents were applied:
     the reference runs white with a #0085ad blue and a #27ae60 green rule; here
     it is ivory, forest and brass.
     ⚠️⚠️ THREE FIGURES IN THIS SECTION ARE NOT OURS AND HAVE NO SOURCE IN THE
     PROJECT. Confirm with the plant before this goes live:
       1. `ΔE < 1.5` — a colour-drift tolerance nothing in the project has ever
          stated.
       2. `1,000,000+` pieces a day — the site's audited figure set is
          500–500,000 units; nothing on this page supports a million.
       3. The reference writes its die-cutting figure as **±0.3 mm**. That fights
          this page's own headline claim of **±0.2 mm** (the H1, the hero rail's
          `01 Cut`, and the SEO title all say 0.2), so it is stated here as
          ±0.2 mm. If the plant really rates 0.3 mm, the H1 is what is wrong.
     ⚠️ The reference's stat bar is a 3px top rule with a rule between every cell.
     **That is a rule-delimited block, which this page's own rule bans** (the test
     is not "is it a `<table>`" but "is this block delimited by a horizontal
     rule"), and §Five Finishes holds the page's one table. Same figures,
     separated by GAP. Do not "restore" the rules.
     ⚠️ The green left rule on the note panel became `--color-brass`: the palette
     has no green accent, and `--color-sage` is already carrying §The Adhesive. */
  .sk-print { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-ivory); }
  .sk-pr-stats {
    list-style: none;
    margin: clamp(2.4rem, 4.6vw, 3.2rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 3vw, 2.6rem);
  }
  .sk-pr-stats b {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-forest);
    white-space: nowrap;
  }
  .sk-pr-stats span {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-muted);
  }
  .sk-pr-grid {
    list-style: none;
    margin: clamp(2.4rem, 4.6vw, 3.2rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  /* The caption is a bar across the foot of the frame, as in the reference. It is
     also the photograph's ROLE — these are machines, and a machine with no name
     is decoration that drifted. */
  .sk-pr-grid figure {
    position: relative;
    margin: 0;
    border-radius: 0.9rem;
    overflow: hidden;
    background: var(--color-clay);
  }
  .sk-pr-grid img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .sk-pr-grid figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.8rem 0.9rem;
    background: rgba(20, 38, 27, 0.84);
    color: var(--ivory);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
  }
  .sk-pr-note {
    margin: clamp(2.4rem, 4.6vw, 3.2rem) 0 0;
    padding: clamp(1.2rem, 2.4vw, 1.7rem) clamp(1.3rem, 2.6vw, 1.9rem);
    border-left: 4px solid var(--color-brass);
    background: var(--color-clay);
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--color-brand-muted);
    max-width: 100ch;
  }
  .sk-pr-note b { font-weight: 600; color: var(--color-forest); }

  /* ======================== 8. FIVE STOPS ========================
     The one place on the page where a rule carries information: the sequence. */
  .sk-stops { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-clay); }
  /* Vertical ledger, not a five-column timeline. Sequence is carried by the
     numeral now, so no rule is needed anywhere in this section. */
  .sk-stop-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.2rem);
  }
  .sk-stop-list li { display: grid; grid-template-columns: 4.4rem minmax(0, 1fr); column-gap: clamp(0.8rem, 2vw, 1.6rem); }
  .sk-stop-n {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.55rem;
    line-height: 1;
    color: var(--brass);
  }
  .sk-stop-body { max-width: 88ch; }
  .sk-stop-when {
    display: block;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .sk-stop-list h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.24;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0.45rem 0 0;
  }
  .sk-stop-list p { font-size: 0.95rem; line-height: 1.68; color: var(--color-brand-muted); margin: 0.6rem 0 0; }

  /* ======================== NOT JUST A PRETTY PACKAGING ========================
     A credentials strip, not a section: the heading sits deliberately below the
     page's section-title scale so it reads as a strip interrupting the flow
     rather than as another full section. */
  .sk-plain { background: var(--color-ivory); padding: clamp(3rem, 6vw, 4.6rem) 0; }
  .sk-plain-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.1vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-brand-text);
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }
  .sk-plain-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2.4rem);
  }
  .sk-plain-row li { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
  .sk-plain-ico { display: block; width: clamp(34px, 3.4vw, 44px); aspect-ratio: 1 / 1; color: var(--color-forest); }
  .sk-plain-ico svg { display: block; }
  .sk-plain-row b {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-brand-text);
  }

  /* ======================== MID-PAGE CTA ========================
     A centred stack, like the final CTA below.
     ⚠️ **Dark scrim + a fixed (parallax) background, 2026-09-20.** The client's
     own photograph paints the band: the scrim is DARK so the ivory type keeps its
     contrast, but it is a gradient rather than a flat wash — heavier over the
     copy, thinning to the right — because they asked for the packaging to stay
     legible (*"图片要清晰一点"*). A flat dark heavy enough for the H2 would lose
     the photograph.
     ⚠️ `background-attachment: fixed` is the "滑动上下跟随" the client asked for:
     the photograph is pinned to the VIEWPORT, so the band reads through a moving
     window of it as the page scrolls. It is set for pointer/desktop only —
     iOS Safari ignores it and would jank, so below 1025 px the background scrolls
     with the band like any other.
     ⚠️ The band is brighter than the flat `--color-forest` of §The Adhesive
     directly below, so that join is a plain chapter edge now. Do not re-derive a
     gradient to hide it: the photograph is what breaks the two apart, and
     matching the next section's ground would mean losing the picture. */
  .sk-midcta {
    position: relative;
    overflow: hidden;
    /* ⚠️ The client has sized this band by hand twice: pulled down from a `6rem`
       cap (*"纵向高度不要太高"*) and then +0.5 cm back (≈38 px per cm → ~19 px per
       side). At 1440 `4.4vw` is 63 px, just inside the `4rem` cap, which is the
       ~9 px per side the last change asked for. */
    padding: clamp(2.4rem, 4.4vw, 4rem) 0;
    background: var(--forest-deep) url('https://img.leelinepackage.com/stickers/mid-cta-bg.webp') center 58% / cover no-repeat;
  }
  .sk-midcta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      rgba(20, 38, 27, 0.82) 0%,
      rgba(20, 38, 27, 0.72) 42%,
      rgba(20, 38, 27, 0.44) 74%,
      rgba(20, 38, 27, 0.14) 100%);
  }
  /* ⚠️ **Centred, and short (2026-09-20).** It was a two-column row — copy left,
     button right in its own 0.65fr track — which is also what kept it from
     reading as the same block as the final CTA. The client asked for centred
     text (*"文字还是居中吧"*) and less height (*"纵向高度不要太高"*), so it is now
     the same centred stack as the final CTA, with the padding roughly halved.
     ⚠️ That leaves the two CTAs the same shape. They are still told apart by
     ground (parallax photograph with a directional scrim here, a radial pool of
     dark over a different photograph there) and by copy — if a future edit wants
     them distinct again, change one of those, NOT the alignment. */
  .sk-midcta-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 60rem;
    margin-inline: auto;
  }
  .sk-midcta-title { font-size: clamp(1.6rem, 2.9vw, 2.4rem); margin-top: 1rem; }
  .sk-midcta-sub { margin: 1.1rem auto 0; }
  .sk-midcta-act { display: flex; justify-content: center; margin-top: clamp(1.7rem, 3vw, 2.3rem); }
  /* the parallax window — desktop/pointer only, see the block comment above */
  @media (min-width: 1025px) {
    .sk-midcta { background-attachment: fixed; }
  }

  /* ======================== 9. HOW BUYERS USE THEM ========================
     Six scenarios, three at a time, looping in both directions. Modelled on the
     acrylic page's carousel, which the client already approved — including the
     arrows sitting ON the row.
     ⚠️ CLONES (in the script) must equal the largest slides-per-view, which is
     3 here, or the wrap shows a gap.
     ⚠️ This section must never get `content-visibility: auto`: the carousel
     measures the track on load, before it is anywhere near the viewport.
     Each slide is image-only with a caption panel, so every slide is exactly the
     same height — a row of cards with ragged copy would make the arrows sit at
     different heights as the track moves. */
  .sk-scenes { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-clay); }
  .sk-car-wrap { position: relative; margin-top: clamp(2.4rem, 5vw, 3.6rem); }
  .sk-car { overflow: hidden; }
  .sk-car-track {
    --sk-car-gap: clamp(1rem, 2vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--sk-car-gap);
  }
  .sk-car-slide {
    position: relative;
    flex: 0 0 calc((100% - 2 * var(--sk-car-gap)) / 3);
    border-radius: 1.2rem;
    overflow: hidden;
    background: var(--color-brand-surface);
  }
  .sk-car-slot {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-brand-surface);
  }
  .sk-car-slot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* a caption panel rather than a scrim: it stays legible over a bright
     photograph and over an empty placeholder alike */
  .sk-car-cap {
    position: absolute;
    inset: auto 0.7rem 0.7rem 0.7rem;
    background: rgba(245, 240, 229, 0.96);
    border-radius: 0.75rem;
    padding: 0.7rem 0.95rem 0.75rem;
    backdrop-filter: blur(6px);
  }
  /* One line. The scenario is named and the photograph does the rest — the same
     treatment the acrylic page's scene carousel uses. */
  .sk-car-cap h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-brand-text);
    margin: 0;
  }
  /* The arrows sit ON the row. The padding mirrors `.wrap`'s gutter so they land
     on the outer slides' own edges at every width. */
  .sk-car-ctl {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: max(clamp(1rem, 3vw, 3rem), calc((100% - 1200px) / 2));
    pointer-events: none;
  }
  .sk-car-ctl .sk-car-btn { pointer-events: auto; }
  .sk-car-btn {
    width: 2.9rem;
    height: 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(31, 59, 44, 0.12);
    background: rgba(245, 240, 229, 0.94);
    color: var(--color-brand-text);
    box-shadow: 0 12px 24px -14px rgba(20, 38, 27, 0.75);
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }
  .sk-car-btn svg { width: 1.15rem; height: 1.15rem; }
  .sk-car-btn:hover { background: var(--color-forest); border-color: var(--color-forest); color: var(--ivory); transform: translateY(-2px); }

  /* ======================== 10. REVIEWS ========================
     Cards, and the body copy is set in the page's own body face rather than as
     an italic serif pull-quote — the client asked for the reviews to read like
     the rest of the page. */
  .sk-quotes {
    padding: clamp(4rem, 9vw, 8rem) 0;
    background: linear-gradient(180deg, var(--color-forest), var(--forest-deep));
  }
  /* ⚠️ **The two cards are the same height** (`align-items` left at the default
     `stretch`). `align-items: start` was here and let the shorter review end
     early, which the client pulled. The card itself is a flex column so the
     attribution can be pushed to the bottom with `margin-top: auto` — without
     that, equal-height cards just leave a gap under the shorter one's byline. */
  .sk-quote-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.4rem, 2.8vw, 2rem); }
  .sk-quote {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(245, 240, 229, 0.055);
    border: 1px solid rgba(245, 240, 229, 0.15);
    border-radius: 1.3rem;
    padding: clamp(1.4rem, 2.6vw, 2rem) clamp(1.4rem, 2.6vw, 2rem) clamp(1.3rem, 2.4vw, 1.7rem);
  }
  /* The pair of marks, not one: an opening “ at the head of the card and its
     closing ” at the foot. A lone opening mark reads as broken punctuation —
     the client's *"引号你要么就用左右都要有，要么就都不要"*. Both are block-level
     decorations in the same size, colour and opacity, so the card is framed
     rather than punctuated; do not move either one inline into the paragraph. */
  .sk-quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.4rem;
    line-height: 0.6;
    color: var(--brass-soft);
    opacity: 0.55;
    margin-bottom: 0.7rem;
  }
  .sk-quote-mark--close {
    text-align: right;
    line-height: 1;
    /* the bottom margin is what guarantees a gap above the byline — the byline
       itself is `margin-top: auto` and collapses to nothing on the taller card */
    margin: -0.2rem 0 1rem;
  }
  .sk-quote p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.72;
    color: rgba(245, 240, 229, 0.82);
    margin: 0 0 0.9rem;
  }
  .sk-quote-who {
    display: flex;
    align-items: center;
    gap: 1.05rem;
    /* pinned to the foot of the card, so both bylines line up whatever the
       review's length */
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(245, 240, 229, 0.2);
  }
  /* Avatar and byline, enlarged 2026-09-20 at the client's request
     (*"客户头像稍微放大一些，文字也可以稍微大一点"*): 52 → 60 px, the name
     0.95 → 1.02rem, the role 0.8 → 0.86rem, and the gap opened with them. The
     review BODY stays at 0.95rem — only the byline block was asked for. */
  .sk-quote-who img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .sk-quote-who b { display: block; font-family: var(--font-body); font-size: 1.02rem; font-weight: 600; color: var(--ivory); }
  .sk-quote-who i { display: block; font-style: normal; font-size: 0.86rem; color: var(--brass-soft); margin-top: 0.2rem; }

  /* ======================== 11. FAQ ======================== */
  .sk-faq { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-ivory); }
  /* centred head, one centred column of questions */
  .sk-faq .sk-head { text-align: center; max-width: 66rem; margin-inline: auto; }
  .sk-faq .sk-sub { margin-inline: auto; }
  .sk-faq-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; max-width: 62rem; margin-inline: auto; }
  .sk-faq-grid details {
    background: var(--color-brand-surface);
    border: 1px solid rgba(31, 59, 44, 0.12);
    border-radius: 1.1rem;
    padding: 1.05rem 1.3rem;
  }
  .sk-faq-grid summary {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.02rem, 1.6vw, 1.16rem);
    line-height: 1.4;
    color: var(--color-brand-text);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 1.9rem;
  }
  .sk-faq-grid summary::-webkit-details-marker { display: none; }
  .sk-faq-grid summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: -0.1rem;
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--brass);
    transition: transform 0.3s ease;
  }
  .sk-faq-grid details[open] summary::after { transform: rotate(45deg); }
  .sk-faq-grid details p { font-size: 0.94rem; line-height: 1.7; color: var(--color-brand-muted); margin: 0.9rem 0 0; }
  /* The page's numeral device, at list scale rather than display scale — the
     question is the payload here, so the figure marks the sequence without
     outranking it. Same italic brass as `.sk-stage-n` and `.sk-stop-n`. */
  .sk-faq-n {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.98rem;
    color: var(--brass);
    margin-right: 0.6rem;
  }

  /* ======================== 12. FINAL CTA ========================
     ⚠️ **The client's photograph paints this band under a DARK radial scrim
     (2026-09-20).** Two things were removed to make room for it and must not be
     re-derived:
       — the `forest → forest-deep` gradient, because the ground is now the image;
       — the brass bloom (`.sk-final::after` used to be a warm glow), because a
         glow only reads on a flat dark ground and over a photograph it is a haze.
     The faint strip of die-cut outlines (`.sk-final-art`) also went: drawn shapes
     over a photograph are decoration that drifted, and with the §Registration die
     drawing replaced by the client's own photo of the real die it would have been
     the page's second drawn module. The hero's cut-path overlay is the page's one.
     ⚠️ The scrim is RADIAL, not flat. The copy is one centred stack, so it needs a
     dark pool in the middle to hold ivory type; a flat dark heavy enough for the
     headline would kill the photograph, and the client asked for it to stay clear
     (*"图片要显示清晰"*). Thinning to the edges leaves the label rolls on both
     sides plainly visible, which is the whole point of the frame.
     ⚠️ The source file is 894 px against a 1440 px band, so `cover` upscales it
     ~1.6×. The scrim hides most of that. If the softness ever shows, the fix is a
     wider source frame, never a heavier scrim. */
  .sk-final {
    position: relative;
    overflow: hidden;
    /* ⚠️ The upper bound started at `9rem`. The client has shortened this band
       twice by hand: −2 cm (9rem → 6.6rem) and then a further −1 cm
       (6.6rem → 5.4rem), each taken as ~38 px per cm → ~19 px off each side.
       Only the CAP moves: on narrower screens `10vw` is already below it, so the
       band keeps the height it had there. */
    padding: clamp(4.2rem, 10vw, 5.4rem) 0;
    background: var(--forest-deep) url('https://img.leelinepackage.com/stickers/final-cta-bg.webp') center / cover no-repeat;
  }
  .sk-final::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 82% 104% at 50% 50%,
      rgba(20, 38, 27, 0.8) 0%,
      rgba(20, 38, 27, 0.72) 42%,
      rgba(20, 38, 27, 0.42) 74%,
      rgba(20, 38, 27, 0.14) 100%);
  }
  .sk-final-inner { position: relative; z-index: 2; text-align: center; max-width: 62rem; margin-inline: auto; }
  .sk-final-sub { margin: 1.2rem auto 0; }
  .sk-final-inner .sk-actions { display: flex; justify-content: center; }

  /* ======================== RESPONSIVE ======================== */
  @media (max-width: 1024px) {
    .sk-hero-grid { grid-template-columns: minmax(0, 1fr); }
    .sk-type-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sk-stage { grid-template-columns: minmax(0, 1fr); gap: 2.2rem; }
    /* stacked: there is no gutter for the connector to sit in */
    .sk-stage > li + li::before { display: none; }
    .sk-mat-grid { grid-template-columns: minmax(0, 1fr); }
    .sk-ind-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sk-car-slide { flex: 0 0 calc((100% - var(--sk-car-gap)) / 2); }
    .sk-quote-grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 640px) {
    .sk-type-grid { grid-template-columns: minmax(0, 1fr); }
    /* The bar stacks into two panels; the frame's internal division turns from a
       left rule into a top rule, exactly as in the preview. */
    .sk-surface li { grid-template-columns: minmax(0, 1fr); }
    .sk-bond { border-left: 0; border-top: 1px solid rgba(201, 168, 124, 0.3); }
    .sk-mat { grid-template-columns: minmax(0, 1fr); }
    .sk-mat-fig img { aspect-ratio: 16 / 9; }
    .sk-mat-body { padding: 0 1.2rem 1.4rem; }
    .sk-ind-grid { grid-template-columns: minmax(0, 1fr); }
    .sk-car-slide { flex: 0 0 100%; }
    .sk-quote-grid { grid-template-columns: minmax(0, 1fr); }
    .sk-plain-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 1.2rem; }
    /* The stats have to stack: three columns at 390 px leaves ~110 px each and
       `1,000,000+` does not fit in that at any size. */
    .sk-pr-stats { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; }
    .sk-pr-grid { grid-template-columns: minmax(0, 1fr); }
    /* the band is one centred column at every width now; only the scrim changes
       — a flat wash, because a directional one no longer has a side to favour */
    .sk-midcta::before { background: rgba(20, 38, 27, 0.78); }
    .sk-stop-list li { grid-template-columns: minmax(0, 1fr); }
    /* The matrix has to FIT at 390, not scroll. A side-scrolling table with a
       column cut off mid-cell reads as a broken table, and the client reads a
       missing edge as a defect. At 390 the wrapper is 358 px: thirty per cent
       for the finish, fourteen per cent per score column and for the cost, with
       the cell padding pulled in to 0.4rem. That leaves ~37 px of content per
       score column, which the short headers and a 10 px dot both clear. */
    .sk-fin-table { min-width: 0; }
    .sk-fin-table thead th:first-child { width: 30%; }
    .sk-fin-table thead th:not(:first-child) { width: 14%; }
    .sk-fin-table thead th { font-size: 0.56rem; letter-spacing: 0; padding-inline: 0.4rem; }
    .sk-fin-table tbody th, .sk-fin-table tbody td { padding-inline: 0.4rem; }
    .sk-fin-name { font-size: 0.94rem; }
    .sk-fin-note { font-size: 0.78rem; margin-top: 0.3rem; }
    .sk-fin-badge { font-size: 0.54rem; letter-spacing: 0.08em; }
    .sk-fin-cost { font-size: 0.95rem; }
    .sk-fin-wide { display: none; }
    .sk-fin-short { display: inline; }
    /* the four registration crosses sit outside the panel's box, so on a narrow
       screen they would push the layout sideways */
    .sk-label { outline-offset: 6px; }
    .sk-label-reg { display: none; }
    .sk-specs { gap: 0.7rem 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  [data-reveal] { opacity: 0; transform: translateY(36px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: var(--d, 0s); }
  [data-reveal].in { opacity: 1; transform: none; }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));

  if ('IntersectionObserver' in window && !reduce) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // ---------------------------------------------------------------------------
  // Six scenarios, three at a time, looping in BOTH directions. Clone slides are
  // copied to both ends: advancing onto a clone and then resetting the track to
  // the matching real slide with no transition is what makes the wrap
  // continuous. CLONES must be >= the slides on screen at any width (3 / 2 / 1),
  // so three covers every breakpoint. The clones carry aria-hidden so a screen
  // reader is not read the same six scenarios twice.
  // ---------------------------------------------------------------------------
  const sceneTrack = document.querySelector('.sk-car-track');
  if (sceneTrack) {
    const CLONES = 3;
    const slides = Array.from(sceneTrack.children);
    const N = slides.length;
    if (N > 0) {
      const n = Math.min(CLONES, N);
      const cloneOf = (el) => {
        const c = el.cloneNode(true);
        c.setAttribute('aria-hidden', 'true');
        return c;
      };
      for (let k = 0; k < n; k++) {
        sceneTrack.insertBefore(cloneOf(slides[(N - n + k) % N]), slides[0]);
      }
      for (let k = 0; k < n; k++) sceneTrack.appendChild(cloneOf(slides[k % N]));
      const start = n;
      let i = start;
      let busy = false;

      const step = () => {
        const gap = parseFloat(getComputedStyle(sceneTrack).gap) || 0;
        return sceneTrack.children[start].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        sceneTrack.style.transition = animate ? 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        sceneTrack.style.transform = `translateX(${-i * step()}px)`;
      };
      const go = (dir) => {
        if (busy) return;
        busy = true;
        i += dir;
        move(true);
        window.setTimeout(() => {
          if (i < start) i += N;
          else if (i > start + N - 1) i -= N;
          move(false);
          busy = false;
        }, 570);
      };

      const prev = document.querySelector('.sk-car-btn--prev');
      const next = document.querySelector('.sk-car-btn--next');
      if (prev) prev.addEventListener('click', () => go(-1));
      if (next) next.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!busy) move(false); });

      // Keyboard, so the control is not mouse-only.
      const ctl = document.querySelector('.sk-car-ctl');
      if (ctl) {
        ctl.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') go(-1);
          if (e.key === 'ArrowRight') go(1);
        });
      }
    }
  }

  // One answer open at a time.
  const faqItems = Array.from(document.querySelectorAll('.sk-faq-grid details'));
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) faqItems.forEach((o) => { if (o !== d) o.open = false; });
    });
  });
</script>
