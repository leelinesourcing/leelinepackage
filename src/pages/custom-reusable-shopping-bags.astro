<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Scenes carousel. Three slides per view on desktop, one on mobile. The track
  // holds the six real slides plus CLONES copies of the first three, so stepping
  // past the last real slide lands on an identical-looking clone; once the
  // transition finishes the track is snapped back with no transition, which is
  // what makes the wrap read as a loop rather than a jump.
  const track = document.getElementById('rs-scenes-track');
  const viewport = track && track.parentElement;
  if (track && viewport) {
    const realSlides = Array.from(track.children);
    const CLONES = 3;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (let i = 0; i < CLONES; i++) {
      const clone = realSlides[i].cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    }

    const slides = Array.from(track.children);
    const total = realSlides.length;
    let index = 0;
    let step = 0;

    const measure = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      step = slides[0].getBoundingClientRect().width + gap;
    };

    const paint = (animate) => {
      track.style.transition = animate && !reduce ? '' : 'none';
      track.style.transform = `translate3d(${-index * step}px, 0, 0)`;
    };

    const advance = (dir) => {
      // stepping backwards off the front: hop to the clone block first, unseen
      if (dir < 0 && index === 0) {
        index = total;
        paint(false);
        void track.offsetWidth;
      }
      index += dir;
      paint(true);
    };

    track.addEventListener('transitionend', (e) => {
      if (e.propertyName !== 'transform') return;
      if (index >= total) { index -= total; paint(false); }
    });

    Array.from(viewport.parentElement.querySelectorAll('.rs-scenes-btn')).forEach((btn) => {
      btn.addEventListener('click', () => advance(Number(btn.dataset.step)));
    });

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => { measure(); paint(false); }, 140);
    });

    measure();
    paint(false);
  }

  // One FAQ open at a time — the list sits in a narrow column, so two open
  // answers push the page instead of reading as a set.
  const faqItems = Array.from(document.querySelectorAll('.rs-faq-list details'));
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      faqItems.forEach((o) => { if (o !== d) o.open = false; });
    });
  });
</script>
