  .mb-sc-slide { flex: 0 0 calc((100% - 2 * var(--sg)) / 3); aspect-ratio: 1376 / 768; margin: 0; border-radius: 1.2rem; overflow: hidden; background: var(--color-clay); }

  /* ============ REVIEWS — speech-bubble carousel ============ */
  /* Geometry mirrors the reference (a bordered speech bubble with the rating riding its
     top edge and a tail at the bottom right, then a 138px round portrait with two
     hand-drawn accent marks). The colors are ours: forest border, brass stars. */
  .mb-rev { background: var(--color-clay); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .mb-tm { position: relative; }
  .mb-tm-vp { overflow: hidden; }
  .mb-tm-track { display: flex; }
  /* one slide per view; the horizontal padding is what narrows the bubble, exactly as the
