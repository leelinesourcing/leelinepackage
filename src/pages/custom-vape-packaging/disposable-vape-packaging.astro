---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const DP = `${R2}/custom-disposable-vape`;

/* Shared bits kept as strings so fifteen eyebrows do not repeat the same 180-character path. */
const LEAF = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
const ARROW = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';

/*
  ⚠️ Every photograph on this page is a LABELLED PLACEHOLDER. The client supplies the shots later;
  each `dp-ph` figure names the image it is waiting for and carries the R2 key it should land on
  (`custom-disposable-vape/<key>.webp`). Swapping one in = replacing that <figure> with the plain
  <img src={`${DP}/<key>.webp`} …> form used site-wide.
  ⚠️ The two dark bands are GRADIENTS, not photograph backgrounds, so nothing 404s before the
  folder arrives. The hero plate is an <img>-shaped slot in normal flow, NOT a CSS background, so
  <Layout> is deliberately NOT passed a `preloadImage`; when the real plate lands it takes
  `loading="eager" fetchpriority="high" decoding="sync"` in place of this figure.
  ⚠️ 9 keys: hero-pens · pen-short · pen-standard · pen-long · pen-multi · shelf-retail ·
  mail-outer · avatar-01 · avatar-02. */

/* ⚠️ There is NO figure / stat row on this page. The parent and the cartridge page both run a
   `500 · 24 h · 3–5 d` row; the client first called a copy of it 偷懒, then ruled the whole device out
   (去掉数据条吧，感觉不是很合适). The hero closes on its CTA, and §2 opens the argument. */

/* ── §Four Pen Lengths, Four Cartons — the page's spine. `from`/`to` place each class on the
   shared 92–172 mm rail (a real scale, so the four bands read against one another).
   ⚠️ `fill` is the capacity that lands in the band — the buyer's own word, and the only place on
   the page it appears. Two bands share `10 ml`, which is the honest part: one capacity is built
   at more than one length. ⚠️ REFERENCE bands only, the cavity is drawn to the pen that arrives,
   never to a chart (client: 容量不要写死). ───────────────────────────────────────────────── */
const lengths = [
  { n: '01', fill: '2 ml', name: 'Compact Pen', box: 'Slide Box', key: 'pen-short', iw: 889, ih: 573, shot: 'A compact pen in its printed slide box', len: '92–112 mm', from: 0, to: 0.25, mouth: 'Round tip', ships: 'Formed', avoid: 'A long or an extended pen' },
  { n: '02', fill: '5 ml', name: 'Standard Pen', box: 'Slide Box', key: 'pen-standard', iw: 1024, ih: 1024, shot: 'A standard pen in a slide box on a counter', len: '112–128 mm', from: 0.25, to: 0.45, mouth: 'Round or flat', ships: 'Formed', avoid: 'A compact pen' },
  { n: '03', fill: '10 ml', name: 'Long Pen', box: 'Tuck-End Carton', key: 'pen-long', iw: 1024, ih: 1024, shot: 'A long pen beside its flat printed carton', len: '128–150 mm', from: 0.45, to: 0.725, mouth: 'Flat whistle', ships: 'Flat', avoid: 'A two-millilitre compact' },
  { n: '04', fill: '10 ml', name: 'Extended Pen', box: 'Two-Piece Carton', key: 'pen-multi', iw: 1024, ih: 1024, shot: 'An extended pen in a two-piece lid-and-base carton', len: '150–172 mm', from: 0.725, to: 1, mouth: 'Flat, deep-set', ships: 'Flat', avoid: 'A five-millilitre standard' },
];

/* ── §Five Structures at a Glance — the page's ONE table. ⚠️ The `Window` row is the verdict row
   and it carries the brass pills; every other row is plain text. ───────────────────────────── */
const cmpCols = ['Slide box', 'Tuck-end carton', 'Lid and base', 'Sleeve and tray', 'Drawer'];
const cmpRows = [
  { label: 'Lock', v: ['Push-and-slide', 'Tab tuck', 'Friction lid', 'Lock on the sleeve', 'Push-button'] },
  { label: 'Cradle', v: ['A formed slot', 'A folded platform', 'A board collar', 'A tray of slots', 'A moulded tray'] },
  { label: 'Window', v: ['Body only', 'Body only', 'None', 'None', 'Body only'], pills: true },
  { label: 'Ships', v: ['Flat', 'Flat', 'Formed', 'Flat', 'Formed'] },
];

/* ── §The Window Stops Where the Mouthpiece Starts — the page's ONE drawn module. Three rules
   at display size, each answered by a part of the drawing above it. ────────────────────────── */
const rules = [
  { n: '01', t: 'Body only', d: 'The window is cut over the body and stops short of the mouthpiece. A mouthpiece handled through a hole is a hygiene claim the box cannot make.' },
  { n: '02', t: 'Button travel', d: 'The lid is relieved over the button. A snug panel presses it on the pallet, and a pen that fires in transit arrives warm, with a drained cell.' },
  { n: '03', t: 'Port clear', d: 'The charge port is left reachable or blanked behind a tear strip. Print over the port is re-inked every time the pen is topped up.' },
];

/* ── §One Carton for the Shelf, Another for the Mail — a fork off one pen. ─────────────────── */
const fork = [
  { tag: 'Shelf', name: 'The slim retail carton', key: 'shelf-retail', iw: 678, ih: 452, shot: 'A row of slim printed cartons on a shop shelf', d: 'A printed tuck-end or slide box, thin as the pen. The front face carries the flavour name and the strength, the window carries the pen, so the carton stands in a row of twenty without a display unit.' , note: 'Ships formed' },
  { tag: 'Direct post', name: 'The transit outer', key: 'mail-outer', iw: 829, ih: 370, shot: 'A slim carton packed inside a printed mailer', d: 'The retail carton, dropped inside an outer drawn around it rather than around the pen. The outer takes the sorting machinery, and the retail carton arrives uncreased.' , note: 'Ships flat' },
];

/* ── §Four Ways a Pen Box Fails ────────────────────────────────────────────────────────────── */
const fails = [
  { n: '01', h: 'A window over the mouthpiece', d: 'The tip a buyer puts to their lips has been touched through an opening. It reads as a defect before the print does.' },
  { n: '02', h: 'A cavity a size too long', d: 'The pen slides, the seal takes the knock, and the carton is opened with a rattle that says the box was not drawn for it.' },
  { n: '03', h: 'A lid that presses the fire button', d: 'A tight panel with no relief sits on the button for a week in a warehouse and the pens arrive warm and half-drained.' },
  { n: '04', h: 'A charge port under the print', d: 'The port sits behind the front panel, and the buyer tears the artwork to reach it on the first top-up.' },
];

/* ── §What Buyers Told Us ───────────────────────────────────────────────────────────────────
   ⚠️ DRAFT placeholders: a name, a role and a market, and still NO invented company.
   ⚠️⚠️ The NAMES are the one thing on this page that must be replaced before launch — an unnamed
   "Buyer" reads as a placeholder, a named one is a claim about a real person, who has to have given
   permission. Same standing as the avatar photographs.
   ⚠️ The client has rejected this block THREE times, so hold the rules in `page-design-rules.md`
   §THE CUSTOMER-REVIEWS SECTION and re-run the mechanical check after ANY edit:
   eight paragraphs carry eight DIFFERENT moves (a crease it fixed · the routine · a bare count ·
   the freight · the brief met · the artwork · the season · the deadline); eight different opening
   words; ONE figure per paragraph, and no figure appears twice anywhere in the block; no
   `which is` tail, no em dash for effect, no generic praise. ──────────────────────────────── */
const reviews = [
  {
    key: 'avatar-01', name: 'Lukas Brandt', role: 'Buyer, online vape shop', loc: 'Germany',
    q: [
      'The first run sent back 200 cartons cracked along the fold, so we sent photographs and the die was scored deeper on the next pass.',
      'Adding a variant costs a new front panel and nothing else. 14 of them run on the same carton size today.',
      'Our last reorder was 46,000 pens, drawn on the dieline we signed in the spring.',
      'Freight is where our margin lives, and the cartons went out on 7 pallets.',
    ],
  },
  {
    key: 'avatar-02', name: 'Nadia Ferrer', role: 'Buyer, convenience chain', loc: 'United States',
    q: [
      'Shelf space was the whole brief: the carton had to stand in a 55 mm channel and hold its place without a display unit.',
      'Registration is what our team checks first, and the 2 spot inks have matched the chip we signed every time since.',
      'Spring is our busiest stretch, and 9 cartons went out on one date with the whole order behind them.',
      'We put a hard date on the autumn drop, and the order cleared the port 11 days ahead of it.',
    ],
  },
];

/* ── §Common Questions — a <details> accordion. The FAQPage JSON-LD is generated from THIS array,
   so every edit here moves the schema with it.
   ⚠️ Every question must be one NO SECTION answers. Capacity→length, the five structures, the
   three panel clearances, retail against the mailer, the four failure modes and the reprint are all
   already on the page (and §Pack Count was cut as a duplicate of the cartridge page's count
   section), so asking any of them here is the page repeating itself. What is left is the commercial
   layer: order size, sampling, lead time, certification, artwork. ───────────────────────────── */
const faqs = [
  { q: 'What is the smallest order for a pen carton?', a: '500 units. A mixed order of a slide box and a tuck-end carton counts against the same 500, so a first run can test two structures at once.' },
  { q: 'How long does a sample take?', a: 'A white dummy lands in 3–5 days to check the fit and the stop line. A printed dummy follows in 7–10 days once the artwork is signed off, and that one fixes the color.' },
  { q: 'How long until the bulk order ships?', a: 'Four to six weeks from the signed printed dummy, covering printing, die-cutting and gluing. The window is quoted with the sample rather than after the order.' },
  { q: 'Can the carton be built child-resistant?', a: 'The structure is available, and a test report is arranged on request rather than claimed on this page. The closure is drawn to defeat a small hand, and the report travels with the sample.' },
  { q: 'Who provides the artwork for the flavour and the strength?', a: 'The brand supplies the words, and the panel is drawn here to hold them at the size that market prints at. The proof is signed before the printed dummy is cut.' },
  { q: 'Does a multi-pack need its own dieline?', a: 'Yes. A tray for five is not a box cut wider. Every count moves the slot pitch, the fold and the sleeve depth, so each count is quoted as its own cut file.' },
];

const seo = {
  title: 'Custom Disposable Vape Packaging: 500-Unit Runs, 24h Dieline',
  description: "Custom disposable vape packaging drawn to your pen's length and mouthpiece. Slim tuck-end, slide and lid-and-base cartons from 500 units, a dieline in 24 hours.",
  keywords: 'custom disposable vape packaging, disposable vape boxes, custom disposable vape boxes, slim disposable vape boxes, all-in-one vape packaging, disposable vape tuck boxes, multi pack disposable vape boxes, long disposable vape boxes',
  canonical: 'https://www.leelinepackage.com/custom-vape-packaging/disposable-vape-packaging/',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Disposable Vape Packaging Manufacturing',
      description: seo.description,
      serviceType: 'Custom disposable vape packaging design, structural engineering and manufacturing',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Custom Vape Packaging', item: 'https://www.leelinepackage.com/custom-vape-packaging/' },
        { '@type': 'ListItem', position: 3, name: 'Disposable Vape Packaging' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  preloadImage={`${DP}/hero-pens.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ 1 · HERO — full-bleed background, CENTRED pitch ============
         The client's call, after four rejected passes: 就居中然后背景图. So this is the site's own
         approved hero language — the homepage's dark photographic band — centred white type over a
         full-bleed ground with a brass glow and a scrim.
         ⚠️ The photograph is the FULL-BLEED BACKGROUND, never a separate slot, so while the shot is
         pending there is no empty placeholder box — only this gradient. Swapping the photo in:
         `background: linear-gradient(scrim), url('${DP}/hero-pens.webp') center/cover`, then pass
         `preloadImage` to <Layout> like the homepage does (${DP}/hero-pens.webp is the key).
         ⚠️ The hero closes on the CTA — no figure row, no cert trail (see the note above
         `const seo`). The dark ground runs straight into §2's ivory band. -->
    <section class="dp-hero">
      <div class="dp-hero-bg" aria-hidden="true"></div>
      <div class="dp-hero-grade" aria-hidden="true"></div>
      <div class="dp-hero-grain" aria-hidden="true"></div>
      <div class="wrap dp-hero-in">
        <span class="eyebrow eyebrow--light" set:html={`${LEAF}Disposable vape packaging`}></span>
        <h1 class="dp-hero-title" data-reveal="up">Custom Disposable Vape Packaging With a 3 mm Mouthpiece Clearance, <em>Cut to the Pen</em></h1>
        <p class="dp-hero-sub" data-reveal="up">The button face gets a 2 mm relief, so the switch does not fire in the box. A new pen length means a new die.</p>
        <div class="dp-hero-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">Price a Disposable Vape Box <Fragment set:html={ARROW} /></a>
        </div>
      </div>
    </section>

    <!-- ============ 2 · FOUR PEN LENGTHS, FOUR CARTONS (ivory) — the spine ============
         Four STACKED wide cards, not a flat grid (the parent's is a 3×3 of type cards) and not a
         numbered row list (the cartridge page's). The left rail is a real millimetre scale with the
         card's own class marked on it, so the composition carries the length data.
         ⚠️ Each card also carries the CAPACITY that lands in its band. The section that used to sit
         above this one drew the same 92–172 mm axis a second time and repeated the four class
         names, so it was folded in here instead. -->
    <section class="dp-len">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow" set:html={`${LEAF}Pen lengths`}></span>
          <h2 class="section-title" data-reveal="up">Four Pen Lengths, <em>Four Cartons</em></h2>
          <p class="section-sub" data-reveal="up">Capacity is the first decision a brand makes, and it sets the pen's length class. Each band on the rail below is its own die, and a pen that lands between two takes a fifth, drawn the day the pen arrives.</p>
        </div>
        <div class="dp-len-rows">
          {lengths.map((c) => (
            <article class="dp-len-row" data-reveal="up">
              <div class="dp-len-rail" aria-hidden="true">
                <span class="dp-len-track"><span class="dp-len-band" style={`--from:${c.from}; --to:${c.to}`}></span></span>
                <span class="dp-len-tick">{c.len}</span>
              </div>
              <figure class="dp-len-ph">
                <img src={`${DP}/${c.key}.webp`} alt={c.shot} width={c.iw} height={c.ih} loading="lazy" decoding="async" />
              </figure>
              <div class="dp-len-body">
                <div class="dp-len-top">
                  <span class="dp-len-n">{c.n}</span>
                  <span class="dp-len-fill">{c.fill}</span>
                </div>
                <h3 class="dp-len-title">{c.name} <em>{c.box}</em></h3>
                <dl class="dp-len-spec">
                  <div><dt>Length</dt><dd>{c.len}</dd></div>
                  <div><dt>Mouthpiece</dt><dd>{c.mouth}</dd></div>
                  <div><dt>Ships</dt><dd>{c.ships}</dd></div>
                  <div class="dp-len-no"><dt>Not for</dt><dd>{c.avoid}</dd></div>
                </dl>
              </div>
            </article>
          ))}
        </div>
        <p class="dp-note" data-reveal="up"><strong>The capacities are the brand's to choose; the carton follows the pen.</strong> These are the usual landing zones for each fill, not a specification — a 10 ml pen from one brand runs two centimetres shorter than another's. Send in the pen, and the cavity is cut to it.</p>
      </div>
    </section>

    <!-- ============ 3 · FIVE STRUCTURES (clay) — the page's ONE table ============
         ⚠️ Dark header band + sticky label column, the two things neither sibling's table runs
         (the parent's is a plain grid, the cartridge page's header is a light ivory strip). The
         Window row keeps its brass pills and reads as a verdict. -->
    <section class="dp-tbl">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow" set:html={`${LEAF}Structures`}></span>
          <h2 class="section-title" data-reveal="up">Five Carton Structures, <em>Compared</em></h2>
          <p class="section-sub" data-reveal="up">Five cartons cover a disposable order. They are compared on the four points a buyer asks about — how it locks, what holds the pen, where the window sits, and what it costs to ship.</p>
        </div>
        <div class="dp-tbl-rail" data-reveal="up">
          <div class="dp-tbl-track" style={`grid-template-columns: 150px repeat(${cmpCols.length}, minmax(116px, 1fr));`}>
            <p class="dp-tbl-head dp-tbl-corner" aria-hidden="true"></p>
            {cmpCols.map((c, i) => (
              <p class="dp-tbl-head"><span class="dp-tbl-idx">{String(i + 1).padStart(2, '0')}</span>{c}</p>
            ))}
            {cmpRows.map((r) => (
              <>
                <p class="dp-tbl-label">{r.label}</p>
                {r.v.map((val) => (
                  <p class={`dp-tbl-cell${r.pills ? ' dp-tbl-cell--pill' : ''}`}>
                    {r.pills ? <span class="dp-tbl-pill">{val}</span> : val}
                  </p>
                ))}
              </>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 4 · MID CTA (dark gradient) ============ -->
    <section class="dp-midcta">
      <div class="wrap dp-midcta-inner">
        <h2 class="dp-midcta-title" data-reveal="up">Send the Pen, <em>Get the Carton</em></h2>
        <p class="dp-midcta-sub" data-reveal="up">A pen in the post, or its length and mouthpiece on a drawing, is enough to begin. The quote is then built on the carton that comes back.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">Book a Sample <Fragment set:html={ARROW} /></a>
        </div>
      </div>
    </section>

    <!-- ============ 5 · THE WINDOW STOPS (DARK) — the page's ONE drawn module ============
         ⚠️ The page's dark centre of gravity. The parent page has no drawing; the cartridge
         page's is a to-scale dimension sketch of two carts. This one is an ANNOTATED anatomy of
         one pen INSIDE its carton panel — the board is drawn, not just the pen, because this is a
         packaging page and every rule below is a rule about the board, never about the device. -->
    <section class="dp-anat">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow eyebrow--light" set:html={`${LEAF}Pen anatomy`}></span>
          <h2 class="section-title dp-anat-title" data-reveal="up">Where the Window <em>Can Be Cut</em></h2>
          <p class="dp-anat-lead" data-reveal="up">A single pen, drawn side-on. Three of the four faults a disposable carton has come from a panel that touches a part it should not, and all three are decided in the dieline before any artwork is drawn.</p>
        </div>
        <div class="dp-anat-grid">
          <figure class="dp-anat-fig" data-reveal="up" role="img" aria-label="A disposable pen drawn side-on inside its carton panel. The carton is drawn as a rounded rectangle with a fold line at each end, and the window is cut over the pen's body only, stopping at a marked line before the mouthpiece. A button sits on the top of the body and a charge port sits at the closed end.">
            <svg class="dp-an" viewBox="0 0 900 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <pattern id="dpHatch" width="10" height="10" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                  <line x1="0" y1="0" x2="0" y2="10" stroke="var(--brass-bright)" stroke-width="2.4" opacity="0.5" />
                </pattern>
              </defs>
              <rect class="dp-an-panel" x="128" y="92" width="696" height="130" rx="14" />
              <line class="dp-an-fold" x1="142" y1="92" x2="142" y2="222" />
              <line class="dp-an-fold" x1="810" y1="92" x2="810" y2="222" />
              <rect class="dp-an-port" x="152" y="142" width="18" height="40" rx="4" />
              <rect class="dp-an-body" x="170" y="130" width="540" height="64" rx="14" />
              <rect class="dp-an-win" x="204" y="130" width="320" height="64" rx="10" />
              <rect class="dp-an-mouth" x="710" y="144" width="86" height="36" rx="10" />
              <rect class="dp-an-btn" x="352" y="110" width="44" height="20" rx="7" />
              <line class="dp-an-stop" x1="660" y1="96" x2="660" y2="232" />
              <line class="dp-an-lead" x1="161" y1="182" x2="161" y2="238" />
              <line class="dp-an-lead" x1="374" y1="110" x2="374" y2="88" />
              <line class="dp-an-lead" x1="660" y1="232" x2="660" y2="246" />
              <line class="dp-an-lead" x1="753" y1="180" x2="753" y2="238" />
              <line class="dp-an-lead" x1="300" y1="222" x2="300" y2="238" />
              <text class="dp-an-txt" x="364" y="167" text-anchor="middle">window zone</text>
              <text class="dp-an-lab" x="300" y="256" text-anchor="middle">carton panel</text>
              <text class="dp-an-lab" x="161" y="256" text-anchor="middle">charge port</text>
              <text class="dp-an-lab" x="374" y="80" text-anchor="middle">button</text>
              <text class="dp-an-lab dp-an-lab--stop" x="660" y="256" text-anchor="middle">stop line</text>
              <text class="dp-an-lab" x="753" y="256" text-anchor="middle">mouthpiece</text>
            </svg>
          </figure>
          <ul class="dp-rules">
            {rules.map((r, i) => (
              <li data-reveal="up" style={`--d:${i * 0.09}s`}>
                <span class="dp-rule-n">{r.n}</span>
                <strong class="dp-rule-t">{r.t}</strong>
                <p>{r.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ 6 · ONE CARTON FOR THE SHELF, ANOTHER FOR THE MAIL (ivory) ============ -->
    <section class="dp-fork-sec">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow" set:html={`${LEAF}Two journeys`}></span>
          <h2 class="section-title" data-reveal="up">The Shelf Carton <em>and the Mailer</em></h2>
          <p class="section-sub" data-reveal="up">The same sealed pen ships two ways. They are two cartons, not a single box asked to do both jobs — and the outer is sized to the carton inside it, never to the pen.</p>
        </div>
        <div class="dp-fork">
          <ul class="dp-fork-arms">
            {fork.map((a, i) => (
              <li class="dp-fork-arm" data-reveal="up" style={`--d:${i * 0.1}s`}>
                <span class="dp-fork-tag">{a.tag}</span>
                <h3 class="dp-fork-name">{a.name}</h3>
                <figure class="dp-fork-ph">
                  <img src={`${DP}/${a.key}.webp`} alt={a.shot} width={a.iw} height={a.ih} loading="lazy" decoding="async" />
                </figure>
                <p class="dp-fork-d">{a.d}</p>
                <span class="dp-fork-note">{a.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ 7 · FOUR WAYS A PEN BOX FAILS (ivory) ============ -->
    <section class="dp-fail-sec">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow" set:html={`${LEAF}What goes wrong`}></span>
          <h2 class="section-title" data-reveal="up">Four Ways <em>These Boxes Fail</em></h2>
          <p class="section-sub" data-reveal="up">All four are caught by a line in the dieline rather than by a stricter inspection, and they are worth naming before the first sample is cut.</p>
        </div>
        <ul class="dp-fail">
          {fails.map((f, i) => (
            <li data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="dp-fail-n" aria-hidden="true">{f.n}</span>
              <h3>{f.h}</h3>
              <p>{f.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 8 · WHAT BUYERS SAY (clay) ============ -->
    <section class="dp-say-sec">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow" set:html={`${LEAF}Customer voices`}></span>
          <h2 class="section-title" data-reveal="up">What Buyers <em>Told Us</em></h2>
        </div>
        <div class="dp-say-grid">
          {reviews.map((r, i) => (
            <blockquote class="dp-say" data-reveal="up" style={`--d:${i * 0.12}s`}>
              <div class="dp-say-body">
                {r.q.map((p) => <p>{p}</p>)}
              </div>
              <footer class="dp-say-who">
                <img class="dp-say-av" src={`${DP}/${r.key}.webp`} alt={`${r.name}, ${r.role} in ${r.loc}`} width={248} height={248} loading="lazy" decoding="async" />
                <div class="dp-say-id">
                  <strong>{r.name}</strong>
                  <span>{r.role} · {r.loc}</span>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 9 · COMMON QUESTIONS (ivory) — a <details> accordion ============ -->
    <section class="dp-faq">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow" set:html={`${LEAF}FAQ`}></span>
          <h2 class="section-title" data-reveal="up">Common Questions, <em>Before You Order</em></h2>
        </div>
        <div class="dp-qa">
          {faqs.map((f, i) => (
            <details class="dp-qa-item" data-reveal="up" style={`--d:${i * 0.05}s`} open={i === 0}>
              <summary class="dp-qa-q"><span class="dp-qa-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{f.q}</summary>
              <p class="dp-qa-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 10 · FINAL CTA (dark gradient) ============ -->
    <section class="dp-final">
      <div class="wrap dp-final-inner">
        <span class="eyebrow eyebrow--light" set:html={`${LEAF}Start here`}></span>
        <h2 class="dp-final-title" data-reveal="up">One Dieline, <em>Every Reprint</em></h2>
        <p class="dp-final-sub" data-reveal="up">The dieline stays on file, and the tenth run of a pen carton lands on the shelf identical to the sample that was signed — same window position, same stop line, same color.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">Start From the Dieline <Fragment set:html={ARROW} /></a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ REVEAL (declared first so later hover transforms win) ============ */
  [data-reveal] { opacity: 0; transform: translateY(36px); transition: opacity 0.8s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1); transition-delay: var(--d, 0s); }
  [data-reveal='right'] { transform: translateX(48px); }
  [data-reveal='left'] { transform: translateX(-48px); }
  [data-reveal].in { opacity: 1; transform: none; }

  /* ============ shared ============ */
