---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev';

const IMG = {
  heroMobile: `${R2}/structural/structural-hero-760.webp`,
  heroDesktop: `${R2}/structural/structural-hero-1200.webp`,
  logo: `${R2}/image-01.webp`,
  processRequirements: `${R2}/structural/process-requirements.webp`,
  processDesign: `${R2}/structural/process-design.webp`,
  processValidation: `${R2}/structural/process-validation.webp`,
  capabilitySturdy: `${R2}/structural/capability-sturdy.webp`,
  capabilityInnovative: `${R2}/structural/capability-innovative.webp`,
  capabilityCost: `${R2}/structural/capability-cost.webp`,
  capabilityStorage: `${R2}/structural/capability-storage.webp`,
  capabilitySustainable: `${R2}/structural/capability-sustainable.webp`,
  capabilityBrand: `${R2}/structural/capability-brand.webp`,
  exampleDisplay: `${R2}/structural/example-display.webp`,
  exampleRigid: `${R2}/structural/example-rigid.webp`,
  exampleMailer: `${R2}/structural/example-mailer.webp`,
  exampleCarton: `${R2}/structural/example-carton.webp`,
  serviceArtwork: `${R2}/structural/service-artwork.webp`,
  servicePrinting: `${R2}/structural/service-printing.webp`,
  avPriya: `${R2}/testimonial-priya.webp`,
  avCallum: `${R2}/testimonial-callum.webp`,
};

const steps = [
  {
    num: '01', title: 'Communication of Product Requirements', img: IMG.processRequirements,
    body: 'We capture the product\u2019s dimensions, fragility, budget and distribution needs \u2014 so custom packaging fits your item perfectly instead of leaving dead space that costs you freight.',
    meta: 'Mostly 1 day',
  },
  {
    num: '02', title: 'Design and Production', img: IMG.processDesign,
    body: 'Countless structural variations \u2014 standard corrugated or premium specialty boards, eco-friendly materials, and your brand colours, fonts and visuals. Flat-pack optimized to cut dimensional weight.',
    meta: '2\u20137 days',
  },
  {
    num: '03', title: 'Validation and Testing', img: IMG.processValidation,
    body: 'A physical prototype to your door, then drop, vibration and compression testing (ISTA) so products arrive safe. Real-time package tracking with status reports at every checkpoint.',
    meta: 'Samples 3\u201310 days',
  },
];

const capabilities = [
  { title: 'Sturdy Protection', img: IMG.capabilitySturdy, body: 'Structures that absorb impact and prevent product movement, so items arrive intact and your returns from damage drop to near zero.' },
  { title: 'Innovative Designs', img: IMG.capabilityInnovative, body: 'No-limit custom packaging gives your products unlimited style options that make the brand stand out on crowded shelves.' },
  { title: 'Cost Reduction', img: IMG.capabilityCost, body: 'Precise dielines eliminate unnecessary space and material \u2014 reduce waste and cut freight without compromising protection.' },
  { title: 'Storage & Shipping Efficiency', img: IMG.capabilityStorage, body: 'Personalized compartments keep items organized, and flat-pack geometry shrinks stored volume and dimensional weight.' },
  { title: 'Sustainable Solutions', img: IMG.capabilitySustainable, body: 'Safe, eco-friendly materials and FSC-certified board that lower your carbon footprint and strengthen the sustainability story.' },
  { title: 'Brand Experience Enhancement', img: IMG.capabilityBrand, body: 'Thoughtfully engineered unboxing that raises perceived product value and turns buyers into advocates who share the moment.' },
];

const examples = [
  { title: 'Custom inserts & display', img: IMG.exampleDisplay, tag: 'Display box' },
  { title: 'Rigid gift boxes \u2014 window + ribbon', img: IMG.exampleRigid, tag: 'Rigid box' },
  { title: 'Corrugated mailer \u2014 flat-pack & recycled', img: IMG.exampleMailer, tag: 'Mailer' },
  { title: 'Folding cartons & display boxes', img: IMG.exampleCarton, tag: 'Carton' },
];

const otherServices = [
  { title: 'Artwork Designs', img: IMG.serviceArtwork, body: 'Print artwork on strong surfaces for a smooth brand story \u2014 Pantone colours, variable data, eco-friendly inks, tactile textures and QR codes that turn buyers into advocates.' },
  { title: 'Printing & Samples', img: IMG.servicePrinting, body: 'Flexographic, litho and digital printing with run-to-run colour consistency, plus white-dummy and printed samples before you commit to a run.' },
];

const faqs = [
  { q: 'Can you create custom structural designs for any product?', a: 'Yes. We design packaging for virtually any product type or size, with cost varying by complexity. Give us the product and our engineers draw the dieline around it.' },
  { q: 'What materials do you use for packaging structural engineering?', a: 'Corrugated, paperboard, rigid board, kraft and more sustainable alternatives \u2014 all FSC-certified options available. We match the board or film to the protection your product needs.' },
  { q: 'How long does the structural design process take?', a: 'Typically 1\u20133 weeks from consultation to final design approval, depending on complexity. You receive a digital 3D mockup within 24 hours of the brief.' },
  { q: 'Do you provide prototypes before final production?', a: 'Yes. Samples are provided after the packaging solution is designed, so you can test and adjust before full production. White dummies in 3\u20135 days, printed samples in 7\u201310 days.' },
  { q: 'What is the minimum order quantity?', a: 'MOQ starts from 500 units, with volume-tiered pricing breaks at 1k, 5k and 10k. Samples and 3D mockups are available before you commit to a run.' },
];

const testimonials = [
  {
    quote: [
      "Our subscription runs on a 43-piece monthly box, so fit and freight matter. We switched our mailer to a custom size and watched dimensional weight drop 28% in the first quarter - that alone paid for the redesign.",
      "The 99.5% on-time delivery rate is real. Across six seasonal launches we have had one late shipment, and that was a carrier issue, not the box team. White-dummy samples arrived in four days, and digital mockups were in our inbox the same day.",
      "The inside-print detail is what our subscribers photograph. Unboxing shares on our gift sets went up 2.4x the month we launched, and returns from damaged goods fell to nearly zero. We keep reordering the same spec."
    ],
    name: 'Priya Mehta', role: 'Operations Director', country: 'United States', industry: 'Subscription Boxes', initials: 'PM', avatar: IMG.avPriya,
  },
  {
    quote: [
      "We briefed a new flat-pouch range for our coffee line - matte finish, our logo, an exact Pantone match. Their team fixed a low-res file before we noticed, and the first physical sample matched the on-screen proof to the shade.",
      "Print quality is the reason we stayed. Run-to-run colour consistency has held at 98% across four reorders of 12,000 units each, and the food-safe barrier keeps our beans at the freshness we measure.",
      "Lead time stayed at 7 business days even when we doubled the order mid-quarter. The pouch cost came in well under our Western quote. It is the rare supplier that is both cheap and precise."
    ],
    name: 'Callum Whitfield', role: 'Product Manager', country: 'Australia', industry: 'Specialty Coffee', initials: 'CW', avatar: IMG.avCallum,
  },
];

const stats = [
  { num: '500', suffix: '+', label: 'MOQ from, units', count: true },
  { num: '24', suffix: 'h', label: 'Digital 3D mockup', count: true },
  { num: '3–10', suffix: ' days', label: 'Sample turnaround', count: false },
  { num: '500', suffix: 'K+', label: 'Boxes shipped', count: true },
];

const seo = {
  title: 'Packaging Structural Engineering | MOQ 500, 24h 3D Mockups',
  description: 'Packaging structural engineering that cuts material cost and product damage. 3D mockups in 24h, samples in 3\u201310 days, ISO 9001 + FSC. Get a free quote.',
  keywords: 'packaging structural engineering, custom packaging design, packaging prototypes and samples, reduce packaging cost, sustainable packaging',
  canonical: 'https://www.leelinepackage.com/structural-engineering-and-design/',
  ogImage: `${R2}/structural/og-structural.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Packaging Structural Engineering',
      description: seo.description,
      serviceType: 'Custom packaging structural engineering and design',
      provider: {
        '@type': 'Organization',
        name: 'LeelinePackage',
        url: 'https://www.leelinepackage.com/',
        areaServed: 'Worldwide',
      },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '320' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.leelinepackage.com/structural-engineering-and-design/' },
        { '@type': 'ListItem', position: 3, name: 'Packaging Structural Engineering' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-rating">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span class="rating-text">4.9/5 from 320 reviews &middot; MOQ from 500</span>
        </div>
        <h1>Packaging Structural Engineering: <em>Protect the Product, Cut the Cost</em></h1>
        <p class="hero-sub">We engineer the box, not just print on it. Structural solutions that lower material costs and minimize product damage — packaging that protects in transit and looks exceptional on the shelf.</p>
        <div class="hero-cta">
          <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
            Get a Free Quote
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ul class="hero-spec">
          <li><span>500</span> MOQ from</li>
          <li><span>24h</span> 3D mockup</li>
          <li><span>3–10d</span> samples</li>
          <li><span>ISO 9001</span> + FSC</li>
        </ul>
      </div>
    </section>

    <!-- ============ STATS BAND ============ -->
    <section class="hero-stats" aria-label="Key figures">
      <div class="wrap hero-stats-row">
        {stats.map((s) => (
          <div class="hs-stat">{s.count
            ? <strong data-count={s.num} data-suffix={s.suffix}>0</strong>
            : <strong>{s.num}{s.suffix}</strong>}<span>{s.label}</span></div>
        ))}
      </div>
    </section>

    <!-- ============ WHY / INTRO ============ -->
    <section class="why-eng" id="why">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Structural Engineering</span>
          <h2 class="section-title" data-reveal="up">Boost your business with <em>packaging structural engineering</em>.</h2>
          <p class="section-sub" data-reveal="up">Your packaging should perform as relentlessly as your product. We engineer it to fit your items precisely, cut cost, and elevate the unboxing experience.</p>
        </div>
        <div class="feature-grid">
          <article class="feature" data-reveal="up">
            <span class="feature-num">01</span>
            <h3>Fit the product exactly</h3>
            <p>Custom dielines cut down extra space and lower shipping costs — packaging that matches the product&#8217;s footprint, not the other way round.</p>
          </article>
          <article class="feature" data-reveal="up">
            <span class="feature-num">02</span>
            <h3>Protect &amp; present</h3>
            <p>Highlight your product&#8217;s unique features while keeping it safe in transit and compelling on display.</p>
          </article>
          <article class="feature" data-reveal="up">
            <span class="feature-num">03</span>
            <h3>Built to your brief</h3>
            <p>Construction matched to your budget, timeline and distribution requirements — never a one-size-fits-all box.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section class="process" id="process">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>How It Works</span>
          <h2 class="section-title" data-reveal="up">From <em>brief to box</em>, in three moves.</h2>
          <p class="section-sub" data-reveal="up">No design files needed — send us the product and our engineers draw the dieline, pick the board and finish, and get a 3D mockup in your inbox within a day.</p>
        </div>
        <ol class="process-list">
          {steps.map((p, i) => (
            <li class="process-step" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="process-num">{p.num}</span>
              <img class="process-thumb" src={p.img} alt={p.title} loading="lazy" width="200" height="200" />
              <div class="process-info"><h3>{p.title}</h3><p>{p.body}</p></div>
              <span class="process-meta">{p.meta}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ CAPABILITIES / WHY CHOOSE ============ -->
    <section class="capabilities" id="capabilities">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Why Choose Us</span>
          <h2 class="section-title" data-reveal="up">Why choose our <em>structural engineering services</em>.</h2>
          <p class="section-sub" data-reveal="up">Every package design is unique, but a solid structural foundation is what elevates it — intelligent, custom solutions that protect your product with cost-effective, visually striking construction.</p>
        </div>
        <div class="cap-grid">
          {capabilities.map((c, i) => (
            <article class="cap-card" data-reveal={['up','scale','up','up','scale','up'][i % 6]} style={`--d:${(i % 3) * 0.1}s`}>
              <figure class="cap-media"><img src={c.img} alt={c.title} loading="lazy" width="530" height="420" /></figure>
              <div class="cap-body"><h3>{c.title}</h3><p>{c.body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ MATERIALS & FINISH ============ -->
    <section class="spec" id="materials">
      <div class="wrap spec-grid">
        <div class="spec-copy">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Materials &amp; Finishes</span>
          <h2 class="section-title" data-reveal="up">Any board. <em>Any finish.</em></h2>
          <p class="section-sub" data-reveal="up">We match the board, film and finish to the protection your product needs — without paying for weight you don&#8217;t use.</p>
          <div class="section-cta" data-reveal="up">
            <a class="btn btn-primary" href="/contact" target="_blank" rel="noopener">Get a Free Quote</a>
          </div>
        </div>
        <div class="spec-lists">
          <div class="spec-group">
            <h3>Materials</h3>
            <ul class="chips"><li>Corrugated</li><li>Paperboard</li><li>Rigid board</li><li>Kraft</li><li>FSC-certified eco</li></ul>
          </div>
          <div class="spec-group">
            <h3>Finishes &amp; print</h3>
            <ul class="chips"><li>CMYK / Pantone</li><li>Foil</li><li>Spot UV</li><li>Emboss / deboss</li><li>Recyclable &amp; compostable</li></ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROOF / TESTIMONIALS ============ -->
    <section class="proof" id="proof">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Real Results</span>
          <h2 class="section-title" data-reveal="up">Structures that inspire <em>lasting brand loyalty</em>.</h2>
          <p class="section-sub" data-reveal="up">Print quality and structural engineering only matter when they hold a run. Two operators on custom packaging tell the story better than we can.</p>
        </div>
        <div class="testimonials">
          {testimonials.map((t) => (
            <figure class="t-card" data-reveal="up">
              <svg class="t-mark" viewBox="0 0 30 22" aria-hidden="true"><path d="M0 22V13.2C0 6 3.9 1.7 10.6 0l1.5 3.2C7.9 4.8 6 7.3 5.9 10.4H11V22H0zm19 0V13.2C19 6 22.9 1.7 29.6 0l1.4 3.2C26.9 4.8 25 7.3 24.9 10.4H30V22H19z" fill="currentColor"/></svg>
              {t.quote.map((q) => <p key={q}>{q}</p>)}
              <figcaption class="t-author">
                <img class="t-avatar" src={t.avatar} alt="" width="74" height="74" loading="lazy" />
                <div class="t-meta"><strong>{t.name}</strong><span>{t.role} &middot; {t.industry} &middot; {t.country}</span></div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ EXAMPLES GALLERY ============ -->
    <section class="examples" id="examples">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>What We Engineer</span>
          <h2 class="section-title" data-reveal="up">Packaging, <em>engineered</em>.</h2>
          <p class="section-sub" data-reveal="up">A structural foundation for every product — from rigid keepsake boxes to flat-pack mailers that ship cheap and arrive intact.</p>
        </div>
        <div class="example-grid">
          {examples.map((e, i) => (
            <div class="example-card" data-reveal="up" style={`--d:${(i % 4) * 0.08}s`}>
              <figure class="example-media"><img src={e.img} alt={e.title} loading="lazy" width="800" height="700" /></figure>
              <div class="example-body">
                <span class="example-tag">{e.tag}</span>
                <h3>{e.title}</h3>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ OTHER SERVICES ============ -->
    <section class="other" id="other-services">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>More Design Services</span>
          <h2 class="section-title" data-reveal="up">Other <em>design services</em> we offer.</h2>
          <p class="section-sub" data-reveal="up">Structural engineering works hand-in-hand with artwork and print — so your packaging ships on-spec and reads on-brand.</p>
        </div>
        <div class="other-grid">
          {otherServices.map((s) => (
            <article class="other-card" data-reveal="up">
              <figure class="other-media"><img src={s.img} alt={s.title} loading="lazy" width="700" height="420" /></figure>
              <div class="other-body">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <a class="text-link" href="/contact" target="_blank" rel="noopener">Discuss your project <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>FAQ</span>
          <h2 class="section-title" data-reveal="up">Frequently asked <em>questions</em>.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item" data-reveal="up">
              <summary><span class="faq-num">Q</span>{f.q}</summary>
              <div class="faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA ============ -->
    <section class="cta cta--final" id="contact">
      <div class="cta-bg" aria-hidden="true"></div>
      <div class="cta-grain" aria-hidden="true"></div>
      <div class="wrap cta-inner">
        <h2 class="cta-title" data-reveal="up">Elevate your packaging game with <em>precision structural engineering</em> — reduce waste and boost durability in one click.</h2>
        <p class="cta-sub" data-reveal="up">Send us what you ship and the quantity — our engineers reply with a dieline, material and quote the same day. Prefer to see it first? We ship a physical sample kit before you commit to a run.</p>
        <div class="cta-actions" data-reveal="up">
          <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
            Get a Free Quote
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-light" href="/contact" target="_blank" rel="noopener">Request Your Sample Kit</a>
        </div>
      </div>
    </section>

    <Footer />

    <a class="back-to-top" href="#top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </main>
</Layout>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: min(88vh, 784px);
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    padding: clamp(8rem, 16vw, 11rem) 0 clamp(4rem, 8vw, 6rem);
    color: var(--ivory);
  }
  .hero-bg { position: absolute; inset: 0; z-index: 0; background: url('https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev/structural/structural-hero-760.webp') center / cover no-repeat; filter: brightness(1.12); }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: rgba(20, 38, 27, 0.48); }
  @media (min-width: 1025px) { .hero-bg { background-image: url('https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev/structural/structural-hero-1200.webp'); } }
  .hero-inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; transform: translateY(-1cm); }
  .hero-rating { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 1.05rem; border-radius: 999px; background: rgba(245, 240, 229, 0.12); border: 1px solid rgba(245, 240, 229, 0.25); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
