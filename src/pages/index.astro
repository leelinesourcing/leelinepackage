<Layout
  title="Custom Packaging Manufacturer | MOQ 500, 5-Day Samples, ISO 9001 | LeelinePackage"
  description="LeelinePackage is a custom packaging manufacturer in China — corrugated mailers, rigid gift boxes, folding cartons, pouches, labels & more. Factory-direct pricing, MOQ from 500, fast 3D mockups, FSC & ISO 9001. Get a free quote today."
  keywords={KEYWORDS}
  canonical="https://www.leelinepackage.com/"
  ogImage="https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev/image-06.avif"
  jsonLd={seoJsonLd}
>
  <style is:global>
    :root {
      --color-brand-primary:   #1F3B2C;
      --color-brand-secondary: #C9A87C;
      --color-brand-accent:    #B08D4C;
      --color-brand-bg:        #F5F0E5;
      --color-brand-surface:   #EDE5D4;
      --color-brand-text:      #21241C;
      --color-brand-muted:     #8C8676;
      --font-heading: 'Newsreader Variable', Georgia, serif;
      --font-body:    'Instrument Sans Variable', system-ui, sans-serif;
      --forest-deep: #14261B;
      --brass: #B08D4C;
      --brass-soft: #C9A87C;
      --ivory: #F5F0E5;
      --kraft: #EDE5D4;
    }

    html { scroll-behavior: smooth; }
    body { overflow-x: hidden; }
    body.menu-open { overflow: hidden; }

    ::selection { background: var(--brass-soft); color: var(--forest-deep); }

    /* Scroll-reveal (kept global so ancestors like html/body aren't scoped away).
       :where() zeroes the inner selector's specificity so hover transforms still win. */
    html.js :where([data-reveal]) {
      opacity: 0;
      transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.9s ease, clip-path 0.9s ease;
      transition-delay: var(--d, 0s);
    }
    html.js :where([data-reveal="up"]) { transform: translateY(36px); }
