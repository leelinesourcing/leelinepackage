---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev';

// Three services, one production path. Two child pages are still being built, so
// their CTA points to /contact (discuss) instead of a not-yet-existing URL.
const steps = [
  {
    num: '01',
    title: 'Structural engineering',
    tag: 'Dieline, board grade, insert & ship-test logic',
    body: 'Fit the product, cut air, and name the style before anyone draws a logo on it.',
    href: '/structural-engineering-design/',
    hrefLabel: 'Open structure page',
  },
  {
    num: '02',
    title: 'Artwork & prepress',
    tag: 'Layout on the real dieline',
    body: 'Bleed, safety, Pantone vs CMYK, foil/emboss plates. Files a press can run \u2014 not a mood board.',
    href: '/contact',
    hrefLabel: 'Start with artwork',
  },
  {
    num: '03',
    title: 'Sample & prototype',
    tag: 'White dummy for fit. Digital print for colour.',
    body: 'Production-grade proto when the spec is locked. Paid sample, credited on bulk.',
    href: '/contact',
    hrefLabel: 'Start with a sample',
  },
];

const delivers = [
  {
    num: '01',
    title: 'Structure',
    when: 'Use when the box does not exist yet, or the current pack wastes cube or fails in transit.',
    items: ['Style + dieline (PDF / AI)', 'Board / flute / rigid spec', 'Insert or partition if needed', 'Typical: 1\u20133 weeks to approved structure'],
  },
  {
    num: '02',
    title: 'Artwork',
    when: 'Use when the structure is chosen and you have a logo, or you need us to place it.',
    items: ['Print-ready artwork on dieline', 'Colour mode and finish map', '3D / flat proof before plate', 'Not a brand-identity agency brief'],
  },
  {
    num: '03',
    title: 'Sample',
    when: 'Use before any bulk PO. Pick the sample grade that matches the risk.',
    items: ['White dummy \u2014 fit & assembly', 'Digital print \u2014 colour & type', 'Production proto \u2014 line & transit', '3\u20137 days after files lock'],
  },
];

const handoffs = [
  { send: 'Product size / weight / photo, ship method, target cost', back: '1\u20132 structure options + dieline', then: 'Approve style \u2192 artwork' },
  { send: 'Logo (AI/PDF), fonts or outlined type, Pantone if you have it', back: 'Print proof on the real dieline', then: 'Approve colour \u2192 sample' },
  { send: 'Signed proof + sample type', back: 'Physical sample + notes (fit, colour, board)', then: 'Sign off \u2192 bulk quote' },
];

const fit = [
  {
    heading: 'A fit',
    items: ['Folding carton, mailer, rigid, paper bag, pouch', 'You can share a product or a reference pack', 'First run is a factory MOQ, not 1-piece POD'],
  },
  {
    heading: 'Not a fit',
    items: ['Fashion backpack / leather bag OEM', 'Unlimited free revisions with no brief', '\u201cFree finished sample, ship tomorrow\u201d'],
  },
  {
    heading: 'What we won\u2019t claim here',
    items: ['No \u201c#1 manufacturer\u201d / \u201c10,000+ brands\u201d on this page', 'No \u201cunlimited free revisions\u201d', 'Sample fee policy matches the quote page'],
  },
];

const seo = {
  title: 'How We Work: Structure, Artwork & Samples | LeelinePackage',
  description: 'Three packaging services, one production path: structural engineering, artwork & prepress, and samples. See what you send, what we return, and where each service fits.',
  keywords: 'custom packaging services, packaging structural engineering, packaging artwork design, packaging samples and prototypes, how we work',
  canonical: 'https://www.leelinepackage.com/services/',
  ogImage: `${R2}/structural/og-structural.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      name: 'LeelinePackage services',
      itemListElement: steps.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.title,
        url: s.href.startsWith('/structural') ? `https://www.leelinepackage.com${s.href}` : 'https://www.leelinepackage.com/contact/',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'How We Work' },
      ],
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO (split, distinct from home) ============ -->
    <header class="svc-hero">
      <div class="wrap svc-hero-grid">
        <div class="svc-hero-copy">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>How we work</span>
          <h1>Our <em>Services</em></h1>
          <p class="svc-hero-sub">Structure first. Artwork that prints. A sample you can refuse. Three services, one production path &mdash; engineer the pack, prep print-ready files, then a white dummy or printed proto before bulk.</p>
          <div class="svc-hero-cta">
            <a class="btn btn-gold" href="/contact">
              Start with a brief
              <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="btn btn-light" href="#path">See the path</a>
          </div>
        </div>

        <aside class="svc-hero-panel" aria-label="The production path">
          <p class="svc-panel-eyebrow">The path</p>
          <ol class="svc-panel-list">
            <li><span class="svc-panel-num">01</span> Structure</li>
            <li><span class="svc-panel-num">02</span> Artwork</li>
            <li><span class="svc-panel-num">03</span> Sample</li>
          </ol>
        </aside>
      </div>
    </header>

    <!-- ============ THE 3 SERVICES (path) ============ -->
    <section class="svc-path" id="path">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>The Path</span>
          <h2 class="section-title" data-reveal="up">Three services, <em>one production path</em>.</h2>
          <p class="section-sub" data-reveal="up">Start where you are. Every pack needs a structure before artwork, and a sample before bulk &mdash; but you never have to buy all three at once.</p>
        </div>

        <div class="svc-path-grid">
          {steps.map((s, i) => (
            <article class="svc-card" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <figure class="svc-card-media">
                <div class="svc-card-ph" aria-hidden="true">
                  <svg class="svc-card-ph-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8.5" cy="8.5" r="1.7" fill="currentColor"/><path d="M21 15.5 15.5 10 4.5 21" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                  <span class="svc-card-ph-text">Image placeholder</span>
                </div>
              </figure>
              <div class="svc-card-body">
                <span class="svc-card-step">{s.num}</span>
                <h3>{s.title}</h3>
                <p class="svc-card-tag">{s.tag}</p>
                <p class="svc-card-body-text">{s.body}</p>
                <a class="text-link" href={s.href} target="_blank" rel="noopener">{s.hrefLabel}
                  <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ WHAT EACH SERVICE DELIVERS ============ -->
    <section class="svc-delivers">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>What you get</span>
          <h2 class="section-title" data-reveal="up">What each service <em>actually delivers</em>.</h2>
          <p class="section-sub" data-reveal="up">A plain-language list of what actually lands in your hands at each step, so you know what &ldquo;done&rdquo; looks like before you commit.</p>
        </div>

        <div class="svc-deliver-grid">
          {delivers.map((d) => (
            <div class="svc-deliver" data-reveal="up">
              <span class="svc-deliver-num">{d.num}</span>
              <h3>{d.title}</h3>
              <p class="svc-deliver-when">{d.when}</p>
              <ul class="svc-deliver-list">
                {d.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ HANDOFF TABLE ============ -->
    <section class="svc-handoff">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Handoff</span>
          <h2 class="section-title" data-reveal="up">What you send, <em>what we return</em>.</h2>
          <p class="section-sub" data-reveal="up">A quick checklist of what we need from you at each step, and what you get back.</p>
        </div>

        <div class="svc-table-wrap" data-reveal="up">
          <table class="svc-table">
            <thead>
              <tr><th>You send</th><th>We return</th><th>Then</th></tr>
            </thead>
            <tbody>
              {handoffs.map((h) => (
                <tr>
                  <td>{h.send}</td>
                  <td>{h.back}</td>
                  <td>{h.then}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ FIT / NOT A FIT ============ -->
    <section class="svc-fit">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Fit check</span>
          <h2 class="section-title" data-reveal="up">Is this path <em>a fit for you</em>?</h2>
        </div>

        <div class="svc-fit-grid">
          {fit.map((f, i) => (
            <div class={`svc-fit-card svc-fit-card--${i}`} data-reveal="up">
              <h3>{f.heading}</h3>
              <ul>
                {f.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA ============ -->
    <section class="svc-cta">
      <div class="wrap svc-cta-inner">
        <h2 class="svc-cta-title" data-reveal="up">Send the product, <em>not a slogan</em>.</h2>
        <p class="svc-cta-sub" data-reveal="up">Quantity, destination, and either a dieline or a photo. We will tell you which of the three steps you still need.</p>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact">
            Get a production quote
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ HERO (split) ============ */
  .svc-hero {
    position: relative;
    background: linear-gradient(180deg, var(--forest-light) 0%, var(--color-forest) 100%);
    color: var(--ivory);
    padding: clamp(7rem, 14vw, 9.5rem) 0 clamp(4rem, 8vw, 6rem);
    overflow: hidden;
  }
  .svc-hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2.2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .svc-hero h1 {
    font-family: var(--font-heading); font-weight: 500;
    font-size: clamp(2.5rem, 6vw, 5rem); line-height: 0.98; letter-spacing: -0.03em;
    color: #FFFFFF; text-shadow: 0 2px 24px rgba(20, 38, 27, 0.4);
    margin: 1.3rem 0 0; max-width: 20ch; text-wrap: balance;
  }
  .svc-hero h1 em { font-style: italic; color: #E3C29A; }
  .svc-hero-sub { font-size: clamp(1.02rem, 1.6vw, 1.16rem); line-height: 1.7; color: rgba(255, 255, 255, 0.95); max-width: 46ch; margin: 1.5rem 0 0; text-shadow: 0 1px 18px rgba(20, 38, 27, 0.4); }
  .svc-hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }

  .svc-hero-panel {
    background: var(--forest-deep);
    border: 1px solid rgba(201, 168, 124, 0.3);
    border-radius: 1.6rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5);
  }
  .svc-panel-eyebrow { font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--brass-soft); margin: 0 0 1.4rem; }
  .svc-panel-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .svc-panel-list li { display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0; border-top: 1px solid rgba(245, 240, 229, 0.14); font-family: var(--font-heading); font-weight: 500; font-size: 1.7rem; color: var(--ivory); }
  .svc-panel-list li:first-child { border-top: 0; padding-top: 0; }
  .svc-panel-num { font-family: var(--font-body); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; color: var(--brass-bright); }

  /* ============ PATH (3 services) ============ */
  .svc-path { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .svc-path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.2rem); }
  .svc-card {
    display: flex; flex-direction: column;
    background: var(--color-brand-surface);
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.4rem; overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .svc-card:hover { transform: translateY(-6px); box-shadow: 0 26px 50px -20px rgba(31, 59, 44, 0.28); border-color: rgba(176, 141, 76, 0.55); }
  .svc-card-media { margin: 0; aspect-ratio: 14/9; overflow: hidden; background: var(--kraft); }
  .svc-card-ph {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem;
    height: 100%; margin: 12px; border: 1px dashed rgba(176, 141, 76, 0.4); border-radius: 0.8rem;
    color: var(--color-brand-muted);
  }
  .svc-card-ph-icon { width: 30px; height: 30px; color: var(--brass); opacity: 0.7; }
  .svc-card-ph-text { font-family: var(--font-body); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-brand-muted); }
  .svc-card-body { padding: clamp(1.4rem, 2.6vw, 1.9rem); display: flex; flex-direction: column; flex: 1; }
  .svc-card-step { font-family: var(--font-body); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; color: var(--brass); }
  .svc-card-body h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.5rem; letter-spacing: -0.01em; color: var(--color-brand-text); margin: 0.5rem 0 0; }
  .svc-card-tag { font-family: var(--font-heading); font-style: italic; font-size: 1.02rem; color: var(--brass); margin: 0.4rem 0 0; }
  .svc-card-body-text { font-size: 0.95rem; line-height: 1.65; color: var(--color-brand-muted); margin: 0.7rem 0 1.2rem; }
  .svc-card-body .text-link { margin-top: auto; }

  /* ============ DELIVERS ============ */
  .svc-delivers { background: var(--kraft); padding: clamp(4rem, 9vw, 8rem) 0; }
  .svc-deliver-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.2rem); }
  .svc-deliver { background: var(--color-brand-surface); border: 1px solid rgba(31, 59, 44, 0.1); border-radius: 1.4rem; padding: clamp(1.5rem, 3vw, 2rem); }
  .svc-deliver-num { font-family: var(--font-body); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; color: var(--brass); }
  .svc-deliver h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.5rem; color: var(--color-brand-text); margin: 0.5rem 0 0.7rem; }
  .svc-deliver-when { font-size: 0.95rem; line-height: 1.65; color: var(--color-brand-muted); margin: 0 0 1.2rem; }
  .svc-deliver-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .svc-deliver-list li { font-size: 0.9rem; line-height: 1.5; color: var(--color-brand-text); position: relative; padding-left: 1.3rem; }
  .svc-deliver-list li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 7px; height: 7px; border-radius: 50%; background: var(--brass); }

  /* ============ HANDOFF TABLE ============ */
  .svc-handoff { background: var(--ivory); padding: clamp(4rem, 9vw, 8rem) 0; }
  .svc-table-wrap { overflow-x: auto; }
  .svc-table {
    width: 100%; border-collapse: collapse;
    background: var(--color-brand-surface);
    border: 1px solid rgba(31, 59, 44, 0.12);
    border-radius: 1.2rem; overflow: hidden;
    font-size: 0.95rem;
  }
  .svc-table th, .svc-table td { text-align: left; padding: 1rem 1.2rem; border-bottom: 1px solid rgba(31, 59, 44, 0.1); vertical-align: top; }
  .svc-table th { font-family: var(--font-body); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-brand-muted); background: rgba(201, 168, 124, 0.12); }
  .svc-table td { color: var(--color-brand-text); }
  .svc-table tbody tr:last-child td { border-bottom: 0; }

  /* ============ FIT ============ */
  .svc-fit { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 8rem) 0; }
  .svc-fit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.2rem); max-width: 980px; margin-inline: auto; }
  .svc-fit-card { background: var(--ivory); border: 1px solid rgba(31, 59, 44, 0.1); border-radius: 1.4rem; padding: clamp(1.5rem, 3vw, 2rem); }
  .svc-fit-card--1 { border-left: 4px solid var(--clay); }
  .svc-fit-card--2 { border-left: 4px solid var(--brass); }
  .svc-fit-card h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.35rem; color: var(--color-brand-text); margin: 0 0 1rem; }
  .svc-fit-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .svc-fit-card li { font-size: 0.92rem; line-height: 1.55; color: var(--color-brand-muted); position: relative; padding-left: 1.3rem; }
  .svc-fit-card li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 7px; height: 7px; border-radius: 50%; background: var(--brass); }

  /* ============ FINAL CTA ============ */
  .svc-cta {
    position: relative;
    background: linear-gradient(180deg, var(--forest-light) 0%, var(--color-forest) 100%);
    color: var(--ivory); padding: clamp(4.5rem, 10vw, 8rem) 0; overflow: hidden;
  }
  .svc-cta-inner { text-align: center; position: relative; z-index: 1; }
  .svc-cta-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.3rem, 6vw, 4.4rem); line-height: 1; letter-spacing: -0.025em; color: #FFFFFF; text-shadow: 0 2px 24px rgba(20, 38, 27, 0.4); margin: 0; max-width: 20ch; margin-inline: auto; text-wrap: balance; }
  .svc-cta-title em { font-style: italic; color: #E3C29A; }
  .svc-cta-sub { font-size: 1.08rem; line-height: 1.7; color: rgba(255, 255, 255, 0.95); max-width: 52ch; margin: 1.4rem auto 0; text-shadow: 0 1px 18px rgba(20, 38, 27, 0.4); }

  /* ============ REVEAL ============ */
  [data-reveal] { opacity: 0; transform: translateY(36px); transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); transition-delay: var(--d, 0s); }
  [data-reveal].in { opacity: 1; transform: none; }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 900px) {
    .svc-hero-grid { grid-template-columns: 1fr; align-items: start; }
    .svc-path-grid, .svc-deliver-grid, .svc-fit-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .svc-hero-cta .btn { width: 100%; }
    .svc-panel-list li { font-size: 1.4rem; }
  }
</style>

<script>
  // Scroll reveal (respect reduced motion; fall back to visible if no IntersectionObserver)
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');

  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          revealIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }
</script>
