---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '../../lib/blog';
import '../../styles/blog.css';

const posts = await getPublishedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const pagePosts = posts.slice(0, POSTS_PER_PAGE);

const canonical = 'https://www.leelinepackage.com/blog/';
const seo = {
  title: 'LeelinePackage Insights & Guides: 122 Factory-Floor Articles',
  description:
    'Practical packaging guides from a working factory: materials, printing, structural design, shipping, QC. 122 articles, written by the people who make the packs.',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      name: 'LeelinePackage Insights & Guides',
      description: seo.description,
      url: canonical,
      publisher: {
        '@type': 'Organization',
        name: 'LeelinePackage',
        url: 'https://www.leelinepackage.com/',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog' },
      ],
    },
  ],
};
---
<Layout
  title={seo.title}
  description={seo.description}
  canonical={canonical}
  jsonLd={JSON.stringify(jsonLd)}
>
  <Navbar />
  <ScrollReveal />
  <main id="top">
    <BlogIndex posts={pagePosts} page={1} lastPage={lastPage} />
  </main>
  <Footer />
</Layout>
