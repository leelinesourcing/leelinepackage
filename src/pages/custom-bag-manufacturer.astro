  .cb-why-item:last-child { border-bottom: 1px solid rgba(31,59,44,0.12); }
  .cb-why-num { flex: 0 0 auto; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1; color: var(--brass); min-width: 2ch; padding-top: 0.1rem; }
  .cb-why-body h3 { font-family: var(--font-heading); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.01em; color: var(--color-brand-text); margin: 0 0 0.45rem; }
  .cb-why-body p { font-size: 0.98rem; line-height: 1.65; color: var(--color-brand-muted); max-width: 52ch; margin: 0; }

  /* ============ BAG TYPES (offset grid) ============ */
  .cb-types { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 8rem) 0; }
  .cb-type-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.1rem, 2.4vw, 1.7rem); }
  .cb-type-card { background: var(--ivory); border: 1px solid rgba(31,59,44,0.1); border-radius: 1.1rem; overflow: hidden; transition: transform 0.45s cubic-bezier(0.22,1,0.36,1), box-shadow 0.45s ease, border-color 0.45s ease; }
  .cb-type-card:hover { transform: translateY(-6px); box-shadow: 0 24px 50px -22px rgba(31,59,44,0.3); border-color: rgba(176,141,76,0.55); }
