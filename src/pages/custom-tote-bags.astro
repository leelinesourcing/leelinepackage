</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // One FAQ open at a time — the list sits in a narrow column, so two open
  // answers push the page instead of reading as a set.
  const faqItems = Array.from(document.querySelectorAll('.tb-faq-list details'));
  faqItems.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      faqItems.forEach((o) => { if (o !== d) o.open = false; });
    });
  });

  // Use-scene carousel — three up, seamless loop in both directions. A copy of
  // the last three slides sits before slide one and a copy of the first three
  // sits after the last, so stepping past either end animates onto a clone and
  // is then snapped (no transition) onto the matching real slide. Clones carry
  // aria-hidden and are the only thing that makes the wrap invisible, so do not
  // let the number of real slides drop below the number of clones.
  const carTrack = document.querySelector('.tb-car-track');
  if (carTrack) {
    const slides = Array.from(carTrack.children);
    const N = slides.length;
    const clones = 3;
    if (N > clones) {
      for (let k = 0; k < clones; k++) {
        const c = slides[(N - clones + k) % N].cloneNode(true);
        c.classList.add('tb-car-clone');
        c.setAttribute('aria-hidden', 'true');
        carTrack.insertBefore(c, slides[0]);
      }
      for (let k = 0; k < clones; k++) {
        const c = slides[k % N].cloneNode(true);
        c.classList.add('tb-car-clone');
        c.setAttribute('aria-hidden', 'true');
        carTrack.appendChild(c);
      }
      let idx = clones;

      const step = () => {
        const gap = parseFloat(getComputedStyle(carTrack).gap) || 0;
        return carTrack.children[clones].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        carTrack.style.transition = animate ? 'transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        carTrack.style.transform = `translateX(${-idx * step()}px)`;
      };
      const go = (dir) => {
        if (carTrack._busy) return;
        carTrack._busy = true;
        idx += dir;
        move(true);
        setTimeout(() => {
          if (idx < clones) idx += N;
          else if (idx > clones + N - 1) idx -= N;
          move(false);
          carTrack._busy = false;
        }, 570);
      };

      const prevBtn = document.querySelector('.tb-car-btn--prev');
      const nextBtn = document.querySelector('.tb-car-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(1));
      move(false);
      // slides-per-view changes at 1024 and 640, so the step has to be remeasured
      window.addEventListener('resize', () => { if (!carTrack._busy) move(false); });
    }
  }
</script>
