---
const LOGO = 'https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev/leelinepackage-logo.webp';
const year = new Date().getFullYear();

const products = ['Custom Boxes', 'Custom Bags', 'Rigid Boxes', 'Mailer Boxes', 'Custom Pouches'];

const info = [
  { label: 'About Us', href: '/#about' },
  { label: 'Blog', href: '/#work' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Privacy Policy', href: '/' },
];

const socials = [
  { name: 'LinkedIn', href: '#', d: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.2 8.5h4.6V23H.2V8.5Zm7.6 0h4.4v2h.06c.61-1.16 2.1-2.38 4.33-2.38 4.63 0 5.49 3.05 5.49 7.01V23h-4.6v-6.6c0-1.57-.03-3.6-2.19-3.6-2.2 0-2.53 1.72-2.53 3.48V23H7.8V8.5Z' },
  { name: 'Instagram', href: '#', d: 'M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.74.07-1.08.05-1.66.23-2.05.38-.51.2-.88.44-1.26.82-.38.38-.62.75-.82 1.26-.15.39-.33.97-.38 2.05-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.08.23 1.66.38 2.05.2.51.44.88.82 1.26.38.38.75.62 1.26.82.39.15.97.33 2.05.38 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.08-.05 1.66-.23 2.05-.38.51-.2.88-.44 1.26-.82.38-.38.62-.75.82-1.26.15-.39.33-.97.38-2.05.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.08-.23-1.66-.38-2.05a3.4 3.4 0 0 0-.82-1.26 3.4 3.4 0 0 0-1.26-.82c-.39-.15-.97-.33-2.05-.38C15.5 4.01 15.15 4 12 4Zm0 3.06A4.94 4.94 0 1 1 12 16.94 4.94 4.94 0 0 1 12 7.06Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.15-3.14a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z' },
  { name: 'X', href: '#', d: 'M18.9 1.5h3.68l-8.04 9.2L24 22.5h-7.4l-5.8-7.6-6.64 7.6H.48l8.6-9.84L0 1.5h7.59l5.24 6.93L18.9 1.5Zm-1.29 18.7h2.04L6.49 3.6H4.3l13.3 16.6Z' },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand brand--light" href="/" aria-label="LeelinePackage home">
          <img class="brand-logo" src={LOGO} alt="LeelinePackage" loading="lazy" />
        </a>
        <p class="footer-tagline">Engineered, not just printed.</p>
        <p class="footer-note">
          The Structural Brand Architect — protecting the product and impressing the customer,
          from the first dieline to the final mile.
        </p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.name}><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={s.d} /></svg></a>
          ))}
        </div>
      </div>

      <nav class="footer-col" aria-label="Popular products">
        <h4>Popular Products</h4>
        {products.map((p) => <a href="/#offerings">{p}</a>)}
      </nav>

      <nav class="footer-col" aria-label="Company">
        <h4>Company Info</h4>
        {info.map((i) => <a href={i.href}>{i.label}</a>)}
      </nav>

      <div class="footer-col footer-col--contact">
        <h4>Contact</h4>
        <a href="mailto:info@LeelinePackage.com">info@LeelinePackage.com</a>
        <a href="tel:+8613986152456">+86 139 8615 2456</a>
        <span>Sitai Industrial Park, No. 4 Sitai Road, Yongfeng Street, Hanyang District, Wuhan City, Hubei Province, China</span>
        <span>Mon–Sat · 9:00–18:00 CST</span>
        <a class="btn btn-gold btn-sm" href="/contact">Get a Free Quote<svg class="btn-leaf" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} LeelinePackage. All rights reserved.</span>
      <span class="footer-mark">Engineered, not just printed.</span>
      <span>ISO 9001 · FSC&reg;</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: linear-gradient(180deg, var(--forest-light) 0%, var(--color-forest) 100%); color: rgba(255, 255, 255, 0.86); padding: clamp(3.5rem, 8vw, 6rem) 0 2rem; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.3fr; gap: clamp(2rem, 4vw, 3.5rem); }

  .brand { display: inline-flex; align-items: center; gap: 0.7rem; }
  .brand--light .brand-word { color: #fff; }
  .brand--light .brand-word em { color: rgba(255, 255, 255, 0.55); }
  .footer .brand-logo { height: 48px; width: auto; object-fit: contain; filter: brightness(0) invert(1) drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35)); }

  .footer-tagline { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-heading); font-style: italic; font-size: 1.35rem; color: var(--brass-soft); margin: 1.4rem 0 1rem; }
  .footer-note { font-size: 0.95rem; line-height: 1.7; max-width: 40ch; margin: 0 0 1.6rem; }

  .socials { display: flex; gap: 0.7rem; }
  .socials a { width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.25); display: grid; place-items: center; color: rgba(255, 255, 255, 0.8); transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.4s ease, background 0.4s ease, color 0.4s ease; }
  .socials a svg { width: 17px; height: 17px; }
  .socials a:hover { transform: translateY(-3px); border-color: var(--brass); background: var(--brass); color: var(--forest-deep); }

  .footer-col { display: flex; flex-direction: column; gap: 0.7rem; padding-top: 0.5cm; }
  .footer-col h4 { font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brass-soft); margin: 0 0 0.6rem; }
  .footer-col a, .footer-col span { font-size: 0.95rem; color: rgba(255, 255, 255, 0.72); transition: color 0.3s ease; }
  .footer-col a:hover { color: #fff; }
  .footer-col--contact .btn { color: var(--forest-deep); padding: 0.6rem 1.15rem; font-size: 0.88rem; margin-top: 0.45rem; align-self: flex-start; }
  .footer-col--contact .btn:hover { color: var(--forest-deep); background: #EFC45A; box-shadow: 0 12px 26px -12px rgba(0, 0, 0, 0.5); }

  .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.14); margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: 1.6rem; font-size: 0.82rem; }
  .footer-mark { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--brass-soft); }

  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-bottom { justify-content: flex-start; flex-direction: column; align-items: flex-start; }
  }
</style>
