---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev';
const svcImg = (name) => `${R2}/services/${name}.webp`;

// Three services, one production path. Structural has an in-repo page; artwork &
// sample child pages are published but not yet rebuilt here, so they link to the
// live URLs so the CTAs always resolve.
const CHILD = {
  structure: '/structural-engineering-design/',
  artwork: 'https://www.leelinepackage.com/packaging-artwork-design/',
  sample: 'https://www.leelinepackage.com/packaging-sample-prototyping/',
};

const heroStats = [
  { k: '24h', v: '3D mockup' },
  { k: '3\u20135 days', v: 'white samples' },
  { k: 'from 500', v: 'MOQ' },
  { k: '4\u20136 weeks', v: 'full production' },
];

const steps = [
  {
    num: '01',
    title: 'Structural engineering',
    responsibility: 'Turn your product into a box that fits, protects and ships cheap.',
    deliverables: ['Style + dieline (PDF / AI)', 'Board, flute or rigid spec', 'Insert, partition & ship-test notes'],
    timing: '1\u20133 weeks to approved structure',
    href: CHILD.structure,
    external: false,
    linkLabel: 'Structural engineering',
    img: svcImg('structural'),
    imgW: 760,
    imgH: 569,
    alt: 'Cutting die for a fluted carton beside a folded white dummy on a workbench',
  },
  {
    num: '02',
    title: 'Packaging artwork design',
    responsibility: 'Put the artwork on the real dieline so it prints exactly as approved.',
    deliverables: ['Print-ready file on the dieline', 'CMYK / Pantone + finish map', '3D proof before the plate'],
    timing: '3\u20137 days to approved proof',
    href: CHILD.artwork,
    external: true,
    linkLabel: 'Packaging artwork design',
    img: svcImg('artwork'),
    imgW: 760,
    imgH: 570,
    alt: 'Designer sketching a dieline on paper beside kraft prototypes on a workbench',
  },
  {
    num: '03',
    title: 'Packaging sample & prototyping',
    responsibility: 'Prove fit, colour and the run with a physical sample before bulk.',
    deliverables: ['White dummy for fit', 'Colour / production prototype'],
    timing: 'White 3\u20135 days \u00b7 printed 7\u201310 days',
    href: CHILD.sample,
    external: true,
    linkLabel: 'Packaging sample & prototyping',
    img: svcImg('sample'),
    imgW: 612,
    imgH: 408,
    alt: 'Folded carton dieline laid flat beside a finished white tuck-end box',
  },
];

const stuck = [
  {
    t: 'No box design yet',
    icon: [
      { d: 'M8 3h8v5h5v8h-5v5H8v-5H3v-8h5z' },
      { d: 'M8 8h8' },
      { d: 'M8 8v8' },
      { d: 'M16 8v8' },
      { d: 'M8 16h8' },
    ],
    body: 'A product and a target cost, but no dieline yet. Send the outer dimensions, the packed weight and a photo, and we draw the structure around it \u2014 the carton style, the board grade and the insert all picked to keep the box cheap to run and still protect the product.',
    note: 'The box shape decides what comes after it \u2014 so front-load the structure.',
  },
  {
    t: 'A design that might not print',
    icon: [
      { d: 'M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10c1.38 0 2.5-1.12 2.5-2.5 0-.61-.23-1.2-.64-1.67-.08-.1-.13-.21-.13-.33 0-.28.22-.5.5-.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9z' },
      { d: 'M6 8a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0z', fill: 'currentColor' },
      { d: 'M9.8 6.5a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0z', fill: 'currentColor' },
      { d: 'M14 8.3a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0z', fill: 'currentColor' },
      { d: 'M5.8 12.5a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0z', fill: 'currentColor' },
    ],
    body: 'A logo or a low-res file that needs placing and correcting for the press. We fix bleed, trapping and colour, and catch the details that break a print run \u2014 a panel that falls on a fold, a finish that shifts the shade, or a thin rule that only holds at one size.',
    note: 'Press-ready artwork means no surprises on press or on the shelf.',
  },
  {
    t: 'Need physical proof first',
    icon: [
      { d: 'M21 8l-9-5-9 5v8l9 5 9-5V8z' },
      { d: 'M3 8l9 5 9-5' },
      { d: 'M12 13v8' },
    ],
    body: 'Hold, fit and sign off a piece before approving a run. We send a white dummy to prove the fit and the assembly, then a colour prototype once the artwork is locked, so the board, finish and coating are judged on the real thing \u2014 not on a screen or a guess.',
    note: 'A physical sample stops a problem before it becomes a whole run.',
  },
  {
    t: 'Ready for a full quote',
    icon: [
      { d: 'M3 3h8l10 10-8 8L3 11V3z' },
      { d: 'M5.8 7a1.2 1.2 0 1 0 2.4 0 1.2 1.2 0 0 0-2.4 0z', fill: 'currentColor' },
    ],
    body: 'The design is locked and you know the volume. Send size, weight, quantity and channel \u2014 plus any deadline or retail target \u2014 and we price it on the actual structure and board, break down every line of the quote, and name the risks to watch before you commit a run.',
    note: 'Get a real price band and a recommended path \u2014 not a generic \u2018contact us\u2019.',
  },
];

const flow = [
  {
    num: '01', title: 'Structure',
    detail: 'A heavy glass serum bottle was rattling inside a loose lid-and-base box. We redrew it as a one-piece folded carton with a fitted insert, so the bottle stays off the corners and the dead air is gone.',
    spec: 'Board kept at 350gsm \u2014 lighter than the old build, still passed a 1\u00a0m drop.',
  },
  {
    num: '02', title: 'Artwork',
    detail: 'The brand artwork had to move off a fragile exterior edge onto a face that wears well in a cart. Foil landed on the front panel, and colour mapped to one Pantone plus a spot UV.',
    spec: 'The proof matched the on-screen design before the plate was cut.',
  },
  {
    num: '03', title: 'Sample',
    detail: 'First a white dummy in 4 days to confirm the fit \u2014 no plate cost yet. Then one colour prototype over two rounds to match the proof.',
    spec: 'Signed off and cleared to the line in about three weeks.',
  },
];
const projectResult = 'No broken bottles on the first shipment \u2014 the same carton now runs for DTC and retail.';

const compare = [
  {
    label: 'Dieline & tooling ownership',
    us: 'You own the dieline and tooling; we keep a master on file for reorders.',
    them: 'Often the supplier\u2019s \u2014 you re-buy tooling or re-approve the structure each run.',
  },
  {
    label: '3D mockup',
    us: 'Free 3D mockup in 24h from a product photo or sketch.',
    them: 'Sometimes a flat 2D proof, or a paid CAD file.',
  },
  {
    label: 'White sample lead time',
    us: '3\u20135 days once the files lock.',
    them: 'Often 1\u20132 weeks, quoted as \u201c7\u201315 days\u201d.',
  },
  {
    label: 'Sample approval before bulk',
    us: 'We won\u2019t run an order until you sign the sample.',
    them: 'Some run straight to production on the proof alone.',
  },
];

const checklist = [
  'Product size, weight and a photo \u2014 or a reference pack',
  'Channel: DTC, Amazon or retail shelf',
  'Estimated quantity',
  'Existing files: a dieline, an AI file, or just a JPG',
  'Any limits: food-contact, FSC or a budget band',
];

const certs = [
  { slug: 'brcgs', w: 493, h: 104, alt: 'BRCGS Packaging Materials certification' },
  { slug: 'bsci', w: 508, h: 510, alt: 'BSCI \u2014 Business Social Compliance Initiative' },
  { slug: 'fsc', w: 447, h: 447, alt: 'FSC \u2014 Forest Stewardship Council' },
  { slug: 'iso-9001', w: 348, h: 349, alt: 'ISO 9001:2015 certified quality management system' },
  { slug: 'sedex', w: 873, h: 253, alt: 'Sedex \u2014 Supplier Ethical Data Exchange' },
];
const certSrc = (slug) => `${R2}/compliance/${slug}.webp`;

const faqs = [
  {
    q: 'What types of packaging do you make?',
    a: 'Corrugated and folding cartons, rigid gift boxes, mailers, paper and tote bags, and soft-pack pouches. The board, film and finish are matched to the protection the product needs. Share a reference pack or a photo and we\u2019ll tell you honestly whether it\u2019s a fit before you pay anything.',
  },
  {
    q: 'Is a smaller-than-MOQ test run possible?',
    a: 'Our production MOQ is from 500 units, but we can run a lower first quantity or a small trial batch for market testing at a slightly higher unit cost. Volume breaks apply at 1k, 5k and 10k. Physical samples are available before you commit to a full run.',
  },
  {
    q: 'How is the price structured \u2014 are there setup, plate or tooling fees?',
    a: 'You usually pay a one-off setup plus any plate or tooling your structure needs, then a per-unit price that falls as quantity rises. The 3D mockup is free; material samples carry a small fee that is credited against bulk. The quote lists each line so the total is clear before you commit.',
  },
  {
    q: 'What certifications and material compliance do you offer?',
    a: 'Our factory holds ISO 9001, and FSC-certified board and food-contact grades are sourced on request. Compliance paperwork for retail or cross-border selling is available on request. Tell us the market and we\u2019ll confirm exactly which certification is backed with documents.',
  },
  {
    q: 'What won\u2019t this factory be a good fit for?',
    a: 'Packaging is the focus, not private-label products, so it\u2019s not a fit for OEM goods, fashion bags or apparel. Unlimited free revisions with no brief aren\u2019t offered, and a finished sample can\u2019t ship overnight. If it isn\u2019t a fit, we\u2019ll say so and save you the cost.',
  },
  {
    q: 'Is my design and tooling kept confidential?',
    a: 'Yes. We work under NDA on request. The dieline, artwork and any tooling are assigned to your product and never shown to or reused for another brand. When you reorder, the master file stays with you in case you ever move suppliers.',
  },
];

const seo = {
  title: 'Custom Packaging Services: 3 Paths to a Production-Ready Box',
  description: 'One supplier, three packaging services: structural engineering, packaging artwork design and prototyping. 24h 3D mockups, 3-5 day white samples, a 500 unit MOQ.',
  keywords: 'custom packaging services, packaging structural engineering, packaging artwork design, packaging samples and prototyping, start a packaging project',
  canonical: 'https://www.leelinepackage.com/services/',
  ogImage: `${R2}/structural/og-structural.webp`,
};

const absUrl = (href) => href.startsWith('/') ? `https://www.leelinepackage.com${href}` : href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Packaging Services',
      description: seo.description,
      serviceType: 'Custom packaging structural engineering, artwork design and samples',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Packaging services',
        itemListElement: steps.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title }, url: absUrl(s.href) })),
      },
    },
    {
      '@type': 'ItemList',
      name: 'LeelinePackage packaging services',
      itemListElement: steps.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: absUrl(s.href) })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ 1. HERO (centered) ============ -->
    <header class="svc-hero">
      <div class="svc-hero-bg" aria-hidden="true"></div>
      <div class="wrap svc-hero-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>How we work</span>
        <h1>Custom Packaging Services:<br /><em>Ready for Production</em>,<br />Not Just Presentation</h1>
        <p class="svc-hero-sub">Structure, artwork, sample &mdash; the three services that take your pack from concept to run-ready. We engineer the box, prepare print-ready files, then prove it with a sample before you commit to mass production. Start at any step, or bundle all three.</p>
        <ul class="svc-hero-stats">
          {heroStats.map((s) => <li><strong>{s.k}</strong><span>{s.v}</span></li>)}
        </ul>
        <div class="svc-hero-cta">
          <a class="btn btn-gold" href="/contact">
            Start a Project
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </header>

    <!-- ============ 2. THE THREE SERVICES (core) ============ -->
    <section class="svc-path" id="three-services">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Services</span>
          <h2 class="section-title" data-reveal="up">Structure, Artwork, Sample &mdash; <em>One Production Path</em></h2>
          <p class="section-sub" data-reveal="up">A pack needs a structure before artwork and a sample before bulk &mdash; each step is a separate decision.</p>
        </div>

        <div class="svc-path-grid">
          {steps.map((s, i) => (
            <article class="svc-card" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <figure class="svc-card-media">
                <Image src={s.img} alt={s.alt} width={s.imgW} height={s.imgH} quality={80} loading="lazy" decoding="async" class="svc-card-img" />
              </figure>
              <div class="svc-card-body">
                <span class="svc-card-step">{s.num}</span>
                <h3>{s.title}</h3>
                <p class="svc-card-body-text">{s.responsibility}</p>
                <ul class="svc-deliver-list">
                  {s.deliverables.map((d) => <li>{d}</li>)}
                </ul>
                <span class="svc-card-timing">{s.timing}</span>
                <a class="text-link" href={s.href} target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener' : undefined}>{s.linkLabel}
                  <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- ============ 3. WHERE ARE YOU STUCK ============ -->
    <section class="svc-stuck" id="where">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Quick route</span>
          <h2 class="section-title" data-reveal="up">Pick the Step <em>You&rsquo;re Stuck On</em></h2>
          <p class="section-sub" data-reveal="up">Four quick routes. Each names the spot where a project usually stalls, then takes you to the page that fixes it &mdash; or straight to a quote.</p>
        </div>

        <div class="svc-stuck-grid">
          {stuck.map((it, i) => (
            <div class="svc-stuck-card" data-reveal="up" style={`--d:${(i % 4) * 0.08}s`}>
              <span class="svc-stuck-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {it.icon.map((p) => <path d={p.d} fill={p.fill || 'none'} />)}
                </svg>
              </span>
              <h3>{it.t}</h3>
              <p>{it.body}</p>
              <p class="svc-stuck-note">{it.note}</p>
            </div>
          ))}
        </div>

        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact">
            Get Tailored Guidance
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 4. ONE PROJECT THROUGH THREE STEPS ============ -->
    <section class="svc-project" id="project">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Overview</span>
          <h2 class="section-title" data-reveal="up">One Project, <em>End to End</em></h2>
          <p class="section-sub" data-reveal="up">A heavy glass serum bottle kept arriving broken. Here is how one carton walked end to end in about three weeks.</p>
        </div>

        <div class="svc-flow" data-reveal="up">
          {flow.map((f, i) => (
            <Fragment>
              <div class="svc-flow-step">
                <span class="svc-flow-num">{f.num}</span>
                <span class="svc-flow-title">{f.title}</span>
                <span class="svc-flow-detail">{f.detail}</span>
                <span class="svc-flow-spec">{f.spec}</span>
              </div>
              {i < flow.length - 1 && <span class="svc-flow-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>}
            </Fragment>
          ))}
        </div>

        <div class="svc-project-result" data-reveal="up">
          <span class="svc-result-tag">Outcome</span>
          <p class="svc-result-text">{projectResult}</p>
        </div>
      </div>
    </section>

    <!-- ============ 5. SHORT COMPARISON TABLE ============ -->
    <section class="svc-compare" id="compare">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Compare</span>
          <h2 class="section-title" data-reveal="up">LeelinePackage vs <em>a Typical Supplier</em></h2>
          <p class="section-sub" data-reveal="up">Four differences that matter on an overview page &mdash; not the full long table.</p>
        </div>

        <div class="svc-table-wrap" data-reveal="up">
          <table class="svc-table svc-table--compare">
            <thead>
              <tr><th></th><th>LeelinePackage</th><th>Typical supplier</th></tr>
            </thead>
            <tbody>
              {compare.map((c) => (
                <tr>
                  <th scope="row">{c.label}</th>
                  <td>{c.us}</td>
                  <td>{c.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ 6. COMPLIANCE / CERTIFICATIONS ============ -->
    <section class="svc-cert" id="compliance">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Compliance</span>
          <h2 class="section-title" data-reveal="up">Certified for <em>Global Retail</em></h2>
          <p class="section-sub" data-reveal="up">Quality management, responsible sourcing and food-contact materials &mdash; the certifications a buyer checks before placing an order.</p>
        </div>

        <ul class="svc-cert-list" data-reveal="up">
          {certs.map((c) => (
            <li class="svc-cert-tile">
              <Image src={certSrc(c.slug)} alt={c.alt} width={c.w} height={c.h} quality={80} loading="lazy" decoding="async" class="svc-cert-img" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 7. START YOUR PROJECT / BRIEF CHECKLIST ============ -->
    <section class="svc-brief" id="brief">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Brief</span>
          <h2 class="section-title" data-reveal="up">Start Your Project &mdash; <em>Send Us This Brief</em></h2>
        </div>

        <div class="svc-brief-grid">
          <div class="svc-brief-copy" data-reveal="up">
            <p class="svc-brief-lead">A finished CAD file isn&rsquo;t required to get going. A photo, rough dimensions and a quantity are enough to start &mdash; not sure what to measure? Tell us and we&rsquo;ll name the few figures that matter most. The points below cover the usual brief; anything extra helps but is never required.</p>
            <ul class="svc-check">
              {checklist.map((c) => (
                <li class="svc-check-item">
                  <svg class="svc-check-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>

          <figure class="svc-brief-media" data-reveal="up">
            <Image src={svcImg('brief')} alt="The LeelinePackage design and production floor: artwork on screen, die-cutting, folding and packed cartons ready for dispatch" width={980} height={680} quality={80} loading="lazy" decoding="async" class="svc-brief-img" />
          </figure>

          <div class="svc-brief-cta" data-reveal="up">
            <p class="svc-brief-promise">A real person reads every brief, then confirms the next step.</p>
            <a class="btn btn-gold" href="/contact">
              Tell Us About Your Pack
              <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 8. FAQ ============ -->
    <section class="svc-faq" id="faq">
      <div class="wrap">
        <div class="section-head section-head--center">
