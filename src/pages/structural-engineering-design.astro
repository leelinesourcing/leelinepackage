---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

const R2 = 'https://pub-f65f4d4fa9664133a4ceca1f5d43e24d.r2.dev';

// Linked service pages (artwork & sample live on the live site until rebuilt in-repo)
const CHILD = {
  artwork: 'https://www.leelinepackage.com/packaging-artwork-design/',
  sample: 'https://www.leelinepackage.com/packaging-sample-prototyping/',
};

// Delivery proof points, distinct from the services-hub stats (24h mockup /
// samples / 4-6 week production) and from the cost numbers in the ledger below.
const stats = [
  { v: '500', l: 'MOQ, units' },
  { v: '1–3 weeks', l: 'to an approved structure' },
  { v: '6 types', l: 'structures in one chart' },
  { v: 'FSC', l: 'certified board' },
];

/* Structure type × channel */
const structures = [
  { name: 'Folding carton (tuck-end / auto-bottom)', src: `${R2}/structural/struct-folding-carton.webp`, best: 'Light, everyday SKUs in steady rotation', channel: 'Retail shelf + DTC', why: 'Cheapest per unit, flat-packs for storage, auto-bottom erects fast on the line.' },
  { name: 'Lid & base (rigid)', src: `${R2}/structural/struct-lid-base.webp`, best: 'Gifts, premium and fragile items', channel: 'Gifting + retail', why: 'Thick greyboard walls, four strong corners, and a reusable keepsake the buyer keeps.' },
  { name: 'Magnetic-closure gift box', src: `${R2}/structural/struct-magnetic.webp`, best: 'Luxury, high perceived value', channel: 'Gifting + DTC', why: 'Fast magnetic seal reads premium on camera — the unboxing moment is the product.' },
  { name: 'Mailer box (e-comm)', src: `${R2}/structural/struct-mailer.webp`, best: 'Single SKUs shipping direct to customers', channel: 'DTC + Amazon', why: 'Fits Amazon size tiers, trims dimensional weight, and needs no filler to pack safely.' },
  { name: 'Insert / divider', src: `${R2}/structural/struct-insert-divider.webp`, best: 'Multi-item kits and fragile sets', channel: 'E-comm + retail', why: 'Locks each piece in place, spreads load across the box, and replaces foam with recyclable board.' },
  { name: 'Window + sleeve', src: `${R2}/structural/struct-window-sleeve.webp`, best: 'Product-led shelf presence', channel: 'Retail', why: 'Shows the product on-shelf while the sleeve holds a cheaper inner box underneath.' },
];

/* Material engineering — each row carries a short description + a placeholder
   image note so the cards above the table introduce every board on the list. */
const materials = [
  { grade: 'E-flute (single wall)', ect: '32 lb/in', thick: '~1.6 mm', use: 'Light retail, cosmetics, printed cartons', desc: 'The thinnest common flute — prints sharp and folds crisp, for light goods that never stack high.', img: 'E-flute cross-section: a thin, tight wave between two liners' },
  { grade: 'B-flute (single wall)', ect: '32–44 lb/in', thick: '~3.2 mm', use: 'Mid-weight mailers, good cushioning for fragile', desc: 'The go-to mailer flute — more air between the liners gives fragile pieces more cushion.', img: 'B-flute cross-section: a rounder wave with more air between liners' },
  { grade: 'C-flute (single wall)', ect: '44 lb/in', thick: '~4.8 mm', use: 'Heavier retail, better stacking strength', desc: 'A taller flute that takes more crush — for heavier retail goods stacked in store.', img: 'C-flute cross-section: the deepest corrugated wave' },
  { grade: 'BC double wall', ect: '55–70 lb/in', thick: '~8 mm', use: 'Heavy or breakable goods, long-haul freight', desc: 'Two flutes laminated together — the strongest, for long-haul sea freight and heavy items.', img: 'BC double-wall section: two stacked waves between liners' },
  { grade: 'Solid greyboard (rigid)', ect: '— (no flute)', thick: '1.5–3 mm', use: 'Lid & base, magnetic boxes, keepsakes', desc: 'No flute — a dense, flat board for rigid lid-and-base and magnetic keepsake boxes.', img: 'A thick greyboard slab beside a rigid gift box' },
  { grade: 'FSC & food-contact grades', ect: 'on request', thick: 'on request', use: 'When retail compliance or direct food contact requires it', desc: 'Forest-certified and food-safe grades, sourced when a market or product requires them.', img: 'FSC and food-contact certification marks' },
];

/* Material cards for the section — E/B/C-flute grouped into one card, so the
   card grid shows 4 cards. The ECT table above still lists all 6 boards.
   Card copy is the "how to choose / trade-off" angle — NOT the spec values
   (ECT / thickness / typical use) which live only in the table. */
const materialCards = [
  { t: 'Single-wall flutes (E · B · C)', src: `${R2}/structural/material-e-b-c.webp`, img: 'E / B / C flute cross-sections showing three wave depths', desc: 'Board depth is the trade-off: a thin flute prints crisply and ships light, a tall one cushions and resists crushing. Choose the shortest depth that still protects the route — the spec for each is in the table below.' },
  { t: 'BC double wall', src: `${R2}/structural/material-bc.webp`, img: 'BC double-wall section: two stacked waves between liners', desc: 'Two flutes bonded face-to-face roughly double the cushioning and crush resistance for about 2 mm extra thickness. The cost is a heavier pack and a little more board — worth it only when the route demands it.' },
  { t: 'Solid greyboard (rigid)', src: `${R2}/structural/material-greyboard.webp`, img: 'A thick greyboard slab beside a rigid gift box', desc: 'No air pockets — a dense card that keeps its shape. It adds almost no cushioning of its own, so a fitted insert does the protecting; what you gain is a hard, reusable shell customers keep.' },
  { t: 'FSC & food-contact grades', src: `${R2}/structural/material-fsc.webp`, img: 'FSC and food-contact certification marks', desc: 'Certified and food-safe grades, sourced on request. They don\u2019t alter the structure \u2014 they open retail and food channels that won\u2019t accept uncertified board.' },
];

/* Dieline / dim-weight worked example */
const dimExample = {
  old: { label: 'Old box', d: '25 × 20 × 15 cm', vol: '7,500 cm³', dim: '1.50 kg' },
  neu: { label: 'Redrawn dieline', d: '22 × 16 × 13 cm', vol: '4,576 cm³', dim: '0.92 kg' },
  dimCut: '−39% billed weight',
  productWeight: '0.4 kg actual',
  note: 'By air, the charge is the greater of actual or dimensional weight. The candle is 0.4 kg; the loose box billed as 1.5 kg. Redrawn, it bills as 0.92 kg.',
};

/* Protection by product class — each card gets its own image placeholder */
const protect = [
  { t: 'Fragile & glass', src: `${R2}/structural/protect-fragile.webp`, text: 'A die-cut corrugated or EVA insert pockets each item with a 3 mm+ air gap off each wall — so a 1 m ISTA drop leaves the bottle intact.', img: 'A die-cut insert cradling a glass bottle' },
  { t: 'Cosmetics & bottles', src: `${R2}/structural/protect-cosmetics.webp`, text: 'Card slots or a partition separate each unit, so product never touches product — and stays recyclable with no foam.', img: 'Card slots separating cosmetic bottles in a row' },
  { t: 'Electronics & heavy', src: `${R2}/structural/protect-electronics.webp`, text: 'Double-wall BC board, corner protectors and a moisture-resistant tape keep a full pallet stack from distorting.', img: 'Corner protectors on a heavy electronics box' },
  { t: 'Light & durable', src: `${R2}/structural/protect-light.webp`, text: 'A well-fit carton with no foam and no filler — the smallest volume that still tracks through the line.', img: 'A snug carton with a product fitting exactly' },
];

/* ISTA testing */
const tests = [
  { t: 'Drop', param: 'ISTA-1A / 2A / 3A', body: 'Dropped flat, edge and corner from 30–76 cm depending on package weight, to confirm the insert keeps the product off the box faces.', pass: 'Product functional + box intact after the test drop.' },
  { t: 'Vibration', param: 'ISTA-3A random vibration', body: '1–3 hours of random vibration that mirrors truck / air transfer, checking the insert does not migrate during a real journey.', pass: 'No movement of the item inside its pocket.' },
  { t: 'Stack & compression', param: 'Compression (ECT-linked)', body: 'Hold 1.4× the tallest warehouse stack for 24 h; a 44 ECT single wall carries ~55 lb per edge, BC double wall ~95 lb.', pass: 'No collapse at the load the DC will actually use.' },
];

/* Cost ledger before / after — one fragile SKU. Freight is deliberately kept
   out here because the dim-weight worked example above already owns that story. */
const ledger = [
  { k: 'Material per box', before: '44 ECT board + foam insert', after: '32 ECT board + die-cut insert', change: '−18%' },
  { k: 'Secondary pack', before: 'Bubble wrap + loose fill', after: 'None', change: '−100%' },
  { k: 'Damage returns', before: '3.2% of units', after: '0.6% of units', change: '−81%' },
  { k: 'Pack time per unit', before: '2.1 min', after: '0.8 min', change: '−62%' },
];

/* What you receive */
const deliverables = [
  { t: 'Dieline (CAD / PDF)', body: 'Dimensioned dieline in CAD and PDF — the master file for tooling and reprints.' },
  { t: '3D structural mockup', body: 'A working 3D mockup within 24 h of a photo or rough dimensions, before any tooling is cut.' },
  { t: 'White-sample recommendation', body: 'The exact board, flute and grammage to prototype, so the first physical sample is already on-spec.' },
  { t: 'Engineering note', body: 'Tolerances, ECT and stacking strength, plus the ISTA test plan for the ship route.' },
];

/* FAQ — structure-led, no overlap with artwork / sample pages, no repeated facts */
const faqs = [
  { q: 'What\u2019s needed to start the structure?', a: 'A photo or sketch, the product size and weight, and the channel \u2014 retail shelf, DTC or Amazon. Rough dimensions are enough; the dieline is drawn around the product to those figures.' },
  { q: 'Which structure suits the product?', a: 'It depends on fragility and the channel. A folding carton wins for everyday DTC SKUs; a rigid lid-and-base or magnetic box for gifts and premium; a mailer for Amazon size tiers. Send the channel and get one recommendation plus a comparable option.' },
  { q: 'Can the box be guaranteed to survive shipping?', a: 'No supplier can guarantee a courier, but structure is the biggest lever. The box is engineered to an ISTA protocol matched to the route, then evidenced with drop, vibration and stack tests before the run \u2014 damage returns typically below 1%.' },
  { q: 'How does structure change cost?', a: 'Mostly in freight and damage, not the unit price. A tighter dieline cuts dimensional weight, a die-cut insert removes foam and loose fill, and the right flute stops breakages \u2014 usually a double-digit % off landed cost per unit.' },
  { q: 'What materials and certifications are available?', a: 'Corrugated in E, B, C and BC double-wall, plus solid greyboard for rigid boxes. ECT is sized to the stack the box holds; FSC-certified and food-contact grades are sourced on request for retail compliance.' },
  { q: 'Is the dieline the customer\u2019s?', a: 'Yes. The dieline and tooling belong to the customer; a master stays on file so a reorder is a reprint, not a redesign.' },
];

const seo = {
  title: 'Packaging Structural Engineering: 6 Structure Types, MOQ 500',
  description: 'Structural engineering cuts damage and cost. Pick the structure, board and dieline for your channel, with ISTA proof, a 24h 3D mockup and an MOQ from 500 units.',
  keywords: 'packaging structural engineering, packaging structure types, corrugated board ECT, custom packaging dieline, reduce packaging cost, reduce dimensional weight, ISTA packaging testing',
  canonical: 'https://www.leelinepackage.com/structural-engineering-and-design/',
  ogImage: `${R2}/structural/og-structural.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Packaging Structural Engineering',
      description: seo.description,
      serviceType: 'Custom packaging structural engineering and design',
      provider: {
        '@type': 'Organization',
        name: 'LeelinePackage',
        url: 'https://www.leelinepackage.com/',
        areaServed: 'Worldwide',
      },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '320' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.leelinepackage.com/services/' },
        { '@type': 'ListItem', position: 3, name: 'Packaging Structural Engineering' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO (split, light) ============ -->
    <section class="eng-hero">
      <div class="wrap eng-hero-grid">
        <div class="eng-hero-copy">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Structural Engineering</span>
          <h1 class="eng-hero-title">Packaging structural engineering that <em>cuts damage, cuts cost</em></h1>
          <p class="eng-hero-sub">Structure, board and size decide whether a box survives the courier, wastes material or ships cheap. Send the product&rsquo;s size, weight and channel &mdash; a dieline and a board recommendation come back.</p>
          <div class="eng-hero-cta" data-reveal="up">
            <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
              Send your dimensions
              <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <div class="eng-hero-visual" data-reveal="right">
          <Image
            class="eng-hero-img"
            src={`${R2}/structural/hero.webp`}
            alt="Dieline, 3D mockup and die-line cut of a custom packaging carton"
            width={1024}
            height={1024}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </div>
      </div>
    </section>

    <!-- ============ STAT STRIP (forest) ============ -->
    <section class="eng-stats" aria-label="Key figures">
      <div class="wrap eng-stats-row">
        {stats.map((s) => (
          <div class="eng-stat">
            <strong>{s.v}</strong>
            <span>{s.l}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ 1. STRUCTURE × CHANNEL (table) ============ -->
    <section class="eng-struct" id="structure">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>1 &middot; Structure</span>
          <h2 class="section-title" data-reveal="up">Pick the structure that matches <em>the channel</em></h2>
          <p class="section-sub" data-reveal="up">A shelf pack and a mailer protect differently. The right choice fits the sales channel &mdash; not the one that looks best in a render.</p>
        </div>
        <div class="eng-struct-grid">
          {structures.map((s, i) => (
            <article class="eng-struct-card" data-reveal="up" style={`--d:${(i % 3) * 0.08}s`}>
              <figure class={"eng-struct-ph" + (s.src ? '' : ' eng-struct-ph--ph')}>
                {s.src ? (
                  <Image src={s.src} alt={s.name} width={600} height={600} loading="lazy" />
                ) : (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
                )}
              </figure>
              <h3>{s.name}</h3>
              <div class="eng-struct-body">
                <span class="eng-pill">{s.channel}</span>
                <p class="eng-struct-best">{s.best}</p>
                <p class="eng-struct-why">{s.why}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
            Get a structure recommendation
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 2. MATERIAL ENGINEERING (data table) ============ -->
    <section class="eng-material" id="material">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>2 &middot; Material</span>
          <h2 class="section-title" data-reveal="up">Engineer the board, <em>not the buzzwords</em></h2>
          <p class="section-sub" data-reveal="up">Strength is measured in ECT &mdash; the load a corrugated edge takes before it buckles. Sized to the stack the box must hold, so a heavy SKU never ships on a light board and a light one never pays for a heavy one.</p>
        </div>
        <div class="eng-mat-grid">
          {materialCards.map((c, i) => (
            <article class="eng-mat-card" data-reveal="up" style={`--d:${(i % 2) * 0.08}s`}>
              <figure class="eng-mat-thumb">
                <Image src={c.src} alt={c.img} width={256} height={256} loading="lazy" />
              </figure>
              <div class="eng-mat-body">
                <h3>{c.t}</h3>
                <p>{c.desc}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="eng-table-wrap" data-reveal="up">
          <table class="eng-table eng-table--spec">
            <thead>
              <tr><th>Board / flute</th><th>ECT</th><th>Thickness</th><th>Typical use</th></tr>
            </thead>
            <tbody>
              {materials.map((m) => (
                <tr><th scope="row">{m.grade}</th><td>{m.ect}</td><td>{m.thick}</td><td>{m.use}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <aside class="eng-callout" data-reveal="up">
          <strong>Humidity:</strong> corrugated loses roughly 30% of its crush strength in damp air. For a box that must stack in a humid DC, a moisture-resistant&nbsp;treatment and a step up in ECT cost less than the damage they prevent.
        </aside>
      </div>
    </section>

    <!-- ============ 3. SIZE & DIELINE / DIM-WEIGHT (split) ============ -->
    <section class="eng-size" id="dieline">
      <div class="wrap eng-size-grid">
        <div class="eng-size-copy">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>3 &middot; Size &amp; dieline</span>
          <h2 class="section-title" data-reveal="up">Measure once, <em>ship cheaper</em></h2>
          <p class="section-sub" data-reveal="up">Freight bills on the greater of actual or dimensional weight. Ten millimetres of dead air on each side is money on each shipment &mdash; so the dieline is drawn tight around the product.</p>
          <ul class="eng-rules" data-reveal="up">
            <li><span>Measure in mm</span> inside dimensions for the product, outside for freight &mdash; the gap is 2&times; board thickness.</li>
            <li><span>Add 2&ndash;3 mm</span> per inner dimension for slid-in fit; keep 4&ndash;6 mm total on the box&rsquo;s diagonal so it never crushes the product.</li>
            <li><span>Test the tight box</span> on the real product &mdash; one too small is a return, one too big is a freight surcharge.</li>
          </ul>
        </div>

        <figure class="eng-dimcard" data-reveal="right">
          <div class="eng-dimcard-head">
            <span class="eng-eye">Worked example &mdash; a 400 g candle</span>
          </div>
          <div class="eng-dimcard-body">
            <div class="eng-dimrow">
              <div class="eng-dimcol">
                <span class="eng-dimlabel">{dimExample.old.label}</span>
                <strong>{dimExample.old.d}</strong>
                <span>{dimExample.old.vol}</span>
                <span class="eng-dimval">{dimExample.old.dim} <em>dim wt</em></span>
              </div>
              <div class="eng-dimsave">→</div>
              <div class="eng-dimcol eng-dimcol--new">
                <span class="eng-dimlabel">{dimExample.neu.label}</span>
                <strong>{dimExample.neu.d}</strong>
                <span>{dimExample.neu.vol}</span>
                <span class="eng-dimval">{dimExample.neu.dim} <em>dim wt</em></span>
              </div>
            </div>
            <p class="eng-dim-note">{dimExample.note}</p>
            <span class="eng-dim-cut">{dimExample.dimCut}</span>
          </div>
        </figure>
        <div class="section-cta" data-reveal="up" style="grid-column: 1 / -1;">
          <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
            Get a dieline drawn
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 4. PROTECTION (dark) ============ -->
    <section class="eng-protect" id="protection">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>4 &middot; Protection</span>
          <h2 class="section-title" data-reveal="up">Stop the product touching <em>the box wall</em></h2>
          <p class="section-sub" data-reveal="up">Most damage isn&rsquo;t a crushed carton &mdash; it&rsquo;s the product moving inside it. The insert is what stops that.</p>
        </div>
        <div class="eng-protect-grid">
          {protect.map((p, i) => (
            <article class="eng-protect-card" data-reveal="up" style={`--d:${i * 0.1}s`}>
              <figure class="eng-protect-thumb">
                <Image src={p.src} alt={p.img} width={400} height={220} loading="lazy" />
              </figure>
              <div class="eng-protect-body">
                <span class="eng-protect-tag">{p.t}</span>
                <p class="eng-protect-text">{p.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 5. TESTING (ISTA) ============ -->
    <section class="eng-test" id="testing">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>5 &middot; Testing</span>
          <h2 class="section-title" data-reveal="up">Prove the box with <em>ISTA</em>, not guesswork</h2>
          <p class="section-sub" data-reveal="up">Tested to the protocol the ship route actually uses, then recorded on the engineering note &mdash; so a buyer sees evidence before the first unit ships.</p>
        </div>
        <div class="eng-test-grid">
          {tests.map((t, i) => (
            <article class="eng-test-card" data-reveal="up" style={`--d:${i * 0.1}s`}>
              <span class="eng-test-param">{t.param}</span>
              <h3>{t.t}</h3>
              <p>{t.body}</p>
              <p class="eng-test-pass"><strong>Pass:</strong> {t.pass}</p>
            </article>
          ))}
        </div>
        <p class="eng-test-note" data-reveal="up">Hold the proof before the run &mdash; order a physical sample &amp; prototype.</p>
      </div>
    </section>

    <!-- ============ 6. COST LEDGER (before/after) ============ -->
    <section class="eng-cost" id="cost">
      <div class="wrap">
        <div class="section-head">
