</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasIO = 'IntersectionObserver' in window;
  const revealEls = document.querySelectorAll('[data-reveal]');
  if (!reduce && hasIO) {
    const revealIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach((el) => revealIO.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in'));
  }

  // Scenes carousel — 3-up, seamless loop in both directions. A copy of the last
  // three slides sits before slide one and a copy of the first three sits after
  // the last, so stepping past either end animates onto a clone and is then
  // snapped (no transition) onto the matching real slide. No visible jump.
  const scTrack = document.querySelector('.fx-sc-track');
  if (scTrack) {
    const slides = Array.from(scTrack.children);
    const N = slides.length;
    if (N > 3) {
      const clones = 3;
      for (let k = 0; k < clones; k++) {
        const c = slides[(N - clones + k) % N].cloneNode(true);
        c.classList.add('fx-sc-clone');
        c.setAttribute('aria-hidden', 'true');
        scTrack.insertBefore(c, slides[0]);
      }
      for (let k = 0; k < clones; k++) {
        const c = slides[k % N].cloneNode(true);
        c.classList.add('fx-sc-clone');
        c.setAttribute('aria-hidden', 'true');
        scTrack.appendChild(c);
      }
      let idx = clones;

      const step = () => {
        const gap = parseFloat(getComputedStyle(scTrack).gap) || 0;
        return scTrack.children[clones].getBoundingClientRect().width + gap;
      };
      const move = (animate) => {
        scTrack.style.transition = animate ? 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        scTrack.style.transform = `translateX(${-idx * step()}px)`;
      };
      const go = (dir) => {
        if (scTrack._busy) return;
        scTrack._busy = true;
        idx += dir;
        move(true);
        setTimeout(() => {
          if (idx < clones) idx += N;
          else if (idx > clones + N - 1) idx -= N;
          move(false);
          scTrack._busy = false;
        }, 520);
      };

      const prevBtn = document.querySelector('.fx-sc-btn--prev');
      const nextBtn = document.querySelector('.fx-sc-btn--next');
      if (prevBtn) prevBtn.addEventListener('click', () => go(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(1));
      move(false);
      window.addEventListener('resize', () => { if (!scTrack._busy) move(false); });
    }
  }
</script>
