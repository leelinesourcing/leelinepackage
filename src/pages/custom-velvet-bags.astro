---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const VB = `${R2}/velvet-bags`;

/* The nine builds. `spec` is one hard property that decides something for the
   buyer; `d` is what their own customer ends up doing with the bag. No card
   restates the section sub or the card above it, and four of the nine names
   carry a search a buyer actually types. */
const types = [
  { n: 'VB-01', key: 'type-drawstring-v2', name: 'Custom Velvet Drawstring Bags', spec: 'Ribbon or twist cord',
    alt: 'A forest green velvet drawstring pouch foil-stamped Your Logo or Text in gold, standing on pale sand',
    d: 'A measured 12 mm casing, bar-tacked at both openings, so the cord cannot pull out of the bag.' },
  { n: 'VB-02', key: 'type-gift-v2', name: 'Custom Velvet Gift Bags', spec: 'Takes a foil block',
    alt: 'A pale grey and a burgundy velvet drawstring pouch, the red one finished with a gold bead and ribbon, on a round woven tray',
    d: 'A gift bag is read before the gift is; velvet takes a foil that catches a room light.' },
  { n: 'VB-03', key: 'type-embroidered-v3', name: 'Embroidered Velvet Bags', spec: 'Thread, not ink',
    alt: 'A black velvet shoulder bag standing upright on a stone ground, embroidered in blue, teal and rose florals and stars',
    d: 'Thread laid into the pile — the one mark here that survives a wash.' },
  { n: 'VB-04', key: 'type-zipper-v2', name: 'Velvet Zipper Pouches', spec: 'Metal zip, fabric pull',
    alt: 'Velvet zip pouches in blue, golden yellow, pink and cream stacked on a pale surface, one open with its tassel pull hanging out',
    d: 'A zip turns a pouch into a case, and a case lives in a handbag rather than a drawer.' },
  { n: 'VB-05', key: 'type-wine-v2', name: 'Velvet Wine Bags', spec: 'One or two bottles',
    alt: 'A wine bottle in a red velvet drawstring bag appliqued with a cream figure and the words Merry Christmas, beside a wooden XMAS sign and a lit tree',
    d: 'Bottle-shaped and carried by the cord, so the bottle arrives dressed.' },
  { n: 'VB-06', key: 'type-beaded-v2', name: 'Beaded Velvet Clutch Bags', spec: 'Hand-set by the piece',
    alt: 'A navy velvet clutch laid flat on a bed of pearls, its face worked edge to edge in teal, red and gold bead embroidery',
    d: 'The dressiest build on the page: beads and a clasp, both set by hand.' },
  { n: 'VB-07', key: 'type-printed-v2', name: 'Printed Velvet Drawstring Bags', spec: 'Print laid in the pile',
    alt: 'Five small velvet drawstring pouches printed with the names Oliver, Noah, Henry and Kate, arranged on a white plate',
    d: 'The whole face becomes the artwork instead of a mark on a coloured bag.' },
  { n: 'VB-08', key: 'type-jewelry-v2', name: 'Custom Velvet Jewelry Pouches', spec: '3 × 4 to 8 × 10 in',
    alt: 'Velvet jewelry pouches in grey, ivory and black foil-stamped with a gold mark, laid out in a row on a tan ground',
    d: 'Padded, lined against tarnish, and measured to the piece — the build most clients reorder.' },
  { n: 'VB-09', key: 'type-tote-v3', name: 'Large Velvet Tote Bags', spec: 'Embroidered panel',
    alt: 'A large black velvet tote with brown webbing handles, its front covered in dense floral thread and bead embroidery',
    d: 'Velvet has the weight to hold a shopper’s shape and a face wide enough to carry a mark.' },
];

/* §Four Fabrics. THE PAGE'S ONE TABLE. Rows are the four cloths; the columns
   are the four things a buyer actually compares. `cost` is relative within
   this page, not a price. Satin is the only banded row because it is the one
   that changes what a buyer does: it is the cheapest of the four and the bag
   most orders for a dust bag or a favour end up on.
   ⚠️ The source photograph named "Recycled-Velvet" is a print of tropical
   foliage with no recycled content visible in the frame. It ships as the
   PRINTED row, and the rPET option is described in the note under the table
   rather than illustrated by a frame that does not show it. */
/* The `…Short` values are what the MARK and CHOSEN FOR cells fall back to below
   640 px, where five columns have ~86 px each. A pair is swapped by CSS, so
   only one of the two is ever in the accessibility tree — the same device the
   stickers page's finish matrix uses. */
const fabrics = [
  { name: 'Premium', cost: '$$', pile: '3–5 mm', mark: 'Embroidery, foil', markShort: 'Embroidery',
    chosen: 'Jewelry, gifts, anything handled often', chosenShort: 'Jewelry, gifts' },
  { name: 'Crushed', cost: '$$', pile: '3–5 mm, pressed', mark: 'Foil, screen print', markShort: 'Foil, screen',
    chosen: 'Fashion and cosmetics, where wear shows', chosenShort: 'Fashion, cosmetics' },
  { name: 'Satin', cost: '$', pile: 'None, flat weave', mark: 'Screen print, transfer', markShort: 'Screen print',
    chosen: 'Dust bags and giveaways at volume', chosenShort: 'Dust bags, favors', badge: 'Cheapest of the four' },
  { name: 'Printed', cost: '$$$', pile: '2–3 mm', mark: 'The print is the mark', markShort: 'The print',
    chosen: 'Designs that carry the identity', chosenShort: 'Artwork-led' },
];

/* §Five Ways to Put a Mark on Velvet. `min` is the run each route becomes
   sensible at; each `d` says what that route is good at and what it costs in
   return, because on a pile every route trades something. */
/* Every route carries its own photograph. The one card that used to hold the only real sample
   is now a client shot of five pouches carrying one printed mark. */
const routes = [
  { name: 'Embroidery', min: 'From 500',
    d: 'Thread laid into the pile. The only route that still reads after a wash, and the route that holds a crest or a monogram at a size the others lose.',
    img: 'mark-embroidery-v2', w: 387, h: 516,
    alt: 'A black velvet panel stretched in an embroidery hoop, worked in silk thread with red, pink and green flowers and leaves' },
  { name: 'Foil stamping', min: 'From 500',
    d: 'A metal layer pressed into the pile under heat. On a flat crushed velvet it lands sharp and mirror-bright; on a deep pile it sinks and softens instead of flattening.',
    img: 'mark-foil-v2', w: 554, h: 554,
    alt: 'A charcoal velvet drawstring pouch stamped in gold foil with a large script mark, laid on a painted ground' },
  { name: 'Screen print', min: 'From 1,000',
    d: 'Ink pushed through a mesh onto the face. Bold shapes only, and it sits on top of the cloth: a print on a pouch that gets handled will wear before the cloth does.',
    img: 'mark-screen-v2', w: 1024, h: 1024,
    alt: 'Five velvet drawstring pouches in silver, white, charcoal, cream and black, each screened with the same gold mark across the face, laid out on a beige ground' },
  { name: 'Deboss', min: 'From 500',
    d: 'The pile pressed down with no ink and no foil. A mark that cannot be read from a distance and cannot be missed in the hand, which suits a house that does not shout.',
    img: 'mark-deboss-v2', w: 960, h: 960,
    alt: 'Four velvet pouches in pale yellow, sage, cream and lilac, each carrying a blind-debossed mark with no ink and no foil' },
  { name: 'Woven or leather label', min: 'From 500',
    d: 'A separate label stitched at the seam. Fine type and two colors both survive here, at the price of another component to make and another thing to sew on.',
    img: 'mark-label-v2', w: 984, h: 984,
    alt: 'A camel velvet drawstring pouch with cream cords and a woven white label stitched across the front, resting on kraft paper' },
];

/* §Four Tests. What the cloth must not do to whatever it is wrapped around.
   Three of the four are standards with a grade; the fourth is a process. */
const tests = [
  { val: 'Grade 4–5', name: 'Dry rub fastness',
    d: 'A black pouch against a white garment is the first question a retail buyer asks, and the grade is the answer. ISO 105-X12, tested on the finished dyed cloth, not on a swatch of yarn.' },
  { val: 'Azo-free', name: 'Dye to REACH Annex XVII',
    d: 'A restricted amine is not something a pouch should carry into a customer’s home. The dye declaration travels with the order, which matters for anything a child will pick up.' },
  { val: 'Two passes', name: 'Brushed, then vacuumed',
    d: 'Velvet sheds onto glass, lenses and polished metal. The cloth is worked against its own pile and vacuumed before packing, which is what opens a box clean.' },
  { val: 'Under 2 %', name: 'Shrinkage at 40 °C',
    d: 'The pouches that come back into circulation are the ones that get washed. Cloth that survives a hand wash at its original size is cloth a customer keeps.' },
];

/* §The Pouch Outlives the Sale. Three statements, each with a hanging numeral.
   This is the section that argues the unit price, so nothing here is a
   property of the fabric — all three are about what happens after the sale. */

/* §Five Decisions — the YJXPACK reading, from the client's brief: a product page should spread a
   bag out into bag type + craft + hardware rather than show one bag photograph. These five facts
   were scattered across §Types, §The Drawstring Channel, §Four Layers, §Five Ways and §Four Buyers;
   this is the one place they are read together, which is what makes a quote readable.
   `opt` is rendered as a chip run, `d` is one line saying what that decision settles. */


/* §Why the Second Run Comes Back a Different Shade. Three facts about a dye
   bath, beside a drawn swatch card. No photograph carries this one: the point
   is the reference chip, so the reference chip is what is drawn. */

/* §Four Buyers. Four columns, the copy set over a gradient on the plate — the
   one place on this page where a photograph carries type. */
const buyers = [
  { key: 'vert-jewelry-v2', name: 'Jewelry and watches', chips: ['Tarnish cloth', 'Padded', '3 × 4 to 8 × 10 in'],
    alt: 'Velvet pouches in lilac, red and teal on a wooden tray with a rose-gold chain, a hand lifting a ring from one of them',
    d: 'Silver and gold stay bright through a season on a counter.' },
  { key: 'vert-gift', name: 'Gifting and events', chips: ['Foil stamp', 'Ribbon', 'Dates and initials'],
    alt: 'Red and green velvet drawstring bags with gold cords and bead detail arranged on a festive tray',
    d: 'One run covers a launch, a wedding or a client dinner, stamped with the date.' },
  { key: 'vert-cosmetics', name: 'Cosmetics and travel', chips: ['Zip', 'Lined', 'Wipes clean'],
    alt: 'Two quilted velvet zip cases, one in dusty blue and one in rose, on a pale pink background',
    d: 'A case rather than a bag, lined to survive a spill.' },
  { key: 'vert-care', name: 'Retail and care kits', chips: ['Drawstring', 'Embossed', 'Ships with the product'],
    alt: 'A flat lay of pale velvet pouches, drawstring bags, a wallet and a presentation box laid out on a white surface',
    d: 'The pouch a product ships in and stays in on the shelf.' },
];

/* §How an Order Moves. `when` is the clock; `win` is what the buyer holds at
   the end of that stop, which is the only reason the stop is on the page. */
/* §Customisation Services. The page never named what it will actually customise for a buyer —
   it only listed product detail. These six are written as "what you hand over" and "what comes
   back", which is the shape the client's reference (packfancy.com/pages/jewelry-pouches) uses.
   `href` carries the service page where one exists, so all three service pages stay linked. */
/* §Customisation Services. The page never named what it will actually customise for a buyer —
   it only listed product detail. Six services, each written as "what you hand over" and "what comes
   back", the shape the client's reference (packfancy.com/pages/jewelry-pouches) uses. `icon` is a
   stroke path drawn inside a brass ring so the row is not six plain rectangles. */
/* §Customisation Services. Six services written as "what you hand over" and "what comes back".
   ⚠️ Two of these marks were WRONG and were redrawn: the first (OEM, copying a build) was a pair of
   offset squares that rendered as a waste bin, and the last (a kit) rendered as a browser window.
   ⚠️ Card 06 linked to the prototyping page while its card is about packing a set. The
   prototyping link moved to 01 (OEM starts by copying a sample), and all three service pages stay
   linked across the page: structural engineering on 02, artwork in §Getting a Logo onto Pile,
   prototyping on 01. */
/* §Customisation Services. Six services written as "what you hand over" and "what comes back".
   ⚠️ The links are INLINE inside the prose now, bold and brass-underlined, because two cards
   used to end with a separate "… →" row and four did not — the client read the unevenness as
   an error. Every card also carries one <b> highlight, so the paragraph has a point rather than
   being a block of even text. All three service pages stay linked: prototyping on 01, structural
   engineering on 02, artwork design in §Getting a Logo onto Pile. */
/* §Customisation Services. `d` is the body of the card and `win` is the point of it, held on its
   own line pinned to the bottom of the card (`.card` is a flex column, so `margin-top:auto` on the
   last child lines all six up across the row). Links are inline inside the prose — two cards used
   to end with a separate "… →" row and four did not, which read as an error. All three service
   pages stay linked: prototyping on 01, structural engineering on 02, artwork in §Getting a Logo
   onto Pile. */
const services = [
  { n: '01', name: 'OEM — a build already selling',
    d: 'An existing build, or one being bought elsewhere, is copied to the millimetre and matched against a swatch mailed in.',
    win: 'Starts with a <a class="inline-link" href="/packaging-sample-prototyping/">sample and prototype</a> of the build you already sell.',
    icon: '<rect x="4" y="4" width="12" height="12" rx="2"/><path d="M8 20h10a2 2 0 0 0 2-2V8"/>' },
  { n: '02', name: 'ODM — drawn from a photograph',
    d: 'A photo with a ruler sets the dimensions, and the pattern, the drawstring channel and the lining are drawn here in <a class="inline-link" href="/structural-engineering-and-design/">structural engineering and design</a>.',
    win: 'A sewn sample comes back before a run is committed.',
    icon: '<path d="M4 15l11-11 5 5-11 11z"/><path d="M8 11l2 2M11 8l2 2"/>' },
  { n: '03', name: 'Private label',
    d: 'Our patterns and our plant, with the client’s own name on the carton, and a repeat order that needs no drawing done again.',
    win: 'Nothing on the pouch carries our mark unless that has been asked for.',
    icon: '<path d="M4 12l8-8h8v8l-8 8z"/><path d="M15.5 8.5h.01"/>' },
  { n: '04', name: 'Colour, stocked or dyed',
    d: 'Pick from the shades on the card, or have the yarn dyed to your Pantone from 2,000 units.',
    win: 'Dyeing to a number instead of to a screen is what lets a third order match a first.',
    icon: '<path d="M12 3c3.5 4 6 7 6 9.5a6 6 0 0 1-12 0C6 10 8.5 7 12 3z"/>' },
  { n: '05', name: 'Any size, cut to order',
    d: 'Nothing is picked off a list. The jewelry range covers 3 × 4 in to 8 × 10 in, and the plant cuts anywhere from about 5 cm to 70 cm on the long edge.',
    win: 'Measure the outside of the pouch being replaced — that single number prevents most remakes.',
    icon: '<path d="M4 9V4h5M20 15v5h-5M4 4l6 6M20 20l-6-6"/>' },
  { n: '06', name: 'A kit, not four suppliers',
    d: 'The pouch, the box, the tissue, the ribbon and the hangtag made here and packed as a set.',
    win: 'A single carton reaches the 3PL, not four arriving from four places.',
    icon: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>' },
];

/* The site's own five compliance marks, re-cut so the white is off them (the originals on
   `custom-bag/compliance/*` are pure white and read as white boxes on the page). Uploaded under
   `velvet-bags/compliance/*`; that page is untouched. Name and intrinsic size travel with each. */
/* §Five Places a Velvet Pouch Gets Kept. `cap` is the label the reader sees. Each `cap` names the
   place in the frame that arrived, so the row reads as five locations rather than five pictures.
   The folder is NOT the brief. */
const scenes = [
  { cap: 'Out on the street', img: 'scene-1-v2', w: 1376, h: 768,
    alt: 'A woman in a denim jacket carrying a small patterned crossbody bag down a stone city street' },
  { cap: 'Lunch in the garden', img: 'scene-2-v2', w: 1376, h: 768,
    alt: 'A woman holding a glass on a garden terrace beside a stone fountain in the evening' },
  { cap: 'Under the tree', img: 'scene-3-v2', w: 1376, h: 768,
    alt: 'Father Christmas carrying a red velvet drawstring sack in front of a lit tree and wrapped presents' },
  { cap: 'At the wedding', img: 'scene-4-v2', w: 1376, h: 768,
    alt: 'A hand holding a small black velvet pouch in a bright venue set out with white chairs' },
  { cap: 'On the bar shelf', img: 'scene-5-v2', w: 1376, h: 768,
    alt: 'Two dark velvet wine bags stamped in gold standing on a bar shelf against a night-city painting' },
];

const certs = [
  { name: 'ISO 9001', img: `${VB}/compliance/iso-9001.webp`, w: 300, h: 300 },
  { name: 'FSC', img: `${VB}/compliance/fsc.webp`, w: 269, h: 300 },
  { name: 'BSCI', img: `${VB}/compliance/bsci.webp`, w: 300, h: 300 },
  { name: 'SEDEX', img: `${VB}/compliance/sedex.webp`, w: 636, h: 160 },
  { name: 'LWG', img: `${VB}/compliance/lwg.webp`, w: 300, h: 300 },
];

const stops = [
  { when: 'Day 0–1', name: 'Swatches and a price',
    d: 'Send the piece, or the size and the shade. Four fabrics go out as physical swatches, because pile weight cannot be chosen from a photograph of pile.',
    win: 'The cloth is in your hand before the price is.' },
  { when: 'Day 1–3', name: 'Pattern and artwork',
    d: 'The bag is drawn on its own pattern and the mark is placed at the size it will really stitch at, so a fine line is caught before it becomes thread.',
    win: 'Nothing is sewn to find out whether the mark works.' },
  { when: 'Day 3–7', name: 'A sewn sample',
    d: 'A finished bag off the real pattern, in the chosen cloth, with the closure fitted and the channel sewn. 5–7 days from sign-off, credited against the run.',
    win: 'The test happens on a bag rather than on a screen.' },
  { when: 'Week 2–5', name: 'The run',
    d: 'The bolt is laid out in a single direction before it is cut, so every panel catches light alike, and the seams are checked as the bags move. 4–6 weeks door to door by sea.',
    win: 'What arrives is what was approved, at the quantity on the order.' },
  { when: 'On dispatch', name: 'Inspection and carton',
    d: 'Each unit is checked at the seam and at the channel opening, then folded flat and packed with a packing sheet and the retained swatch.',
    win: 'Under 0.2 % of what ships arrives unusable, and the reference chip rides with it.' },
];

/* The source page's own two reviewers, held to three paragraphs each. David
   Brooks' quote carries no figure in the original and therefore carries none
   here; Emma Rodriguez' 500 units is hers. The two must not share a sentence
   frame — the openings, the middles and the closes are all deliberately
   different shapes. */
const quotes = [
  { name: 'David Brooks', role: 'Product Manager · United States', img: `${VB}/avatar-david.webp`,
    alt: 'Portrait of David Brooks',
    p: [
      'Our watches leave the service bench in these pouches as well as leaving the shop in them, which means the bag has to look right in a hand at a counter and survive a courier on the same day. What settled it was the stitching. The channel is straight and the seam does not pull, which I could not say about the samples we were sent before this.',
      'Sizing was a short conversation because it was specific. We gave the case dimensions and the worst bracelet we make, and the pouch that came back fits without the watch moving inside it.',
      'Sheen held across the reorder. Same depth of pile, same color, no drift into a duller batch — the argument I had expected to have, and did not.',
    ] },
  { name: 'Emma Rodriguez', role: 'Event Planner · United States', img: `${VB}/avatar-emma.webp`,
    alt: 'Portrait of Emma Rodriguez',
    p: [
      'Five hundred pouches for a client’s anniversary dinner, stamped in gold with the date. The bag was the wrapping and the keepsake at once, and it had to pass as both.',
      'I had one afternoon to choose a size, which is no way to buy packaging. Swatches arrived, and a straight answer came with them about which of the three sizes the giveaway belonged in — the part a catalogue cannot tell you.',
      'It landed ahead of the date printed on it, and the foil was sharp on all five hundred. Two more events have gone out on the same build since, in a different color each time, and the pouch has not been the thing that held anything up.',
    ] },
];

/* Six decisions §the sections above do not make for the buyer. Each was checked against the band
   nearest to it: the Pantone minimum is already under the fabric table and in service 04, the
   fine-line answer is already the woven-label card in §Five Ways, and the child-safe answer is
   already the azo line in §Four Tests, so all three were replaced rather than rephrased. What is
   left — lining, artwork to send, closure, the size of a set, what one run may mix, and the four
   lines behind the unit price — is answered on this page once, here. */
const faqs = [
  { q: 'What size pouch holds a necklace and its matching earrings?',
    a: 'Measure the longest dimension of the piece and allow 15 mm of clearance on every side. A 45 cm chain doubled over sits in a 4 × 6 in pouch, and studs disappear in anything above 3 × 4 in, so a set usually reads as one 4 × 6 and two 3 × 4 rather than one bag for the lot. Inches are enough to quote from.' },
  { q: 'Which lining belongs inside a silver pouch, and which inside a gift pouch?',
    a: 'Tarnish cloth where the piece is going to be stored, because silver and gold dull on the inside of the cloth rather than on the outside air. Satin where the pouch is presentation and the piece moves to a box the same evening. A lining is a second component sewn into the same seam, so it moves the sewing line of the quote rather than the cloth line.' },
  { q: 'What do I send so the artwork can be used as it is?',
    a: 'A vector outline rather than a picture, with the strokes already at the width the route needs: 0.5 mm for a foil stamp or a deboss, 2 mm for embroidery. A raster file is redrawn here first, and the redraw comes back as a line drawing to approve before anything is priced. Pantone references rather than screen colors for anything printed.' },
  { q: 'How do I choose between a cord, a zip and a frame clasp?',
    a: 'A cord or a ribbon where the pouch is opened often and closed with one pull, and where nothing inside is small enough to fall out. A zip where the pouch becomes a case and travels in a handbag, because the contents are held even upside down. A frame clasp where the bag is carried by the hand instead of kept in a drawer — on that build the closure is the point rather than an addition.' },
  { q: 'Can one run carry more than one size or color?',
    a: 'Yes, and the 500-unit minimum applies to the order rather than to each variant, so a first run can be three sizes in two colors. Weight and packing follow the total count rather than the number of variants. A second mark is the one change that arrives with its own setup.' },
  { q: 'How is the price built?',
    a: 'Four lines: the cloth, the sewing and the closure, the mark, and the packing. Cloth and sewing are per unit and fall as the quantity rises. The mark is the line a first order carries and a reorder does not, because an embroidery card, a screen or a stamping die is made once and filed against your pattern. Packing follows how the pouches leave — loose, or folded into a kit.' },
];

const seo = {
  title: 'Custom Velvet Bags Manufacturer: 4 Velvets, 500-Unit Minimum',
  description: 'Velvet pouches lined with tarnish cloth that holds silver bright for 18 months. Four velvets, cut in one direction and sewn from 500 units. Samples in 5–7 days.',
  keywords: 'custom velvet bags manufacturer, custom velvet pouches manufacturer, custom velvet drawstring bags manufacturer, wholesale custom velvet bags, OEM velvet bags manufacturer, custom velvet jewelry bags manufacturer, custom velvet gift bags manufacturer, custom velvet dust bags manufacturer, custom logo velvet bags factory, velvet pouch manufacturer China, custom velvet bags wholesale, luxury velvet packaging manufacturer',
  canonical: 'https://www.leelinepackage.com/custom-velvet-bags/',
  ogImage: `${VB}/hero-plate-v2.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Velvet Bags Manufacturing',
      description: seo.description,
      serviceType: 'Custom velvet bag and pouch manufacturing — cloth selection across premium, crushed, satin and printed velvet, pattern cutting with the pile laid one direction, sewn drawstring channels and zip closures, tarnish-cloth and satin linings, embroidery, foil stamping, screen printing and debossing, and wholesale runs from 500 units',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Velvet Bags' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${VB}/hero-plate-v2.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============================================================ 1. HERO
         H1 and lede replaced with the client's own copy (2026-09-20). The 25% figure is the
         client's and is NOT one of the audited site numbers (500 · 5–7 days · 4–6 weeks ·
         <0.2% · 180–250 GSM) — flagged, left as supplied. -->
    <section class="hero" id="vb-hero">
      <div class="wrap hero-in">
        <div>
          <span class="eyebrow"><Fragment set:html={leaf} />Six cloths, one pattern</span>
          <h1 class="hero-title">Custom Velvet Bags Manufacturer: 180–250 GSM Low-Lint Linings for <em>Scratch-Safe Product Packaging</em></h1>
          <p class="hero-lede">Cut transit scratch returns by up to 25% with static-safe velvet pouches that stay non-abrasive in shipment. Non-flaking hot stamping and low-lint lining keep high-shine jewelry and luxury metals presentation-ready, with physical samples in 5–7 days.</p>
          <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">Get My Velvet Quote<Fragment set:html={arrow} /></a>
        </div>
        <div class="cluster">
          <figure class="plate"><img src={`${VB}/hero-plate-v2.webp`} alt="A mustard velvet drawstring pouch foil-stamped Milan and Co with a sage pouch and a black pouch monogrammed in white, nested in white sheepskin with eucalyptus and cotton bolls" width="1376" height="768" loading="eager" fetchpriority="high" decoding="sync" /></figure>
          <figure class="plate cluster-sub"><img src={`${VB}/hero-sub.webp`} alt="Nine velvet drawstring pouches fanned out in blush, red, camel, black, blue and sage on a white ground, with a camel flat pouch in front" width="1332" height="1332" loading="lazy" decoding="async" /></figure>
        </div>
