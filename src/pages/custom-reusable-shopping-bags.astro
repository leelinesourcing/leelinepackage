---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const R2 = 'https://img.leelinepackage.com';
const RS = `${R2}/reusable-shopping-bags`;

/* The nine shells. Every card carries a spec the factory actually holds and one
   consequence the buyer's customer feels — no two cards make the same claim. */
const types = [
  { n: '01', key: 'type-nonwoven-v2', name: 'Non-Woven Reusable Bags', spec: '80–120 gsm PP',
    alt: 'Orange, maroon and light blue nonwoven shopping bags printed with a fruit mark and a logo',
    d: 'Cheap enough to hand out by the thousand at a checkout and still take a full shop home.' },
  { n: '02', key: 'type-rpet-v2', name: 'Recycled PET Bags', spec: 'GRS certified',
    alt: 'Black, blue and natural recycled PET shopping bags printed with recycle-message artwork',
    d: 'Ten to eighteen collected bottles go into each shell, and the paperwork to prove it travels with the lot.' },
  { n: '03', key: 'type-jute-v2', name: 'Jute and Burlap Bags', spec: '280–340 gsm',
    alt: 'Three natural jute gift bags with cotton rope handles and cream satin bows',
    d: 'Stands up on its own, holding a logo square on a shelf instead of slumping into the corner.' },
  { n: '04', key: 'type-canvas-v2', name: 'Custom Canvas Bags', spec: '10–16 oz cotton',
    alt: 'A black, a cream and a navy-handled cotton canvas tote, one printed with a line-drawn flower',
    d: 'The bag a shopper keeps after the promotion, because the base never gave out.' },
  { n: '05', key: 'type-foldable-v2', name: 'Foldable Nylon Bags', spec: 'Packs into its own pouch',
    alt: 'Six foldable nylon bags in black, red, orange, yellow, green and blue, each in its own pouch',
    d: 'Goes into a coat pocket, then comes out again at the till — which is why giveaways in this shell get used.' },
  { n: '06', key: 'type-cooler-v2', name: 'Insulated Cooler Bags', spec: 'Foil-lined interior',
    alt: 'Red, maroon and navy insulated lunch bags with cross-stitched webbing handles',
    d: 'Holds a delivery at temperature from the counter to the door, then wipes out with a cloth.' },
  { n: '07', key: 'type-drawstring-v2', name: 'Drawstring Backpacks', spec: '210D–420D nylon',
    alt: 'Black, lime, red and royal blue drawstring backpacks with black cord straps',
    d: 'A conference giveaway that turns up at the gym months later, still carrying the brand.' },
  { n: '08', key: 'type-gift-v2', name: 'Luxury Reusable Gift Bags', spec: 'Rope handle, ribbon',
    alt: 'Cream, blush and pale blue gift bags with woven rope handles and printed branding',
    d: 'Leaves the boutique as part of the present rather than as something to throw away.' },
  { n: '09', key: 'type-laminated-v2', name: 'Laminated Reusable Bags', spec: 'Gloss or matte',
    alt: 'Red, black and blue laminated shopping bags with zip tops and webbing handles',
    d: 'Takes a wet shop and a full-color print without either spoiling the other.' },
];

/* Four certifications, each showing the scheme's own mark on a white tile. The
   source files ship with a white margin, so they were trimmed to the mark before
   upload — the w/h below are the trimmed sizes and are what the <img> declares. */
const certs = [
  { code: 'GOTS', full: 'Global Organic Textile Standard',
    key: 'cert-gots', w: 260, h: 260, mark: 'GOTS organic textile certification mark',
    d: 'The organic cotton in the canvas and blend shells.' },
  { code: 'GRS', full: 'Global Recycled Standard',
    key: 'cert-grs', w: 149, h: 68, mark: 'Global Recycled Standard certification mark',
    d: 'The recycled PET, with a TC certificate per lot.' },
  { code: 'FSC', full: 'Forest Stewardship Council',
    key: 'cert-fsc', w: 214, h: 260, mark: 'FSC Forest Stewardship Council certification mark',
    d: 'The board in hang tags and shipper cartons.' },
  { code: 'ISO 9001', full: 'Quality management system',
    key: 'cert-iso-9001', w: 255, h: 260, mark: 'ISO 9001:2015 certification mark',
    d: 'The process: AQL 2.5 inspection per lot.' },
];

/* The six fibers, photographed from the same distance under the same light. The
   recycled and laminated shells now show the client's own mill photography; the
   other four keep the sourced swatches until theirs arrive. */
const fabrics = [
  { key: 'fabric-organic-cotton', name: 'GOTS Organic Cotton', spec: 'Certified organic',
    alt: 'Rolled bolts of organic cotton jersey in cream, sage and natural brown',
    d: 'The softest thing that can sit on a shoulder, and it breaks back down at the end of its life.' },
  { key: 'fabric-canvas', name: 'Heavy-Duty Canvas', spec: '10–16 oz',
    alt: 'Folded natural cotton canvas showing a dense woven surface',
    d: 'The grocery and market weight. Built for a full trolley on repeat rather than a single season.' },
  { key: 'fabric-rpet-v2', name: 'RPET (Recycled PET)', spec: '10–18 bottles per bag',
    alt: 'Teal, purple, yellow, maroon and red recycled PET fabric swatches with pinked edges',
    d: 'Waterproof and light, spun from bottles that were already in circulation — the strongest story per dollar.' },
  { key: 'fabric-nonwoven', name: 'Non-Woven PP', spec: '80–120 gsm',
    alt: 'Bolts of lime green and blue nonwoven polypropylene fabric, close up',
    d: 'Shrugs off water and dirt, folds flat in a car, and costs little enough to give away in thousands.' },
  { key: 'fabric-jute', name: 'Natural Jute', spec: '280–340 gsm',
    alt: 'Folded natural jute burlap showing a coarse woven plant fiber',
    d: 'A plant fiber with a surface that suits organic and artisanal brands, and composts when it is done.' },
  { key: 'fabric-laminated-v2', name: 'Laminated Woven PP', spec: '100–140 gsm, filmed',
    alt: 'Blue laminated woven polypropylene folded back to show the gloss film over the weave',
    d: 'A woven shell under a gloss or matte film, which is what carries full-color artwork and a wet shop.' },
];

/* The signature module. Name and spec live in the rail; the single line that
   decides the choice lives on the stage, so nothing is written twice. */
const closures = [
  { id: 'tape', name: 'Peel-and-Seal Tape Tab', key: 'close-tape-v2', spec: 'Adhesive, resealable',
    alt: 'A hand peeling back the resealable tape strip along the lip of a clear bag',
    line: 'Seals flat and reseals, with no zip to catch or stud to lose.' },
  { id: 'anchor', name: 'Cross-Stitched Handle Anchor', key: 'close-anchor-v2', spec: 'Box-X stitch',
    alt: 'Close-up of a box-X cross stitch anchoring a canvas handle to a natural bag body',
    line: 'Fitted as standard to every shell that leaves carrying a load.' },
  { id: 'hook', name: 'Hook-and-Loop Closure', key: 'close-hook-loop-v2', spec: 'Hook-and-loop strip',
    alt: 'Fingers pulling apart a strip of black hook-and-loop fastener',
    line: 'For cooler and insulated shells opened and shut at the counter.' },
  { id: 'snap', name: 'Concealed Magnetic Snap', key: 'close-snap-v2', spec: 'Recessed, self-closing',
    alt: 'The two halves of a silver magnetic snap on the lining of a floral printed bag',
    line: 'For gift and boutique shells that need the printed face left clean.' },
  { id: 'stitch', name: 'Contrast Stitch Detail', key: 'close-stitch-v2', spec: 'Any thread color',
    alt: 'Cream contrast thread box-X stitching standing out against dark charcoal canvas',
    line: 'For shells where the logo sits close to a join and the seam shows.' },
  { id: 'cord', name: 'Drawstring', key: 'close-drawstring-v2', spec: 'Cinched cotton cord',
    alt: 'Two printed cotton drawstring pouches, one cinched shut, on a pale wood table',
    line: 'For produce bags and hardware-free promotional shells.' },
];

/* The checklist the finished bag is measured against. Only the title and the
   method are shown — the paragraph explaining why each one matters was saying
   the same thing twice. */
const checks = [
  { t: 'Durability',
    how: 'Handle joins are load-pulled on a sewn shell drawn from each batch, and a base seam is opened to read the stitch count against the spec.' },
  { t: 'Water and Weather',
    how: 'Coated and laminated shells go through a rub test and a water-spot check before the film is signed off.' },
  { t: 'Reusable and Washable',
    how: 'A sewn shell from the lot goes through 50 wash cycles, then the print is measured against the signed strike-off.' },
  { t: 'End of Life',
    how: 'Fiber content is confirmed against the mill certificate, and the GRS transaction certificate is issued against the lot number.' },
  { t: 'Versatility',
    how: 'The shell is built to the size and the load in the brief, and the dieline is proven on a white dummy before ink.' },
  { t: 'Finish',
    how: 'Hardware, thread and film are logged per lot, so a reorder pulls the same components rather than an equivalent.' },
];

/* Six print routes. One line each: the route and what we do about it, in a
   single sentence rather than a description followed by a repeat of it. `key`
   is the photograph of that route on the line. */
const print = [
  { key: 'route-screen-v2', name: 'Screen Printing',
    alt: 'A squeegee pulling green ink through a screen onto a cotton tote on a press bed',
    d: 'Lowest cost per bag on a long run. Artwork is separated for the shell it will print on, and the strike-off is approved on that fabric before the screens are committed.' },
  { key: 'route-embroidery-v2', name: 'Embroidery',
    alt: 'A ten-needle embroidery machine stitching a multicolor swirl onto white fabric',
    d: 'A raised stitched badge. The logo is digitized for the needle rather than auto-converted, so thin strokes do not close up in thread.' },
  { key: 'route-digital-v2', name: 'Digital Printing',
    alt: 'A direct-to-garment printer laying a full-color illustration onto a cotton tote bag',
    d: 'Photographic artwork with no screen or plate charge, which is what makes a 500-unit first run viable.' },
  { key: 'route-sublimation-v2', name: 'Sublimation',
    alt: 'A wide-format roll printer running printed polyester fabric under the print head',
    d: 'Edge-to-edge color on light polyester and nylon. The shell is checked for fiber first, because the dye will not take on cotton.' },
  { key: 'route-transfer-v2', name: 'Thermal Transfer',
    alt: 'Hands aligning a floral transfer film on a cotton tote under a heat press arm',
    d: 'Fine detail, gradients and thin type. A strike-off is pressed on the actual shell to check the smallest type before the run.' },
  { key: 'route-laminate-v2', name: 'Laminated and Foil',
    alt: 'A roll laminating line running printed film onto woven fabric in the factory',
    d: 'Full-color film or metallic foil for retail and gift shells, matched so a matte laminate does not flatten a foil printed beside it.' },
];

/* Six stages. The sample stages run while material is being booked, which is
   what keeps the whole run inside the four to six weeks quoted. */
const stages = [
  { when: 'Day 0', name: 'Artwork and Dieline', d: 'Files preflighted, dieline drawn, a 3D mockup back inside 24 hours.' },
  { when: 'Day 1–3', name: 'Material Booked', d: 'Fabric reserved against the run and the cert lot noted, while the sample is being sewn.' },
  { when: 'Day 3–8', name: 'White Dummy Sewn', d: 'A plain bag to your dimensions in 3–5 working days, settling size before ink.' },
  { when: 'Day 8–18', name: 'Printed Sample', d: 'One shell in the final fabric, 7–10 days, with the color signed off on paper.' },
  { when: 'Day 18–33', name: 'Print and Sew', d: 'The full run printed panel by panel, then cut, sewn, trimmed and turned.' },
  { when: 'Day 33–38', name: 'Inspect and Pack', d: 'AQL 2.5 across the lot, folded, wrapped against moisture, pallet strapped.' },
];

/* Six places the finished bags end up. Each panel is the client's own
   photograph of that setting. */
const scenes = [
  { key: 'scene-1-v2', cap: 'Grocery and Supermarket Checkout',
    alt: 'Shoppers at a collection counter holding printed reusable bags in green, orange and blue',
    d: 'Bought at the till, then brought back for the following week of shopping.' },
  { key: 'scene-3-v2', cap: 'Boutique and High-Street Retail',
    alt: 'A shopper crossing a sunlit street carrying a printed boutique shopping bag',
    d: 'Handed over with the purchase, so the packaging leaves with the customer.' },
  { key: 'scene-2-v2', cap: 'Farmers Markets and Produce',
    alt: 'A shopper filling a cotton tote and a mesh produce bag at a vegetable display',
    d: 'Filled, wiped down and reused across a full market day.' },
  { key: 'scene-4-v2', cap: 'Food Delivery and Takeaway',
    alt: 'A person carrying several loaded green reusable bags through a doorway',
    d: 'Carried from the counter to the door, then loaded again on the next shift.' },
  { key: 'scene-5-v2', cap: 'Expos and Promotional Giveaways',
    alt: 'A rack of printed giveaway bags in green, red, blue and yellow in a shop',
    d: 'Picked up at a stand and still in use months later.' },
  { key: 'scene-6-v2', cap: 'Gym, School and Campus',
    alt: 'Two drawstring bags being packed by a couple sitting on a living-room floor',
    d: 'The second life a giveaway earns once it leaves the event.' },
];

/* The reviewers are the source page's own two, expanded. No figure has been
   introduced that was not already in their original comments. */
const quotes = [
  { name: 'David Nguyen', role: 'Event Manager · EcoLife Expo', img: `${RS}/avatar-david.webp`,
    alt: 'Portrait of David Nguyen',
    p: [
      'For the sustainability fair we needed bags that looked considered and could still take a stack of heavy event materials. That combination is harder to buy than it sounds.',
      'They arrived packed flat and in order, and the print was identical across every piece. After three days of being loaded, unloaded and carried across the hall, the handles were still firm and comfortable.',
      'We are ordering the same build again next year, which is the only review that really counts.',
    ] },
  { name: 'Laura Martinez', role: 'Operations Coordinator · City Farmers Market', img: `${RS}/avatar-laura.webp`,
    alt: 'Portrait of Laura Martinez',
    p: [
      'These came out better than the sample suggested. They fold down small enough to live behind the checkout counter, and the surface wipes clean in seconds after a market day.',
      'The vendors took to them immediately. The branding sits well on the weave instead of looking like a sticker dropped on top of it.',
      'Ordering was straightforward and the delivery landed two days ahead of the date we had planned around.',
    ] },
];

/* Everything the body sections do not already answer: how a price is built,
   color count, wash behavior, mixed orders, the certificates, and matching
   to a Pantone chip. */
const faqs = [
  { q: 'What actually decides the price of a printed reusable bag?',
    a: 'Four things: fabric weight, the number of print colors, the closure hardware, and the run length. A single-color nonwoven shell and a four-color laminated shell at the same quantity are not the same bag. The quote lists the screen or plate charge as its own line, which is why a repeat order visibly drops it.' },
  { q: 'How many colors can a screen-printed bag carry?',
    a: 'Each color is a separate screen and a separate pass. That count drives both cost and drying time. Three or four colors on canvas is routine. Once a design needs more than that, digital or thermal transfer usually works out cheaper at 500 units — the print route follows the artwork rather than the other way round.' },
  { q: 'Will the print survive washing?',
    a: 'That is a question about the route, not the shell. Embroidery is thread and takes the wash better than any ink. A screen print on canvas and a laminated print both hold through normal household cycles. A thin transfer on a fiber it was not formulated for is the combination that fails, so tell us the wash regime and the artwork is separated with that in mind.' },
  { q: 'Can a single order cover several styles or fabrics?',
    a: 'Yes. The 500-unit minimum applies per style. Two styles means two lots and two inspection reports, written into the quote upfront rather than discovered when the packing list arrives, and it is why a mixed order is often worth splitting across two deliveries.' },
  { q: 'Do the bags come with the certification documents?',
    a: 'They do. Organic cotton and blend shells travel with their GOTS paperwork, recycled shells with GRS documentation, and the AQL 2.5 inspection report for the lot is issued with the shipping papers. Certificate scans arrive with the quote, letting a compliance team read them before the order is placed rather than after.' },
  { q: 'How is a color matched to a Pantone chip on a dyed fabric?',
    a: 'A dyed shell and an ink film will not land on a coated Pantone chip on the first pull, and anyone who promises otherwise has not done it. The fabric is dyed first, the ink is then mixed against that dyed surface, and the strike-off is measured next to the chip and signed. The signed bag is held as the reference for later reprints.' },
];

const seo = {
  title: 'Custom Reusable Shopping Bags Wholesale: 9 Styles, rPET, GRS',
  description: 'Custom reusable shopping bags in nine styles and six eco-certified fabrics. GRS and GOTS material with TC transaction certificates and 4-6 week production runs.',
  keywords: 'custom reusable shopping bags, reusable shopping bags manufacturer, reusable shopping bags wholesale, eco friendly reusable bags manufacturer, custom printed reusable bags China, 100% post consumer rPET bags, GRS certified reusable bags, PPWR compliant reusable bags, carbon reduction reusable bags, RPET recycled shopping bags bulk, custom reusable bags, reusable grocery bags manufacturer, non woven reusable bags, insulated reusable shopping bags, jute reusable bags, custom canvas bags, foldable reusable bags',
  canonical: 'https://www.leelinepackage.com/custom-reusable-shopping-bags/',
  ogImage: `${RS}/hero-left.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Reusable Shopping Bag Manufacturing',
      description: seo.description,
      serviceType: 'Custom reusable shopping bag design, printing and manufacture in organic cotton, canvas, jute, recycled PET and nonwoven',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Reusable Shopping Bags' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const arrow = '<svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const leaf = '<svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>';
/* width/height must be attributes, not CSS: this string is injected with
   set:html, so a scoped `.rs-stars svg` rule never matches it and the SVG
   collapses to zero width inside the inline-flex wrapper. */
const star = '<svg viewBox="0 0 24 24" width="16" height="16" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6-4.8-4.6 6.6-.9z" fill="currentColor"/></svg>';
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  preloadImage={`${RS}/hero-left.webp`}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ 1. HERO — storefront band, ivory card overlapping ============ -->
    <section class="rs-hero" id="rs-hero">
      <div class="rs-band">
        <img src={`${RS}/hero-left.webp`} alt="Five printed cotton reusable shopping bags in white, teal, yellow, pink and navy on a gray blanket"
             width={800} height={533} loading="eager" fetchpriority="high" decoding="sync" />
        <img src={`${RS}/hero-right.webp`} alt="A shopper carrying a large natural jute reusable shopping bag with cotton rope handles"
             width={1000} height={667} loading="eager" fetchpriority="high" decoding="sync" />
      </div>

      <div class="wrap rs-card-wrap">
        <div class="rs-card" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Reusable bags &middot; GRS certified</span>
          <h1 class="rs-title">Custom Reusable Shopping Bags Manufacturer: 100% Post-Consumer rPET with Up to <em>45% Carbon Reduction</em></h1>
          <p class="rs-lede">Work with a GRS-certified custom reusable shopping bags manufacturer offering full TC transaction certificates and seams tested across 50 wash cycles — so recycled content is verified, bags stay intact in repeat use, and your spec is ready for EU PPWR review.</p>
          <div class="rs-actions">
            <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
              Price My Reusable Bag
              <Fragment set:html={arrow} />
            </a>
          </div>
        </div>

        <!-- None of these restate the headline's numbers (100% / 45% / 50 / TC)
             or another section's lead claim — each one introduces a figure the
             page has not given yet. -->
        <ul class="rs-stats" data-reveal="up">
          <li><strong>10&ndash;18</strong> bottles recycled per rPET shell</li>
          <li><strong>24 h</strong> from artwork to a 3D mockup</li>
          <li><strong>3&ndash;5 days</strong> to a white dummy in your size</li>
          <li><strong>4</strong> certifications held by the plant</li>
        </ul>
      </div>
    </section>

    <!-- ============ 2. NINE STYLES — catalogue cards, three per row ============ -->
    <section class="rs-types" id="rs-types">
      <div class="wrap">
        <div class="section-head section-head--center" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />The range</span>
          <h2 class="section-title">Nine Reusable Shopping Bag Styles, Printed to One Standard</h2>
          <p class="section-sub rs-sub">Whatever the shell, the terms underneath are identical: a 500-unit first run, ink matched to your Pantone, and an inspection report dated before the pallet is strapped.</p>
        </div>

        <ul class="rs-type-grid">
          {types.map((t, i) => (
            <li class="rs-type" data-reveal="up" style={`--d:${(i % 3) * 0.07}s`}>
              <img src={`${RS}/${t.key}.webp`} alt={t.alt} width={520} height={520} loading="lazy" decoding="async" />
              <div class="rs-type-body">
                <span class="rs-type-top"><b>{t.n}</b><i>{t.spec}</i></span>
                <h3>{t.name}</h3>
                <p>{t.d}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="section-cta">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Send Your Bag Spec
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 3. MID CTA — type over the client's own studio shot ============ -->
    <section class="rs-mid" id="rs-mid">
      <div class="wrap rs-mid-inner" data-reveal="up">
        <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />Next step</span>
        <h2 class="rs-mid-title">One Sample Bag Answers Most of It</h2>
        <p class="rs-mid-sub">Send artwork, a size and a quantity. A white dummy and a printed shell come back with the price written against them, and the recycled content already documented for your compliance file.</p>
        <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
          Request a Sample Bag
          <Fragment set:html={arrow} />
        </a>
      </div>
    </section>

    <!-- ============ 4. CERTIFICATIONS — dark band, iconed seals ============ -->
    <section class="rs-certs" id="rs-certs">
      <div class="wrap rs-cert-grid">
        <div class="rs-cert-head">
          <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />Papers, not promises</span>
          <h2 class="section-title">Certified: GOTS, GRS, FSC and ISO 9001</h2>
          <p class="rs-cert-note">Each certificate covers a different part of the order. Scans and lot numbers travel with the quote rather than following the invoice.</p>
        </div>
        <ul class="rs-cert-list">
          {certs.map((c) => (
            <li data-reveal="up">
              <span class="rs-cert-badge">
                <img src={`${RS}/${c.key}.webp`} alt={c.mark}
                     width={c.w} height={c.h} loading="lazy" decoding="async" />
              </span>
              <span class="rs-seal">{c.code}</span>
              <strong>{c.full}</strong>
              <p>{c.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 5. FABRICS — the sample card, six swatches ============ -->
    <section class="rs-fabrics" id="rs-fabrics">
      <div class="wrap">
        <div class="section-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />The sample card</span>
          <h2 class="section-title">Six Fabrics, and What Each Does After Printing</h2>
          <p class="section-sub rs-sub">Photographed at the same distance under the same light. Pick two shells and the sample bag arrives to compare both against the artwork.</p>
        </div>

        <ul class="rs-fab-grid">
          {fabrics.map((f, i) => (
            <li class="rs-fab" data-reveal="up" style={`--d:${(i % 3) * 0.07}s`}>
              <img src={`${RS}/${f.key}.webp`} alt={f.alt} width={300} height={300} loading="lazy" decoding="async" />
              <h3>{f.name}</h3>
              <span class="rs-chip">{f.spec}</span>
              <p>{f.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 6. CLOSURES — the signature, an interactive selector ============ -->
    <section class="rs-closures" id="rs-closures">
      <div class="wrap">
        <div class="section-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />The signature module</span>
          <h2 class="section-title">Six Closures, and Where Each Belongs</h2>
          <p class="section-sub rs-sub">The closure is the first part of the bag a customer touches and the first part that fails if it was chosen by habit. Pick a closure to see what it decides.</p>
        </div>

        <!-- A stage and a numbered rail. The rail names the six; the stage shows
             the one line that decides it. The stage stretches to the rail's height,
             so the image can never be a different size from the list beside it. -->
        <div class="rs-close-mod">
          <figure class="rs-close-stage" id="rs-close-stage" role="tabpanel"
                  aria-labelledby="rs-close-tab-0" data-reveal="up">
            <span class="rs-close-count"><b id="rs-close-num">01</b> / 06</span>
            <button type="button" class="rs-close-nav rs-close-prev" data-step="-1" aria-label="Previous closure">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="rs-close-nav rs-close-next" data-step="1" aria-label="Next closure">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <img id="rs-close-img" src={`${RS}/${closures[0].key}.webp`} alt={closures[0].alt}
                 width={1024} height={1024} loading="lazy" decoding="async" />
            <figcaption class="rs-close-cap"><p id="rs-close-line">{closures[0].line}</p></figcaption>
          </figure>

          <div class="rs-close-col">
            <div class="rs-close-head">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              Select a closure
            </div>
            <ul class="rs-close-idx" id="rs-close-idx" role="tablist" aria-label="Closures">
              {closures.map((c, i) => (
                <li>
                  <button type="button" role="tab" id={`rs-close-tab-${i}`} data-i={i}
                          data-src={`${RS}/${c.key}.webp`} data-line={c.line} data-alt={c.alt}
                          aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                    <span class="rs-close-ring">{String(i + 1).padStart(2, '0')}</span>
                    <span class="rs-close-txt">
                      <span class="rs-close-name">{c.name}</span>
                      <span class="rs-close-spec">{c.spec}</span>
                    </span>
                    <span class="rs-close-chev">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="section-cta">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Pick My Closure Hardware
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 7. INSPECTION SHEET — what is checked and how ============ -->
    <section class="rs-survive" id="rs-survive">
      <div class="wrap">
        <div class="rs-sheet" data-reveal="up">
          <header class="rs-sheet-head">
            <div>
              <span class="eyebrow"><Fragment set:html={leaf} />Pass or fail</span>
              <h2 class="section-title">Six Things Every Bag Is Checked Against</h2>
            </div>
            <span class="rs-sheet-stamp">AQL 2.5 &middot; each lot</span>
          </header>
          <ul class="rs-check-list">
            {checks.map((c) => (
              <li>
                <svg class="rs-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5l5 5 10-11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <div>
                  <h3>{c.t}</h3>
                  <p>{c.how}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ 8. PRINTING — six routes as six cards ============ -->
    <section class="rs-print" id="rs-print">
      <div class="wrap">
        <div class="section-head section-head--center" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Printing</span>
          <h2 class="section-title">Six Print Routes, Matched to the Fabric and the Run</h2>
          <p class="section-sub rs-sub">The artwork decides the route. A photographic design and a flat single-color mark rarely travel the same way, and the run length settles the rest. Whichever route is chosen, the separation work is done here rather than left to the printer.</p>
        </div>

        <ul class="rs-route-grid">
          {print.map((p, i) => (
            <li class="rs-route" data-reveal="up" style={`--d:${(i % 3) * 0.07}s`}>
              <img class="rs-route-img" src={`${RS}/${p.key}.webp`} alt={p.alt}
                   width={1000} height={562} loading="lazy" decoding="async" />
              <h3>{p.name}</h3>
              <p class="rs-route-d">{p.d}</p>
            </li>
          ))}
        </ul>

        <div class="section-cta">
          <a class="btn btn-primary" href="/contact/" target="_blank" rel="noopener">
            Review My Artwork
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>

    <!-- ============ 9. PROCESS — six-stage stepper ============ -->
    <section class="rs-flow" id="rs-flow">
      <div class="wrap">
        <div class="section-head section-head--center" data-reveal="up">
          <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />The run</span>
          <h2 class="section-title">From Artwork to Pallet in 4&ndash;6 Weeks</h2>
          <p class="section-sub rs-sub">Six stages, with the two sample rounds running while material is being booked rather than after it. That overlap is what keeps the calendar where it is.</p>
        </div>

        <ol class="rs-flow-list">
          {stages.map((s, i) => (
            <li data-reveal="up" style={`--d:${i * 0.06}s`}>
              <span class="rs-flow-dot" aria-hidden="true"></span>
              <span class="rs-flow-when">{s.when}</span>
              <h3>{s.name}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>

        <p class="rs-flow-foot" data-reveal="up">Sample charges are credited back against the production order, so the two sample rounds cost the run nothing once the run is placed.</p>
      </div>
    </section>

    <!-- ============ 10. SCENES — six places, three-up carousel ============ -->
    <section class="rs-scenes" id="rs-scenes">
      <div class="wrap">
        <div class="rs-scenes-head" data-reveal="up">
          <div>
            <span class="eyebrow"><Fragment set:html={leaf} />In use</span>
            <h2 class="section-title">Six Places These Bags End Up</h2>
            <p class="section-sub rs-sub">Where the order actually lives after it ships — six settings, photographed on the job.</p>
          </div>
        </div>

        <div class="rs-scenes-viewport" data-reveal="up">
          <ul class="rs-scenes-track" id="rs-scenes-track">
            {scenes.map((sc) => (
              <li class="rs-scene">
                <img class="rs-scene-img" src={`${RS}/${sc.key}.webp`} alt={sc.alt}
                     width={1200} height={670} loading="lazy" decoding="async" />
                <h3>{sc.cap}</h3>
                <p>{sc.d}</p>
              </li>
            ))}
          </ul>

          <div class="rs-scenes-ctrl">
            <button type="button" class="rs-scenes-btn" data-step="-1" aria-label="Previous scene">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="rs-scenes-btn" data-step="1" aria-label="Next scene">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 11. TESTIMONIALS — quote-mark cards ============ -->
    <section class="rs-quotes" id="rs-quotes">
      <div class="wrap">
        <div class="section-head section-head--center" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />In their words</span>
          <h2 class="section-title">What Two Buyers Said After the First Run</h2>
        </div>

        <div class="rs-quote-grid">
          {quotes.map((q) => (
            <figure class="rs-quote" data-reveal="up">
              <span class="rs-quote-mark" aria-hidden="true">&ldquo;</span>
              <blockquote>
                {q.p.map((para, pi) => (
                  <p>{para}{pi === q.p.length - 1 && (<span class="rs-quote-close" aria-hidden="true">&rdquo;</span>)}</p>
                ))}
              </blockquote>
              <figcaption>
                <img src={q.img} alt={q.alt} width={160} height={160} loading="lazy" decoding="async" />
                <span><strong>{q.name}</strong><em>{q.role}</em></span>
                <span class="rs-stars" role="img" aria-label="Rated 5 out of 5"><Fragment set:html={star.repeat(5)} /></span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 12. FAQ — centred head, one column down the page ============ -->
    <section class="rs-faq" id="rs-faq">
      <div class="wrap">
        <div class="rs-faq-head" data-reveal="up">
          <span class="eyebrow"><Fragment set:html={leaf} />Questions</span>
          <h2 class="section-title">What Buyers Ask Before a Reusable Bag Order</h2>
        </div>

        <div class="rs-faq-list" data-reveal="up">
          {faqs.map((f, i) => (
            <details>
              <summary><span class="rs-faq-n">{String(i + 1).padStart(2, '0')}</span>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 13. FINAL CTA — centred over the client's own photograph ============ -->
    <section class="rs-final" id="rs-final">
      <div class="rs-final-bg" aria-hidden="true"></div>
      <div class="rs-final-scrim" aria-hidden="true"></div>
      <div class="wrap rs-final-inner" data-reveal="up">
        <span class="eyebrow eyebrow--light"><Fragment set:html={leaf} />Start here</span>
        <h2 class="rs-final-title">A Bag That Outlives the Campaign It Was Ordered For</h2>
        <p class="rs-final-sub">Send the artwork, the size and the quantity. A price and a sample plan come back against them, with the certificate scans attached.</p>
        <a class="btn btn-gold" href="/contact/" target="_blank" rel="noopener">
          Get My Bag Quote
          <Fragment set:html={arrow} />
        </a>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ============ local atoms ============ */
  [data-reveal] { opacity: 0; transform: translateY(36px); transition: opacity 0.8s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1); transition-delay: var(--d, 0s); }
  [data-reveal='right'] { transform: translateX(44px); }
  [data-reveal='left'] { transform: translateX(-44px); }
  [data-reveal].in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  :global(body) { background: var(--color-brand-bg); }

  /* The shared .section-sub caps at 46ch, which wraps a full sentence head to
     three lines. Widen the measure on this page rather than cutting the copy. */
  .rs-sub { max-width: 74ch; }
  .section-head--center .rs-sub { max-width: 78ch; }

  .rs-chip {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--brass);
    background: rgba(176, 141, 76, 0.1);
    border: 1px solid rgba(176, 141, 76, 0.26);
    border-radius: 999px;
    padding: 0.34rem 0.72rem;
  }

  /* ============ 1. HERO ============ */
  .rs-hero { background: var(--ivory); padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .rs-band {
    display: grid; grid-template-columns: 1.04fr 0.96fr; gap: 2px;
    height: clamp(230px, 34vw, 430px);
  }
  .rs-band img { width: 100%; height: 100%; object-fit: cover; }

  /* The H1 and lede are centred and larger than the other product pages; the
     card stays ivory and still overlaps the band, so the style is unchanged. */
  .rs-card-wrap { padding-top: 0; }
  .rs-card {
    position: relative; z-index: 2;
    max-width: 62rem;
    /* lifted a further 1 cm into the photo band; the clamp is the base overlap */
    margin-top: calc(clamp(-7rem, -8vw, -4rem) - 1cm);
    margin-inline: auto;
    text-align: center;
    background: var(--ivory);
    border-radius: 1.5rem;
    box-shadow: 0 48px 96px -62px rgba(31, 59, 44, 0.62);
    padding: clamp(2rem, 4vw, 3.2rem) clamp(1.6rem, 4vw, 3.4rem);
  }
  .rs-title {
    margin: 1.2rem 0 0;
    font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(1.7rem, 4.1vw, 3.05rem); line-height: 1.06; letter-spacing: -0.028em;
    color: var(--color-brand-text);
    max-width: 34ch; margin-inline: auto; text-wrap: balance;
  }
  .rs-title em { font-style: italic; color: var(--brass); }
  .rs-lede {
    margin: 1.3rem auto 0; max-width: 74ch;
    font-size: clamp(1.04rem, 1.45vw, 1.16rem); line-height: 1.74;
    color: var(--color-brand-muted);
  }
  .rs-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin-top: 2rem; }

  .rs-stats {
    list-style: none; margin: clamp(2.2rem, 4vw, 3.2rem) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(31, 59, 44, 0.16);
  }
  .rs-stats li {
    padding: 1.25rem 1.1rem 0;
    border-left: 1px solid rgba(31, 59, 44, 0.12);
    text-align: center;
    font-size: 0.9rem; line-height: 1.5; color: var(--color-brand-muted);
  }
  .rs-stats li:first-child { border-left: 0; }
  .rs-stats strong {
    display: block; margin-bottom: 0.15rem;
    font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(1.45rem, 2.4vw, 1.95rem); line-height: 1.1; letter-spacing: -0.02em;
    color: var(--color-brand-text);
  }

  /* ============ 2. NINE STYLES ============ */
  .rs-types { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--ivory); }
  .rs-type-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.7rem);
  }
  .rs-type {
    /* Lighter than the old clay so the photographs do not read dark, but paired
       with a hairline edge and a soft lift so the card still reads as a card
       against the ivory band behind it. */
    background: color-mix(in srgb, var(--color-clay) 45%, var(--ivory));
    border: 1px solid rgba(31, 59, 44, 0.1);
    border-radius: 1.3rem; overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 18px 40px -36px rgba(31, 59, 44, 0.45);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.55s ease;
  }
  .rs-type:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -42px rgba(31, 59, 44, 0.5); }
  /* The nine photographs arrive as studio shots on white. Multiply drops that
     white into the card's own tone, so the picture sits on the page's colour
     instead of in a white box, and a small lift keeps the bags from going dull. */
  .rs-type img {
    width: 100%; aspect-ratio: 1 / 1; object-fit: cover;
    mix-blend-mode: multiply;
    filter: brightness(1.07) saturate(1.03);
  }
  .rs-type-body { padding: 1.15rem 1.25rem 1.35rem; }
  .rs-type-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.7rem; }
  .rs-type-top b {
    font-family: var(--font-heading); font-weight: 600; font-size: 0.98rem;
    letter-spacing: 0.02em; color: var(--brass);
  }
  .rs-type-top i {
    font-style: normal; font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-brand-muted);
    text-align: right;
  }
  .rs-type h3 {
    margin: 0.55rem 0 0; font-family: var(--font-heading); font-weight: 600;
    font-size: 1.16rem; line-height: 1.25; letter-spacing: -0.01em; color: var(--color-brand-text);
  }
  .rs-type p { margin: 0.55rem 0 0; font-size: 0.9rem; line-height: 1.62; color: var(--color-brand-muted); }

  /* ============ 4. CERTIFICATIONS ============ */
  .rs-certs {
    padding: clamp(3.4rem, 7vw, 5.6rem) 0;
    background: linear-gradient(150deg, var(--forest-light) 0%, var(--color-forest) 52%, var(--forest-deep) 100%);
  }
  .rs-cert-grid { display: grid; grid-template-columns: 0.86fr 2.14fr; gap: clamp(2rem, 4vw, 3.6rem); align-items: start; }
  .rs-cert-head .section-title { color: #fff; font-size: clamp(1.8rem, 3.2vw, 2.6rem); }
  .rs-cert-note { margin: 1.15rem 0 0; max-width: 40ch; font-size: 0.93rem; line-height: 1.68; color: rgba(245, 240, 229, 0.72); }
  .rs-cert-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.9rem, 1.8vw, 1.3rem); }
  .rs-cert-list li {
    border: 1px solid rgba(245, 240, 229, 0.24);
    border-radius: 1.1rem;
    padding: 1.25rem 1.15rem 1.35rem;
  }
  /* The scheme's own mark on a white tile. The files arrive with different
     baked-in backgrounds (FSC is white-on-green, ISO is blue-on-white), so the
     tile is what makes the row read as one set. */
  .rs-cert-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 4.4rem; height: 4.4rem; margin-bottom: 1rem;
    padding: 0.42rem;
    border-radius: 0.9rem;
    background: #fff;
    box-shadow: 0 12px 26px -20px rgba(0, 0, 0, 0.65);
  }
  .rs-cert-badge img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; }
  .rs-seal {
    display: block; padding-bottom: 0.5rem;
    font-family: var(--font-heading); font-weight: 600; font-size: 1.42rem; letter-spacing: -0.01em;
    color: #E3C29A;
  }
  .rs-cert-list strong {
    display: block; margin-bottom: 0.6rem;
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(245, 240, 229, 0.62);
  }
  .rs-cert-list p { margin: 0; font-size: 0.86rem; line-height: 1.62; color: rgba(245, 240, 229, 0.82); }

  /* ============ 5. FABRICS ============ */
  .rs-fabrics { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--color-brand-surface); }
  .rs-fab-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.7rem);
  }
  .rs-fab {
    background: var(--ivory);
    border-radius: 1.2rem;
    padding: 0.85rem 0.85rem 1.4rem;
    box-shadow: 0 24px 50px -44px rgba(31, 59, 44, 0.5);
  }
  /* 4/3 rather than a square: at three across, the swatch was taking more of
     the card than the copy did. This is the ratio a photo sample wants. */
  .rs-fab img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.85rem; }
  .rs-fab h3 { margin: 1.1rem 0 0; font-family: var(--font-heading); font-weight: 600; font-size: 1.12rem; letter-spacing: -0.01em; color: var(--color-brand-text); }
  .rs-fab .rs-chip { margin-top: 0.6rem; }
  .rs-fab p { margin: 0.7rem 0 0; font-size: 0.9rem; line-height: 1.62; color: var(--color-brand-muted); }

  /* ============ 6. CLOSURES — a stage and a numbered rail ============ */
  .rs-closures { padding: clamp(4rem, 9vw, 8rem) 0; background: var(--ivory); }
  .rs-close-mod {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(1.4rem, 3vw, 2.6rem); align-items: stretch;
  }
  .rs-close-col { display: flex; flex-direction: column; min-width: 0; }
  .rs-close-head {
    display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.9rem;
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.17em; text-transform: uppercase;
    color: var(--brass);
  }
  .rs-close-head svg { width: 0.95rem; height: 0.95rem; }
  /* The rail defines the row height and the stage stretches to it, which is what
     keeps the photograph and the list exactly level at every width. */
  .rs-close-stage { position: relative; margin: 0; min-height: 300px; }
  .rs-close-stage img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    border-radius: 1.3rem; background: var(--color-clay);
  }
  .rs-close-stage::after {
    content: ''; position: absolute; inset: 0; border-radius: 1.3rem; pointer-events: none;
    background: linear-gradient(180deg, rgba(20, 38, 27, 0.1) 0%, rgba(20, 38, 27, 0) 34%, rgba(20, 38, 27, 0.86) 100%);
  }
  .rs-close-count {
    position: absolute; top: 0.95rem; left: 0.95rem; z-index: 2;
    font-family: var(--font-heading); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.06em;
    color: #fff; background: rgba(20, 38, 27, 0.5);
    border: 1px solid rgba(245, 240, 229, 0.32); border-radius: 999px; padding: 0.3rem 0.68rem;
  }
  .rs-close-count b { color: #E3C29A; }
  .rs-close-cap { position: absolute; left: 1.15rem; right: 1.15rem; bottom: 1.05rem; z-index: 2; }
  .rs-close-cap p {
    margin: 0; max-width: 42ch;
    font-size: 0.92rem; line-height: 1.62; color: rgba(245, 240, 229, 0.94);
  }
  .rs-close-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; cursor: pointer;
    width: 2.7rem; height: 2.7rem; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(245, 240, 229, 0.92); color: var(--color-brand-text);
