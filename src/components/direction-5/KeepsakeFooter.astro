---
import Ornament from './Ornament.astro';
---

<footer class="k-footer">
  <div class="container k-footer__inner">
    <div class="k-footer__brand">
      <span class="k-brand__mark"><Ornament variant="mark" class="k-brand__svg" /></span>
      <p class="k-footer__name">Leeline<em>Package</em></p>
      <p class="k-footer__tagline">The Structural Brand Architect.<br />Protect &amp; Impress.</p>
      <p class="k-footer__sign">
        <Ornament variant="flourish" class="k-footer__sign-orn" />
        Engineered, not just printed.
      </p>
    </div>

    <nav class="k-footer__col" aria-label="Packaging">
      <h4 class="k-footer__h">Packaging</h4>
      <a href="#atelier">Rigid Boxes</a>
      <a href="#atelier">Folding Cartons</a>
      <a href="#atelier">Corrugated Mailers</a>
      <a href="#atelier">Pouches &amp; Bags</a>
      <a href="#atelier">Tin, Acrylic &amp; Satin</a>
    </nav>

    <nav class="k-footer__col" aria-label="Company">
      <h4 class="k-footer__h">Company</h4>
      <a href="#work">Keepsakes</a>
      <a href="#craft">The Craft</a>
      <a href="#proof">Proof</a>
      <a href="#quote">Get a Free Quote</a>
    </nav>

    <div class="k-footer__col k-footer__contact">
      <h4 class="k-footer__h">Contact</h4>
      <p>Wuhan, Hubei, China</p>
      <a href="mailto:hello@leelinepackage.com">hello@leelinepackage.com</a>
      <p class="k-footer__social">
        <a href="#top" aria-label="Instagram">Instagram</a>
        <a href="#top" aria-label="LinkedIn">LinkedIn</a>
        <a href="#top" aria-label="Pinterest">Pinterest</a>
      </p>
    </div>
  </div>

  <div class="k-footer__base">
    <div class="container k-footer__baseline">
      <span>© 2026 LeelinePackage · The Unboxing Advantage</span>
      <span>ISO 9001 · FSC-certified · ISTA-tested</span>
    </div>
  </div>
</footer>
