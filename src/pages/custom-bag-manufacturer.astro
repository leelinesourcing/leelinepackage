---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

const R2 = 'https://img.leelinepackage.com';
const BAG = `${R2}/custom-bag`;

/* Why a brand picks us — five outcomes, no repeated claims. */
const why = [
  { n: '01', t: 'In-house design & R&D', d: 'A rough sketch becomes a runnable sample in-house — no separate design bill.' },
  { n: '02', t: 'Small runs, low risk', d: 'Order for the moment you are in, then scale up only once the demand is proven.' },
  { n: '03', t: 'Shipping that bends', d: 'Air, sea or DDP express — routed to the lowest landed cost for your market.' },
  { n: '04', t: 'Materials with a footprint', d: 'Recycled, renewable and FSC\u00ae-certified, so the label backs the claim.' },
  { n: '05', t: 'Certified & documented', d: 'ISO 9001 from the floor to the last QC check, with proof at every handoff.' },
];

/* The 9 bag types we produce. */
const types = [
  { name: 'Custom Tote Bags', img: `${BAG}/type-tote.webp`, w: 550, h: 525, alt: 'An ivory and black tote bag printed with a handwritten wordmark' },
  { name: 'Custom Reusable Shopping Bags', img: `${BAG}/type-reusable.webp`, w: 550, h: 525, alt: 'A cluster of colourful reusable shopping bags stacked together' },
  { name: 'Custom Paper Bag', img: `${BAG}/type-paper.webp`, w: 550, h: 525, alt: 'Several printed paper bags with handles arranged on a table' },
  { name: 'Custom Satin Bags', img: `${BAG}/type-satin.webp`, w: 550, h: 525, alt: 'Red and white satin drawstring pouches lying on a dark surface' },
  { name: 'Custom Velvet Bags', img: `${BAG}/type-velvet.webp`, w: 550, h: 525, alt: 'Velvet drawstring pouches in deep green, navy and burgundy' },
  { name: 'Custom Dust Bags', img: `${BAG}/type-dust.webp`, w: 550, h: 525, alt: 'Cotton dust bags with a printed botanical logo' },
  { name: 'Eco-Friendly Jute Bags', img: `${BAG}/type-jute.webp`, w: 550, h: 525, alt: 'Natural jute tote bags with a printed pattern' },
  { name: 'Custom Mesh Bags', img: `${BAG}/type-mesh.webp`, w: 550, h: 525, alt: 'Bright mesh drawstring bags in pink, yellow and teal' },
  { name: 'PVC Packaging Bags', img: `${BAG}/type-pvc.webp`, w: 550, h: 525, alt: 'Clear PVC pouches with printed accents' },
];

/* Capability band — what a real manufacturer does. */
const capability = [
  { n: '01', t: 'China Bag Factory', d: 'Launch a bag line without your own factory — every construction method sits with one supplier.' },
  { n: '02', t: 'OEM & ODM Bags', d: 'Your logo on a finished, shelf-ready bag — art, print and hardware set up and run for you.' },
  { n: '03', t: 'Design & Innovation', d: 'Stay a step ahead of what\u2019s in demand — 30% of our profit goes back into new processes yearly.' },
  { n: '04', t: 'Private Label Bags', d: 'Pick from 6,000+ styles and make one yours — tags, hardware and finishing tuned to your brand.' },
];

/* Materials. */
const materials = [
  { name: 'Organic Cotton', img: `${BAG}/material-cotton.webp`, w: 600, h: 400, alt: 'Layers of soft organic cotton fabric stacked in neutral and pastel tones', d: 'A soft, GMO-free feel buyers read as premium the moment it\u2019s in hand.' },
  { name: 'Heavy-Duty Canvas', img: `${BAG}/material-canvas.webp`, w: 600, h: 400, alt: 'A close-up of cream heavy-duty canvas weave', d: 'Tough enough for daily use, so your brand is carried into the world again and again.' },
  { name: 'Waterproof Nylon & Polyester', img: `${BAG}/material-nylon.webp`, w: 600, h: 400, alt: 'Black waterproof nylon fabric, sleek and smooth', d: 'Light and weatherproof \u2014 a sleek look that also keeps freight lean.' },
  { name: 'Recycled & Jute', img: `${BAG}/material-eco.webp`, w: 600, h: 400, alt: 'A roll of natural jute fabric', d: 'An eco fabric that holds a real sustainability story, without a plasticky feel.' },
];

/* Customisation levers. */
const customize = [
  { t: 'Size & Shape', d: 'Compact crossbody, roomy tote or a gift bag — cut to the exact dimension you need.' },
  { t: 'Functional Features', d: 'Compartments, padded laptop sleeves, waterproof linings and adjustable straps, so it carries exactly what the day needs.' },
  { t: 'Custom Linings', d: 'Patterned fabric, printed motifs or a logo inside — a small surprise on open.' },
  { t: 'Logo & Printing', d: 'Embroidery, screen print or embossing in your own pattern and palette — the brand shown where it is seen.' },
];

/* Industries we supply. */
const industries = [
  { name: 'Food & Beverage', img: `${BAG}/industry-food.webp`, w: 500, h: 400, alt: 'Liquid drink pouches with spouts', d: 'Preserves freshness and extends shelf life from production to consumption.' },
  { name: 'Agriculture & Seed', img: `${BAG}/industry-agriculture.webp`, w: 500, h: 400, alt: 'Seed packets arranged in rows', d: 'Shields against moisture, UV and weather from storage through shipment.' },
  { name: 'Electronics & Technology', img: `${BAG}/industry-electronics.webp`, w: 500, h: 400, alt: 'A padded electronic accessory pouch', d: 'Anti-static, moisture-resistant layers so components arrive intact.' },
  { name: 'Cosmetics & Personal Care', img: `${BAG}/industry-cosmetics.webp`, w: 500, h: 400, alt: 'A row of cosmetic bottles and pumps', d: 'Lightweight, moisture-proof and brand-forward, pristine on the shelf.' },
  { name: 'Chemical & Industrial', img: `${BAG}/industry-chemical.webp`, w: 500, h: 400, alt: 'Bulk industrial bags stacked on pallets', d: 'Leak-proof and chemical-resistant, built to international transport standards.' },
  { name: 'E-commerce & Retail', img: `${BAG}/industry-ecommerce.webp`, w: 500, h: 400, alt: 'A printed poly mailer bag with a branded design', d: 'Lightweight, customisable and eco-friendly, for a memorable unboxing.' },
];

/* Real-life examples — curated bento. */
const cases = [
  { i: 'case-2', img: `${BAG}/case-2.webp`, w: 520, h: 400, cap: 'Kraft bags running the line', big: true },
  { i: 'case-4', img: `${BAG}/case-4.webp`, w: 800, h: 700, cap: 'Printed totes, private label', big: false },
  { i: 'case-6', img: `${BAG}/case-6.webp`, w: 800, h: 700, cap: 'Cosmetics pouch, soft-touch print', big: false },
  { i: 'case-3', img: `${BAG}/case-3.webp`, w: 520, h: 400, cap: 'Single-needle canvas construction', big: false },
  { i: 'case-retail', img: `${BAG}/case-retail.webp`, w: 800, h: 700, cap: 'Retail tote, full-bleed print', big: false },
  { i: 'case-5', img: `${BAG}/case-5.webp`, w: 560, h: 400, cap: 'Floral-print drawstring', big: false },
];

/* Two customers, two full paragraphs, real names. */
const testimonials = [
  {
    name: 'Sarah Thompson', role: 'Marketing Manager', co: 'EcoTrend Retail', loc: 'United States',
    avatar: `${BAG}/avatar-sarah.webp`,
    q: [
      'The first batch of tote samples came back with stitching so clean we barely ran a second check. Their QC signs off on the factory floor, not on paper — which is exactly why the last 1,000 eco-friendly totes pushed our pop-up brand engagement up by 20%.',
      'Lead time held to the day. We moved 500 units, then doubled the order without touching the artwork once.',
    ],
  },
  {
    name: 'Michael Chen', role: 'Event Coordinator', co: 'Horizon Conventions', loc: 'Canada',
    avatar: `${BAG}/avatar-michael.webp`,
    q: [
      'The canvas drawstring sample was embroidered to spec, every logo crisp and evenly spaced. Because the prototype came back fast, sign-off took days instead of weeks.',
      'Five hundred bags at the conference, zero defects returned, and their updates kept the whole timeline honest.',
    ],
  },
];

/* People also ask — no overlap with the numbers above. */
const faqs = [
  { q: 'How long does custom bag production take?', a: 'Once the design is approved we agree a delivery date with you, and a rush lane is available if a launch is fixed.' },
  { q: 'Can you design the bag for me?', a: 'Yes. An in-house team turns a brief into a production-ready dieline and a sample, keeping you in the loop at each handoff.' },
  { q: 'What materials can I choose from?', a: 'Organic cotton, heavy-duty canvas, waterproof nylon and polyester, recycled fabric and natural jute. We match the material to what the product needs to survive.' },
  { q: 'Do you offer eco-friendly custom bags?', a: 'Recycled polyester from plastic bottles and jute are standard, and FSC\u00ae-certified options are available for brands that need the claim on the label.' },
  { q: 'What is your MOQ for custom bags?', a: 'Low MOQ is standard, so a launch can start small and scale with volume-tier pricing as demand grows.' },
];

const seo = {
  title: 'Custom Bag Manufacturer: OEM & ODM Bags, MOQ 500, Since 2015',
  description: 'Custom bag manufacturer for OEM, ODM and private label: MOQ 500, 4-6 week production, eco materials, and sample-first proof from a China bag factory since 2015.',
  keywords: 'custom bag manufacturer, OEM bag manufacturer, ODM bag manufacturer, private label bag manufacturer, custom bag factory, wholesale custom bags, bulk custom bags, custom bag supplier, contract bag manufacturer, custom bag production, low MOQ custom bags',
  canonical: 'https://www.leelinepackage.com/custom-bag-manufacturer/',
  ogImage: `${BAG}/hero.webp`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Custom Bag Manufacturer',
      description: seo.description,
      serviceType: 'OEM & ODM custom bag manufacturing and private label',
      provider: { '@type': 'Organization', name: 'LeelinePackage', url: 'https://www.leelinepackage.com/', areaServed: 'Worldwide' },
      areaServed: 'Worldwide',
      offers: { '@type': 'Offer', price: 'Free quote', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '320' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.leelinepackage.com/' },
        { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.leelinepackage.com/#offerings' },
        { '@type': 'ListItem', position: 3, name: 'Custom Bag Manufacturer' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const stat = [
  { v: 'Since 2015', l: 'a bag factory you can rely on' },
  { v: '3\u20137 days', l: 'to a printed sample' },
  { v: '4\u20136 weeks', l: 'to a full production' },
  { v: '90%', l: 'eco-friendly materials' },
];
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  ogType="website"
  ogImage={seo.ogImage}
  jsonLd={JSON.stringify(jsonLd)}
>
  <main id="top">
    <Navbar />

    <!-- ============ HERO (full-bleed · centred) ============ -->
    <section class="cb-hero">
      <div class="cb-hero-shade"></div>
      <div class="cb-hero-grain"></div>
      <div class="wrap cb-hero-inner">
        <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>China custom bag factory &middot; OEM &amp; ODM</span>
        <h1 class="cb-hero-title" data-reveal="up">Custom Bag Manufacturer: <em>Lower Unit Cost, Fewer Damage Returns</em></h1>
        <p class="cb-hero-sub" data-reveal="up">Cut what each bag costs and keep the product safe in transit, then sign off a printed sample before any bulk run &mdash; the board, print and finish you approve is the one that ships.</p>
        <div class="cb-hero-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
            Get a Free Quote
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ul class="cb-hero-stats" data-reveal="up">
          {stat.map((s) => (
            <li><strong>{s.v}</strong><span>{s.l}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ WHY (editorial numbers) ============ -->
    <section class="cb-why">
      <span class="cb-ghost" aria-hidden="true">why</span>
      <div class="wrap cb-why-grid">
        <div class="cb-why-head" data-reveal="up">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Why a brand picks us</span>
          <h2 class="section-title">A China Bag Factory Built Around <em>Your Brand, Not Stock</em></h2>
          <p class="section-sub">Five things that change when the factory works for you, not the other way around.</p>
        </div>
        <ol class="cb-why-list">
          {why.map((w, i) => (
            <li class="cb-why-item" data-reveal="up" style={`--d:${i * 0.06}s`}>
              <span class="cb-why-num">{w.n}</span>
              <div class="cb-why-body">
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ BAG TYPES (offset grid) ============ -->
    <section class="cb-types" id="bag-types">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Custom bag types</span>
          <h2 class="section-title" data-reveal="up">The Bag Types We <em>Cut, Sew and Print</em></h2>
          <p class="section-sub" data-reveal="up">Nine constructions, one factory. From a paper carry bag to a velvet drawstring pouch, built to your spec.</p>
        </div>
        <div class="cb-type-grid">
          {types.map((t, i) => (
            <article class="cb-type-card" data-reveal="up" style={`--d:${(i % 3) * 0.1}s`}>
              <figure class="cb-type-ph">
                <Image src={t.img} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" class="cb-img" />
              </figure>
              <h3 class="cb-type-name">{t.name}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CAPABILITY (diagonal forest band) ============ -->
    <section class="cb-cap">
      <svg class="cb-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,90 C160,20 360,8 560,32 C760,56 900,80 1120,60 C1280,44 1360,28 1440,34 L1440,90 L0,90 Z" fill="#2E4F3D"/>
      </svg>
      <div class="cb-cap-bg"></div>
      <div class="wrap cb-cap-inner">
        <div class="section-head section-head--center cb-cap-head">
          <span class="eyebrow eyebrow--light"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>What we can do</span>
          <h2 class="section-title" data-reveal="up">What a Custom Bag Manufacturer <em>Can Actually Do</em></h2>
          <p class="section-sub" data-reveal="up">A certified China bag factory that scales with you &mdash; from a startup&rsquo;s first test run to an established label&rsquo;s steady line.</p>
        </div>
        <div class="cb-cap-grid">
          {capability.map((c, i) => (
            <div class="cb-cap-card" data-reveal="up" style={`--d:${i * 0.08}s`}>
              <span class="cb-cap-num">{c.n}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          ))}
        </div>
        <div class="section-cta" data-reveal="up">
          <a class="btn btn-gold" href="/contact" target="_blank" rel="noopener">
            Use the Factory, Not a Middleman
            <svg class="btn-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ MATERIALS ============ -->
    <section class="cb-mat" id="materials">
      <div class="wrap cb-mat-grid">
        <div class="cb-mat-head" data-reveal="up">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Premium materials</span>
          <h2 class="section-title">Premium Materials, <em>Chosen for Feel and Footprint</em></h2>
          <p class="section-sub">The fabric sets the feel in a customer&rsquo;s hand, how long the bag lasts and the story it tells.</p>
          <figure class="cb-mat-hero" data-reveal="up">
            <Image src={`${BAG}/material-hero.webp`} alt="A curated stack of fabric swatches in natural, neutral and earthy tones" width={600} height={512} loading="lazy" decoding="async" class="cb-img" />
          </figure>
        </div>
        <div class="cb-mat-list">
          {materials.map((m, i) => (
            <article class="cb-mat-card" data-reveal="up" style={`--d:${i * 0.07}s`}>
              <figure class="cb-mat-ph">
                <Image src={m.img} alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async" class="cb-img" />
              </figure>
              <div class="cb-mat-body">
                <h3>{m.name}</h3>
                <p>{m.d}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CUSTOMISATION ============ -->
    <section class="cb-cust">
      <div class="wrap cb-cust-grid">
        <div class="cb-cust-body" data-reveal="up">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Customisation</span>
          <h2 class="section-title">Make the Bag <em>Unmistakably Yours</em></h2>
          <p class="section-sub">Four levers so the bag fits your product, your brand and the way you pack it.</p>
          <ol class="cb-cust-list">
            {customize.map((c, i) => (
              <li class="cb-cust-item" data-reveal="up" style={`--d:${i * 0.07}s`}>
                <span class="cb-cust-num">0{i + 1}</span>
                <div>
                  <h3>{c.t}</h3>
                  <p>{c.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="cb-cust-visual" data-reveal="right">
          <figure class="cb-cust-ph">
            <Image src={`${BAG}/customize-hero.webp`} alt="A finished custom tote bag with a printed logotype and rope handles" width={900} height={700} loading="lazy" decoding="async" class="cb-img" />
            <figcaption class="cb-cust-cap">Print, lining and hardware &mdash; on one bag</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ INDUSTRIES ============ -->
    <section class="cb-ind" id="industries">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Across industries</span>
          <h2 class="section-title" data-reveal="up">Custom Bags for <em>Every Packing Industry</em></h2>
          <p class="section-sub" data-reveal="up">Each field has its own packaging problem &mdash; we build the bag that solves it.</p>
        </div>
        <div class="cb-ind-grid">
          {industries.map((it, i) => (
            <article class="cb-ind-card" data-reveal="up" style={`--d:${(i % 3) * 0.09}s`}>
              <figure class="cb-ind-ph">
                <Image src={it.img} alt={it.alt} width={it.w} height={it.h} loading="lazy" decoding="async" class="cb-img" />
              </figure>
              <div class="cb-ind-body">
                <h3>{it.name}</h3>
                <p>{it.d}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ REAL-LIFE EXAMPLES (bento) ============ -->
    <section class="cb-cases" id="cases">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Real samples</span>
          <h2 class="section-title" data-reveal="up">Real Samples, <em>Real Product</em></h2>
          <p class="section-sub" data-reveal="up">A few bags that left the floor &mdash; totes, cosmetics pouches and kraft production runs.</p>
        </div>
        <div class="cb-carousel" data-reveal="up">
          <button class="cb-car-btn cb-car-btn--prev" type="button" aria-label="Previous sample">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <div class="cb-car-vp">
            <div class="cb-car-track">
              {cases.map((cs) => (
                <figure class="cb-car-slide" aria-hidden="true">
                  <Image src={cs.img} alt={cs.cap} width={cs.w} height={cs.h} loading="lazy" decoding="async" class="cb-car-img" />
                  <figcaption class="cb-car-cap"><span>{cs.cap}</span></figcaption>
                </figure>
              ))}
            </div>
          </div>
          <button class="cb-car-btn cb-car-btn--next" type="button" aria-label="Next sample">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ TESTIMONIALS ============ -->
    <section class="cb-quote" id="testimonials">
      <div class="wrap">
        <div class="section-head section-head--center">
          <span class="eyebrow"><svg class="eyebrow-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4c-8.5 0-15 5.2-15.4 13 .6-3 2.7-5.6 6-6.7C15.4 8.8 19 7.5 20 4z" fill="currentColor"/></svg>Customer voices</span>
          <h2 class="section-title" data-reveal="up">What Customers Say <em>About Their Bags</em></h2>
        </div>
        <div class="cb-quote-grid">
          {testimonials.map((t, i) => (
            <blockquote class="cb-quote-card" data-reveal="up" style={`--d:${i * 0.12}s`}>
              <div class="cb-quote-copy">
                {t.q.map((p) => <p>{p}</p>)}
              </div>
              <footer class="cb-quote-person">
                <Image src={t.avatar} alt={`${t.name} portrait`} width={400} height={400} loading="lazy" decoding="async" class="cb-avatar" />
                <div>
                  <strong>{t.name}</strong>
                  <span>{t.role}, {t.co} &middot; {t.loc}</span>
                </div>
              </footer>
            </blockquote>
          ))}
