  .cr-order { background: linear-gradient(rgba(237,229,212,0.64), rgba(237,229,212,0.78)), url('https://img.leelinepackage.com/custom-child-resistant/order.webp') center / cover no-repeat; padding: clamp(4rem, 9vw, 7.5rem) 0; }
  /* the photo shows through more now, so the copy drops from muted to the full ink for contrast */
  .cr-order .section-sub { max-width: 62ch; color: var(--color-brand-text); }
  .cr-route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(1rem, 2.4vw, 1.8rem); counter-reset: none; }
  .cr-stop { position: relative; padding-top: 1.1rem; border-top: 2px solid rgba(31,59,44,0.22); }
