  .dp-fork-arms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.2rem, 2.8vw, 2.4rem); }
  .dp-fork-tag { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass); }
  .dp-fork-name { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.2rem, 1.9vw, 1.5rem); line-height: 1.18; color: var(--color-brand-text); margin: 0.55rem 0 0; }
  .dp-fork-ph { aspect-ratio: 2 / 1; margin-top: 1rem; }
  .dp-fork-d { font-size: 0.94rem; line-height: 1.66; color: var(--color-brand-muted); margin: 0.9rem 0 0; max-width: 52ch; }
  .dp-fork-note { display: inline-block; margin-top: 0.9rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--forest-light); }

  /* ============ 6 · FOUR WAYS A PEN BOX FAILS (ivory) ============ */
  .dp-fail-sec { background: var(--ivory); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .dp-fail-sec .section-sub { max-width: 80ch; }
  .dp-fail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(0.9rem, 2vw, 1.4rem); }
  .dp-fail li { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 0.9rem; row-gap: 0.32rem; align-content: start; background: var(--color-brand-surface); border: 1px solid rgba(31,59,44,0.14); border-radius: 1rem; padding: clamp(1.15rem, 2.2vw, 1.6rem); }
  .dp-fail-n { grid-column: 1; grid-row: 1 / span 2; font-family: var(--font-heading); font-weight: 700; font-size: 1.05rem; line-height: 1.5; color: var(--brass); }
  .dp-fail h3 { grid-column: 2; grid-row: 1; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.08rem, 1.6vw, 1.3rem); line-height: 1.22; color: var(--color-brand-text); margin: 0; }
  .dp-fail p { grid-column: 2; grid-row: 2; font-size: 0.92rem; line-height: 1.64; color: var(--color-brand-muted); margin: 0; }

  /* ============ 7 · MID CTA (dark gradient) ============ */
  /* ⚠️ The client asked for the PHOTOGRAPH to follow the scroll (不是整条 CTA 吸顶) — a parallax
     reveal, not a sticky band. `background-attachment` is a per-layer comma list: the scrim keeps
     `scroll` so it stays welded to the band, and ONLY the photograph is `fixed`, which anchors it
     to the VIEWPORT — so the band travels over a stationary photo as you scroll.
     ⚠️ `cover` against the viewport means the photo is sized to the screen, not to the 250 px band,
     so you see one horizontal slice of it at a time. ⚠️ iOS Safari still ignores `fixed` for
     non-body elements, where this degrades to a normal scrolling background. */
  .dp-midcta {
    background-image: linear-gradient(150deg, rgba(20,38,27,0.78) 0%, rgba(31,59,44,0.52) 58%, rgba(46,79,61,0.82) 100%), url('https://img.leelinepackage.com/custom-disposable-vape/mid-cta.webp');
    background-position: center, center;
    background-size: cover, cover;
    background-repeat: no-repeat, no-repeat;
    background-attachment: scroll, fixed;
    color: var(--ivory); text-align: center; padding: clamp(4rem, 9vw, 7rem) 0; overflow: hidden;
  }
  .dp-midcta::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 62% at 50% 0%, rgba(228,181,77,0.16), transparent 70%); pointer-events: none; }
  .dp-midcta-inner { position: relative; z-index: 1; }
  .dp-midcta-title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.7rem, 3.6vw, 2.7rem); line-height: 1.06; letter-spacing: -0.026em; color: #fff; margin: 0; }
  .dp-midcta-title em { font-style: italic; color: #E3C29A; }
  .dp-midcta-sub { font-size: clamp(0.98rem, 1.4vw, 1.08rem); line-height: 1.7; color: rgba(245,240,229,0.84); max-width: 58ch; margin: 1.1rem auto 0; }
  .dp-midcta .section-cta { justify-content: center; }

  /* ============ 8 · WHAT BUYERS SAY (clay) ============ */
  .dp-say-sec { background: var(--color-brand-surface); padding: clamp(4rem, 9vw, 7.5rem) 0; }
  .dp-say-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.2rem, 3vw, 2.4rem); }
  .dp-say { margin: 0; background: var(--ivory); border: 1px solid rgba(31,59,44,0.16); border-left: 4px solid var(--brass); border-radius: 0 1rem 1rem 0; padding: clamp(1.5rem, 2.8vw, 2.1rem); display: flex; flex-direction: column; }
  .dp-say-body { display: grid; gap: 0.9rem; margin-bottom: clamp(1.3rem, 2.6vw, 1.8rem); }
  .dp-say-body p { margin: 0; font-size: 0.97rem; line-height: 1.7; color: var(--color-brand-text); }
