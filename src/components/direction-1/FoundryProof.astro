---
import FoundryMark from './FoundryMark.astro';

const testimonials = [
  {
    quote: 'Our unboxing video count tripled the quarter we switched. The mailers survive carrier drop-kicks and still look flawless on camera.',
    name: 'DTC Danny',
    role: 'Founder · 7-figure accessories brand',
  },
  {
    quote: 'The rigid boxes are the first thing my customers touch. They feel like a $200 product before it even opens — and they film it.',
    name: 'Cosmetic Carla',
    role: 'Founder · luxury skincare line',
  },
  {
    quote: 'Perfect fit, zero rattling, and the dimensional-weight savings cut our freight by 18%. I finally stopped worrying about the box.',
    name: 'Subscription Sarah',
    role: 'Ops Lead · subscription box',
  },
];

const badges = [
  { label: 'ISO 9001', sub: 'quality systems' },
  { label: 'FSC', sub: 'certified materials' },
  { label: 'ISTA', sub: 'drop & compression' },
  { label: 'CMYK / Pantone', sub: 'color matched' },
];

const brands = ['BLOOM & CO', 'DRIFT SUPPLY', 'MILA BEAUTY', 'ROAST & ROUTE', 'KIT & KIN', 'OAKMONT'];
---

<section class="proof on-dark" id="proof">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal="up">
        <span class="mark"><FoundryMark variant="notch" /></span>
        Proof, in numbers
      </p>
      <h2 class="h-display" data-reveal="clip">A decade of <em>load-bearing</em> design.</h2>
    </div>

    <!-- Stats -->
    <div class="proof-stats" data-reveal="up">
      <div class="pstat">
        <span class="pstat-num"><span data-target="500" data-suffix="K+">0</span></span>
        <span class="pstat-label">boxes shipped since 2015</span>
      </div>
      <div class="pstat">
        <span class="pstat-num"><span data-target="2015">0</span></span>
        <span class="pstat-label">founded in Wuhan</span>
      </div>
      <div class="pstat">
        <span class="pstat-num"><span data-target="500">0</span></span>
        <span class="pstat-label">minimum order, factory-direct</span>
      </div>
      <div class="pstat">
        <span class="pstat-num"><span data-target="24" data-suffix="h">0</span></span>
        <span class="pstat-label">digital 3D mockups</span>
      </div>
      <div class="pstat">
        <span class="pstat-num">3–5</span>
        <span class="pstat-label">day white-dummy samples</span>
      </div>
    </div>

    <!-- Cert badges -->
    <div class="badges" data-reveal="up" style="--d:100ms">
      {badges.map((b) => (
        <div class="badge">
          <span class="badge-mark"><FoundryMark variant="reg" /></span>
          <span class="badge-text"><strong>{b.label}</strong><small>{b.sub}</small></span>
        </div>
      ))}
    </div>

    <!-- Testimonials -->
    <div class="quotes">
      {testimonials.map((t, i) => (
        <figure class="quote" data-reveal="scale" style={`--d:${i * 120}ms`}>
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.role}</span>
          </figcaption>
          <span class="quote-notch" aria-hidden="true"><FoundryMark variant="corner" /></span>
        </figure>
      ))}
    </div>

    <!-- Logo wall -->
    <div class="logowall" data-reveal="up" style="--d:140ms">
      <div class="logowall-head">
        <FoundryMark variant="foldline" />
        <span>Trusted by DTC teams across 40+ countries</span>
      </div>
      <div class="logowall-row">
        {brands.map((b) => <span class="logo">{b}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .proof {
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background:
      radial-gradient(80% 60% at 85% 0%, rgba(199, 154, 99, 0.12), transparent 55%),
      linear-gradient(180deg, var(--foundry-ink) 0%, var(--foundry-ink-2) 100%);
    color: var(--color-brand-cream);
    position: relative;
    overflow: hidden;
  }
  .proof::after {
    content: '';
    position: absolute; top: -1px; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(199,154,99,0.5), transparent);
  }

  .section-head { margin-bottom: clamp(2.6rem, 5vw, 4rem); }
  .section-head .h-display { margin-top: 1.3rem; max-width: 20ch; }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.4rem;
    padding: clamp(1.6rem, 3vw, 2.4rem) 0;
    border-top: 1px solid var(--foundry-line-light);
    border-bottom: 1px solid var(--foundry-line-light);
  }
  .pstat { display: flex; flex-direction: column; gap: 0.45rem; }
  .pstat-num {
    font-family: var(--font-heading);
    font-weight: 540;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-brand-cream);
  }
  .pstat-label {
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(250, 247, 242, 0.5);
    line-height: 1.4;
  }

  .badges {
    display: flex; flex-wrap: wrap; gap: 0.9rem;
    margin: clamp(1.8rem, 3vw, 2.6rem) 0 clamp(2.6rem, 5vw, 4rem);
  }
  .badge {
    display: inline-flex; align-items: center; gap: 0.7rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--foundry-line-light);
    border-radius: 999px;
    transition: border-color 0.4s ease, background-color 0.4s ease, transform 0.5s var(--ease-spring);
  }
  .badge:hover { border-color: rgba(199, 154, 99, 0.5); background: rgba(199, 154, 99, 0.08); transform: translateY(-2px); }
  .badge-mark { width: 20px; height: 20px; color: var(--color-brand-accent); display: inline-flex; }
  .badge-mark svg { width: 100%; height: 100%; }
  .badge-text { display: flex; flex-direction: column; line-height: 1.2; }
  .badge-text strong { font-size: 0.86rem; font-weight: 700; letter-spacing: 0.03em; }
  .badge-text small { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(250,247,242,0.5); }

  .quotes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
    margin-bottom: clamp(2.6rem, 5vw, 4rem);
  }
  .quote {
    position: relative;
    background: rgba(250, 247, 242, 0.04);
    border: 1px solid var(--foundry-line-light);
    border-radius: 18px;
    padding: 1.9rem 1.6rem 1.6rem;
    transition: transform 0.6s var(--ease-spring), background-color 0.4s ease, border-color 0.4s ease;
  }
  .quote:hover { transform: translateY(-5px); background: rgba(250, 247, 242, 0.07); border-color: rgba(199, 154, 99, 0.35); }
  .quote-mark {
    font-family: var(--font-heading);
    font-size: 3rem; line-height: 0.4;
    color: var(--color-brand-accent);
    display: block; margin-bottom: 0.9rem;
  }
  .quote blockquote {
    font-size: 1.02rem; line-height: 1.65;
    color: rgba(250, 247, 242, 0.86);
    margin: 0 0 1.2rem;
  }
  .quote figcaption { display: flex; flex-direction: column; gap: 0.2rem; }
  .quote figcaption strong { font-family: var(--font-heading); font-weight: 560; font-size: 1.05rem; }
  .quote figcaption span { font-size: 0.78rem; letter-spacing: 0.06em; color: rgba(250, 247, 242, 0.5); }
  .quote-notch {
    position: absolute; top: 0.9rem; right: 0.9rem;
    width: 22px; height: 22px; color: rgba(199, 154, 99, 0.45);
  }
  .quote-notch svg { width: 100%; height: 100%; }

  .logowall { border-top: 1px solid var(--foundry-line-light); padding-top: clamp(1.8rem, 3vw, 2.6rem); }
  .logowall-head {
    display: flex; align-items: center; gap: 1rem;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(250, 247, 242, 0.45);
    margin-bottom: 1.6rem;
  }
  .logowall-head svg { width: 120px; height: 12px; color: var(--color-brand-accent); flex: none; }
  .logowall-row {
    display: flex; flex-wrap: wrap; gap: 1.2rem 2.4rem; align-items: center;
  }
  .logo {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    letter-spacing: 0.02em;
    color: rgba(250, 247, 242, 0.35);
    transition: color 0.35s ease;
    white-space: nowrap;
  }
  .logo:hover { color: rgba(250, 247, 242, 0.75); }

  @media (min-width: 720px) {
    .proof-stats { grid-template-columns: repeat(5, 1fr); gap: 1.6rem; }
    .quotes { grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  }
</style>
