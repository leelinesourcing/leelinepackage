---
/*
  CertMarks — a compact certification / inspection strip.

  A centred row of compliance marks above one line of supporting text. It is
  deliberately not a card and carries no fill: it sits on whatever band it is
  dropped into and gets its boundary from the marks themselves. Pass real
  width/height for every mark (the compliance scans are not square) and keep
  the sentence short enough to stay on one line at 1200px.
*/
interface Mark {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  marks: Mark[];
}

const { marks } = Astro.props;
---

<div class="cert-marks">
  <ul class="cert-marks-list">
    {marks.map((m) => (
      <li>
        <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
  <p class="cert-marks-note"><slot /></p>
</div>

<style>
  .cert-marks {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding-top: clamp(1.8rem, 3.4vw, 2.6rem);
    margin-top: clamp(2.2rem, 4.6vw, 3.4rem);
    border-top: 1px solid rgba(31, 59, 44, 0.14);
  }
  .cert-marks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.6rem, 6vw, 3.6rem);
  }
  .cert-marks-list li { display: grid; place-items: center; }
  .cert-marks-list img {
    height: clamp(30px, 3.2vw, 40px);
    width: auto;
    object-fit: contain;
    display: block;
  }
  .cert-marks-note {
    margin: 0;
    max-width: 68ch;
    text-align: center;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--color-brand-muted);
  }
  .cert-marks-note :global(strong) { color: var(--color-brand-text); font-weight: 600; }
</style>
